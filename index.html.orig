  if (def.kind === "steps") { renderSteps(def, i, prev, next); VzView.def = def; return; }
  VzView.def = def; VzView.st = Object.assign({}, def.state); VzView.tweens = null; VzView.playing = null; VzView.stale = true;
  if (def.reset) def.reset();
