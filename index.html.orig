  },
  // a name set off from the point (x, y) of the picture in the screen direction (ux, uy): its middle moves out by half
  // its own size as well, so it grows away from the point, and turns with the direction smoothly (no anchor flips)
  lab(x, y, ux, uy, off, html, col, size = 15) {
    const L = Math.hypot(ux, uy); if (L < 1e-9) { ux = .7; uy = -.7; } else { ux /= L; uy /= L; }
    const w = String(html).replace(/<[^>]+>/g, "").length * size * .55;
