      `<text x="${q2(x)}" y="${q2(y + 4.6 * fs)}" text-anchor="middle" font-family="'Manrope', sans-serif" font-size="${q2(13 * fs)}" font-weight="700" fill="${hot > .5 ? VZ.deep : VZ.ink}">${txt}</text></g>`;
