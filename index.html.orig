    const Mc = cam(...M), keep = [P, Q, Ft, F.mul(F.add(Q, Ft), .5), nTip].map(p => cam(...p)), ew = C.lab.eq.length * 7.4;
    let eq = null, bs = -Infinity;
    pa.corners.map(p => cam(...p)).forEach(c => {
      const dx = c[0] - Mc[0], dy = c[1] - Mc[1], L = Math.hypot(dx, dy) || 1, cx = c[0] + dx / L * (8 + ew / 2), cy = c[1] + dy / L * 13;
      const room = Math.min(...keep.map(k => Math.max(Math.abs(k[0] - cx) - ew / 2, Math.abs(k[1] - cy) - 10)), ...boxes.map(([bx, by, bw]) => Math.max(Math.abs(bx - cx) - (bw + ew) / 2, Math.abs(by - cy) - 16)));
      const sc2 = Math.min(room, 40) - (cy > 400 || cy < 52 ? 100 : 0);
      if (sc2 > bs) { bs = sc2; eq = { c, ux: dx / L, uy: dy / L, at: [cx, cy] }; }
    });
    if (eq) labs += this.lab(eq.c[0], eq.c[1], eq.ux, eq.uy, 8, C.lab.eq, "#7A5C0F", 13.5);
    const avoid = [P, Q, Ft, nTip].map(p => cam(...p)).concat(eq ? [eq.at, [eq.at[0] - ew / 2, eq.at[1]], [eq.at[0] + ew / 2, eq.at[1]]] : []);
    o += this.axes3(cam, avoid, 1.1) + pa.svg;
    const inP = F.sub(P, Ft), il = F.len(inP);
    if (il * sc > 3) o += vzPath3(cam, [P, Ft], `stroke="${VZ.grey}" stroke-width="1.3" stroke-dasharray="5 4"`);
    if (on) {
      o += `<g opacity=".6">${vzArrow3(cam, Ft, Q, "O", 9)}</g>`;
      if (Math.abs(sd) * sc > 16 && il * sc > 16) o += this.ra3(cam, Ft, F.mul(nh, Math.sign(sd)), F.unit(inP), 11 / sc);
    }
    o += vzArrow3(cam, P, Q, "I", 2.6) + vzArrow3(cam, P, nTip, "R", 2.8);
    o += vzDot3(cam, P, 4.5, VZ.ink) + vzDot3(cam, Q, 4.5, VZ.ink) + (on ? vzDot3(cam, Ft, 3.6, VZ.deep) : "") + labs;
    o += vzKey([["fill", VZ.gold, "the plane"], ["line", VZ.ink, "PQ"], ["line", VZ.red, "normal n"], ["line", VZ.gold, "shadow of PQ on n: the distance"]]);
    return o;
  },
  readout(s) {
    const C = this.calc(s), N = C.steps.length, k = vzClamp(Math.round(+s.k) || 0, 0, N), Fr = this._fresh, now = performance.now();
    const fresh = i => Fr && now - Fr.t < 450 && i >= Fr.from && i < Fr.to;
    const steps = C.steps.slice(0, k).map((h, i) => `<div class="vz-eq vz-small" style="display:flex;gap:9px;align-items:baseline${fresh(i) ? ";animation:vzReadIn .4s ease both" : ""}"><span style="flex:none;min-width:9px;font:800 10.5px var(--font-sans);color:var(--ink-mute)">${i + 1}</span><div style="min-width:0">${h}</div></div>`).join("");
    const btns = k < N ? `<button type="button" class="vz-chip" data-tvk="next">Show next step</button><button type="button" class="vz-chip" data-tvk="all">Show all steps</button>`
      : `<button type="button" class="vz-chip" data-tvk="hide">Hide the working</button>`;
    return `${C.ans.map(a => `<div class="vz-eq">${a}</div>`).join("")}
      <div class="vz-ptop-k" style="margin:10px 0 4px">The working${k ? ` · ${k} of ${N}` : ""}</div>${steps}
      <div class="vz-chips" style="margin:6px 0 0">${btns}</div>
