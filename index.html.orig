      if (nn > 1e-12) { const k = (F.dot(n, Q) - g("ed")) / nn, Ft = F.sub(Q, F.mul(n, k)), i = [0, 1, 2].find(j => Math.abs(n[j]) > 1e-9), P = [0, 1, 2].map(j => j === i ? g("ed") / n[i] : 0); show = [F.sub(Ft, P)]; }
    }
    show = show.filter(a => F.len(a) > 1e-9).map(F.unit);
    const nl = F.len(n), al = along ? F.len(along) : 0, y0 = vzClamp(+s.yaw || 0, -180, 180);
    let best = [y0, .45], bs = -Infinity;
    for (let e = .3; e < .86; e += .1) for (let y = -180; y <= 180; y += 5) {
      const a = vzRad(y), view = [-Math.cos(e) * Math.sin(a), -Math.cos(e) * Math.cos(a), Math.sin(e)];
      let sc = nl > 1e-9 * Math.max(1, al * al) ? -Math.pow((Math.acos(Math.min(1, Math.abs(F.dot(n, view)) / nl)) * 180 / Math.PI - target) / 30, 2)
