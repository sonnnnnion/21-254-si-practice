vzAdd({
  id: "tool-eigen", title: "Eigenvalues of your own matrix", card: "Eigenvalues of your matrix",
  tagline: "Type a matrix: get each λ, its eigenvectors, and the working.",
  tryIt: "Change any entry: every step updates.",
  blurb: "Type any \\(2\\times2\\) or \\(3\\times3\\) matrix. The working follows the course: solve \\(\\det(A-\\lambda I)=0\\) (factor, or use the quadratic formula), check against the trace and determinant, row reduce \\(A-\\lambda I\\) for each real \\(\\lambda\\) to get its eigenvectors, then compare multiplicities to decide whether \\(A=PDP^{-1}\\). Everything is exact: fractions and square roots, no rounding. The picture shows \\(\\mathbf v\\) and \\(A\\mathbf v\\): on a dashed eigenvector line, \\(A\\mathbf v=\\lambda\\mathbf v\\).",
  state: { n: 2, m2: "1|2|1|0", ok2: "1|2|1|0", m3: "2|0|0|1|3|1|1|1|3", ok3: "2|0|0|1|3|1|1|1|3", th: 26.565, yaw: TEIG_yaw(TEIG_sol({ n: 3, ok3: "2|0|0|1|3|1|1|1|3" }), -32) },
  thumb: {},
  // extra matrices for the fuzz checks
