};

/* ---------- Section 9: double integrals, change of variables, Green's theorem ---------- */
// arrows spaced along a closed or open world-space curve r(t)
function skFlowArrows(S, P, r, ts, color, w = 2.2) { ts.forEach(t => S.arrow(P(r(t - .015)), P(r(t + .015)), { color, w, head: 10 })); }

/* Region-and-strip pictures. A representative strip is a thin band whose two ends (dots) sit on the
   boundary curves, with its width marked dx or dy. Problems that switch the order show the region twice:
   vertical strips on the left, horizontal strips on the right. */
function skPanel2(S, x0, y0, w, h, xr, yr) {           // a 2-D panel at screen (x0, y0) with its own fit and light axes
  const P0 = skFit2([[xr[0], yr[0]], [xr[1], yr[1]]], w, h, { pad: 14 }), P = p => { const q = P0(p); return [q[0] + x0, q[1] + y0]; };
  S.arrow(P([xr[0], 0]), P([xr[1], 0]), { color: SKC.faint, w: 1.1, head: 7 }); S.arrow(P([0, yr[0]]), P([0, yr[1]]), { color: SKC.faint, w: 1.1, head: 7 });
  S.label("x", P([xr[1], 0]), { size: 12, color: SKC.grey, dir: [.1, 1], dist: 4 }); S.label("y", P([0, yr[1]]), { size: 12, color: SKC.grey, dir: [1, .1], dist: 4 });
  return P;
}
function skStrip(S, P, kind, c, a, b, o = {}) {       // kind "v": x = c, y from a to b; "h": y = c, x from a to b
  const w = o.w || .16, col = o.color || SKC.red, at = (s, t) => kind === "v" ? P([c + s, t]) : P([t, c + s]);
  S.region([at(-w / 2, a), at(w / 2, a), at(w / 2, b), at(-w / 2, b)], { fill: col, fop: .42, stroke: col, w: 1.1, free: true });
  const A = kind === "v" ? P([c, a]) : P([a, c]), B = kind === "v" ? P([c, b]) : P([b, c]);
  S.point(A, { r: 3.4, color: SKC.ink }); S.point(B, { r: 3.4, color: SKC.ink });
  if (o.width) S.label(o.width, A, { size: 13, color: SKC.deep, dir: kind === "v" ? [0, 1] : [-1, 0], dist: 7 });
}
function skParabolaRegion(S, P, o = {}) {              // between y = x² and y = 2 − x, which meet at x = −2 and x = 1
  const top = [], bot = [];
  for (let i = 0; i <= 40; i++) { const x = -2 + 3 * i / 40; top.push(P([x, 2 - x])); bot.push(P([x, x * x])); }
  S.region(top.concat(bot.reverse()), { fop: .09, w: 1.6 });
  skFn(S, P, x => x * x, -2.12, 1.25, { color: SKC.red, w: 1.2, free: true, op: .45 });
  skFn(S, P, x => 2 - x, -2.25, 1.4, { color: SKC.red, w: 1.2, free: true, op: .45 });
  S.point(P([-2, 4]), { r: 3 }); S.point(P([1, 1]), { r: 3 });
  if (o.labels) { S.label("y=x^2", P([-1.55, 2.4]), { color: SKC.red, dir: [-1, .3], size: o.size || 13 }); S.label("y=2-x", P([.25, 1.75]), { color: SKC.red, dir: [1, -.2], size: o.size || 13 }); }
}
// a polar cell with its two sides named: dr along the ray, r dθ along the arc
function skPolarCell(S, P, r0, r1, t0, t1) {
  const pts = [];
  for (let i = 0; i <= 16; i++) { const t = t0 + (t1 - t0) * i / 16; pts.push(P([r1 * Math.cos(t), r1 * Math.sin(t)])); }
  for (let i = 16; i >= 0; i--) { const t = t0 + (t1 - t0) * i / 16; pts.push(P([r0 * Math.cos(t), r0 * Math.sin(t)])); }
  S.region(pts, { fill: SKC.red, fop: .42, stroke: SKC.deep, w: 1.2, free: true });
  const tm = (t0 + t1) / 2, rm = (r0 + r1) / 2;          // label directions are screen vectors (y points down)
  S.line(P([0, 0]), P([r0 * Math.cos(tm), r0 * Math.sin(tm)]), { color: SKC.grey, w: 1, dash: "3 3", free: true });
  S.label("r", P([r0 * .5 * Math.cos(tm), r0 * .5 * Math.sin(tm)]), { size: 13, color: SKC.grey, dir: [-Math.sin(tm), -Math.cos(tm)], dist: 5 });
  S.label("dr", P([rm * Math.cos(t0), rm * Math.sin(t0)]), { size: 13, color: SKC.deep, dir: [Math.sin(t0), Math.cos(t0)], dist: 6 });
  S.label("r\\,d\\theta", P([r1 * Math.cos(tm), r1 * Math.sin(tm)]), { size: 13, color: SKC.deep, dir: [Math.cos(tm), -Math.sin(tm)], dist: 6 });
}

SKETCH["doublegreen-001"] = () => {
  const S = skNew(400, 250); S.grid();
  const xr = [-.5, 4.4], yr = [-.5, 6.7], tri = [[0, 0], [3, 3], [0, 6]];
  const L = skPanel2(S, 4, 26, 192, 206, xr, yr), R = skPanel2(S, 204, 26, 192, 206, xr, yr);
  [L, R].forEach(P => S.region(tri.map(P), { fop: .09, w: 1.6 }));
  S.label("y=x", L([2.3, 2.3]), { color: SKC.red, size: 12.5, dir: [1, .4] }); S.label("y=6-x", L([2, 4]), { color: SKC.red, size: 12.5, dir: [1, -.3] });
  skStrip(S, L, "v", 1.2, 1.2, 4.8, { width: "dx" });
  S.line(R([-.3, 3]), R([3.9, 3]), { color: SKC.grey, w: 1, dash: "3 4", free: true });
  skStrip(S, R, "h", 1.5, 0, 1.5, { color: SKC.gold, width: "dy" }); skStrip(S, R, "h", 4.4, 0, 1.6, { color: SKC.gold });
  S.note("dy dx: vertical strips", 100, 18, { anchor: "middle", color: SKC.ink, weight: 600 });
  S.note("dx dy: horizontal strips", 300, 18, { anchor: "middle", color: SKC.ink, weight: 600 });
  S.note("dashed: the right end switches lines here", 392, 244, { anchor: "end" });
  return skDone("Vertical strips vs horizontal strips across the triangle", S.svg("Region of integration, both orders"),
    "Each vertical strip runs from y = x up to y = 6 − x. A horizontal strip's right end lies on y = x low down but on y = 6 − x higher up, so in dx dy order the region splits where it switches.");
};

