/* ---------- Check your own work: vectors with your own numbers (Lectures 16 and 17) ----------
   The student picks what to compute (dot product and angle, projection, cross product, the plane through three
   points, the distance from a point to a plane) and types the numbers from their own problem: whole numbers,
   decimals or fractions. Everything is worked out exactly (BigInt fractions; roots pulled apart, √20 = 2√5) and
   laid out the course's way, one line per step, behind "Show next step". The picture follows the numbers: when an
   entry changes, every point glides to its new place and the view refits itself, instead of jumping. */
const TVEC_KEYS = ["v1", "v2", "v3", "w1", "w2", "w3", "p1", "p2", "p3", "q1", "q2", "q3", "r1", "r2", "r3", "ea", "eb", "ec", "ed", "x0", "y0", "z0"];
const TVEC_OPS = ["Dot · angle", "Projection", "Cross product", "Plane through 3 points", "Point to plane"];
// exact fractions [n, d] (BigInt, d > 0, lowest terms)
const TVEC_Q = (n, d = 1n) => {
  if (d < 0n) { n = -n; d = -d; }
  let a = n < 0n ? -n : n, b = d;
  while (b) [a, b] = [b, a % b];
  return a > 1n ? [n / a, d / a] : [n, d];
};
const TVEC_R = {
  add: (x, y) => TVEC_Q(x[0] * y[1] + y[0] * x[1], x[1] * y[1]),
  sub: (x, y) => TVEC_Q(x[0] * y[1] - y[0] * x[1], x[1] * y[1]),
  mul: (x, y) => TVEC_Q(x[0] * y[0], x[1] * y[1]),
  div: (x, y) => TVEC_Q(x[0] * y[1], x[1] * y[0]),          // never called with y = 0
  abs: x => [x[0] < 0n ? -x[0] : x[0], x[1]],
  z: x => x[0] === 0n,
  num: x => Number(x[0]) / Number(x[1]),
  txt: x => (x[0] < 0n ? "−" + (-x[0]) : String(x[0])) + (x[1] === 1n ? "" : "/" + x[1]),
  dot: (a, b) => a.reduce((s, x, i) => TVEC_R.add(s, TVEC_R.mul(x, b[i])), [0n, 1n]),
  cross: (a, b) => { const m = TVEC_R.mul, s = TVEC_R.sub; return [s(m(a[1], b[2]), m(a[2], b[1])), s(m(a[2], b[0]), m(a[0], b[2])), s(m(a[0], b[1]), m(a[1], b[0]))]; },
  vsub: (a, b) => a.map((x, i) => TVEC_R.sub(x, b[i])),
  scale: (k, a) => a.map(x => TVEC_R.mul(k, x)),
};
// a number from the state back to the fraction that was typed (denominators up to 10000 come back exactly)
function tvecRat(x) {
  x = +x;
  if (!Number.isFinite(x)) return [0n, 1n];
  if (Number.isInteger(x)) return [BigInt(x), 1n];
  const a = Math.abs(x), sg = x < 0 ? -1n : 1n;
  let h0 = 0, h1 = 1, k0 = 1, k1 = 0, f = a;
  for (let i = 0; i < 40; i++) {
    const t = Math.floor(f), h2 = t * h1 + h0, k2 = t * k1 + k0;
    if (k2 > 10000) break;
    h0 = h1; h1 = h2; k0 = k1; k1 = k2;
    if (Math.abs(a - h1 / k1) < 1e-10) return TVEC_Q(sg * BigInt(h1), BigInt(k1));
    const fr = f - t; if (fr < 1e-15) break; f = 1 / fr;
  }
  return TVEC_Q(sg * BigInt(Math.round(a * 10000)), 10000n);
}
// what the student typed: 2, −1.5, .25, 3/4, −3/4 (a half-typed "−" or "3/" waits quietly)
function tvecParse(raw) {
  const t = String(raw == null ? "" : raw).trim().replace(/[−–—]/g, "-").replace(/\s+/g, "");
  if (!t) return { ok: false, blank: true };
  if (/^([+-]?\.?|[+-]?\d+\/[+-]?)$/.test(t)) return { ok: false, pending: true };
  let q, m;
  if ((m = t.match(/^([+-]?)(\d+)\/([+-]?)(\d+)$/))) {
    if (BigInt(m[4]) === 0n) return { ok: false, msg: "A fraction can't have 0 at the bottom." };
    q = TVEC_Q((m[1] === "-" ? -1n : 1n) * (m[3] === "-" ? -1n : 1n) * BigInt(m[2]), BigInt(m[4]));
  } else if ((m = t.match(/^([+-]?)(\d*)(?:\.(\d*))?$/)) && (m[2] || m[3])) {
    const fr = m[3] || "";
    if (fr.length > 4) return { ok: false, msg: "Use at most 4 decimal places, or a fraction." };
    q = TVEC_Q((m[1] === "-" ? -1n : 1n) * BigInt((m[2] || "0") + fr), 10n ** BigInt(fr.length));
  } else return { ok: false, msg: "Type a number like 2, −1.5 or 3/4." };
  if (q[1] > 10000n) return { ok: false, msg: "Keep the bottom of a fraction up to 10000." };
  if (TVEC_R.abs(q)[0] > 9999n * q[1]) return { ok: false, msg: "Keep numbers between −9999 and 9999." };
  return { ok: true, q, num: TVEC_R.num(q) };
}
const tvecIn = x => TVEC_R.txt(tvecRat(x)).replace("−", "-");   // the text an entry shows for a value
function tvecIsqrt(n) {                                    // ⌊√n⌋ for a BigInt n ≥ 0
  if (n < 2n) return n;
  let x = BigInt(Math.ceil(Math.sqrt(Number(n)) * (1 + 1e-12))) + 1n;
  for (;;) { const y = (x + n / x) >> 1n; if (y >= x) break; x = y; }
  while (x * x > n) x--;
  return x;
}
// √q for a fraction q ≥ 0, as c√r with c a fraction and r a whole number with no square factor: √(20/9) = (2/3)√5
function tvecRoot(q) {
  let m = q[0] * q[1], s = 1n, r = 1n;
  if (m <= 0n) return { c: [0n, 1n], r: 1n };
  for (let f = 2n; f <= 100000n && f * f <= m; f += f === 2n ? 1n : 2n) {
    if (m % f) continue;
    let e = 0; while (m % f === 0n) { m /= f; e++; }
    for (let j = 1; j < e; j += 2) s *= f;
    if (e % 2) r *= f;
  }
  if (m > 1n) { const t = tvecIsqrt(m); if (t * t === m) s *= t; else r *= m; }
  return { c: TVEC_Q(s, q[1]), r };
}
function tvecRootTxt(x) {                                  // 3, 2√5, √2/2, −3√10/5
  const R = TVEC_R;
  if (R.z(x.c)) return "0";
  if (x.r === 1n) return R.txt(x.c);
  const n = x.c[0] < 0n ? -x.c[0] : x.c[0];
  return (x.c[0] < 0n ? "−" : "") + (n === 1n ? "" : String(n)) + "√" + x.r + (x.c[1] === 1n ? "" : "/" + x.c[1]);
}
const tvecRootNum = x => TVEC_R.num(x.c) * Math.sqrt(Number(x.r));
// a / (c√r), with the root moved to the top: 10/(2√5) = √5
const tvecOverRoot = (a, rt) => ({ c: TVEC_R.div(a, TVEC_R.mul(rt.c, [rt.r, 1n])), r: rt.r });
// "= 0.5" when the decimal is the number itself, "≈ 2.24" when it is rounded
function tvecApprox(x) {
  const a = Math.abs(x), dg = a >= 100 ? 1 : a >= 1 ? 2 : 3;
  let t = vzNum(x, dg); if (t.includes(".")) t = t.replace(/0+$/, "").replace(/\.$/, "");
  return (Math.abs(parseFloat(t.replace("−", "-")) - x) < 1e-9 ? "= " : "≈ ") + t;
}
// an exact answer in bold, with its decimal beside it when that adds something (2√5 ≈ 4.47; never 4 = 4)
const tvecNumTxt = x => tvecRootTxt(x) + (x.r === 1n && x.c[1] === 1n ? "" : " " + tvecApprox(tvecRootNum(x)));   // for the picture's caption
const tvecWithDec = x => `<b>${tvecRootTxt(x)}</b>` + (x.r === 1n && x.c[1] === 1n ? "" : ` <span class="vz-approx">${tvecApprox(tvecRootNum(x))}</span>`);
// √q written out, then simplified: √10, √20 = 2√5, √9 = 3, √(25/4) = 5/2
function tvecRootChain(q) {
  const x = tvecRoot(q), a = "√" + (q[1] === 1n ? String(q[0]) : "(" + TVEC_R.txt(q) + ")"), b = tvecRootTxt(x);
  return a === b ? `<b>${b}</b>` : `${a} = <b>${b}</b>`;
}
const tvecV = a => `<span class="vz-nw">[${a.map(TVEC_R.txt).join(", ")}]</span>`;
const tvecPt = a => `<span class="vz-nw">(${a.map(TVEC_R.txt).join(", ")})</span>`;
const tvecVs = a => `[${a.map(TVEC_R.txt).join(", ")}]`;
const tvecPts = a => `(${a.map(TVEC_R.txt).join(", ")})`;
const tvecPr = (a, b) => a.map((x, i) => `(${TVEC_R.txt(x)})(${TVEC_R.txt(b[i])})`).join(" + ");
const tvecSq = a => a.map(x => `(${TVEC_R.txt(x)})²`).join(" + ");
// an arrow over a name, for the vector from P to Q
const tvecAB = ab => `<span style="display:inline-block;position:relative">${ab}<span aria-hidden="true" style="position:absolute;left:0;right:0;top:-.66em;font-size:.72em;line-height:1;text-align:center">→</span></span>`;
// a x + b y + c z with the signs folded in (no 1x, no 0y); names may be values, (3), or brackets, (x − 1)
function tvecLin(co, names = ["x", "y", "z"]) {
  let o = "";
  co.forEach((c, i) => {
    if (TVEC_R.z(c)) return;
    const neg = c[0] < 0n, a = TVEC_R.abs(c), t = a[0] === 1n && a[1] === 1n ? "" : a[1] === 1n ? String(a[0]) : "(" + TVEC_R.txt(a) + ")";
    o += (o ? (neg ? " − " : " + ") : neg ? "−" : "") + t + names[i];
  });
  return o || "0";
}
// the 3 × 3 determinant with i, j, k on top
const tvecDet = (a, b) => `<span style="display:inline-block;vertical-align:middle;border-left:1.5px solid currentColor;border-right:1.5px solid currentColor;padding:0 2px;margin:2px 2px"><table class="vz-mtab" style="line-height:1.3">${[["<b>i</b>", "<b>j</b>", "<b>k</b>"], a.map(TVEC_R.txt), b.map(TVEC_R.txt)].map(r => `<tr>${r.map(x => `<td style="padding:1px 6px;font-size:14px">${x}</td>`).join("")}</tr>`).join("")}</table></span>`;
// a x + b y + c z = d times a number: whole numbers, no common factor, first coefficient positive
function tvecScale(co, d) {
  const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) [a, b] = [b, a % b]; return a; };
  const all = co.concat([d]); let L = 1n;
  all.forEach(x => { L = L / g(L, x[1]) * x[1]; });
  const ints = all.map(x => x[0] * (L / x[1])); let G = 0n;
  ints.forEach(x => { G = g(G, x); });
  if (!G) G = 1n;
  const lead = co.find(x => x[0] !== 0n), sg = lead && lead[0] < 0n ? -1n : 1n, f = TVEC_Q(L * sg, G), T = TVEC_R.txt;
  const ft = f[0] === 1n && f[1] === 1n ? "" : f[1] === 1n ? "× " + (f[0] < 0n ? "(" + T(f) + ")" : T(f))
    : f[0] === 1n || f[0] === -1n ? "÷ " + (f[0] < 0n ? "(−" + f[1] + ")" : String(f[1])) : "× (" + T(f) + ")";
  const out = ints.map(x => [x * sg / G, 1n]);
