  },
  // a point's name, pushed away from the middle of the figure on the picture
  ptLabel(cam, p, mid, text, col = VZ.ink, size = 13.5, boxes) {
    const q = cam(p[0], p[1], p[2]), dx = q[0] - mid[0], dy = q[1] - mid[1], L = Math.hypot(dx, dy), ux = L > 1 ? dx / L : .7, uy = L > 1 ? dy / L : -.7;
    if (boxes) { const w = text.length * size * .55; boxes.push([q[0], q[1], 10], [q[0] + ux * (14 + w / 2), q[1] + uy * (14 + size * .4), w]); }
    return this.lab(q[0], q[1], ux, uy, 14, text, col, size);
  },
  // a name at (x, y), in whichever of the screen directions dirs keeps it clearest of the boxes [cx, cy, width] already taken
  labFree(x, y, dirs, off, html, col, size, boxes) {
    const w = String(html).replace(/<[^>]+>/g, "").length * size * .55;
    let best = dirs[0], bs = -Infinity;
    dirs.forEach(([ux, uy], i) => {
      const L = Math.hypot(ux, uy) || 1, a = ux / L, b = uy / L, cx = x + a * (off + w / 2), cy = y + b * (off + size * .4);
      const d = Math.min(40, ...boxes.map(([bx, by, bw]) => Math.max(Math.abs(bx - cx) - (bw + w) / 2, Math.abs(by - cy) - 16)));
      if (d - i * 2 > bs) { bs = d - i * 2; best = [a, b]; }
    });
    return this.lab(x, y, best[0], best[1], off, html, col, size);
  },
  // the directions to try for a name past an arrow tip: straight on, then turning further and further away
