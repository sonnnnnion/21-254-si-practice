      sol.steps.map((st, j) => `<section class="st-step${j < this.rv ? " on" : ""}${j === this.rv - 1 ? " now" : j < this.rv - 1 ? " past" : ""}" data-j="${j}"><div class="st-in">
        <div class="st-step-h"><span class="st-step-n">Step ${j + 1}</span>${esc(st.t)}</div>
        ${st.why ? `<p class="st-why">${st.why}</p>` : ""}
        ${st.lines.map(L => `<div class="st-line${j < this.rv ? " on" : ""}"><div class="st-in">${L.html ? `<div class="st-text">${L.html}</div>` : `<div class="st-tex">\\[${L}\\]</div>`}</div></div>`).join("")}
