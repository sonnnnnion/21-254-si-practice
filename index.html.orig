    panel.querySelectorAll("[data-teig-n]").forEach(b => b.classList.toggle("on", +b.dataset.teigN === n));
    const mx = panel.querySelector("#teigMx"), ex = panel.querySelector("#teigEx");
    if (mx && mx.dataset.n !== String(n)) {
