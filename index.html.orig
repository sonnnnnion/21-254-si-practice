          <p>Drag, slide, or press Play, and watch the core ideas move.</p>
        </div>
      </div>
      <nav class="vz-jump" aria-label="Jump to a group">${VZ_GROUPS.filter(g => VZ_LIST.some(v => v.group === g)).map((g, gi) => `<button type="button" class="vz-chip" data-jump="vzg-${gi}">${escapeHtml(g)}</button>`).join("")}</nav>
      ${VZ_GROUPS.filter(g => VZ_LIST.some(v => v.group === g)).map((g, gi) => {
        const items = VZ_LIST.filter(v => v.group === g);
        return `<div class="vz-group" id="vzg-${gi}"><h3 class="vz-group-title">${escapeHtml(g)}</h3><div class="vz-cards">${items.map(v => `
          <a class="vz-card" href="#/visualize/${v.id}">
            <svg class="vz-thumb" viewBox="0 0 ${VZ_W} ${VZ_H}" aria-hidden="true" data-th="${v.id}">${vzDefs(v.defs)}<g clip-path="url(#vz-clip)">${v._th || ""}</g></svg>
            <span class="vz-card-title">${escapeHtml(v.card || v.title)}</span>
            <span class="vz-card-blurb">${escapeHtml(v.tagline || v.blurb)}</span>
          </a>`).join("")}</div></div>`;
      }).join("")}`;
