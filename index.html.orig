  const u = o.u || 13, w = c * u, h = r * u, x0 = x - w / 2, y0 = y - h / 2;
  S.raw("fill", `<rect x="${skN(x0)}" y="${skN(y0)}" width="${skN(w)}" height="${skN(h)}" rx="2.5" fill="${o.fill || "#FFFFFF"}" stroke="${o.stroke || SKC.ink}" stroke-width="1.3"/>`);
  let g = "";
  for (let i = 1; i < r; i++) g += `<line x1="${skN(x0)}" y1="${skN(y0 + i * u)}" x2="${skN(x0 + w)}" y2="${skN(y0 + i * u)}"/>`;
  for (let j = 1; j < c; j++) g += `<line x1="${skN(x0 + j * u)}" y1="${skN(y0)}" x2="${skN(x0 + j * u)}" y2="${skN(y0 + h)}"/>`;
  S.raw("fill", `<g stroke="${SKC.rule}" stroke-width=".8">${g}</g>`);
  if (o.row != null) S.raw("mid", `<rect x="${skN(x0)}" y="${skN(y0 + o.row * u)}" width="${skN(w)}" height="${u}" fill="${o.hl || SKC.red}" fill-opacity=".22" stroke="${o.hl || SKC.red}" stroke-width="1.2"/>`);
  if (o.col != null) S.raw("mid", `<rect x="${skN(x0 + o.col * u)}" y="${skN(y0)}" width="${u}" height="${skN(h)}" fill="${o.hl2 || SKC.gold}" fill-opacity=".22" stroke="${o.hl2 || SKC.gold}" stroke-width="1.2"/>`);
  if (o.cell) S.raw("mid", `<rect x="${skN(x0 + o.cell[1] * u)}" y="${skN(y0 + o.cell[0] * u)}" width="${u}" height="${u}" fill="${SKC.red}" fill-opacity=".45" stroke="${SKC.deep}" stroke-width="1.2"/>`);
  return { x0, y0, w, h };
}
const skDone = (title, svg, caption, extra) => Object.assign({ kicker: "Visual idea", title, svg, caption, scaled: true, plain: true }, extra || {});

/* ---------- Section 1: vectors and matrices ---------- */
SKETCH["vecmat-001"] = () => {
  const a = [2, -1, 3], b = [-1, 4, 2], O = [0, 0, 0];
  const { S, P } = sk3D([a, b], { axis: 3.4 });
  S.arrow(P(b), P(a), { color: SKC.gold, w: 2.2 });                  // a − b goes from the tip of b to the tip of a
  skVec3(S, P, O, a, { color: SKC.red, label: "a" });
  skVec3(S, P, O, b, { color: SKC.ink, label: "b" });
  const m = sk3.mul(sk3.add(a, b), .5);
  S.label("a-b", P(m), { color: SKC.gold, size: 13.5, dir: [1, -.2] });
  S.point(P(O), { r: 3 });
  return skDone("a, b and a − b form a triangle; a · b tells you its angle at 0", S.svg("a, b and a − b"),
    "The sign of a · b says whether the angle is acute, right or obtuse. If it is a right angle, the Pythagorean theorem gives ‖a − b‖ straight from ‖a‖ and ‖b‖.",
    { formula: "a\\cdot b=\\|a\\|\\,\\|b\\|\\cos\\theta,\\qquad \\|a\\|=\\sqrt{a\\cdot a}" });
};

SKETCH["vecmat-002"] = () => {
  const v = [3, -1, 4], u = k => [1, k, 2], O = [0, 0, 0];
  // the camera looks straight at the plane of v and the perpendicular u, so the right angle looks like one
  const n = sk3.unit(sk3.cross(v, u(11))), pitch = Math.asin(n[2]) - .12, yaw = Math.atan2(-n[0], -n[1]) + .12;
  const { S, P } = sk3D([v, u(11), u(0), [1, 12.5, 2], [0, 0, 0]], { axis: 4, yaw, pitch, pad: 40, noAxes: true });
  skLine3(S, P, [1, 0, 2], [0, 1, 0], -1, 12.5, { color: SKC.faint });
  skVec3(S, P, O, u(0), { color: SKC.faint, w: 1.6 });
  S.label("k=0", P(u(0)), { color: SKC.grey, size: 12.5, dir: [-.5, -1] });
  S.note("dashed: where the tip of u goes as k changes", 392, 238, { anchor: "end" });
  skRight3(S, P, O, v, u(11), 1.4);
  skVec3(S, P, O, v, { color: SKC.ink, label: "v" });
  skVec3(S, P, O, u(11), { color: SKC.red, label: "u", dir: [0, -1] });
  S.label("k=\\,?", P(u(11)), { color: SKC.red, size: 12.5, dir: [0, 1] });
  S.point(P(O), { r: 3 });
  return skDone("As k grows, the tip of u slides along a line; exactly one k makes u meet v at a right angle", S.svg("u for several k"),
    "Perpendicular means the dot product is 0: write u · v in terms of k, set it to 0, and solve.", { formula: "u\\perp v\\iff u\\cdot v=0" });
};

// matrix sizes: (2x3)(3x2) = 2x2 and (3x2)(2x3) = 3x3
SKETCH["vecmat-003"] = () => {
  const S = skNew(400, 250); S.grid();
  const row = (y, parts) => {
    let x = parts.x0;
    parts.items.forEach(it => {
      if (it.sym) { S.label(it.sym, [x + 10, y], { at: [x + 10, y], size: 16, color: SKC.grey, halo: 0 }); x += 20; return; }
      const u = 13, w = it.c * u, b = skBlock(S, x + w / 2, y, it.r, it.c, it.o || {});
      S.label(it.name, [x + w / 2, b.y0 - 11], { at: [x + w / 2, b.y0 - 11], size: 14, color: it.color || SKC.ink, halo: 0 });
      S.note(it.q ? "? × ?" : it.r + "×" + it.c, x + w / 2, b.y0 + b.h + 14, { anchor: "middle", size: 10.5, color: it.q ? SKC.red : undefined });
      x += w + 12;
    });
  };
  row(78, { x0: 70, items: [{ name: "A", r: 2, c: 3, o: { row: 0 } }, { sym: "\\cdot" }, { name: "C", r: 3, c: 2, o: { col: 0 } }, { sym: "=" }, { name: "AC", r: 2, c: 2, color: SKC.red, q: true, o: { cell: [0, 0] } }] });
  row(182, { x0: 64, items: [{ name: "C", r: 3, c: 2 }, { sym: "\\cdot" }, { name: "A", r: 2, c: 3 }, { sym: "=" }, { name: "CA", r: 3, c: 3, color: SKC.red, q: true }] });
  S.note("inner sizes must match", 200, 236, { anchor: "middle", color: SKC.green, size: 10.5 });
  return skDone("A row of A meets a column of C: the inner sizes must match", S.svg("Matrix sizes for AC and CA"),
    "Each entry of AC is a row of A dotted with a column of C, so the inner sizes must agree; the outer sizes give the size of the product.", { scaled: false });
};

SKETCH["vecmat-004"] = () => {
  // follow e1 through both products: B then A, versus A then B
  const e1 = [1, 0], Be = [3, 4], ABe = [11, -4], Ae = [1, 0];
  const { S, P } = sk2D([e1, Be, ABe, [0, 5], [12, -5]], { xr: [-1, 12.6], yr: [-5, 5.2] });
  const bend = (a, b, k) => { const pa = P(a), pb = P(b), m = [(pa[0] + pb[0]) / 2, (pa[1] + pb[1]) / 2], d = [pb[0] - pa[0], pb[1] - pa[1]], L = Math.hypot(...d);
    return [m[0] - d[1] / L * k, m[1] + d[0] / L * k]; };
  const hop = (a, b, color, name, k) => { const c = bend(a, b, k), pa = P(a), pb = P(b), pts = [];
    for (let i = 0; i <= 30; i++) { const t = i / 30; pts.push([(1 - t) ** 2 * pa[0] + 2 * (1 - t) * t * c[0] + t * t * pb[0], (1 - t) ** 2 * pa[1] + 2 * (1 - t) * t * c[1] + t * t * pb[1]]); }
    S.path(pts, { stroke: color, w: 1.8, dash: "5 4", free: true }); S.arrow(pts[26], pts[30], { color, w: 1.8, head: 9 });
    S.label(name, pts[15], { color, size: 13.5, dir: [c[0] - (pa[0] + pb[0]) / 2, c[1] - (pa[1] + pb[1]) / 2], dist: 5 }); };
  skVec2(S, P, [0, 0], e1, { color: SKC.ink, label: "e_1", dir: [0, 1] });
  hop(e1, Be, SKC.red, "B", -26); hop(Be, ABe, SKC.red, "A", -30);
  S.point(P(ABe), { color: SKC.red, r: 4 }); S.label("AB\\,e_1", P(ABe), { color: SKC.red, size: 13.5, dir: [-1, .6] });
  S.point(P(Be), { color: SKC.ink, r: 4 }); S.label("BA\\,e_1", P(Be), { color: SKC.ink, size: 13.5, dir: [1, -.4] });
  S.note("the first column of XY is X times the first column of Y", 392, 20, { anchor: "end" });
  return skDone("Follow e₁ through B then A, and through A then B", S.svg("Following e1 through AB and BA"),
    "Follow e₁ both ways: AB e₁ applies B first and then A, BA e₁ the other way round. If the two land in different places, one column is enough to show AB ≠ BA.",
    { formula: "AB\\,e_1=A(Be_1),\\qquad BA\\,e_1=B(Ae_1)" });
};

SKETCH["vecmat-005"] = () => {
  const S = skNew(400, 250); S.grid();
  const blocks = (y, items, x0) => { let x = x0; const out = [];
    items.forEach(it => { if (it.sym) { S.label(it.sym, [x + 10, y], { at: [x + 10, y], size: 16, color: SKC.grey, halo: 0 }); x += 20; return; }
      const w = it.c * 12, b = skBlock(S, x + w / 2, y, it.r, it.c, { u: 12 }); out.push([x + w / 2, b.y0, b.y0 + b.h]);
      S.label(it.name, [x + w / 2, b.y0 - 11], { at: [x + w / 2, b.y0 - 11], size: 14, color: it.color || SKC.ink, halo: 0 });
      S.note(it.r + "×" + it.c, x + w / 2, b.y0 + b.h + 13, { anchor: "middle", size: 10.5 }); x += w + 12; });
    return out; };
  const top = blocks(70, [{ name: "A", r: 2, c: 3 }, { sym: "\\cdot" }, { name: "C", r: 3, c: 2 }, { sym: "=" }, { name: "AC", r: 2, c: 2 }], 96);
  const bot = blocks(180, [{ name: "C^T", r: 2, c: 3, color: SKC.red }, { sym: "\\cdot" }, { name: "A^T", r: 3, c: 2, color: SKC.red }, { sym: "=" }, { name: "(AC)^T", r: 2, c: 2, color: SKC.red }], 96);
  S.arrow([top[0][0], top[0][2] + 20], [bot[1][0] - 8, bot[1][1] - 20], { color: SKC.faint, w: 1.2, head: 7 });
  S.arrow([top[1][0], top[1][2] + 20], [bot[0][0] + 8, bot[0][1] - 20], { color: SKC.faint, w: 1.2, head: 7 });
  S.note("transposing reverses the order", 200, 236, { anchor: "middle", color: SKC.red });
  return skDone("(AC)ᵀ = CᵀAᵀ: transpose each factor and reverse the order", S.svg("Transpose of a product"),
    "Row i of A times column j of C becomes entry (j, i): exactly row j of Cᵀ times column i of Aᵀ.", { scaled: false, formula: "(AC)^T=C^TA^T" });
};

SKETCH["vecmat-006"] = () => {
  const S = skNew(400, 250); S.grid();
  const M = skMatrix(S, 200, 112, [["2", "k", "0"], ["1", "3", "4"], ["0", "4", "-1"]], { cw: 48, ch: 40, size: 17,
    colorAt: (i, j) => ((i === 0 && j === 1) || (i === 1 && j === 0)) ? SKC.red : null });
  for (let i = 0; i < 3; i++) { const c = M.cell(i, i); S.raw("fill", `<rect x="${skN(c[0] - 20)}" y="${skN(c[1] - 16)}" width="40" height="32" rx="8" fill="${SKC.gold}" fill-opacity=".16"/>`); }
  const pair = (a, b, color, w) => { const p = M.cell(...a), q = M.cell(...b), d = [q[0] - p[0], q[1] - p[1]], L = Math.hypot(...d), u = [d[0] / L, d[1] / L];
    S.arrow([p[0] + u[0] * 15, p[1] + u[1] * 15], [q[0] - u[0] * 15, q[1] - u[1] * 15], { color, w, head: 7 });
    S.arrow([q[0] - u[0] * 15, q[1] - u[1] * 15], [p[0] + u[0] * 15, p[1] + u[1] * 15], { color, w, head: 7 }); };
  pair([0, 1], [1, 0], SKC.red, 1.5); pair([1, 2], [2, 1], SKC.faint, 1.2);
  S.ring(M.cell(0, 1), 14, { color: SKC.red }); S.ring(M.cell(1, 0), 14, { color: SKC.red });
  S.note("the diagonal is the mirror; mirrored entries must match", 200, 208, { anchor: "middle", color: SKC.grey });
  S.note("so which k makes the red pair match?", 200, 226, { anchor: "middle", color: SKC.red, weight: 600 });
  return skDone("Symmetric means the matrix is its own mirror image across the diagonal", S.svg("Symmetric matrix"),
    "Entry (1, 2) must equal entry (2, 1). Check that every other mirrored pair already matches, then solve for k.", { scaled: false, formula: "M^T=M\\iff m_{ij}=m_{ji}" });
};

SKETCH["vecmat-007"] = () => {
  const S = skNew(400, 250); S.grid();
  const nodes = [["e_3", 70], ["e_2", 160], ["e_1", 250], ["\\mathbf 0", 340]], y = 118;
  nodes.forEach(([t, x], i) => {
    S.raw("fill", `<circle cx="${x}" cy="${y}" r="22" fill="${i === 3 ? SKC.goldTint : "#FFFFFF"}" stroke="${i === 3 ? SKC.gold : SKC.ink}" stroke-width="1.5"/>`);
    S.label(t, [x, y], { at: [x, y], size: 17, color: i === 3 ? SKC.gold : SKC.ink, halo: 0 });
    if (i < 3) { S.arrow([x + 26, y], [nodes[i + 1][1] - 26, y], { color: SKC.red, w: 2 }); S.label("N", [(x + nodes[i + 1][1]) / 2, y - 16], { at: [(x + nodes[i + 1][1]) / 2, y - 17], size: 14, color: SKC.red, halo: 0 }); }
  });
  S.raw("mid", `<path d="M${skPt([70, 146])}C${skPt([90, 196])} ${skPt([230, 196])} ${skPt([250, 146])}" fill="none" stroke="${SKC.grey}" stroke-width="1.3" stroke-dasharray="4 3"/>`);
  S.label("N^2", [160, 194], { at: [160, 200], size: 14, color: SKC.grey, halo: 3 });
  S.note("N shifts every coordinate down one slot", 200, 236, { anchor: "middle" });
  return skDone("N pushes e₃ → e₂ → e₁ → 0: follow the chain", S.svg("Nilpotent shift"),
    "Each column of N is the next basis vector down the chain. Count how many pushes it takes before every basis vector has reached 0.", { scaled: false, formula: "Ne_1=\\mathbf 0,\\quad Ne_2=e_1,\\quad Ne_3=e_2" });
};

