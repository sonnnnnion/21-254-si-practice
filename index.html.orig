    const fill = () => { if (!root.isConnected) return; todo.splice(0, 6).forEach(el => { const g = el.querySelector("g[clip-path]"); if (g) g.innerHTML = vzThumb(VZ_BY_ID[el.dataset.th]); el.classList.add("vz-th-in"); }); if (todo.length) requestAnimationFrame(fill); };
    if (todo.length) requestAnimationFrame(fill);
