SKETCH["doublegreen-003"] = () => {
  const { S, P } = sk2D([[-2.2, 4.2], [1.4, -.3]], { xr: [-2.5, 1.7], yr: [-.4, 4.5] });
  skParabolaRegion(S, P, { labels: true, size: 14 });
