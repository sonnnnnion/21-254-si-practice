      // on the far side from 0, and w's past its tip, off the dashed line
      const side = (uw[0] * v[1] - uw[1] * v[0]) >= 0 ? -1 : 1, nx = -uw[1] * side, ny = -uw[0] * side, wx = uw[0], wy = -uw[1];
      const pop = vzClamp((pl - 20) / 20, 0, 1), qop = vzClamp((ql - 22) / 20, 0, 1), m1 = F.mul(pr, .5), m2 = F.add(pr, F.mul(perp, .5));
      if (pop > .01) labs.push(`<g opacity="${q2(pop)}">${this.lab(P.X(m1[0]), P.Y(m1[1]), nx, ny, 12, vzSub("proj", "w", "(v)"), "#7A5C0F")}</g>`);
      if (qop > .01) labs.push(`<g opacity="${q2(qop)}">${this.lab(P.X(m2[0]), P.Y(m2[1]), sg * wx, sg * wy, 10, vzB("v") + "<tspan>⊥</tspan>", VZ.deep)}</g>`);
