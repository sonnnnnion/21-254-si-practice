    if (el.dataset.rrR == null) return;
    const r = +el.dataset.rrR, c = +el.dataset.rrC; if (this.mat(s) !== s.A || !s.A[r] || s.A[r][c] == null) return;
    const P = trrefParse(el.value), mark = on => { el.style.borderColor = on ? "var(--gold, #B89642)" : ""; el.style.background = on ? "#FFFAEB" : ""; el.setAttribute("aria-invalid", on ? "true" : "false"); };
    if (P.bad) {                                           // half-typed or not a number: say so, keep the last good number in the picture
