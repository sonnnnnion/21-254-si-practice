        <button class="btn btn-red btn-sm" type="button" data-rr="next">Next step</button>
        <button class="btn btn-ghost btn-sm" type="button" data-rr="all">Show all</button>
        <button class="btn btn-ghost btn-sm" type="button" data-rr="reset">Start over</button>
      </div>
