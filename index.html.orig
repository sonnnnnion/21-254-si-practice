      if (op === 2) {                                         // the parallelogram (its half, the triangle, a shade darker) and v × w
        const cr = lc * sc > 3 ? vzArrow3(cam, Z, cd, "D", 3.2) : "", front = F.dot(c, cam.view) >= 0;
        if (!front) o += cr;
        if (lc > 1e-9) {
          const pt = p => { const q = cam(p[0], p[1], p[2]); return q2(q[0]) + " " + q2(q[1]); };
          o += `<path d="M${pt(Z)}L${pt(v)}L${pt(F.add(v, w))}L${pt(w)}Z" fill="${VZ.red}" fill-opacity=".12" stroke="${VZ.red}" stroke-opacity=".5" stroke-width="1.3" stroke-linejoin="round"/>`;
          o += `<path d="M${pt(Z)}L${pt(v)}L${pt(w)}Z" fill="${VZ.red}" fill-opacity=".1" stroke="none"/>` + vzPath3(cam, [v, w], `stroke="${VZ.red}" stroke-opacity=".45" stroke-width="1.1" stroke-dasharray="4 4"`);
        }
        if (front) o += cr;
        if (lc * sc > 3) tips.push({ v: cd, html: vzB("v") + " × " + vzB("w"), col: VZ.deep });
      }
      o += vzArrow3(cam, Z, w, "R", 2.6) + vzArrow3(cam, Z, v, "I", 2.8) + `<circle cx="${q2(O[0])}" cy="${q2(O[1])}" r="3.4" fill="${VZ.ink}"/>`;
      const FP = { X: x => O[0] + x, Y: y => O[1] + y }, scr = p => { const q = cam(p[0], p[1], p[2]); return [q[0] - O[0], q[1] - O[1]]; };
      o += vzTipLabels(FP, tips.map(q => Object.assign({}, q, { v: scr(q.v) })));
      const zs = [lv * sc < 3 ? "v" : "", lw * sc < 3 ? "w" : ""].filter(Boolean);
      if (zs.length) o += vzLabel(O[0] + 12, O[1] - 12, zs.map(n => vzB(n)).join(", ") + " = 0", VZ.ink, 15, "start");
