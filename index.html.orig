  const drop = (to, k, op, col = VZ.grey, w = 1.5, dash = "3 4") => k > 0 && op > .01 && len(sub(G.v, to)) > .02
    ? `<g opacity="${q2(op)}">${vzPath3(cam, [G.v, lerp(G.v, to, k)], `stroke="${col}" stroke-width="${w}" stroke-dasharray="${dash}" stroke-linecap="round"`)}</g>` : "";
