      const d = tdetNum(tdetDetQ(Array.from({ length: n }, (_, i) => M.slice(i * n, i * n + n).map(v => ({ n: BigInt(v), d: 1n })))));
      if (!d || Math.abs(d) > (n === 3 ? 30 : 15)) continue;
