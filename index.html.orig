  },
  // ---- space ℝ³: a camera that turns about the middle of the scene and keeps all of it on the picture ----
  cam3(pts, yaw, el = .45) {
    const lo = [Infinity, Infinity, Infinity], hi = [-Infinity, -Infinity, -Infinity];
    pts.forEach(p => p.forEach((x, i) => { lo[i] = Math.min(lo[i], x); hi[i] = Math.max(hi[i], x); }));
    const C = lo.map((a, i) => (a + hi[i]) / 2);
    let R = .8; pts.forEach(p => { R = Math.max(R, Math.hypot(p[0] - C[0], p[1] - C[1], p[2] - C[2])); });
    let sc = 166 / R, base = vzCam(0, 0, sc, vzRad(yaw), vzClamp(Number.isFinite(+el) ? +el : .45, .1, 1.3)), ox = 300, oy = 240;
    if (this._tight) {                                     // the card's thumbnail never turns: fill it with the scene as seen
      const q = pts.map(p => base(p[0] - C[0], p[1] - C[1], p[2] - C[2])), xs = q.map(a => a[0]), ys = q.map(a => a[1]);
      const k = Math.min(500 / Math.max(1, Math.max(...xs) - Math.min(...xs)), 330 / Math.max(1, Math.max(...ys) - Math.min(...ys)));
      sc *= k; base = vzCam(0, 0, sc, vzRad(yaw), vzClamp(+el || .45, .1, 1.3)); ox = 300 - k * (Math.max(...xs) + Math.min(...xs)) / 2; oy = 230 - k * (Math.max(...ys) + Math.min(...ys)) / 2;
    }
    const f = (x, y, z) => { const q = base(x - C[0], y - C[1], z - C[2]); return [ox + q[0], oy + q[1], q[2]]; };
    f.view = base.view; f.sc = sc; f.C = C; f.R = R;
    return f;
  },
  // light x, y, z axes through 0, when 0 is near the scene; an axis keeps its name only where no other name is near
  axes3(cam, avoid = [], near0 = 1.6) {
    if (Math.hypot(...cam.C) > near0 * cam.R) return "";
    const L = cam.R; let o = "";
    [[1, 0, 0, "x"], [0, 1, 0, "y"], [0, 0, 1, "z"]].forEach(([a, b, c, n]) => {
      const A = cam(-a * L * .4, -b * L * .4, -c * L * .4), B = cam(a * L, b * L, c * L), T = cam(a * L * 1.1, b * L * 1.1, c * L * 1.1);
      o += `<line x1="${q2(A[0])}" y1="${q2(A[1])}" x2="${q2(B[0])}" y2="${q2(B[1])}" stroke="${VZ.ink}" stroke-width="1.1" opacity=".26"/>`;
      const near = Math.min(99, ...avoid.map(q => Math.hypot(q[0] - T[0], q[1] - T[1])));
      if (near > 20) o += `<g opacity="${q2(vzClamp((near - 20) / 16, 0, 1))}">${vzLabel(T[0], T[1] + 5, n, VZ.grey, 14)}</g>`;
    });
    return o;
  },
  ra3(cam, p, d1, d2, s) {                                 // the square of a right angle at p, between unit directions d1, d2
    const F = TVEC_F, a = F.add(p, F.mul(d1, s)), b = F.add(a, F.mul(d2, s)), c = F.add(p, F.mul(d2, s));
    return vzPath3(cam, [a, b, c], `stroke="${VZ.deep}" stroke-width="1.3"`);
  },
  // a plane patch: a square of half-size h about the point M, and its in-plane directions
  patch(cam, n, M, h) {
    const F = TVEC_F, nh = F.unit(n); let e1 = F.cross(nh, [0, 0, 1]);
    e1 = F.len(e1) < 1e-6 ? [1, 0, 0] : F.unit(e1);
    const e2 = F.cross(nh, e1), at = (i, j) => F.add(M, F.add(F.mul(e1, i * h), F.mul(e2, j * h)));
    const cs = [at(-1, -1), at(1, -1), at(1, 1), at(-1, 1)], pt = p => { const q = cam(p[0], p[1], p[2]); return q2(q[0]) + " " + q2(q[1]); };
    let o = `<path d="M${cs.map(pt).join("L")}Z" fill="${VZ.gold}" fill-opacity=".11" stroke="${VZ.gold}" stroke-opacity=".6" stroke-width="1.3" stroke-linejoin="round"/>`;
    for (let k = -1; k <= 1; k++) o += `<path d="M${pt(at(k / 2, -1))}L${pt(at(k / 2, 1))}M${pt(at(-1, k / 2))}L${pt(at(1, k / 2))}" stroke="${VZ.gold}" stroke-opacity=".28" fill="none"/>`;
    const top = cs.map(p => cam(p[0], p[1], p[2])).reduce((a, q) => q[1] < a[1] ? q : a);
