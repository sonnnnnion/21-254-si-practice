    const ly = P.cy + 15 > 410 ? P.cy - 7 : P.cy + 15;
    for (let i = Math.ceil((16 - P.cx) / u / step); i <= Math.floor((584 - P.cx) / u / step); i++) if (i) { const X = P.X(i * step); o += `<path d="M${q2(X)} ${q2(P.cy - 3)}V${q2(P.cy + 3)}" stroke="${VZ.ink}" stroke-opacity=".35"/>` + (ly > 50 ? tx(X, ly, i * step, "middle") : ""); }
    for (let i = Math.ceil((P.cy - 440) / u / step); i <= Math.floor((P.cy - 14) / u / step); i++) if (i) { const Y = P.Y(i * step); o += `<path d="M${q2(P.cx - 3)} ${q2(Y)}H${q2(P.cx + 3)}" stroke="${VZ.ink}" stroke-opacity=".35"/>` + (Y > 50 && Y < 408 ? tx(P.cx - 7, Y + 4, i * step, "end") : ""); }
    return `<g class="vz-note">${o}</g>`;
  },
  flat(s, D, C, thumb) {
    const F = TVEC_F, op = this.op(s), v = [D.v1, D.v2], w = [D.w1, D.w2], ww = F.dot(w, w), pr = op === 1 && ww > 1e-12 ? F.mul(w, F.dot(v, w) / ww) : null;
    let x0 = 0, x1 = 0, y0 = 0, y1 = 0;
