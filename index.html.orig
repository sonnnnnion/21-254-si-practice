  },
});

/* ---------- 4b. Projection onto a plane in ℝ³ (Lecture 16, Theorem 16.2) ----------
   A short film in four takes, over a plane P tiled by its basis {w₁, w₂}:
   1. a plumb line drops from the tip of v onto the line of w₁, and the shadow proj_w₁(v) runs out along it;
   2. the same for w₂;
   3. the second shadow slides tip to tail onto the first, and their sum v∥ lands on a corner of the tiling;
   4. a plumb line drops from v straight onto v∥: v⊥ meets P square, and its length is the distance.
   With a basis that is not orthogonal the shadows still add up, but to the wrong corner, and the drop leans. */
const VZ_PLANES = [
  { chip: "The floor z = 0", eq: "z = 0", n: [0, 0, 1], w1: [1, 0, 0], w2: [0, 1, 0], v: [1, 2, 3], yaw: -40, el: .6 },
  { chip: "A tilted plane", eq: "x + 2z = 0", n: [1, 0, 2], w1: [0, 1, 0], w2: [2, 0, -1], v: [-1, 2, 3], yaw: -34, el: .5 },
  { chip: "Not orthogonal", eq: "z = 0", n: [0, 0, 1], w1: [2, 0, 0], w2: [1, 1, 0], v: [1, 2, 2], yaw: -34, el: .66, bad: true, fit: 232 },
];
// √n for an SVG label: exact when it can be (3, √6, 2√2), two decimals otherwise
function vzRootTxt(n2) {
  const r = Math.sqrt(Math.max(0, n2)), k = Math.round(n2);
  if (Math.abs(r - Math.round(r)) < 1e-9) return String(Math.round(r));
  if (Math.abs(n2 - k) > 1e-9) return vzNum(r);
  let out = 1, inn = k; for (let f = 2; f * f <= inn; f++) while (inn % (f * f) === 0) { out *= f; inn /= f * f; }
  return (out > 1 ? out : "") + "√" + inn;
}
// ---- the projection-onto-a-plane scene, shared by the picture and the step-by-step method ----
// G: v against a plane through 0 with basis w₁, w₂ (Pl: { eq, n, w1, w2, bad })
function vzProjGeo(Pl, v) {
  const w1 = Pl.w1, w2 = Pl.w2, d1 = vzDot(v, w1), n1 = vzDot(w1, w1), d2 = vzDot(v, w2), n2 = vzDot(w2, w2), g = vzDot(w1, w2);
  const c1 = d1 / n1, c2 = d2 / n2, p1 = w1.map(x => x * c1), p2 = w2.map(x => x * c2), sum = p1.map((x, i) => x + p2[i]);
  // coordinates (a, b) of a point a w₁ + b w₂ of P, from its dot products with w₁ and w₂
  const det = n1 * n2 - g * g, ab = p => { const e1 = vzDot(p, w1), e2 = vzDot(p, w2); return [(e1 * n2 - e2 * g) / det, (n1 * e2 - g * e1) / det]; };
  const tc = ab(v), tru = w1.map((x, i) => x * tc[0] + w2[i] * tc[1]);            // the true closest point
  const perp = v.map((x, i) => x - sum[i]), nn = Math.hypot(...Pl.n), sg = vzDot(v, Pl.n) < 0 ? -1 : 1;
  return { Pl, v, w1, w2, d1, n1, d2, n2, g, c1, c2, p1, p2, sum, tru, perp, ab, bad: !!Pl.bad, nrm: Pl.n.map(x => x * sg / nn) };
}
// the corners of the patch of P that is drawn, in the w₁, w₂ grid, around everything that lands on P
function vzProjPatch(G) {
  const pts = [[0, 0], [1, 0], [0, 1], [G.c1, 0], [0, G.c2], [G.c1, G.c2], G.ab(G.tru)], L1 = Math.sqrt(G.n1), L2 = Math.sqrt(G.n2);
  // a margin of 0.7 (in length, whatever the size of w₁, w₂) around them, and at least 3.4 across each way
  let a0 = Math.min(...pts.map(p => p[0])) - .7 / L1, a1 = Math.max(...pts.map(p => p[0])) + .7 / L1;
  let b0 = Math.min(...pts.map(p => p[1])) - .7 / L2, b1 = Math.max(...pts.map(p => p[1])) + .7 / L2;
  const grow = (lo, hi, L) => { const d = Math.max(0, 3.4 / L - (hi - lo)) / 2; return [lo - d, hi + d]; };
  [a0, a1] = grow(a0, a1, L1); [b0, b1] = grow(b0, b1, L2);
