        let e = F.sub(b, F.mul(a, cs)); if (F.len(e) < 1e-9) e = F.cross(a, Math.abs(a[0]) < .9 ? [1, 0, 0] : [0, 1, 0]); e = F.unit(e);
        if (C.lab.perp && Math.abs(cs) < 1e-9) o += this.ra3(cam, Z, a, e, 13 / sc);
        else if (th > .02) {
          const pts = []; for (let i = 0; i <= 36; i++) { const q = th * i / 36; pts.push(F.add(F.mul(a, r * Math.cos(q)), F.mul(e, r * Math.sin(q)))); }
          const rm = r + 14 / sc, M = cam(...F.add(F.mul(a, rm * Math.cos(th / 2)), F.mul(e, rm * Math.sin(th / 2))));
          o += vzPath3(cam, pts, `stroke="${VZ.grey}" stroke-width="1.4"`) + vzLabel(M[0], M[1] + 5, "θ", VZ.grey, 15);
        }
