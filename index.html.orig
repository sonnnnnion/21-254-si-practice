function vzProjScene(cam, camR, G, ph, opt = {}) {
  const { basis = 1, dropA = 0, shA = 0, fadeA = 1, sqA = 0, labA = 0, dropB = 0, shB = 0, fadeB = 1, sqB = 0, labB = 0,
    slide = 0, sumG = 0, dim = 0, labSum = 0, dropD = 0, sq = 0, tri = 0, dist = 0, truD = 0, truS = 0 } = ph;
  const W = opt.W || 600, H = opt.H || 450, AX = opt.axis == null ? 3.1 : opt.axis, nm = opt.names || {};   // axis 0: no axes
  const pr = p => cam(p[0], p[1], p[2]), add = (a, b) => a.map((x, i) => x + b[i]), sub = (a, b) => a.map((x, i) => x - b[i]);
  const mul = (k, a) => a.map(x => x * k), lerp = (a, b, k) => a.map((x, i) => x + (b[i] - x) * k), len = a => Math.hypot(...a), unit = a => mul(1 / (len(a) || 1), a);
  const P2 = q => q2(q[0]) + " " + q2(q[1]), O = [0, 0, 0], So = pr(O), above = vzDot(cam.view, G.nrm) >= 0;
  let plane = "", flat = "", up = "";

