  },
  // ---- the plane ℝ²: dot product and angle, projection ----
  ticks(P) {                                               // small numbers along the axes, a round step apart
    const u = P.u, step = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000, 50000].find(c => c * u >= 34) || 1e5;
    const tx = (x, y, s, a) => `<text x="${q2(x)}" y="${q2(y)}" font-family="'Manrope', sans-serif" font-size="11" fill="${VZ.faint}" text-anchor="${a}">${vzNum(s, 0)}</text>`;
    let o = "";
