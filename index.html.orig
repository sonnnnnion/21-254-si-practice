    Object.assign(tipOf(G.w1), { id: "w1", html: vzB("w", "1"), col: VZ.red, op: basis }),
    Object.assign(tipOf(G.w2), { id: "w2", html: vzB("w", "2"), col: "#22603A", op: basis }),
  ];
  if (len(G.p1) > .3) items.push(Object.assign(footOf(G.p1), { id: "p1", html: vzSub("proj", "w₁", "(v)"), col: VZ.red, op: labA, size: 14 }));
  if (len(G.p2) > .3) items.push(Object.assign(footOf(G.p2), { id: "p2", html: vzSub("proj", "w₂", "(v)"), col: "#22603A", op: labB, size: 14 }));
  if (len(G.sum) > .3) items.push(Object.assign(tipOf(G.sum), { id: "sum", html: nm.sum || (G.bad ? "sum of shadows" : vzB("v") + "<tspan>∥</tspan>"), col: "#7A5C0F", op: labSum, size: nm.sum ? 14 : 16 }));
  if (len(G.perp) > .3) items.push(Object.assign(midOf(G.sum, G.v), { id: "perp", html: nm.perp || (G.bad ? "v − sum" : vzB("v") + `<tspan>⊥</tspan><tspan font-style="normal" font-size="14">  length ${vzRootTxt(vzDot(G.perp, G.perp))}</tspan>`), col: VZ.deep, op: dist, gap: 10 }));
  if (G.bad && len(sub(G.v, G.tru)) > .3) {
    const T = pr(G.tru), Sm = pr(G.sum), dx = T[0] - Sm[0], dy = T[1] - Sm[1], L = Math.hypot(dx, dy) || 1;
    items.push({ id: "tru", at: [T[0], T[1]], dir: [dx / L, dy / L], html: "closest point", col: VZ.ink, op: truS, size: 14 });
