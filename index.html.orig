    return `<div class="vz-mx teig-mx${n === 3 ? " teig-n3" : ""}"><span class="vz-mx-name"><i>A</i> =</span><span class="vz-brk vz-mx-grid" style="grid-template-columns:repeat(${n}, ${n === 3 ? 54 : 60}px)">${Array.from({ length: n * n }, (_, k) =>
      `<input type="text" id="teig-e${k}" class="teig-in" data-teig-e="${k}" value="${escapeHtml(raw[k] || "")}" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="next" aria-label="row ${Math.floor(k / n) + 1}, column ${k % n + 1}">`).join("")}</span>
      <span class="vz-mx-hint">whole numbers, decimals or fractions like −3/4</span></div>`;
  },
  sync(s, panel) {
