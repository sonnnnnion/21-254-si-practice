const TEIG_CSS = `
.teig-board { position: absolute; z-index: 2; display: flex; flex-direction: column; background: var(--surface); border-right: 1px solid var(--border);
  border-radius: var(--r-lg) 0 0 var(--r-lg); overflow: hidden; container-type: inline-size; }
.teig-board.teig-stack { position: relative; z-index: auto; margin: 14px 0 2px; border: 1px solid var(--border); border-radius: var(--r-md); overflow: visible; }
.teig-scroll { position: relative; flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; padding: 0 18px 14px; }
.teig-stack .teig-scroll { overflow: visible; padding: 0 13px 10px; }
.teig-math { font-size: clamp(14px, 3.2cqw, 17.5px); }
.teig-layer { transition: opacity .3s ease; }
.teig-layer.teig-pending { position: absolute; left: 18px; right: 18px; top: 0; visibility: hidden; pointer-events: none; }
.teig-stack .teig-layer.teig-pending { left: 13px; right: 13px; }
.teig-board.teig-stale .teig-layer { opacity: .4; }
.teig-given { position: sticky; top: 0; z-index: 1; background: var(--surface); padding: 14px 0 10px; border-bottom: 1px dashed var(--border-strong); line-height: 1.5; color: var(--ink); }
.teig-given::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 14px; background: linear-gradient(var(--surface), rgba(255, 255, 255, 0)); pointer-events: none; }
.teig-stack .teig-given { position: static; padding-top: 12px; }
.teig-stack .teig-given::after { display: none; }
.teig-board .st-step.now .st-step-n { color: var(--red); }
.teig-board .st-step:not(.now) .st-step-n { color: var(--ink-mute); }
.teig-board .st-text { font-size: .95em; }
.teig-board .st-tex { scrollbar-width: thin; }
.teig-foot { flex: none; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 9px 18px 10px; border-top: 1px solid var(--border); background: var(--surface); }
.teig-stack .teig-foot { position: sticky; bottom: 0; z-index: 2; padding: 9px 13px; border-radius: 0 0 var(--r-md) var(--r-md); box-shadow: 0 -6px 14px rgba(31, 41, 51, .06); }
.teig-foot .btn { gap: 6px; }
.teig-foot .btn:disabled { opacity: .45; cursor: default; }
.teig-count { margin-left: auto; font: 700 11px var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-mute); white-space: nowrap; }
.teig-head { display: none; }
.teig-stack .teig-head { display: block; padding: 11px 13px 0; font: 800 11px var(--font-sans); letter-spacing: .09em; text-transform: uppercase; color: var(--ink-mute); }
.teig-mx .vz-mx-grid input.teig-bad { border-color: var(--red); background: var(--red-tint); }
.teig-mx .vz-mx-grid input { font-size: 13.5px; }
.teig-mx.teig-n3 { grid-template-columns: auto auto; }
.teig-mx.teig-n3 .vz-mx-hint { grid-column: 1 / -1; }
.teig-top { display: grid; gap: 10px; }
.teig-top .vz-mx { margin: 0; }
`;
const TEIG_UI = {
  ver: 0, key: "", rv: 1, steps: 0, timer: 0, split: null,
  reset() { this.ver++; this.key = ""; this.split = null; clearTimeout(this.timer); this.rv = 1; },
  css() { if (!document.getElementById("teigCss")) { const st = document.createElement("style"); st.id = "teigCss"; st.textContent = TEIG_CSS; document.head.appendChild(st); } },
  board() { return document.getElementById("teigBoard"); },
  // where the board goes: over the left of the picture when the picture is wide, else in the panel
  place(def) {
    const wrap = document.querySelector(".vz-stage-wrap"), stage = document.getElementById("vzStage"), panel = document.querySelector(".vz-panel");
    if (!wrap || !stage || !panel) return;
    let b = this.board();
    if (!b) {
      b = document.createElement("div"); b.id = "teigBoard"; b.className = "teig-board";
      b.innerHTML = `<div class="teig-head">The working</div><div class="teig-scroll teig-math"></div><div class="teig-foot"><button type="button" class="btn btn-red btn-sm" data-teig="next">Next step</button><button type="button" class="btn btn-ghost btn-sm" data-teig="all">Show all steps</button><span class="teig-count"></span></div>`;
      b.addEventListener("click", e => { const t = e.target.closest("[data-teig]"); if (t) this.click(t.dataset.teig); });
      if (window.ResizeObserver) {                         // the board got wider or narrower: refit the long lines
        let w0 = 0;
        new ResizeObserver(() => { const w = b.clientWidth, L = b.querySelector(".teig-layer:not(.teig-pending)"); if (Math.abs(w - w0) > 1 && L) { w0 = w; this.fit(L); } }).observe(b);
      }
    }
    const split = stage.getBoundingClientRect().width >= 560;
    if (split) {
      if (getComputedStyle(wrap).position === "static") wrap.style.position = "relative";
      if (b.parentElement !== wrap) wrap.appendChild(b);
      b.classList.remove("teig-stack");
      const r = stage.getBoundingClientRect(), w = wrap.getBoundingClientRect();   // (an svg has no offsetLeft)
      Object.assign(b.style, { left: (r.left - w.left - wrap.clientLeft) + "px", top: (r.top - w.top - wrap.clientTop) + "px", height: r.height + "px", width: Math.round(r.width * TEIG_SPLIT) + "px" });
    } else {
      const ro = document.getElementById("vzReadout");
      if (b.parentElement !== panel) panel.insertBefore(b, ro ? ro.nextSibling : null);
      b.classList.add("teig-stack");
      Object.assign(b.style, { left: "", top: "", height: "", width: "" });
    }
    const small = !split && stage.getBoundingClientRect().width < 480;      // a phone: the picture's words are drawn bigger
    if (split !== this.split || small !== def._small) { this.split = split; def._split = split; def._small = small; VzView.stale = true; }
  },
  html(sol) {
    const esc = t => escapeHtml(t);
