  rebuild(el) { const p = el.closest(".vz-panel"), gr = p && p.querySelector("#trrefGrid"); if (gr) gr.innerHTML = this.gridHtml(VzView.st); },
  onClick(el, s) {
    const sm = el.closest("summary[data-rr-list]"); if (sm) { this._open = !sm.parentElement.open; return false; }
    const b = el.closest("[data-rr]"); if (!b || b.disabled || b.dataset.rr === "aug" || el.closest("input")) return false;
    const act = b.dataset.rr, D = this.data(s), end = D.ops.length + 1;
    if (act === "next") { this._auto = false; const k = Math.min(end, Math.floor(this.target(s) + 1e-6) + 1); vzTweenTo({ x: k }, k === end ? 900 : 700); return true; }
    if (act === "all") {
