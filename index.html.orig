        const red = [], edge = { rowOp: (i, y) => tdetEdge(y) };
        const cells = ch.map(st => tdetCells(st.M, f)), cw = tdetColW(cells.flat(), f);
        const aug = cells.map((c, j) => tdetMat(c, f, { cw, bar: 2, rowOp: edge.rowOp, hi: i => ch[j].changed.includes(i) ? red[j] : 0, hiCells: tdetCells(ch[j].M, f, { col: VZ.red, wt: 700 }) }));
        const lab = tdetS(`[<tspan font-style="italic">A</tspan> | <tspan font-style="italic">I</tspan>] =`, f, {}, tdetW("[A | I] =", f));
        const readB = tdetFit(ff => tdetRow([tdetSup("A", "−1", ff), tdetS(" = ", ff), tdetMat(tdetCells(W.inv, ff), ff, edge)]), f, 560);
        const checkB = tdetFit(ff => tdetRow([tdetS(`<tspan font-style="italic">A</tspan>`, ff, {}, tdetW("A", ff) + 2), tdetSup("A", "−1", ff), tdetS(" = ", ff), tdetMat(tdetCells(W.A, ff), ff, edge), tdetSp(ff * .15), tdetMat(tdetCells(W.inv, ff), ff, edge), tdetS(" = ", ff), tdetMat(tdetCells(W.prod, ff), ff, edge), tdetS(" ✓", ff, { col: TDET_OK, wt: 700 })]), f, 572);
        const capT = "row 1 · column 1:  " + [0, 1, 2].map(q => `(${tdetTxt(W.A[0][q])})(${tdetTxt(W.inv[q][0])})`).join(" + ") + " = " + tdetTxt(W.prod[0][0]);
        const cap = tdetFit(ff => tdetS(capT, ff, { col: VZ.grey }), f * .75, 560);
        const xm = Math.max(300 - aug[0].w / 2, 22 + lab.w + 8);
        const blocks = aug.map((bx, j) => ({ box: bx, x: xm, h: bx.up + bx.dn, op: j ? ch[j].ops.map(tdetOp).join(",   ") : "" }));
        blocks.push({ box: readB, x: 300 - readB.w / 2, h: readB.up + readB.dn, op: "the left half is I, so the right half is A⁻¹", sans: true });
        blocks.push({ box: checkB, x: 300 - checkB.w / 2, h: checkB.up + checkB.dn + 10 + cap.up + cap.dn, cap, op: "multiply back to check", sans: true });
        const LG = f * 2.2, Y = [0];
        blocks.forEach((b, j) => { if (j) Y.push(Y[j - 1] + blocks[j - 1].h + LG); });
        const tall = Math.max(...blocks.map((b, j) => b.h + (j ? blocks[j - 1].h + LG : 0)));
        return { red, lab, f, blocks, Y, LG, xm, w: lab.w + 8 + aug[0].w, tall };
      };
      let C = build(25);
