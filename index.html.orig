  const inv = ok ? [[tdetDiv(d, det), tdetDiv(tdetNeg(b), det)], [tdetDiv(tdetNeg(c), det), tdetDiv(a, det)]] : null;
  return { ad, bc, det, inv, prod: ok ? tdetMatMul(A, inv) : null, N0: 3, N1: ok ? 4 : 0,
    say0: ["For a 2 × 2 matrix, det A = ad − bc.", `Put in a = ${T(a)}, b = ${T(b)}, c = ${T(c)} and d = ${T(d)}.`,
      ok ? `det A = ${T(det)}, not 0, so A is invertible.` : "det A = 0, so A has no inverse."],
    say1: ok ? ["Swap a and d, change the signs of b and c, then divide by det A.", `Put in det A = ${T(det)} and the entries of A.`,
      tdetIs(det, 1) ? "det A = 1, so this matrix is already A⁻¹." : `Multiply every entry by ${T(tdetDiv(TDET_1, det))}.`, "Check: A times A⁻¹ is I, so the inverse is right."] : [] };
}
function tdetWork3(A) {
  const T = tdetTxt, Z = q => q.n === 0n, sub = "₁₂₃";
  let ex = null;                                           // the row (or else column) with the most zeros: the least work
  for (let L = 0; L < 6; L++) { const row = L < 3, idx = L % 3, z = [0, 1, 2].filter(p => Z(row ? A[idx][p] : A[p][idx])).length; if (!ex || z > ex.z) ex = { row, idx, z }; }
  const terms = [0, 1, 2].map(p => {
    const i = ex.row ? ex.idx : p, j = ex.row ? p : ex.idx, sg = (i + j) % 2 ? -1 : 1, a = A[i][j];
    const M = [0, 1, 2].filter(r => r !== i).map(r => [0, 1, 2].filter(c => c !== j).map(c => A[r][c])), md = tdetDetQ(M);
    return { i, j, sg, a, M, md, term: tdetMul(sg > 0 ? a : tdetNeg(a), md) };
  });
  const det = terms.reduce((x, t) => tdetAdd(x, t.term), TDET_0), ok = det.n !== 0n;
  const line = (ex.row ? "Row " : "Column ") + (ex.idx + 1), sgs = terms.map(t => t.sg > 0 ? "+" : "−").join(", ");
  const say0 = ["Next step picks the row or column with the most zeros.",
    ex.z === 3 ? `${line} is all zeros, so every term is 0.` : ex.z ? `${line} has the most zeros: expand along it (signs ${sgs}).` : `No zeros, so expand along row 1 (signs ${sgs}).`,
    ...terms.map(t => Z(t.a) ? `a${sub[t.i]}${sub[t.j]} = 0, so its whole term is 0.` : `a${sub[t.i]}${sub[t.j]} = ${T(t.a)}: cross out row ${t.i + 1} and column ${t.j + 1}; its sign is ${t.sg > 0 ? "+" : "−"}.`),
    ok ? `det A = ${T(det)}, not 0, so A is invertible.` : "det A = 0, so A has no inverse."];
  // the inverse: row reduce [A | I] a column at a time (a pivot of 1, then zeros above and below it)
  let chain = null, inv = null;
  const say1 = [];
  if (ok) {
    let M = A.map((r, i) => r.concat([0, 1, 2].map(j => i === j ? TDET_1 : TDET_0)));
    chain = [{ M, ops: [], changed: [] }];
    say1.push("Write I beside A, then row reduce until the left half is I.");
    for (let c = 0; c < 3; c++) {
      const ops = [], chg = [];
      if (Z(M[c][c])) {                                    // swap in a row below, one with a ±1 there if there is one
        const cand = [c + 1, c + 2].filter(q => q < 3 && !Z(M[q][c])), r = cand.find(q => tdetIs(M[q][c], 1) || tdetIs(M[q][c], -1)) ?? cand[0];
        M = M.slice(); [M[c], M[r]] = [M[r], M[c]]; ops.push(["swap", c, r]); chg.push(c, r); }
      if (!tdetIs(M[c][c], 1)) { const k = tdetDiv(TDET_1, M[c][c]); M = M.map((row, i) => i === c ? row.map(v => tdetMul(v, k)) : row); ops.push(["scale", c, k]); if (!chg.includes(c)) chg.push(c); }
      if (ops.length) { chain.push({ M, ops, changed: chg }); say1.push(`Column ${c + 1}: ` + (ops[0][0] === "swap" ? "swap rows so the pivot isn't 0" + (ops.length > 1 ? ", then scale it to 1." : ".") : `scale row ${c + 1} so its pivot is 1.`)); }
