    panel.querySelectorAll("[data-tvo]").forEach(b => b.classList.toggle("on", +b.dataset.tvo === op));
    panel.querySelectorAll("[data-tvd]").forEach(b => b.classList.toggle("on", +b.dataset.tvd === (d3 ? 3 : 2)));
    const seg = panel.querySelector("[data-tvdim]"); if (seg) seg.style.visibility = op < 2 ? "" : "hidden";
    panel.querySelectorAll("[data-tvg]").forEach(g => {                 // the entries for this computation fade in
      const on = g.dataset.tvg === grp;
      if (g.hidden === on) { g.hidden = !on; if (on) { g.style.animation = "none"; void g.offsetWidth; g.style.animation = "vzReadIn .35s ease"; } }
    });
    ["v3", "w3"].forEach(k => { const e = panel.querySelector(`[data-tv="${k}"]`); if (e) e.hidden = !d3; });
    panel.querySelectorAll("[data-tvgrid]").forEach(g => { g.style.gridTemplateColumns = `repeat(${d3 ? 3 : 2}, 56px)`; });
    panel.querySelectorAll("[data-tv]").forEach(e => {                  // show the numbers in force, never fighting the entry being typed
