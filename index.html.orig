  if (G.dir) {
    const du = unit(G.dir), last = Math.hypot(...nrm[2]), ends = [C0.map((x, q) => x - 2.2 * du[q]), C0.map((x, q) => x + 2.2 * du[q])];
    o += `<g opacity="${q2(1 - vzClamp(last / .35, 0, 1))}">${vzPath3(cam, ends, `stroke="${VZ.deep}" stroke-width="3.4" stroke-linecap="round"`)}</g>`;
    lines.push(ends.map(pr));                            // (the gauss picture draws this line from the start)
  }
  if (!G.dir) { const S = pr(C0); o += `<circle cx="${q2(S[0])}" cy="${q2(S[1])}" r="11" fill="${VZ.red}" opacity=".16"/>` + vzDot3(cam, C0, 5.5, VZ.deep); if (opt.label !== false && (opt.labelOp == null || opt.labelOp > .01)) { if (opt.labelOp != null) o += `<g opacity="${q2(opt.labelOp)}">`; o += vzLabel(S[0] + 14, S[1] - 12, `(${C0.map(vzShort).join(", ")})`, VZ.deep, 15, "start"); busy.push([S[0] + 50, S[1] - 16], [S[0] + 20, S[1] - 16], [S[0] + 80, S[1] - 16], [S[0], S[1]]); if (opt.labelOp != null) o += `</g>`; } }
  // each plane's name, just outside its rim, at the spot clearest of the other rims (a plane lying on another one
  // doesn't count: it has the same rim), the axis names, the solution and its name, and the other planes' names.
  // With opt.mem (a memory kept by the caller) a name keeps its spot until another is clearly better, then slides
  // along its own rim to it, or, when that is far round the rim, fades out where it was and in at the new spot.
  // Names also keep off the equations (top left) and the operation (top right), where gauss and m-gauss write them.
  const rims = disks.map(D => D.pts.map(p => pr(p))), mem = opt.mem, now = performance.now();
  const W = opt.W || 2 * pr(C0)[0], H = opt.H || 450, avoid = opt.avoid || [[0, 0, 240, 86], [W - 210, 0, W, 46]];   // (the solution is at the middle)
  const seg = (p, a, b) => { const ex = b[0] - a[0], ey = b[1] - a[1], t = vzClamp(((p[0] - a[0]) * ex + (p[1] - a[1]) * ey) / (ex * ex + ey * ey || 1), 0, 1); return [Math.hypot(a[0] + t * ex - p[0], a[1] + t * ey - p[1]), t]; };
  const dist = (p, r, closed) => { let d = 1e9; for (let m = 0; m < r.length - (closed ? 0 : 1); m++) d = Math.min(d, seg(p, r[m], r[(m + 1) % r.length])[0]); return d; };
  const inside = (p, r) => { let c = false; for (let m = 0, n = r.length - 1; m < r.length; n = m++) { const a = r[m], b = r[n]; if ((a[1] > p[1]) !== (b[1] > p[1]) && p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0]) c = !c; } return c; };
  const alike = (D, E) => Math.hypot(...D.ctr.map((x, q) => x - E.ctr[q])) < .08 && Math.abs(vzDot(nrm[D.i], nrm[E.i])) / (Math.hypot(...nrm[D.i]) * Math.hypot(...nrm[E.i])) > .995;
  const at = (r, f) => { const n = r.length, m = ((Math.floor(f) % n) + n) % n, a = r[m], b = r[(m + 1) % n], t = f - Math.floor(f); return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]; };
  const onRim = (r, p) => { let bf = 0, bd = 1e9; r.forEach((a, m) => { const [d, t] = seg(p, a, r[(m + 1) % r.length]); if (d < bd) { bd = d; bf = m + t; } }); return bf; };
  const names = {};                                      // where each plane's name is: this frame once placed, else last frame
  if (mem) disks.forEach(D => { const m = mem["L" + who[D.i]]; if (m) names[D.i] = m.p; });
  disks.forEach((D, k) => {
    const r = rims[k], n = r.length, c = pr(D.ctr), id = who[D.i];
    const spot = q => { const dx = q[0] - c[0], dy = q[1] - c[1], L = Math.hypot(dx, dy) || 1; return [q[0] + dx / L * 15, q[1] + dy / L * 15]; };
    const obst = disks.filter((E, kk) => kk !== k && E.op > .3 && !alike(D, E)).map(E => rims[disks.indexOf(E)]);
    const near = disks.filter(E => E !== D && E.op > .3 && names[E.i]).map(E => names[E.i]);
    const score = p => {                                 // about how many pixels the name has to itself (at most 46, +10 off the other discs)
      let d = 46;
      obst.forEach(q => { d = Math.min(d, dist(p, q, true) - 3); });
      lines.forEach(q => { d = Math.min(d, dist(p, q, false) - 3); });
      busy.forEach(z => { d = Math.min(d, Math.hypot(z[0] - p[0], z[1] - p[1]) * .7); });
      near.forEach(z => { d = Math.min(d, Math.hypot(z[0] - p[0], z[1] - p[1]) * .6); });
      if (!obst.some(q => inside(p, q))) d += 10;
      if (p[0] < 24 || p[0] > W - 24 || p[1] < 28 || p[1] > H - 40 || avoid.some(([x0, y0, x1, y1]) => p[0] > x0 && p[0] < x1 && p[1] > y0 && p[1] < y1)) d -= 40;
      return d;
    };
    let f = 0, bs = -1e9, fade = null;
    for (let m = 0; m < n; m += 2) { const s = score(spot(r[m])); if (s > bs) { bs = s; f = m; } }
    const st = mem && mem["L" + id];
    if (st) {
      const f0 = onRim(r, st.a), to = score(spot(at(r, f0))) > bs - 8 ? f0 : f, dI = ((to - f0) % n + n * 1.5) % n - n / 2;   // the short way round
      fade = st.fade && now - st.fade.t0 < 320 ? st.fade : null;
      if (Math.abs(dI) > n / 5 && !fade) { fade = { p: st.p, t0: now }; f = to; }
      else { const step = Math.min(64, now - st.t) / 24; f = f0 + Math.sign(dI) * Math.min(Math.abs(dI), step); if (Math.abs(dI) > step) VzView.again = true; }
    }
    const p = spot(at(r, f)), u = fade ? vzEase(vzClamp((now - fade.t0) / 320, 0, 1)) : 1, sw = opt.swap;
    if (fade && u < 1) VzView.again = true;                // still sliding or fading: draw again next frame, even at rest
    if (mem) mem["L" + id] = { a: at(r, f), p, t: now, fade };
    names[D.i] = p;
    const txt = (q, s, op) => op < .01 ? "" : `<text x="${q2(vzClamp(q[0], 18, W - 18))}" y="${q2(vzClamp(q[1] + 5, 20, H - 8))}" font-family="'Fraunces', Georgia, serif" font-size="15" font-style="italic" fill="${GT(D.i)}" text-anchor="middle" stroke="${VZ.paper}" stroke-width="4" stroke-linejoin="round" paint-order="stroke" opacity="${q2(op)}">${s}</text>`;
    // a row swap: the plane keeps its place and colour, its name changes
    const both = (q, op) => sw && (D.i === sw.i || D.i === sw.j) ? txt(q, "R" + vzSubN(D.i), op * (1 - sw.e)) + txt(q, "R" + vzSubN(D.i === sw.i ? sw.j : sw.i), op * sw.e) : txt(q, "R" + vzSubN(D.i), op);
    if (fade && u < 1) o += both(fade.p, D.op * (1 - u));
    o += both(p, D.op * u);
  });
  return o;
}
vzAdd({
  id: "gauss", title: "Row operations keep the solution", card: "Gaussian elimination",
  tagline: "Row operations never move the solution.",
  blurb: "Each equation in \\(x, y, z\\) is a plane, and a solution lies on all three. \\(R_i\\to R_i+kR_j\\) swings plane \\(i\\) about the line where it meets plane \\(j\\), so the solution stays put; scaling a row leaves its plane where it is. Gaussian elimination ends with the planes \\(x=a\\), \\(y=b\\), \\(z=c\\), where the solution can be read off.",
  tryIt: "Press Play: the planes swing, the solution stays put.",
  state: { sys: 0, x: 0, yaw: 120 },
  thumb: { x: .45 },
  controls: [
    { k: "x", label: "row operations done", min: 0, max: 1, step: .001, fmt: function (v) { const G = VZ_GAUSS[Math.round(VzView.st ? VzView.st.sys : 0)] || VZ_GAUSS[0]; return Math.round(v * G.ops.length) + " of " + G.ops.length; }, play: .06, progress: true, aria: "row operations",
      // a rest after each operation, and one a hair before the end (drawn as the end): RREF stays up ~2 s, not 1
      rests: s => { const N = (VZ_GAUSS[Math.round(s.sys)] || VZ_GAUSS[0]).ops.length; return Array.from({ length: N - 1 }, (_, i) => (i + 1) / N).concat([1 - 1e-4]); }, restMs: 900 },
    { k: "yaw", label: "turn the view", min: -180, max: 180, step: 1, unit: "°", digits: 0, noPlay: true },
  ],
  panelTop() { return `<div><div class="vz-ptop-k">The system</div><div class="vz-chips">${VZ_GAUSS.map((G, i) => `<button type="button" class="vz-chip" data-gs="${i}">${escapeHtml(G.chip)}</button>`).join("")}</div></div>`; },
  sync(s, panel) { panel && panel.querySelectorAll("[data-gs]").forEach(b => b.classList.toggle("on", +b.dataset.gs === Math.round(s.sys))); },
  onClick(el, s) { const b = el.closest("[data-gs]"); if (!b) return false; s.sys = +b.dataset.gs; s.x = 0; s.yaw = this.G(s).yaw; this._mem = {}; return true; },   // each system comes with a view where no plane is edge-on
  G(s) { return VZ_GAUSS[Math.round(s.sys)] || VZ_GAUSS[0]; },
  X(s) { const x = vzClamp(s.x, 0, 1) * this.G(s).ops.length, r = Math.round(x); return Math.abs(x - r) < 2e-3 ? r : x; },   // operations done (a hair from a whole number counts as it)
  cam(s) { const G = this.G(s), C0 = G.c0, c0 = vzCam(0, 0, 70, vzRad(s.yaw), G.el || .5); const f = (x, y, z) => { const q = c0(x - C0[0], y - C0[1], z - C0[2]); return [300 + q[0], 238 + q[1], q[2]]; }; f.view = c0.view; return f; },
  draw(s, t, thumb) {
    const G = this.G(s), { M, op } = vzGaussRows(G, this.X(s));
    const fr0 = op ? this.X(s) - Math.floor(this.X(s) + 1e-9) : 0;
    const cam = this.cam(s);
    let o = vzGaussScene(cam, M, G, op ? op[1] : -1, { hiW: Math.sin(Math.PI * fr0), mem: VzView.live ? (this._mem || (this._mem = {})) : null });
    // a line of solutions is there from the start (the scene alone shows it only once a row has run out), so it can
    // be watched staying put like the single point; at the end the scene's own line lies exactly under it
    if (G.dir) { const L = Math.hypot(...G.dir), du = G.dir.map(v => v / L); o += vzPath3(cam, [G.c0.map((v, q) => v - 2.2 * du[q]), G.c0.map((v, q) => v + 2.2 * du[q])], `stroke="${VZ.deep}" stroke-width="3.4" stroke-linecap="round"`); }
    if (!thumb) {
      // the three equations, each in its plane's colour; the one being changed cross-fades from before to after
      const x = this.X(s), K = Math.floor(x + 1e-9), A0 = vzGaussRows(G, K).M, A1 = vzGaussRows(G, Math.min(G.ops.length, K + 1)).M, e = op ? vzEase(x - K) : 0;
      A0.forEach((r, i) => {
        if (op && i === op[1]) {                           // the old equation fades out, then the new one fades in
          const a = vzClamp(1 - e * 2.2, 0, 1), b = vzClamp(e * 2.2 - 1.2, 0, 1);
          if (a > .01) o += `<g opacity="${q2(a)}">${vzNote(22, 34 + 20 * i, `R${vzSubN(i)}:  ${vzEqn(r)}`, "start", VZ_GTXT[i])}</g>`;
          if (b > .01) o += `<g opacity="${q2(b)}">${vzNote(22, 34 + 20 * i, `R${vzSubN(i)}:  ${vzEqn(A1[i])}`, "start", VZ_GTXT[i])}</g>`;
        }
        else o += vzNote(22, 34 + 20 * i, `R${vzSubN(i)}:  ${vzEqn(r)}`, "start", VZ_GTXT[i]);
      });
      if (op) { const fr = x - K; o += `<g opacity="${q2(vzClamp(Math.min(fr / .12, (1 - fr) / .12), 0, 1))}">${vzNote(578, 34, vzGaussOp(op), "end", VZ.ink)}</g>`; }
    }
    o += vzKey([["fill", VZ_GCOL[0], "plane 1"], ["fill", VZ_GCOL[1], "plane 2"], ["fill", VZ_GCOL[2], "plane 3"], G.dir ? ["line", VZ.deep, "the solutions"] : ["dot", VZ.deep, "the solution"]]);
    return o;
  },
  readout(s) {
    const G = this.G(s), x = this.X(s), { M, K, op } = vzGaussRows(G, x), done = Math.round(x), R = vzGaussRows(G, done).M;
    const cell = v => Math.abs(v) < 1e-9 ? "0" : (v < 0 ? "−" : "") + vzShort(Math.abs(v));
    const hl = op ? op[1] : -1, rows = R.map((r, i) => `<tr${i === hl ? ' class="hl"' : ""}>${r.map((v, q) => `<td${q === 3 ? ' class="bar"' : ""}>${cell(v)}</td>`).join("")}</tr>`).join("");
    const N = G.ops.length, end = done >= N;
    // always one line for the operation (now, next, or all done), so the panel keeps its height through Play
    const line = op ? `now: <b>${vzGaussOp(op)}</b>` : K < N ? `next: ${vzGaussOp(G.ops[K])}` : `all ${N} row operations done`;
    const msg = end ? G.end : op ? (op[0] === "scale" ? `Scaling R${vzSubN(op[1])} leaves its plane where it is.` : `Plane ${op[1] + 1} turns about its line with plane ${op[2] + 1}.`)
      : K ? (G.dir ? "The line of solutions hasn't moved." : "The solution hasn't moved.") : G.start;
    return `<div class="vz-mat-row"><span class="vz-mx-name">[A | b] =</span><span class="vz-brk"><table class="vz-mtab vz-aug">${rows}</table></span></div>
      <div class="vz-eq">${line}</div>
      <div class="vz-status ${end ? "ok" : ""}">${msg}</div>`;
  },
});

/* ---------- Undoing a matrix (Lecture 10) ----------
   Play applies A to the whole plane, then A⁻¹ carries everything back where it started. With a singular A the
   plane is squashed onto a line: two different points land on the same spot, so nothing can send that spot back
   (where to: here, or there?). The readout runs the lecture's checklist of what invertible means. */
const VZ_INVS = [
  { chip: "Turn and stretch", m: [2, 1, 1, 1] },
  { chip: "Shear", m: [1, 1, 0, 1] },
  { chip: "Swap x and y", m: [0, 1, 1, 0] },
  { chip: "Squash (det 0)", m: [2, -2, 1, -1] },
];
vzAdd({
  id: "inverse", title: "Undoing a matrix", card: "Inverses",
  tagline: "A⁻¹ undoes A, unless A squashes the plane.",
  blurb: "\\(A^{-1}\\) undoes \\(A\\): if \\(A\\mathbf x=\\mathbf y\\) then \\(\\mathbf x=A^{-1}\\mathbf y\\), and \\(AA^{-1}=A^{-1}A=I\\). For a \\(2\\times2\\) matrix, \\(A^{-1}=\\frac1{\\det A}\\begin{bmatrix}d&-b\\\\-c&a\\end{bmatrix}\\). When \\(\\det A=0\\), \\(A\\) squashes the plane onto a line, two different points land in the same place, and no matrix can undo that.",
  tryIt: "Play, then pick Squash: two dots land on one spot.",
  state: { m: 0, t: 0 },
  thumb: { t: 1 },
  controls: [{ k: "t", label: "apply A, then A⁻¹", min: 0, max: 2, step: .01, fmt: v => v <= 1 ? "A: " + Math.round(v * 100) + "%" : "A⁻¹: " + Math.round((v - 1) * 100) + "%", play: .32, progress: true, aria: "apply A then its inverse", rests: () => [1], restMs: 1300 }],
  panelTop() { return `<div><div class="vz-ptop-k">The matrix A</div><div class="vz-chips">${VZ_INVS.map((M, i) => `<button type="button" class="vz-chip" data-iv="${i}">${escapeHtml(M.chip)}</button>`).join("")}</div></div>`; },
  sync(s, panel) { panel && panel.querySelectorAll("[data-iv]").forEach(b => b.classList.toggle("on", +b.dataset.iv === Math.round(s.m))); },
  onClick(el, s) { const b = el.closest("[data-iv]"); if (!b) return false; s.m = +b.dataset.iv; s.t = 0; return true; },
  A(s) { return (VZ_INVS[Math.round(s.m)] || VZ_INVS[0]).m; },
  draw(s, t, thumb) {
    const A = this.A(s), det = A[0] * A[3] - A[1] * A[2], sing = Math.abs(det) < 1e-9, u = vzClamp(s.t, 0, 2);
    const e1 = vzEase(vzClamp(u, 0, 1)), e2 = vzEase(vzClamp(u - 1, 0, 1)), back = sing ? 0 : e2;
    // the matrix in force now: on the way there (1 − e)I + eA, on the way back (1 − e)A + eI = ((1 − e)I + eA⁻¹)A
    const k = u <= 1 ? e1 : 1 - back, M = [1 + (A[0] - 1) * k, A[1] * k, A[2] * k, 1 + (A[3] - 1) * k], ap = p => [M[0] * p[0] + M[1] * p[1], M[2] * p[0] + M[3] * p[1]];
    const P = vzPlane(300, 236, 52);
    let g = "";
    for (let q = -9; q <= 9; q++) { const c1 = ap([1, 0]), c2 = ap([0, 1]); g += P.line(ap([q, 0]), c2, `stroke="${VZ.grey}" stroke-opacity="${q ? .28 : .55}" stroke-width="${q ? 1 : 1.4}"`) + P.line(ap([0, q]), c1, `stroke="${VZ.grey}" stroke-opacity="${q ? .28 : .55}" stroke-width="${q ? 1 : 1.4}"`); }
    let o = P.axes(.1) + g;
    const dM = M[0] * M[3] - M[1] * M[2];
    o += P.poly([[0, 0], [1, 0], [1, 1], [0, 1]].map(ap), `fill="${dM < 0 ? VZ.gold : VZ.red}" fill-opacity="${q2(.14 * vzClamp(Math.abs(dM) * 4, 0, 1))}" stroke="${dM < 0 ? VZ.gold : VZ.red}" stroke-width="1.4" stroke-opacity=".8" stroke-linejoin="round"`);
    o += P.poly([[.2, .15], [.2, .85], [.62, .85], [.62, .68], [.36, .68], [.36, .15]].map(ap), `fill="${VZ.ink}" fill-opacity=".55" stroke="none"`);
    // two marked points: for a singular A they differ by a vector A sends to 0, so they land on the same spot
    const nul = sing ? (Math.hypot(A[0], A[1]) > 1e-9 ? [-A[1], A[0]] : [1, 0]) : null;
    // (for the squash, x₁ and x₂ sit on either side of the spot they both land on, so the two "?" arrows part)
    const x1 = sing ? [1, 2] : [1, 1], x2 = sing ? [-3, -2] : null, Y = ap(x1);
    if (sing && u > 1) {                                   // where would A⁻¹ send this point? both of these, so nowhere
      const q = vzEase(vzClamp((u - 1) * 2, 0, 1));
      o += `<g opacity="${q2(q)}">${P.line(x1, nul, `stroke="${VZ.deep}" stroke-width="1.4" stroke-dasharray="6 5" opacity=".6"`)}`;
      [x1, x2].forEach((x, i) => {
        const a = [P.X(Y[0]), P.Y(Y[1])], b = [P.X(x[0]), P.Y(x[1])], m = [(a[0] + b[0]) / 2 - 30, (a[1] + b[1]) / 2 - 22];
        o += `<path d="M${q2(a[0])} ${q2(a[1])}Q${q2(m[0])} ${q2(m[1])} ${q2(b[0])} ${q2(b[1])}" fill="none" stroke="${VZ.ink}" stroke-width="1.6" stroke-dasharray="5 5"/>`;
        o += `<circle cx="${q2(b[0])}" cy="${q2(b[1])}" r="7" fill="#fff" fill-opacity=".6" stroke="${i ? VZ.ink : VZ.red}" stroke-width="1.8"/>`;
        o += vzLabel(b[0] + 13, b[1] + 5, i ? "x₂" : "x₁", i ? VZ.ink : VZ.deep, 15, "start") + vzLabel(m[0], m[1] + 6, "?", VZ.ink, 20);
      });
      o += `</g>`;
    }
    o += P.arrow([0, 0], ap([1, 0]), "R", 2.6) + P.arrow([0, 0], ap([0, 1]), "I", 2.6) + P.dot([0, 0], 3.4);
    const dot = (x, col) => { const p = ap(x); return `<circle cx="${q2(P.X(p[0]))}" cy="${q2(P.Y(p[1]))}" r="6.5" fill="${col}" stroke="#fff" stroke-width="1.6"/>`; };
    if (sing) o += dot(x2, VZ.ink);
    o += dot(x1, VZ.red);
    // names of the dots: x, then Ax, then x again (cross-fading as the motion settles); for the squash each dot
    // has its own name at the start, and the shared name sits below the spot (above it is the arrow Ae₂)
    const nmOp = [1 - vzClamp(u * 3, 0, 1), vzClamp(u * 3 - 2, 0, 1) * (sing ? 1 : 1 - vzClamp((u - 1) * 3, 0, 1)), sing ? 0 : vzClamp((u - 1) * 3 - 2, 0, 1)];
    const lab = (txt, op, col = VZ.deep, x = x1, dy = -12) => { if (op < .01) return ""; const p = ap(x); return `<g opacity="${q2(op)}">${vzLabel(P.X(p[0]) + 12, P.Y(p[1]) + dy, txt, col, 16, "start")}</g>`; };
    o += sing ? lab("x₁", nmOp[0]) + lab("x₂", nmOp[0], VZ.ink, x2) + lab("Ax₁ = Ax₂", nmOp[1], VZ.deep, x1, 26)
      : lab(vzB("x"), nmOp[0]) + lab("A" + vzB("x"), nmOp[1]) + lab("A⁻¹A" + vzB("x") + " = " + vzB("x"), nmOp[2]);
    o += vzNoteFade(22, 34, u, [1.03], ["applying A to every point", sing ? "back to x₁ or to x₂? No A⁻¹ can do both." : "applying A⁻¹: every point goes back"], "start", VZ.ink);
    // (the item whose text can change goes after the flag, so nothing in the key shifts sideways mid-play)
    o += vzKey([["fill", VZ.ink, "a flag, to show which way round"], ["fill", dM < 0 ? VZ.gold : VZ.red, dM < 0 ? "the unit square, flipped" : "the unit square"]].concat(sing ? [["dash", VZ.deep, "every x with Ax = Ax₁"]] : []));
    return o;
  },
  readout(s) {
    const A = this.A(s), [a, b, c, d] = A, det = a * d - b * c, ok = Math.abs(det) > 1e-9, R = v => vzShort(v);
    const row = (good, txt) => `<li class="${good ? "ok" : "no"}"><span>${good ? "✓" : "✗"}</span><div>${txt}</div></li>`;
    const nul = ok ? null : (Math.hypot(a, b) > 1e-9 ? [-b, a] : [1, 0]);
    const inv = ok ? [d / det, -b / det, -c / det, a / det] : null;
    return `<div class="vz-mat-row">${vzMatH("A", A)}${ok ? vzMatH("A⁻¹", inv) : ""}</div>
      <ul class="vz-check">
        ${row(ok, `det A = <b>${R(det)}</b>`)}
        ${row(ok, `rank ${ok ? 2 : 1}`)}
        ${row(ok, `columns ${ok ? "independent" : "dependent"}`)}
        ${row(ok, `null space ${ok ? "{0}" : "a line"}`)}
        ${row(ok, `A<b>x</b> = <b>b</b>: ${ok ? "one solution" : "none or many"}`)}
      </ul>
      <div class="vz-status ${ok ? "ok" : "warn"}">${ok ? "All true together: invertible." : "All fail together: singular."}</div>`;
  },
});

/* ---------- Diagonalization: A = PDP⁻¹ in three moves (Lectures 13 and 15) ----------
   The grid drawn is the eigenvector grid (lines along v₁ and v₂). P⁻¹ straightens it into the ordinary square grid
   (it rewrites every vector in eigenvector coordinates); D stretches that square grid along its axes by λ₁ and λ₂;
   P tilts it back. The three moves end exactly where A alone sends the plane, which a ghost shows at the end. */
vzAdd({
  id: "diag", title: "Diagonalization: A = PDP⁻¹", card: "Diagonalization",
  tagline: "Change to eigenvector coordinates, stretch, change back.",
  blurb: "If \\(A\\) has an eigenbasis \\(\\mathbf v_1,\\mathbf v_2\\) with eigenvalues \\(\\lambda_1,\\lambda_2\\), then \\(A=PDP^{-1}\\) with \\(P=[\\mathbf v_1\\ \\mathbf v_2]\\) and \\(D=\\operatorname{diag}(\\lambda_1,\\lambda_2)\\). Read right to left: \\(P^{-1}\\) rewrites a vector in eigenvector coordinates, \\(D\\) stretches each coordinate by its eigenvalue, and \\(P\\) changes back. So \\(A^k=PD^kP^{-1}\\): only the eigenvalues get raised to the power.",
  tryIt: "Follow the gold vector x through the three moves.",
  state: { t: 0 },
  thumb: { t: 1.5 },
  controls: [{ k: "t", label: "the three moves", min: 0, max: 3, step: .01, fmt: v => ["P⁻¹", "D", "P", "done"][Math.min(3, Math.floor(v + 1e-6))] + (v < 3 ? " " + Math.round((v - Math.floor(v + 1e-6)) * 100) + "%" : ""), play: .3, progress: true, aria: "the three moves", rests: () => [1, 2], restMs: 1100 }],
  P: [1, -1, 1, 2], Pi: [2 / 3, 1 / 3, -1 / 3, 1 / 3], L: [2, .5],
  M(t) {                                                  // the map so far: each move eased in as (1 − s)I + s·(that move)
    const mul = vzMul, lerp = (B, s) => [1 + (B[0] - 1) * s, B[1] * s, B[2] * s, 1 + (B[3] - 1) * s], E = x => vzEase(vzClamp(x, 0, 1));
    const D = [this.L[0], 0, 0, this.L[1]];
    let M = lerp(this.Pi, E(t));
    if (t > 1) M = mul(lerp(D, E(t - 1)), this.Pi);
    if (t > 2) M = mul(lerp(this.P, E(t - 2)), mul(D, this.Pi));
    return M;
  },
  draw(s, t, thumb) {
    const u = vzClamp(s.t, 0, 3), M = this.M(u), ap = p => [M[0] * p[0] + M[1] * p[1], M[2] * p[0] + M[3] * p[1]], P = vzPlane(300, 236, 64);
    const v1 = [this.P[0], this.P[2]], v2 = [this.P[1], this.P[3]], at = (a, b) => [a * v1[0] + b * v2[0], a * v1[1] + b * v2[1]];
    let o = P.axes(.14);
    // the eigenvector grid, carried along by the moves so far
    let g = "";
    for (let k = -6; k <= 6; k++) { g += P.line(ap(at(k, 0)), ap(v2), `stroke="${VZ.ink}" stroke-opacity="${k ? .16 : .45}" stroke-width="${k ? 1 : 1.5}"`) + P.line(ap(at(0, k)), ap(v1), `stroke="${VZ.red}" stroke-opacity="${k ? .16 : .45}" stroke-width="${k ? 1 : 1.5}"`); }
    o += g;
    // one cell of the eigen-grid, shaded, so the stretch can be seen as a change of shape
    o += P.poly([[0, 0], ap(v1), ap(at(1, 1)), ap(v2)], `fill="${VZ.ink}" fill-opacity=".06" stroke="${VZ.ink}" stroke-opacity=".3" stroke-width="1.2"`);
    // at the end, a ghost of A applied in one go, landing on the same spot
    const ge = vzEase(vzClamp((u - 2.75) / .25, 0, 1)), A = vzMul(this.P, vzMul([this.L[0], 0, 0, this.L[1]], this.Pi)), x = [1, 0], Ax = [A[0], A[2]];
    if (ge > .01) o += `<g opacity="${q2(ge)}"><circle cx="${q2(P.X(Ax[0]))}" cy="${q2(P.Y(Ax[1]))}" r="15" fill="none" stroke="${VZ.ink}" stroke-width="1.6" stroke-dasharray="4 4"/>${vzLabel(P.X(Ax[0]) + 16, P.Y(Ax[1]) + 32, "A in one go", VZ.ink, 14, "start")}</g>`;
    // v₁, v₂ and x (gold, so it never reads as v₁), carried along
    o += P.arrow([0, 0], ap(v1), "R", 2.8) + P.arrow([0, 0], ap(v2), "I", 2.8) + P.arrow([0, 0], ap(x), "O", 3.6) + P.dot([0, 0], 3.4);
    // their names after each move, cross-fading around the middle of each move: v → e (eigenvector coordinates) →
    // stretched e → stretched v; x → P⁻¹x → DP⁻¹x → Ax
    const sets = [[vzB("v", "1"), vzB("v", "2"), vzB("x")], [vzB("e", "1"), vzB("e", "2"), "P⁻¹" + vzB("x")],
      ["2" + vzB("e", "1"), "½" + vzB("e", "2"), "DP⁻¹" + vzB("x")], ["2" + vzB("v", "1"), "½" + vzB("v", "2"), "A" + vzB("x")]], br = [-9, .5, 1.5, 2.5, 9];
    sets.forEach((nm, i) => {
      const op = vzClamp(Math.min((u - br[i]) / .12 + .5, (br[i + 1] - u) / .12 + .5), 0, 1);
      if (op > .01) o += `<g opacity="${q2(op)}">${vzTipLabels(P, [{ v: ap(v1), html: nm[0], col: VZ.red }, { v: ap(v2), html: nm[1], col: VZ.ink }, { v: ap(x), html: nm[2], col: "#7A5C0F" }])}</g>`;
    });
    if (!thumb) o += vzNoteFade(22, 34, u, [.04, 1.05, 2.05, 2.96], ["eigenvectors v₁ = [1, 1] with λ = 2, v₂ = [−1, 2] with λ = ½", "1 · P⁻¹: the eigen-grid becomes the square grid", "2 · D: stretch by 2 along e₁, by ½ along e₂", "3 · P: back to ordinary coordinates", "PDP⁻¹x = Ax"], "start", VZ.ink, .035);
    o += vzKey([["line", VZ.red, "lines along v₁"], ["line", VZ.ink, "lines along v₂"], ["line", VZ.gold, "x = [1, 0]"]]);
    return o;
  },
  readout(s) {
    const u = vzClamp(s.t, 0, 3), st = Math.min(3, Math.floor(u + 1e-6)), mt = (n, m) => `<span class="vz-nw" style="display:inline-flex;align-items:center;gap:6px"><span class="vz-mx-name">${n}</span><span class="vz-brk"><table class="vz-mtab"><tr><td>${vzShort(m[0])}</td><td>${vzShort(m[1])}</td></tr><tr><td>${vzShort(m[2])}</td><td>${vzShort(m[3])}</td></tr></table></span></span>`;
    const on = k => st >= k ? "" : " vz-dim";
    return `<div class="vz-mat-row">${mt("A =", [1.5, .5, 1, 1])}${mt("P =", this.P)}${mt("D =", [2, 0, 0, .5])}${mt("P⁻¹ =", this.Pi)}</div>
      <div class="vz-eq${on(1)}">P⁻¹<b>x</b> = <b>[2/3, −1/3]</b>, as <b>x</b> = (2/3)v₁ − (1/3)v₂</div>
      <div class="vz-eq${on(2)}">DP⁻¹<b>x</b> = <b>[4/3, −1/6]</b>: v₁ part ×2, v₂ part ×½</div>
      <div class="vz-eq${on(3)}">PDP⁻¹<b>x</b> = (4/3)v₁ − (1/6)v₂ = <b>[3/2, 1]</b> = A<b>x</b></div>
      <div class="vz-status ok">A<sup>k</sup> = PD<sup>k</sup>P⁻¹: only the eigenvalues get powered.</div>`;
  },
});

/* ---------- 4. The dot product and projection onto a line (Lecture 16) ----------
   What v · w measures: the signed length of v's shadow on the line of w (comp_w(v), a number), times |w|.
   So the picture draws the shadow (proj_w(v), a vector), the part left over (v⊥, square to w), the signed
   length as a brace, and v · w itself as a rectangle: sides |w| and comp_w(v). Swap the roles to see that
   proj_w(v) and proj_v(w) are different vectors with the same dot product behind them. */
// readout helpers in the course's notation: [a, b, c] vectors, stacked fractions, expanded dot products
const vzVec = p => `<span class="vz-nw">[${p.map(vzShort).join(", ")}]</span>`;   // a vector never breaks across lines
const vzFrac = (n, d) => `<span class="vz-fr"><span>${n}</span><span>${d}</span></span>`;
const vzDotX = (a, b) => a.map((x, i) => `(${vzShort(x)})(${vzShort(b[i])})`).join(" + ");
const vzSqX = a => a.map(x => `(${vzShort(x)})²`).join(" + ");
const vzDot = (a, b) => a.reduce((s, x, i) => s + x * b[i], 0);
// √(n) written exactly when it can be (√10, 3, 2√2), with a decimal beside it when it isn't whole
function vzRoot(n2) {
  const r = Math.sqrt(Math.max(0, n2)), k = Math.round(n2);
  if (Math.abs(r - Math.round(r)) < 1e-9) return vzShort(Math.round(r));
  if (Math.abs(n2 - k) < 1e-9) {
    let out = 1, inn = k;
    for (let f = 2; f * f <= inn; f++) while (inn % (f * f) === 0) { out *= f; inn /= f * f; }
    return (out > 1 ? out : "") + "√" + inn + ` <span class="vz-approx">≈ ${vzNum(r)}</span>`;
  }
  return vzNum(r);
}
// a name written along a segment p0 → p1 of plane P, like a dimension on a drawing: off px to the side n points to
function vzAlong(P, p0, p1, n, off, html, col, size = 15) {
  const A = [P.X(p0[0]), P.Y(p0[1])], B = [P.X(p1[0]), P.Y(p1[1])], dx = B[0] - A[0], dy = B[1] - A[1], L = Math.hypot(dx, dy) || 1;
  let ns = [n[0] * P.u, -n[1] * P.uy]; const nl = Math.hypot(...ns) || 1; ns = [ns[0] / nl, ns[1] / nl];
  let ang = Math.atan2(dy, dx) * 180 / Math.PI; if (ang > 90) ang -= 180; if (ang < -90) ang += 180;   // never upside down
  const x = (A[0] + B[0]) / 2 + ns[0] * off, y = (A[1] + B[1]) / 2 + ns[1] * off;
  return `<g transform="rotate(${q2(ang)} ${q2(x)} ${q2(y)})">${vzLabel(x, y + size * .33, html, col, size)}</g>`;
}
// subscripted names for SVG labels: proj_w(v), comp_w(v), v∥, v⊥
const vzSub = (base, sub, after = "") => `${base}<tspan baseline-shift="sub" font-size="11">${sub}</tspan>${after ? `<tspan>${after}</tspan>` : ""}`;
// v stored by direction and length (so Play can turn it), set from exact grid points so the numbers stay exact
const vzPolarSt = (x, y) => ({ th: ((Math.atan2(y, x) * 180 / Math.PI) + 360) % 360, lv: Math.hypot(x, y) });
vzAdd({
  id: "projection", group: "More linear algebra", title: "The dot product and projection", card: "Dot product and projection",
  tagline: "v · w is the length of v's shadow on w, times |w|.",
  blurb: "Only the part of \\(\\mathbf v\\) along \\(\\mathbf w\\) counts. Its signed length is \\(\\operatorname{comp}_{\\mathbf w}(\\mathbf v)=\\frac{\\mathbf v\\cdot\\mathbf w}{|\\mathbf w|}\\) (a number), the shadow itself is \\(\\operatorname{proj}_{\\mathbf w}(\\mathbf v)\\) (a vector), and \\(\\mathbf v\\cdot\\mathbf w=\\operatorname{comp}_{\\mathbf w}(\\mathbf v)\\,|\\mathbf w|\\): the area of a rectangle standing on the shadow, \\(|\\mathbf w|\\) tall.",
  tryIt: "Play: the shadow vanishes at 90°, then turns negative.",
  state: Object.assign({ wx: 3, wy: 1, role: 0 }, vzPolarSt(2, 3)),
  controls: [
    { k: "th", label: "direction of v", min: 0, max: 360, step: 1, unit: "°", digits: 0, play: 40, magnet: 3, aria: "v",
      rests: s => { const a = Math.atan2(s.wy, s.wx) * 180 / Math.PI; return [0, 90, 180, 270].map(d => ((a + d) % 360 + 360) % 360); } },
  ],
  presets: [["Acute", Object.assign({ wx: 3, wy: 1 }, vzPolarSt(2, 3))], ["Right angle", Object.assign({ wx: 3, wy: 1 }, vzPolarSt(-1, 3))],
    ["Obtuse", Object.assign({ wx: 3, wy: 1 }, vzPolarSt(-2, 1))], ["Along w", Object.assign({ wx: 3, wy: 1 }, vzPolarSt(1.5, .5))]],
  P: vzPlane(300, 216, 50),                              // a little high, so v's name clears the key when v points down
  lim: { x0: -5.6, x1: 5.6, y0: -3.8, y1: 4.2 },
  maxLen: 4,                                             // v can turn all the way round and stay on the picture
  v(s) { const r = c => Math.abs(c - Math.round(c * 4) / 4) < 1e-9 ? Math.round(c * 4) / 4 : c, l = Math.min(s.lv, this.maxLen); return [r(l * Math.cos(vzRad(s.th))), r(l * Math.sin(vzRad(s.th)))]; },   // grid points come back exact
  w(s) { return [s.wx, s.wy]; },
  handles(s) { const P = this.P, v = this.v(s); return [{ k: "v", x: P.X(v[0]), y: P.Y(v[1]) }, { k: "w", x: P.X(s.wx), y: P.Y(s.wy) }]; },
  dragTo(s, k, x, y, fine) {
    const P = this.P, L = this.lim;
    let p = [vzClamp((x - P.cx) / P.u, L.x0, L.x1), vzClamp((P.cy - y) / P.u, L.y0, L.y1)];
    const len = Math.hypot(...p);
    if (len > this.maxLen) p = p.map(c => c * this.maxLen / len);
    if (!fine) {                                          // let go: a grid point, still inside the limit
      p = p.map(c => vzSnap(c, .5));
      if (Math.hypot(...p) > this.maxLen + 1e-9) p = p.map(c => Math.sign(c) * Math.floor(Math.abs(c) * 2 + 1e-9) / 2);
    }
    if (Math.hypot(...p) < .5) { const an = Math.atan2(p[1], p[0]) || 0; p = fine ? [.5 * Math.cos(an), .5 * Math.sin(an)] : [vzSnap(Math.cos(an), .5) || .5, vzSnap(Math.sin(an), .5)]; }   // never the zero vector
    if (k === "w") { s.wx = p[0]; s.wy = p[1]; return; }
    s.th = ((Math.atan2(p[1], p[0]) * 180 / Math.PI) + 360) % 360; s.lv = Math.hypot(...p);
  },
  panelTop() { return `<div><div class="vz-ptop-k">Project</div><div class="vz-seg" role="group" aria-label="Which vector to project"><button type="button" data-role="0">v onto w</button><button type="button" data-role="1">w onto v</button></div></div>`; },
  sync(s, panel) { panel && panel.querySelectorAll("[data-role]").forEach(b => b.classList.toggle("on", +b.dataset.role === s.role)); },
  onClick(el, s) { const b = el.closest("[data-role]"); if (!b) return false; s.role = +b.dataset.role; return true; },
  // the side the area stands on, swung over in ~0.35 s when it changes (on the live picture): a steady swing, eased,
  // that ends (an exponential ease would creep on for seconds, keeping the names moving at rest)
  sideNow(target, thumb) {
    if (thumb || !VzView.live) return target;
    const now = performance.now(), dt = this._sdT == null ? 1 : Math.min(.1, (now - this._sdT) / 1000); this._sdT = now;
    if (this._sd == null) this._sd = target;
    const step = dt / .175, gap = target - this._sd;
    this._sd = Math.abs(gap) <= step ? target : this._sd + Math.sign(gap) * step;
    if (this._sd !== target) VzView.again = true;
    return 2 * vzEase((this._sd + 1) / 2) - 1;
  },
  // a 0-to-1 switch for a name, eased over ~0.2 s on the live picture, so a name never sits half-faded and never pops
  fadeTo(key, on, thumb) {
    if (thumb || !VzView.live) return on ? 1 : 0;
    const F = this._fd || (this._fd = {}), now = performance.now(), f = F[key] || (F[key] = { v: on ? 1 : 0, t: now });
    const dt = Math.min(.1, (now - f.t) / 1000); f.t = now;
    f.v = on ? Math.min(1, f.v + dt / .2) : Math.max(0, f.v - dt / .2);
    if (f.v > 0 && f.v < 1) VzView.again = true;
    return vzEase(f.v);
  },
  // a: the vector being projected, b: the one it is projected onto
  geo(s) {
    const v = this.v(s), w = this.w(s), a = s.role ? w : v, b = s.role ? v : w;
    const ab = vzDot(a, b), bb = vzDot(b, b), lb = Math.sqrt(bb), comp = ab / lb, pr = [b[0] * ab / bb, b[1] * ab / bb], perp = [a[0] - pr[0], a[1] - pr[1]];
    return { v, w, a, b, ab, bb, lb, comp, pr, perp, an: s.role ? "w" : "v", bn: s.role ? "v" : "w" };
  },
  draw(s, t, thumb) {
    const P = this.P, g = this.geo(s), { a, b, pr, perp, comp, lb } = g, ub = [b[0] / lb, b[1] / lb];
    const bCol = s.role ? VZ.ink : VZ.red;                 // the colour of the vector projected onto (w, or v when the roles swap)
    let o = P.axes(.16) + P.line([0, 0], b, `stroke="${VZ.grey}" stroke-width="1.2" stroke-dasharray="6 6" opacity=".8"`);
    // which side of the line a lies on: the area goes on the other side
    // (when a crosses the line the area swings over to the other side, flattening as it goes, instead of jumping)
    const side = Math.sign(ub[0] * a[1] - ub[1] * a[0]) || 1, sd = this.sideNow(side, thumb), sgn = Math.sign(sd) || side;
    const nrm = [ub[1] * sgn, -ub[0] * sgn], nrmR = [ub[1] * sd, -ub[0] * sd], sideOp = vzClamp(Math.abs(sd) * 1.6, 0, 1);   // nrm points away from a
    const pl = Math.hypot(...pr), ql = Math.hypot(...perp), neg = comp < -1e-9, sg = neg ? -1 : 1;
    // the names fade in and out as the lengths they need come and go, never switching on at once
    const ramp = (x, lo, hi) => vzClamp((x - lo) / (hi - lo), 0, 1), zeroOp = this.fadeTo("zero", pl <= .02, thumb);
    // v · w as an area: a rectangle standing on the shadow, as tall as |w| (on the far side of the line from v)
    if (pl > .02 || zeroOp < .99) {
      const C = [[0, 0], pr, [pr[0] + nrmR[0] * lb, pr[1] + nrmR[1] * lb], [nrmR[0] * lb, nrmR[1] * lb]];
      o += P.poly(C, `fill="${neg ? VZ.grey : VZ.red}" fill-opacity="${neg ? .1 : .09}" stroke="${neg ? VZ.grey : VZ.red}" stroke-opacity=".45" stroke-width="1.2" ${neg ? 'stroke-dasharray="5 4"' : ""}`);
      // the far side is |w| long: a copy of w turned square to the line, drawn as the rectangle's edge in w's colour
      o += `<line x1="${q2(P.X(C[0][0]))}" y1="${q2(P.Y(C[0][1]))}" x2="${q2(P.X(C[3][0]))}" y2="${q2(P.Y(C[3][1]))}" stroke="${bCol}" stroke-width="2.6" stroke-linecap="round" opacity=".75"/>`;
      // names on the area: |w| beside its edge, and v · w in the middle when there is room (beside it when not)
      const mE = [nrmR[0] * lb / 2 - ub[0] * sg * .34, nrmR[1] * lb / 2 - ub[1] * sg * .34];
      o += `<g opacity="${q2(sideOp * (1 - zeroOp))}">` + vzLabel(P.X(mE[0]), P.Y(mE[1]) + 5, `|${vzB(g.bn)}|`, bCol, 15);
      // the base is the shadow's signed length
      const cOp = ramp(pl, 1.1, 1.4);
      if (cOp > .01) o += `<g opacity="${q2(cOp)}">${vzAlong(P, [0, 0], pr, nrm, 15, `comp = ${vzNum(comp)}`, "#7A5C0F", 13.5)}</g>`;
      const cen = [pr[0] / 2 + nrmR[0] * lb / 2, pr[1] / 2 + nrmR[1] * lb / 2], room = pl > 1.5 && lb > 1.1;
      const at = room ? cen : [pr[0] + ub[0] * sg * .3 + nrmR[0] * lb / 2, pr[1] + ub[1] * sg * .3 + nrmR[1] * lb / 2];
      const g2 = vzGlide("area@", [P.X(at[0]), P.Y(at[1])], 40);
      o += vzLabel(g2[0] + (room ? 0 : 6 * sg * Math.sign(ub[0] || 1)), g2[1] + 6, `${vzB(g.an)} · ${vzB(g.bn)} = ${vzShort(g.ab)}`, neg ? VZ.ink : VZ.deep, 16, room ? "middle" : (sg * (ub[0] || 1) > 0 ? "start" : "end"));
      const nOp = room && neg ? ramp(pl, 1.5, 1.8) * ramp(lb, 1.6, 1.9) : 0;
      if (nOp > .01) o += `<g opacity="${q2(nOp)}">${vzLabel(g2[0], g2[1] + 26, `<tspan font-style="normal" font-size="12.5">a negative area</tspan>`, VZ.grey, 12.5)}</g>`;
      o += `</g>`;
    }
    // the angle between them (its name fades out as the angle closes up, where it would sit on the arrows)
    const a0 = Math.atan2(b[1], b[0]), a1 = Math.atan2(a[1], a[0]); let da = ((a1 - a0) % (2 * Math.PI) + 3 * Math.PI) % (2 * Math.PI) - Math.PI;
    const thDeg = Math.abs(da) * 180 / Math.PI, right = Math.abs(thDeg - 90) < .6, thOp = ramp(thDeg, 4, 12), thAt = [.98 * Math.cos(a0 + da * .6), .98 * Math.sin(a0 + da * .6)];
    if (right) o += P.rightAngle([0, 0], ub, [a[0] / Math.hypot(...a), a[1] / Math.hypot(...a)], .32);
    else if (thOp > .01) { let arc = ""; for (let i = 0; i <= 28; i++) { const tt = a0 + da * i / 28; arc += (i ? "L" : "M") + q2(P.X(.6 * Math.cos(tt))) + " " + q2(P.Y(.6 * Math.sin(tt))); }
      o += `<g opacity="${q2(thOp)}"><path d="${arc}" fill="none" stroke="${VZ.grey}" stroke-width="1.3"/>` + vzLabel(P.X(thAt[0]), P.Y(thAt[1]) + 5, "θ", VZ.grey, 15) + `</g>`; }
    // the part left over: from the foot of the drop up to a's tip, square to the line
    if (ql > .06) {
      o += `<line x1="${q2(P.X(pr[0]))}" y1="${q2(P.Y(pr[1]))}" x2="${q2(P.X(a[0]))}" y2="${q2(P.Y(a[1]))}" stroke="${VZ.deep}" stroke-width="2" stroke-dasharray="5 4"/>`;
      if (pl > .3 && ql > .3) o += P.rightAngle(pr, [perp[0] / ql, perp[1] / ql], [-sg * ub[0], -sg * ub[1]], .2);
      const mid = [(pr[0] + a[0]) / 2, (pr[1] + a[1]) / 2], pOp = ramp(ql, .9, 1.2);
      if (pOp > .01) o += `<g opacity="${q2(pOp)}">${vzLabel(P.X(mid[0] + ub[0] * .38 * sg), P.Y(mid[1] + ub[1] * .38 * sg) + 5, vzB(g.an) + "<tspan>⊥</tspan>", VZ.deep, 15)}</g>`;
    }
    // the shadow: a wide band on the line, under w, so both stay in sight; its signed length is comp
    if (pl > .05) o += `<g opacity=".55">${P.arrow([0, 0], pr, "O", 11)}</g>`;
    if (!thumb) o += vzGrip(P.X(g.v[0]), P.Y(g.v[1]), VZ.ink, VzView.hot === "v") + vzGrip(P.X(g.w[0]), P.Y(g.w[1]), VZ.red, VzView.hot === "w");
    o += P.arrow([0, 0], g.w, "R", 2.6) + P.arrow([0, 0], g.v, "I", 2.8) + P.dot([0, 0], 3.6);
    o += vzTipLabels(P, [{ v: g.v, html: vzB("v"), col: VZ.ink }, { v: g.w, html: vzB("w"), col: VZ.red }]);
    // the shadow's name, written along it on v's side, at its tip end (clear of the square at the foot of v⊥) and clear
    // of the angle θ near 0; when the shadow is too short to hold it, past its tip instead (the two cross-fade)
    if (pl > .25) {
      const u = P.u, LW = 58, du = [ub[0] * sg, ub[1] * sg];
      const thAlong = (thAt[0] * du[0] + thAt[1] * du[1]) * u, thAcross = Math.abs(ub[0] * thAt[1] - ub[1] * thAt[0]) * u;
      const s0 = thOp > .01 && !right && thAlong > 0 && thAcross < 33 ? Math.max(34, thAlong + 10) : 34;   // where the name may start
      const room = pl * u - 14 - s0 - LW, on = thumb ? room > 0 : (this._kOn = room > (this._kOn ? -6 : 6)), kA = this.fadeTo("along", on, thumb), c = Math.max(s0 + LW / 2, pl * u - 14 - LW / 2) / u, nm = vzSub("proj", g.bn, `(${g.an})`);
      o += `<g opacity="${q2(sideOp * kA)}">${vzAlong(P, [du[0] * (c - .1), du[1] * (c - .1)], [du[0] * (c + .1), du[1] * (c + .1)], [-nrm[0], -nrm[1]], 15, nm, "#7A5C0F", 15)}</g>`;
      const at = [pr[0] + du[0] * .75 - nrm[0] * .42, pr[1] + du[1] * .75 - nrm[1] * .42], gg = vzGlide("shadow@", [P.X(at[0]), P.Y(at[1])], 30), tOp = (1 - kA) * ramp(pl, .25, .45);
      o += `<g opacity="${q2(tOp)}">${vzLabel(gg[0], gg[1] + 5, nm, "#7A5C0F", 14)}</g>`;
    }
    if (zeroOp > .01) o += `<g opacity="${q2(zeroOp)}">${vzLabel(P.X(-nrm[0] * .2 - ub[0] * .9), P.Y(-nrm[1] * .2 - ub[1] * .9) + 5, `${vzB(g.an)} · ${vzB(g.bn)} = 0`, VZ.deep, 16)}</g>`;
    o += vzKey([["line", VZ.ink, "v"], ["line", VZ.red, "w"], ["line", VZ.gold, `shadow of ${g.an} on ${g.bn}`], ["dash", VZ.deep, `${g.an}⊥`], ["fill", VZ.red, `${g.an} · ${g.bn} as an area`]]);
    return o;
  },
  readout(s) {
    const g = this.geo(s), { a, b, ab, bb, pr, perp, an, bn } = g, A = `<b>${an}</b>`, B = `<b>${bn}</b>`;
    const lv = Math.hypot(...g.v), lw = Math.hypot(...g.w), cos = vzClamp(ab / (lv * lw), -1, 1), th = Math.acos(cos) * 180 / Math.PI;
    const sub = (x, y) => `${x}<sub>${y}</sub>`;
    return `<div class="vz-eq"><b>v</b> · <b>w</b> = ${vzDotX(g.v, g.w)} = <b>${vzShort(ab)}</b></div>
      <div class="vz-eq">${sub("comp", B)}(${A}) = ${vzFrac(`${A} · ${B}`, `|${B}|`)} = ${vzFrac(vzShort(ab), vzRoot(bb).replace(/ <span.*$/, ""))} ${Math.abs(Math.sqrt(bb) - Math.round(Math.sqrt(bb))) > 1e-9 ? "≈ " : "= "}<b>${vzNum(ab / Math.sqrt(bb))}</b> <span class="vz-tag">a number</span></div>
      <div class="vz-eq">${sub("proj", B)}(${A}) = ${vzFrac(`${A} · ${B}`, `${B} · ${B}`)} ${B} = ${vzFrac(vzShort(ab), vzShort(bb))} ${vzVec(b)} = <b>${vzVec(pr)}</b> <span class="vz-tag">a vector</span></div>
      <div class="vz-eq">${A}<sub>⊥</sub> = ${A} − ${sub("proj", B)}(${A}) = <b>${vzVec(perp)}</b>, and ${A}<sub>⊥</sub> · ${B} = <b>${vzShort(Math.abs(vzDot(perp, b)) < 1e-9 ? 0 : vzDot(perp, b))}</b></div>
      <div class="vz-status ${Math.abs(ab) < 1e-9 ? "warn" : "ok"}">${Math.abs(ab) < 1e-9 ? "v · w = 0: perpendicular, no shadow."
        : Math.hypot(...perp) < 1e-9 ? `${an} lies along ${bn}: its shadow is itself.`
