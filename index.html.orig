      const dx = Ln.d[0], dy = -Ln.d[1], a = this.reach(G, dx, dy), b = this.reach(G, -dx, -dy);
      o += `<line x1="${q2(cx - dx * b)}" y1="${q2(cy - dy * b)}" x2="${q2(cx + dx * a)}" y2="${q2(cy + dy * a)}" stroke="${VZ.grey}" stroke-width="2" stroke-dasharray=".01 7" stroke-linecap="round" opacity="${q2(.55 * (1 - Ln.on) + .1)}"/>`;
      if (Ln.on > .01) o += `<line x1="${q2(cx - dx * b)}" y1="${q2(cy - dy * b)}" x2="${q2(cx + dx * a)}" y2="${q2(cy + dy * a)}" stroke="${VZ.red}" stroke-width="3" stroke-linecap="round" opacity="${q2(.5 * Ln.on)}"/>`;
      const side = dx * v[0] + dy * -v[1] > 0 ? -1 : 1, r = Math.min(side > 0 ? a : b, G.R + 6) * .92;
      tags.push(this.tag(cx + side * dx * r, cy + side * dy * r, this.lamTag(sol, Ln.e), Ln.on, G));
