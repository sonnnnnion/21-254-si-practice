  o += vzDot3(cam, O, 3.4, VZ.ink);

  // ---- names
  const tipOf = p => { const q = pr(p), dx = q[0] - So[0], dy = q[1] - So[1], L = Math.hypot(dx, dy); return { at: [q[0], q[1]], dir: L > 4 ? [dx / L, dy / L] : [0, -1] }; };
  const midOf = (a, b) => { const A = pr(a), B = pr(b), m = [(A[0] + B[0]) / 2, (A[1] + B[1]) / 2], dx = B[0] - A[0], dy = B[1] - A[1], L = Math.hypot(dx, dy) || 1;
    let n = [-dy / L, dx / L]; if (n[0] * (So[0] - m[0]) + n[1] * (So[1] - m[1]) > 0) n = [-n[0], -n[1]]; return { at: m, dir: n }; };
  // a shadow's name goes past its foot, away from v (the drop and the light sheet are on v's side)
