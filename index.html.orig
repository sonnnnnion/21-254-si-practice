    [["0|0|0|0", 2], ["3|0|0|3", 2], ["99|-99|99|99", 2], ["1/2|1/3|1/5|1/7", 2], ["0|1|0|0", 2], ["1|2|2|4", 2], ["0|1|-1|0", 2], ["1|2|3|4|5|6|7|8|9", 3], ["5|0|0|0|5|0|0|0|5", 3],
     ["0|0|0|0|0|0|0|0|0", 3], ["2|1|0|0|2|1|0|0|2", 3], ["2|1|0|1|2|1|0|1|2", 3], ["99|98|-97|-96|95|94|93|-92|91", 3], ["1|1|0|-1|1|0|0|0|3", 3], ["1|2|0|3|4|5|6|7|8", 3]].map(([m, n]) => ({ n, ["m" + n]: m, ["ok" + n]: m }))),
  controls: [{ k: "yaw", label: "turn the view", min: -180, max: 180, step: 1, unit: "°", digits: 0, play: 24, show: s => s.n === 3, aria: "the view" }],
  reset() { TEIG_UI.reset(); this._split = false; },
  panelTop() {
    return `<div class="teig-top"><div class="vz-seg" role="group" aria-label="Size of the matrix"><button type="button" data-teig-n="2">2 × 2</button><button type="button" data-teig-n="3">3 × 3</button></div>
      <div id="teigMx"></div><div><div class="vz-ptop-k">Or start from</div><div class="vz-chips" id="teigEx"></div></div></div>`;
  },
  mxHtml(s, n) {
