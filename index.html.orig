        const wl = Math.hypot(Ws[0] - O[0], Ws[1] - O[1]) || 1, wx = (Ws[0] - O[0]) / wl, wy = (Ws[1] - O[1]) / wl;
        let nx = -wy, ny = wx; if (nx * (Vs[0] - O[0]) + ny * (Vs[1] - O[1]) > 0) { nx = -nx; ny = -ny; }
        if (pop > .01) labs += `<g opacity="${q2(pop)}">${this.lab(A[0], A[1], nx, ny, 12, vzSub("proj", "w", "(v)"), "#7A5C0F")}</g>`;
        if (qop > .01) labs += `<g opacity="${q2(qop)}">${this.lab(B[0], B[1], sg * wx, sg * wy, 10, vzB("v") + "<tspan>⊥</tspan>", VZ.deep)}</g>`;
        if (wl > 3) labs += this.lab(Ws[0], Ws[1], wx + nx, wy + ny, 13, vzB("w"), VZ.red, 16);
      }
      if (op === 0 && lv > 1e-9 && lw > 1e-9) {               // the angle, drawn in the plane of v and w
