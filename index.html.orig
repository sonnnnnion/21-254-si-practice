vzAdd({
  id: "tool-det", title: "Determinant and inverse", card: "Determinant and inverse",
  tagline: "Type your own matrix: see det A and A⁻¹ worked out.",
  blurb: "For a 2 × 2 matrix, \\(\\det A=ad-bc\\). For a 3 × 3, pick a row or column, multiply each entry by its cofactor \\(C_{ij}=(-1)^{i+j}M_{ij}\\) and add; the minor \\(M_{ij}\\) is the 2 × 2 determinant left after crossing out row \\(i\\) and column \\(j\\), so zeros save work. \\(A\\) has an inverse exactly when \\(\\det A\\neq0\\), and row reducing \\([A\\mid I]\\) then ends at \\([I\\mid A^{-1}]\\). The size of \\(\\det A\\) is how much \\(A\\) scales area (2 × 2) or volume (3 × 3).",
  tryIt: "Type a 0 into A: the expansion moves to that row.",
  state: { n: 3, m2: TDET_EX[2], m3: TDET_EX[3], pg: 0, k0: 0, k1: 0 },
  thumb: { n: 2, k0: 2 },
  controls: [],
  variants: [{ n: 2 }, { n: 2, k0: 2, pg: 1, k1: 3 }, { n: 2, pg: .5, k0: 1.5, k1: 1.5 }, { n: 3, k0: 5 }, { n: 3, k0: 3.4 }, { n: 3, pg: 1, k1: 9 }, { n: 3, pg: 1, k1: 4.5 },
    { n: 3, m3: ["1", "2", "3", "2", "4", "6", "0", "1", "1"], k0: 5 }, { n: 3, m3: ["0", "0", "0", "0", "0", "0", "0", "0", "0"], k0: 5 }, { n: 2, m2: ["0", "0", "0", "0"], k0: 2 },
    { n: 3, m3: ["1/2", "-3/4", "2", "0", "5/3", "-1", "7", "0", "-2/9"], pg: 1, k1: 4.5 }, { n: 3, m3: ["99", "-98", "97", "-96", "95", "-94", "93", "-92", "1/99"], pg: 1, k1: 10 },
    { n: 3, m3: ["99", "-98", "97", "-96", "95", "-94", "93", "-92", "1/99"], k0: 5 }, { n: 2, m2: ["-97/98", "95/99", "1/97", "-89/96"], pg: 1, k1: 3 }, { n: 2, m2: ["0", "1", "1", "0"], pg: 1, k1: 3 },
    { n: 3, m3: ["0", "1", "2", "1", "0", "3", "4", "-3", "8"], pg: 1, k1: 2 }, { n: 3, m3: ["0", "0", "1", "0", "1", "0", "1", "0", "0"], pg: 1, k1: 3 }],
  reset() { this._bad = null; },
  work(s) {
    const n = s.n === 2 ? 2 : 3, raw = n === 2 ? s.m2 : s.m3, key = n + ":" + (Array.isArray(raw) ? raw.join(",") : "");
    if (this._w && this._w.key === key) return this._w;
    const ent = Array.from({ length: n * n }, (_, i) => (Array.isArray(raw) && tdetParse(raw[i]).q) || TDET_0);
    const A = Array.from({ length: n }, (_, i) => ent.slice(i * n, i * n + n)), W = n === 2 ? tdetWork2(A) : tdetWork3(A);
    return (this._w = Object.assign(W, { key, n, A }));
  },
  // where the steps are heading (a glide in progress counts as arrived), and a glide there
  tgt(s) { const tw = VzView.tweens, r = {}; ["pg", "k0", "k1"].forEach(q => { r[q] = tw && tw.to && typeof tw.to[q] === "number" ? tw.to[q] : Math.round(+s[q] || 0); }); return r; },
  go(s, to, dur = 640) { vzTweenTo(Object.assign(this.tgt(s), to), dur); },
  fix(s) { const W = this.work(s); VzView.tweens = null; s.k0 = vzClamp(Math.round(s.k0), 0, W.N0 - 1); s.k1 = W.inv ? vzClamp(Math.round(s.k1), 0, W.N1 - 1) : 0; s.pg = W.inv ? Math.round(s.pg) : 0; },
  panelTop() {
    const inp = (n, i) => `<input type="text" id="tdet-${n}-${i}" data-tdc="${n}-${i}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="next" aria-label="row ${Math.floor(i / n) + 1}, column ${i % n + 1}">`;
    const grid = n => `<div class="vz-mx tdet-mx" data-tdg="${n}"><span class="vz-mx-name"><i>A</i> =</span><span class="vz-brk vz-mx-grid" style="grid-template-columns:repeat(${n}, ${n === 2 ? 62 : 54}px)">${Array.from({ length: n * n }, (_, i) => inp(n, i)).join("")}</span><span class="vz-mx-hint">whole numbers or fractions like −1/2</span></div>`;
    return `<style>.tdet-mx{margin:0}.tdet-mx .vz-mx-grid input.tdet-bad{border-color:var(--gold);background:#FFFAEB;box-shadow:0 0 0 3px rgba(184,150,66,.2)}
      .tdet-bar{display:flex;align-items:center;justify-content:space-between;gap:8px}.tdet-count{font:700 11px var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);white-space:nowrap}
      .tdet-bar .vz-seg button:disabled{opacity:.45;cursor:default}.tdet-btns{display:flex;flex-wrap:wrap;gap:6px}.tdet-btns .btn{padding:7px 11px;font-size:13px}
      .tdet-btns .btn:disabled{opacity:.4;cursor:default;transform:none;box-shadow:none}</style>
      <div><div class="vz-seg" role="group" aria-label="Size of A"><button type="button" data-tdn="2">2 × 2</button><button type="button" data-tdn="3">3 × 3</button></div></div>
      ${grid(2)}${grid(3)}
      <div class="vz-chips"><button type="button" class="vz-chip" data-tdx="ex">Example</button><button type="button" class="vz-chip" data-tdx="rnd">Random</button><button type="button" class="vz-chip" data-tdx="sing">det = 0</button></div>
      <div class="tdet-bar"><div class="vz-seg" role="group" aria-label="Which part"><button type="button" data-tdp="0">det A</button><button type="button" data-tdp="1">A⁻¹</button></div><span class="tdet-count" id="tdetCount"></span></div>
      <div class="tdet-btns"><button type="button" class="btn btn-ghost btn-sm" data-tds="back" aria-label="Back one step">←</button><button type="button" class="btn btn-red btn-sm" data-tds="next">Next step →</button><button type="button" class="btn btn-ghost btn-sm" data-tds="all">Show all</button><button type="button" class="btn btn-ghost btn-sm" data-tds="over">Start over</button></div>`;
  },
  // typing: a whole number or fraction takes effect at once (the board dissolves to the new numbers); half-typed
  // input waits; anything else is marked and, on leaving the box, put back to the last good value
  wire(panel) {
    const cell = e => e.target && e.target.closest ? e.target.closest("[data-tdc]") : null;
    panel.addEventListener("input", e => { const el = cell(e); if (el) this.typed(el); });
    panel.addEventListener("focusin", e => { const el = cell(e); if (el) setTimeout(() => { if (document.activeElement === el) el.select(); }, 0); });
    panel.addEventListener("focusout", e => {
      const el = cell(e); if (!el || !VzView.st) return;
      const [m, i] = el.dataset.tdc.split("-").map(Number), arr = m === 2 ? VzView.st.m2 : VzView.st.m3;
      if (!tdetParse(el.value).q && arr) el.value = String(arr[i]);
      el.classList.remove("tdet-bad");
      if (this._bad) { this._bad = null; vzChanged(); }
    });
    panel.addEventListener("keydown", e => {
      const el = cell(e); if (!el) return;
      if (e.key === "Enter") {
        e.preventDefault();
        const all = [...el.parentNode.querySelectorAll("input")], j = all.indexOf(el);
        if (j < all.length - 1) all[j + 1].focus(); else el.blur();
      } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
        const r = tdetParse(el.value); if (!r.q) return;
        e.preventDefault();
        const q = tdetAdd(r.q, { n: e.key === "ArrowUp" ? 1n : -1n, d: 1n });
        if (tdetAbs(q.n) <= 99n * q.d) { el.value = tdetStore(q); this.typed(el); }
      }
    });
  },
  typed(el) {
    const s = VzView.st; if (!s || VzView.def !== this) return;
    const [m, i] = el.dataset.tdc.split("-").map(Number), key = m === 2 ? "m2" : "m3", r = tdetParse(el.value);
    if (r.q) {
      el.classList.remove("tdet-bad"); this._bad = null;
      const v = tdetStore(r.q);
      if (s[key][i] !== v) { const arr = s[key].slice(); arr[i] = v; s[key] = arr; if (m === (s.n === 2 ? 2 : 3)) { this.fix(s); vzSwap(true, 320); } }
    } else { el.classList.toggle("tdet-bad", r.err !== "part"); this._bad = r.err === "part" ? null : { m, i, err: r.err }; }
    vzChanged();
  },
  sync(s, panel) {
    if (!panel) return;
    if (!panel._tdet) { panel._tdet = true; this.wire(panel); }
    const n = s.n === 2 ? 2 : 3, W = this.work(s), tg = this.tgt(s), p = W.inv ? Math.round(vzClamp(tg.pg, 0, 1)) : 0;
    panel.querySelectorAll("[data-tdn]").forEach(b => b.classList.toggle("on", +b.dataset.tdn === n));
    panel.querySelectorAll("[data-tdg]").forEach(g => { const h = +g.dataset.tdg !== n; if (g.hidden !== h) g.hidden = h; });
    [2, 3].forEach(m => { const arr = m === 2 ? s.m2 : s.m3; if (Array.isArray(arr)) arr.forEach((v, i) => { const el = document.getElementById(`tdet-${m}-${i}`); if (el && el !== document.activeElement && el.value !== String(v)) { el.value = String(v); el.classList.remove("tdet-bad"); } }); });
    panel.querySelectorAll("[data-tdp]").forEach(b => {
      b.classList.toggle("on", +b.dataset.tdp === p);
      if (b.dataset.tdp === "1" && b.disabled !== !W.inv) { b.disabled = !W.inv; b.title = W.inv ? "" : "det A = 0: there is no inverse"; }
    });
    const N = p ? W.N1 : W.N0, k = vzClamp(Math.round(p ? tg.k1 : tg.k0), 0, N - 1), cnt = document.getElementById("tdetCount"), txt = `Step ${k + 1} of ${N}`;
    if (cnt && cnt.textContent !== txt) cnt.textContent = txt;
    const k0 = Math.round(tg.k0), k1 = Math.round(tg.k1);
    const off = { back: p === 0 && k === 0, next: k >= N - 1 && !(p === 0 && W.inv), all: k0 >= W.N0 - 1 && (!W.inv || k1 >= W.N1 - 1), over: p === 0 && k0 === 0 && k1 === 0 };
    panel.querySelectorAll("[data-tds]").forEach(b => { const d = !!off[b.dataset.tds]; if (b.disabled !== d) b.disabled = d; });
  },
  onClick(el, s) {
    const b = el.closest && el.closest("[data-tdn], [data-tdx], [data-tdp], [data-tds]");
    if (!b || b.disabled) return false;
    const W = this.work(s), tg = this.tgt(s), n = s.n === 2 ? 2 : 3;
    const restart = () => { VzView.tweens = null; s.pg = 0; s.k0 = 0; s.k1 = 0; this._bad = null; };
    if (b.dataset.tdn) { if (+b.dataset.tdn === n) return false; s.n = +b.dataset.tdn; restart(); return true; }
    if (b.dataset.tdx) { const key = "m" + n; s[key] = b.dataset.tdx === "ex" ? TDET_EX[n].slice() : tdetRandom(n, b.dataset.tdx === "sing", s[key]); restart(); return true; }
    if (b.dataset.tdp) { const p = +b.dataset.tdp; if ((p === 1 && !W.inv) || p === Math.round(tg.pg)) return false; this.go(s, { pg: p }, 720); return true; }
    const p = W.inv ? Math.round(vzClamp(tg.pg, 0, 1)) : 0, kk = p ? "k1" : "k0", N = p ? W.N1 : W.N0, k = vzClamp(Math.round(tg[kk]), 0, N - 1);
    switch (b.dataset.tds) {
      case "next": if (k < N - 1) this.go(s, { [kk]: k + 1 }); else if (p === 0 && W.inv) this.go(s, { pg: 1 }, 720); else return false; return true;
      case "back": if (k > 0) this.go(s, { [kk]: k - 1 }); else if (p === 1) this.go(s, { pg: 0 }, 720); else return false; return true;
      case "all": VzView.tweens = null; s.pg = p; s.k0 = W.N0 - 1; s.k1 = W.inv ? W.N1 - 1 : 0; return true;
      case "over": restart(); return true;
    }
    return false;
  },
  draw(s, t, thumb) {
    const W = this.work(s), pg = W.inv ? vzClamp(+s.pg || 0, 0, 1) : 0;
    let o = "";
    // one page leaves (lifting a little) before the other arrives (settling up into place), so they barely overlap
    const out = vzClamp(1 - pg / .6, 0, 1), inn = vzClamp((pg - .4) / .6, 0, 1);
    if (out > .01) o += `<g opacity="${q2(out)}" transform="translate(0 ${q2(-16 * pg)})">${W.n === 2 ? this.det2(W, s, true) : this.det3(W, s, true)}</g>`;
    if (inn > .01) o += `<g opacity="${q2(inn)}" transform="translate(0 ${q2(16 * (1 - pg))})">${W.n === 2 ? this.inv2(W, s) : this.inv3(W, s)}</g>`;
    return o;
  },
  verdict(W, x, y, fs, op) {
    return tdetText(x, y, W.inv ? `det <tspan font-style="italic">A</tspan> ≠ 0, so <tspan font-style="italic">A</tspan> is invertible.` : `det <tspan font-style="italic">A</tspan> = 0, so <tspan font-style="italic">A</tspan> has no inverse.`, fs, { anchor: "start", col: W.inv ? TDET_OK : TDET_NO, op, wt: 600 });
  },
  // page 1, 2 × 2: det A = ad − bc, the numbers put in, the value; the unit square and its image beside
  det2(W, s, key) {
    const k = vzClamp(+s.k0 || 0, 0, W.N0 - 1), show = j => vzClamp(k - j + 1, 0, 1), [[a, b], [c, d]] = W.A, X = 26, fs = 23;
    const rise = j => (1 - show(j)) * 8;
    let o = tdetFit(f => tdetRow([tdetLine([{ it: "A" }, " = "], f), tdetMat(tdetCells(W.A, f), f)]), fs, 300).d(X, 104);
    const lhs = tdetLine(["det ", { it: "A" }], fs), xe = X + lhs.w, mw = 334 - xe;
    const l1 = tdetFit(f => tdetLine([" = ", { it: "ad" }, " − ", { it: "bc" }], f), fs, mw);
    const l2 = tdetFit(f => tdetLine([" = ", { f: a }, { f: d }, " − ", { f: b }, { f: c }], f), fs, mw);
    const l3 = tdetFit(f => tdetLine([" = ", { q: W.ad }, " − ", W.bc.n < 0n ? { f: W.bc } : { q: W.bc }, " = ", { q: W.det, o: { wt: 700 } }], f), fs, mw);
    o += lhs.d(X, 204) + l1.d(xe, 204);
    o += l2.d(xe, 268 + rise(1), show(1)) + l3.d(xe, 332 + rise(2), show(2));
    o += this.verdict(W, X, 394 + rise(2), 17, show(2));
    const bx = [346, 58, 242, 300];
    o += tdetPanelBg(...bx) + tdetPic2(W.A, [bx[0], bx[1] + 30, bx[2], bx[3] - 30]);
    if (key) o += vzKey([["dash", VZ.grey, "unit square"], ["fill", VZ.red, "its image"]], bx[0] + 6, bx[1] - 12);
    const al = tdetFit(f => tdetLine(["area = |det ", { it: "A" }, "| = ", { q: { n: tdetAbs(W.det.n), d: W.det.d } }], f, { col: VZ.deep }), 17, bx[2] - 26);
    o += al.d(bx[0] + 13, bx[1] + 20, show(2));
    return o;
  },
  // page 1, 3 × 3: the line with the most zeros, its signs, then one cofactor term per entry (its row and column
  // crossed out in A, the minor written out and worked), then the sum; the unit cube and its image up in the corner
  det3(W, s, key) {
    const k = vzClamp(+s.k0 || 0, 0, W.N0 - 1), show = j => vzClamp(k - j + 1, 0, 1), rise = j => (1 - show(j)) * 8, ex = W.ex, A = W.A;
    const a1 = show(1), xo = vzClamp(k - 1, 0, 1) * vzClamp(5 - k, 0, 1), p = vzClamp(k - 2, 0, 2);
    const onL = (i, j) => ex.row ? i === ex.idx : j === ex.idx, along = (i, j) => ex.row ? j : i;
    const foc = (i, j) => onL(i, j) ? vzClamp(1 - Math.abs(along(i, j) - p), 0, 1) : 0;
    const struck = (i, j) => vzClamp(Math.max(onL(i, j) ? 1 : 0, vzClamp(1 - Math.abs(along(i, j) - p), 0, 1)) - foc(i, j), 0, 1) * xo;
    // A, fitted so its signs still clear the picture
    const mkA = f => { const m = tdetMat(tdetCells(A, f), f, { cellOp: (i, j) => 1 - .72 * struck(i, j), hi: (i, j) => foc(i, j) * xo, hiCells: tdetCells(A, f, { col: VZ.red, wt: 700 }) }), nm = tdetLine([{ it: "A" }, " = "], f); return { m, nm, w: nm.w + m.w + 92 }; };
    let fa = 22, AA = mkA(fa); if (AA.w > 296) AA = mkA(fa = fa * 296 / AA.w);
    const xA = 14 + AA.nm.w, cyA = Math.max(74, 24 + AA.m.up), g = AA.m.geo(xA, cyA);
    let o = "";
    // the chosen row or column, shaded
    if (a1 > .01) {
      const L = ex.idx, r = ex.row ? [g.l + 4, g.ys[L] - g.rows[L].up - 4, g.r - g.l - 8, g.rows[L].up + g.rows[L].dn + 8] : [g.xs[L] - g.cw[L] / 2 + 2, g.top + 3, g.cw[L] - 4, g.bot - g.top - 6];
      o += `<rect x="${q2(r[0])}" y="${q2(r[1])}" width="${q2(r[2])}" height="${q2(r[3])}" rx="9" fill="${VZ.gold}" fill-opacity="${q2(.22 * a1)}"/>`;
    }
    o += AA.nm.d(14, cyA) + AA.m.d(xA, cyA);
    // crossing out the row and column of the entry in focus (they glide from entry to entry)
    if (xo > .01) {
      const lerp = (v, q) => { const i0 = Math.floor(q), i1 = Math.min(2, i0 + 1), fr = q - i0; return v[i0] + (v[i1] - v[i0]) * fr; };
      const fx = ex.row ? lerp(g.xs, p) : g.xs[ex.idx], fy = ex.row ? g.ys[ex.idx] : lerp(g.ys, p), gp = fa * 1.05, ly = fy - fa * .02;
      o += `<g opacity="${q2(xo)}" stroke="${VZ.red}" stroke-width="2.2" stroke-linecap="round" fill="none"><path d="M${q2(g.l + 6)} ${q2(ly)}H${q2(fx - gp)}M${q2(fx + gp)} ${q2(ly)}H${q2(g.r - 6)}M${q2(fx)} ${q2(g.top + 4)}V${q2(fy - gp)}M${q2(fx)} ${q2(fy + gp)}V${q2(g.bot - 4)}"/>` +
        `<circle cx="${q2(fx)}" cy="${q2(fy)}" r="${q2(fa * .95)}" stroke-width="2"/></g>`;
    }
    // the checkerboard of signs, the chosen line's in red
    if (a1 > .01) {
      const sx = g.r + 22, st = 22;
      let sg = "";
      for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) {
        const on = onL(i, j), h = on ? 5.5 : 4, cx = sx + j * st + st / 2, cy = g.ys[i] + 1, plus = (i + j) % 2 === 0;
        sg += `<path d="M${q2(cx - h)} ${q2(cy)}H${q2(cx + h)}${plus ? `M${q2(cx)} ${q2(cy - h)}V${q2(cy + h)}` : ""}" stroke="${on ? VZ.red : VZ.grey}" stroke-width="${on ? 2.4 : 1.6}" stroke-linecap="round" opacity="${on ? 1 : .6}"/>`;
      }
      o += `<g opacity="${q2(a1)}">${sg}${tdetText(sx + 1.5 * st, g.top - 4, "signs", 12, { sans: true, col: VZ.grey })}</g>`;
      o += tdetText(14, g.bot + 21, `expand along ${ex.row ? "row" : "column"} ${ex.idx + 1}`, 14.5, { sans: true, anchor: "start", col: VZ.deep, wt: 700, op: a1 });
    }
    // the picture, top right
    const px = Math.max(316, g.r + 22 + 66 + 14), bx = [px, 30, 588 - px, 122];
    const vl = tdetFit(f => tdetLine(["volume = |det ", { it: "A" }, "| = ", { q: { n: tdetAbs(W.det.n), d: W.det.d } }], f, { col: VZ.deep }), 15, bx[2] - 16), vh = vl.up + vl.dn;
    o += tdetPanelBg(...bx) + tdetPic3(A, [bx[0], bx[1] + 2, bx[2], bx[3] - vh - 8]);
    if (key) o += vzKey([["fill", VZ.grey, "unit cube"], ["fill", VZ.red, "its image"]], bx[0] + 4, bx[1] - 8);
    o += vl.d(bx[0] + bx[2] / 2 - vl.w / 2, bx[1] + bx[3] - 5 - vl.dn, show(5));
    // the terms, the sum and the verdict, sized so they fit below
    const y0 = Math.max(g.bot + 36, 166), build = f => {
      const rows = W.terms.map(T => {
        const z = T.a.n === 0n, sgn = T.sg > 0 ? "+" : "−";
        const left = tdetRow([tdetS(sgn, f), tdetSp(f * .1), tdetPar(T.a, f), tdetS(" · ", f), tdetMat(tdetCells(T.M, f), f, { br: "|", cellOp: () => z ? .4 : 1 })]);
        const eA = z ? tdetLine([" = 0"], f) : tdetLine([" = ", sgn, { f: T.a }, " · [", { f: T.M[0][0] }, { f: T.M[1][1] }, " − ", { f: T.M[0][1] }, { f: T.M[1][0] }, "]"], f);
        const eB = z ? null : tdetLine([" = ", sgn, { f: T.a }, { f: T.md }, " = ", { q: T.term, o: { wt: 700 } }], f), gE = f * .4;
        const hE = eA.up + eA.dn + (eB ? gE + eB.up + eB.dn : 0);
        return { left, eA, eB, gE, hE, h: Math.max(left.up + left.dn, hE) };
      });
      const sum = [" = "];
      W.terms.forEach((T, i) => { if (!i) sum.push({ q: T.term }); else if (T.term.n < 0n) sum.push(" − ", { q: tdetNeg(T.term) }); else sum.push(" + ", { q: T.term }); });
      sum.push(" = ", { q: W.det, o: { wt: 700 } });
      const sl = tdetLine(sum, f * 1.05), sh = tdetLine(["det ", { it: "A" }], f * 1.05), lw = Math.max(sh.w, ...rows.map(r => r.left.w)) + f * .2;
      const w = lw + Math.max(sl.w, ...rows.map(r => Math.max(r.eA.w, r.eB ? r.eB.w : 0))), gap = f * .5;
      const h = rows.reduce((a, r) => a + r.h + gap, 0) + sl.up + sl.dn + gap + f * 1.3;
      return { rows, sl, sh, lw, w, h, gap, f };
    };
    let B = build(20);
    B = build(20 * Math.min(22 / 20, 572 / B.w, (436 - y0) / B.h));
    const xe = 14 + B.lw;
    let y = y0;
    B.rows.forEach((R, t) => {
      const op = show(2 + t), cy = y + R.h / 2 + rise(2 + t);
      if (op > .01) {
        o += R.left.d(xe - B.f * .2 - R.left.w, cy, op);
        const top = cy - R.hE / 2;
        o += R.eA.d(xe, top + R.eA.up, op);
        if (R.eB) o += R.eB.d(xe, top + R.eA.up + R.eA.dn + R.gE + R.eB.up, op);
      }
      y += R.h + B.gap;
    });
    const op5 = show(5), cs = y + B.sl.up + rise(5);
    o += B.sh.d(xe - B.f * .2 - B.sh.w, cs, op5) + B.sl.d(xe, cs, op5);
    o += this.verdict(W, 14, cs + B.sl.dn + B.f * 1.15, Math.min(17.5, B.f * .9), op5);
    return o;
  },
  // page 2, 2 × 2: A⁻¹ = (1/det A)[d −b; −c a], the numbers put in, divided out, and multiplied back
  inv2(W, s) {
    const k = vzClamp(+s.k1 || 0, 0, W.N1 - 1), show = j => vzClamp(k - j + 1, 0, 1), rise = j => (1 - show(j)) * 8, [[a, b], [c, d]] = W.A;
    let X = 24;
    const build = f => {
      const it = (t, neg) => tdetS(`${neg ? "−" : ""}<tspan font-style="italic">${t}</tspan>`, f, {}, tdetW((neg ? "−" : "") + t, f));
      const lhs = tdetSup("A", "−1", f), ai = tdetSup("A", "−1", f), eq = tdetS(" = ", f), sp = tdetSp(f * .25);
      const L1 = tdetRow([eq, tdetFrac("1", `det <tspan font-style="italic">A</tspan>`, f), sp, tdetMat([[it("d"), it("b", 1)], [it("c", 1), it("a")]], f)]);
      const L2 = tdetRow([eq, tdetQB(tdetDiv(TDET_1, W.det), f), sp, tdetMat(tdetCells([[d, tdetNeg(b)], [tdetNeg(c), a]], f), f)]);
      const L3 = tdetRow([eq, tdetMat(tdetCells(W.inv, f), f)]);
      const L4 = tdetRow([tdetS(`<tspan font-style="italic">A</tspan>`, f, {}, tdetW("A", f) + 2), ai, eq, tdetMat(tdetCells(W.A, f), f), tdetSp(f * .15), tdetMat(tdetCells(W.inv, f), f), eq, tdetMat(tdetCells(W.prod, f), f), tdetS(" ✓", f, { col: TDET_OK, wt: 700 })]);
      const cap = `row 1 · column 1:  (${tdetTxt(a)})(${tdetTxt(W.inv[0][0])}) + (${tdetTxt(b)})(${tdetTxt(W.inv[1][0])}) = ${tdetTxt(W.prod[0][0])}`, fc = f * .74;
      const L5 = tdetS(cap, fc, { col: VZ.grey });
      const g = f * .75, h = [L1, L2, L3, L4].reduce((s2, L) => s2 + L.up + L.dn + g, 0) + L5.up + L5.dn;
      return { lhs, L1, L2, L3, L4, L5, g, h, w: Math.max(lhs.w + Math.max(L1.w, L2.w, L3.w), L4.w, L5.w), f };
    };
    let B = build(22);
    const sf = Math.min(1, 556 / B.w, 420 / B.h); if (sf < 1) B = build(22 * sf);
    X = Math.max(X, 300 - B.w / 2);
    const xe = X + B.lhs.w;
    let y = 225 - B.h / 2;
    const at = L => { const cy = y + L.up; y += L.up + L.dn + B.g; return cy; };
    const c1 = at(B.L1), c2 = at(B.L2), c3 = at(B.L3), c4 = at(B.L4), c5 = y + B.L5.up;
    let o = B.lhs.d(X, c1) + B.L1.d(xe, c1);
