  S.label("\\text{area }1", P([.5, .5]), { at: [P([1.35, .45])[0] + 18, P([1.35, .45])[1]], size: 12.5, color: SKC.grey });
  S.label("\\text{area }|\\det A|", P([.55, 3.6]), { size: 14.5, color: SKC.deep, dir: [1, -.2], dist: 34 });
