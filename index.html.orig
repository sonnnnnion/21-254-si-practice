}
// that camera turned to yaw (degrees), at elevation el, with the middle drawn at (X0, Y0)
function vzFitCam(fit, yaw, el, X0, Y0) {
  const { c, sc } = fit, c0 = vzCam(0, 0, sc, vzRad(yaw), el);
  const f = (x, y, z) => { const q = c0(x - c[0], y - c[1], z - c[2]); return [X0 + q[0], Y0 + q[1], q[2]]; };
  f.view = c0.view; return f;
}
// the same, but turned so the plane with normal n lies flat like a table (n points up the screen), seen from el above it;
// e1 fixes which way "yaw 0" faces. The x, y, z axes then lean, which is honest: it is the plane that is level.
function vzFitCamPlane(fit, n, e1, yaw, el, X0, Y0) {
  const N = n.map(x => x / Math.hypot(...n)), d = vzDot(e1, N), a = e1.map((x, i) => x - d * N[i]), A = a.map(x => x / Math.hypot(...a));
  const B = [N[1] * A[2] - N[2] * A[1], N[2] * A[0] - N[0] * A[2], N[0] * A[1] - N[1] * A[0]], { c, sc } = fit, c0 = vzCam(0, 0, sc, vzRad(yaw), el);
  const f = (x, y, z) => { const p = [x - c[0], y - c[1], z - c[2]], q = c0(vzDot(p, A), vzDot(p, B), vzDot(p, N)); return [X0 + q[0], Y0 + q[1], q[2]]; };
  const v = c0.view; f.view = [0, 1, 2].map(i => v[0] * A[i] + v[1] * B[i] + v[2] * N[i]); return f;
}
// names beside points, each clear of the others, of the points and of obstacles [x, y, width]; with a memory
// (mem) a name keeps last frame's side unless it must move. box: the picture's size, the caption's and key's edges
function vzNames(items, obst, box, mem) {
  const placed = items.map(it => [it.at[0], it.at[1], 16]).concat(obst || []), { W, H, top, keyY } = box;
  let o = "";
  items.forEach(it => {
    const sz = it.size || 16, w = it.html.replace(/<[^>]+>/g, "").length * sz * .5 + 8, gap = (it.gap || 14) + w / 2 * Math.abs(it.dir[0]), key = "pp|" + it.id;
    const ux = it.dir[0], uy = it.dir[1];
    let best = null, bs = -1e9, bi = 0;
    [[0, 0], [14, 0], [-14, 0], [28, 0], [-28, 0], [0, 18], [44, 0], [-44, 0], [20, 18], [-20, 18], [0, 36], [62, 0], [-62, 0], [40, 30], [-40, 30]].forEach(([side, more], i) => {
      const x = it.at[0] + ux * (gap + more) - uy * side, y = it.at[1] + uy * (gap + more - 4) + ux * side;
      const d = Math.min(9, ...placed.map(p => Math.max(Math.abs(p[0] - x) / ((p[2] + w) / 2), Math.abs(p[1] - y) / (p[2] < 10 ? 16 : 28))));
      const edge = x - w / 2 < 6 || x + w / 2 > W - 6 || y < top || y > H - 12 || (keyY < H && y > keyY && x - w / 2 < W * 5 / 6) ? 40 : 0;   // the edges, the caption, the key (it spans ~5/6 of the width)
      const sc = (d >= 1 ? 100 : d * 50) - i * 2 - edge + (mem && mem[key] === i ? 14 : 0);
      if (sc > bs) { bs = sc; best = [x, y]; bi = i; }
    });
    if (it.op > .01) { if (mem) mem[key] = bi; placed.push([best[0], best[1], w]); o += `<g opacity="${q2(Math.min(1, it.op))}">${vzLabel(best[0], best[1] + 5, it.html, it.col, sz)}</g>`; }
  });
  return o;
}
// The scene. ph says how far each take has got (0 to 1):
//   basis: w₁, w₂ and the grid they tile P with; dropA, shA, sqA, labA: the drop onto the line of w₁, its shadow, the
//   square where they meet, the shadow's name (fadeA takes the drop away again); the same with B for w₂;
//   slide, sumG, dim, labSum: tip to tail, the sum, the shadows quietening, the sum's name;
//   dropD, sq, tri, dist: the drop onto P, its square, the right triangle, v⊥'s name; truD, truS: the true drop (bad basis)
// camR: the same camera at rest, so P's name keeps its spot while the camera drifts. opt: W, H, top, keyY, axis, gid,
