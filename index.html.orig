    }
    const nh = F.unit(n), Pt = C.lab.Pn || F.mul(n, d / nn), P = F.sub(Pt, F.mul(n, (F.dot(n, Pt) - d) / nn));
    const sd = (F.dot(n, Q) - d) / Math.sqrt(nn), Ft = F.sub(Q, F.mul(nh, sd)), M = F.mul(F.add(P, Ft), .5), h = Math.max(F.len(F.sub(P, M)) * 1.5, Math.abs(sd) * .7, .9);
    const nTip = F.add(P, F.mul(nh, .55 * h)), cand = [P, Q, Ft, nTip];
    { const e = F.cross(nh, [0, 0, 1]), e1 = F.len(e) < 1e-6 ? [1, 0, 0] : F.unit(e), e2 = F.cross(nh, e1); [-1, 1].forEach(a => [-1, 1].forEach(b => cand.push(F.add(M, F.add(F.mul(e1, a * h), F.mul(e2, b * h)))))); }
    const cam = this.cam3(cand, yaw, s.el), sc = cam.sc, pa = this.patch(cam, n, M, h), mid = cam(...F.mul(F.add(P, F.add(Q, Ft)), 1 / 3)), on = Math.abs(sd) * sc > 2;
    // the names first (so the axes' names can keep clear of them): P and Q, the distance beside the drop on the side away
    // from P, n past its tip, and the plane's equation by the corner of the patch clearest of everything else
    const boxes = [], Ps = cam(...P), T = cam(...nTip);
    let labs = this.ptLabel(cam, P, mid, "P" + C.lab.P, VZ.ink, 13.5, boxes) + this.ptLabel(cam, Q, mid, "Q" + C.lab.Q, VZ.ink, 13.5, boxes);
    if (on && Math.abs(sd) * sc > 30) {
      const A = cam(...Q), B = cam(...Ft), mx = (A[0] + B[0]) / 2, my = (A[1] + B[1]) / 2;
      let nx = -(B[1] - A[1]), ny = B[0] - A[0]; if (nx * (Ps[0] - mx) + ny * (Ps[1] - my) > 0) { nx = -nx; ny = -ny; }
      labs += this.lab(mx, my, nx, ny, 14, "distance " + C.lab.dist, "#7A5C0F", 14);
