SKETCH["vecmat-009"] = () => {
  const S = skNew(400, 250); S.grid();
  const A = skMatrix(S, 110, 110, [["1", "0"], ["-2", "3"], ["4", "1"]], { cw: 34, ch: 30, size: 15, colorAt: i => i === 2 ? SKC.red : null });
  const B = skMatrix(S, 280, 94, [["2", "-1", "0", "3"], ["1", "4", "5", "-2"]], { cw: 32, ch: 30, size: 15, colorAt: (i, j) => j === 3 ? SKC.gold : null });
  S.raw("fill", `<rect x="${skN(A.x0 + 2)}" y="${skN(A.y0 + 2 * A.ch + 2)}" width="${skN(A.W - 4)}" height="${A.ch - 4}" rx="6" fill="${SKC.red}" fill-opacity=".1" stroke="${SKC.red}" stroke-width="1.2"/>`);
  S.raw("fill", `<rect x="${skN(B.x0 + 3 * B.cw + 2)}" y="${skN(B.y0 + 2)}" width="${B.cw - 4}" height="${skN(B.H - 4)}" rx="6" fill="${SKC.gold}" fill-opacity=".14" stroke="${SKC.gold}" stroke-width="1.2"/>`);
  S.label("A", [A.x0 - 22, A.y0 + A.H / 2], { at: [A.x0 - 24, A.y0 + A.H / 2], size: 16, halo: 0 });
  S.label("B", [B.x0 - 22, B.y0 + B.H / 2], { at: [B.x0 - 22, B.y0 + B.H / 2], size: 16, halo: 0 });
  S.label("(AB)_{34}=(\\text{row }3\\text{ of }A)\\cdot(\\text{column }4\\text{ of }B)", [200, 205], { at: [200, 208], size: 15, color: SKC.deep, halo: 0 });
  return skDone("Entry (3, 4) of AB uses only row 3 of A and column 4 of B", S.svg("One entry of AB"),
