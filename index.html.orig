  const st = def.state;
  return def.controls.map(c => {
    if (c.type === "matrix") return `<div class="vz-mx" data-ctl="${c.k}"><span class="vz-mx-name">${c.label || "A ="}</span><span class="vz-brk vz-mx-grid"${c.cols ? ` style="grid-template-columns:repeat(${c.cols}, 54px)"` : ""}>${c.keys.map(k =>
      `<input type="number" inputmode="decimal" id="vz-${k}" data-k="${k}" step="${c.step}" min="${c.min}" max="${c.max}" value="${vzMxText(st[k])}" aria-label="${escapeHtml(c.names ? c.names[c.keys.indexOf(k)] : k)}">`).join("")}</span>
      <span class="vz-mx-hint">${c.hint || "type or use the arrow keys"}</span></div>`;
    if (c.type === "toggle") return `<label class="vz-toggle" data-ctl="${c.k}"><input type="checkbox" role="switch" id="vz-${c.k}" data-k="${c.k}" ${st[c.k] ? "checked" : ""}><span class="vz-sw" aria-hidden="true"></span><span>${c.label}</span></label>`;
    return `<div class="vz-sl" data-ctl="${c.k}">
      <div class="vz-sl-top"><label class="vz-sl-name" for="vz-${c.k}">${c.label}</label>
        <span class="vz-sl-right">${c.noPlay ? "" : `<button class="vz-play" type="button" data-play="${c.k}" aria-label="Play ${escapeHtml(c.aria || c.label)}"><span>Play</span></button>`}<output id="vzo-${c.k}">${vzCtlText(c, st[c.k])}</output></span></div>
      <input type="range" id="vz-${c.k}" data-k="${c.k}" min="${c.min}" max="${c.max}" step="${c.step}" value="${st[c.k]}">
    </div>`;
  }).join("");
}
const vzMxText = v => String(Math.round(v * 1000) / 1000);
const vzCtlText = (c, v) => c.fmt ? c.fmt(v) : vzNum(v, c.digits == null ? 2 : c.digits) + (c.unit || "");

// Play. A progress slider (steps, time, how far) runs to its right end, rests, then the picture fades out,
// starts over from the left end and fades back in: no rewinding backwards through every value. A full-turn
// angle keeps turning; any other slider sweeps back and forth, slowing into each end and resting there.
// A control may list rests(s): values where the motion eases to a stop for a moment (an eigenvector, a right
// angle), so there is time to read what is special there. Only one slider plays at a time.
const vzSpeed = (c, v) => typeof c.play === "function" ? c.play(v) : c.play || (c.max - c.min) / 5;   // units per second (may depend on the value)
const vzWraps = c => typeof c.wrap === "function" ? !!c.wrap(VzView.st) : c.wrap != null ? !!c.wrap : !c.progress && c.unit === "°" && c.max - c.min === 360;
function vzFade(a) {                                      // the drawing and the readout, not the paper behind them
  const g = document.querySelector("#vzStage > g[clip-path]"), ro = document.getElementById("vzReadout");
  const v = a >= .999 ? "" : String(Math.round(a * 1000) / 1000);
  if (g) g.style.opacity = v; if (ro) ro.style.opacity = v;
}
// Paused mid-way, a slider glides on to its nearest step: c lands on a quarter, n on a whole number of
// cells (not a picture frozen half way through a split), an angle on a whole degree.
function vzPauseSnap(k) {
  const c = VzView.def && VzView.def.controls.find(x => x.k === k); if (!c || !c.step || c.type) return;
  const v = VzView.st[k], t = vzClamp(c.min + Math.round((v - c.min) / c.step) * c.step, c.min, c.max);
  if (Math.abs(t - v) > 1e-9) vzTweenTo({ [k]: +t.toFixed(6) }, 320);
}
function vzSetPlay(k) {
  VzView.playing = k; vzFade(1);
  if (k) {
    const c = VzView.def.controls.find(x => x.k === k), v = VzView.st[k], now = performance.now();
    VzView.phase = vzWraps(c) || !c.progress ? { name: "run", c, dir: !vzWraps(c) && v >= c.max - 1e-9 ? -1 : 1, s0: v }
      : v >= c.max - 1e-9 ? { name: "out", t0: now, c } : { name: "run", c, dir: 1, s0: v };
  }
  $$(".vz-play").forEach(b => { const on = b.dataset.play === k; b.classList.toggle("on", on); b.querySelector("span").textContent = on ? "Pause" : "Play"; });
}
function vzPlayStep(now) {
  const ph = VzView.phase, c = ph.c, st = VzView.st, span = c.max - c.min, wraps = vzWraps(c);
  const put = v => { ph.v = v; st[c.k] = v; };          // continuous: pictures glide between values, never step
  const cur = ph.v != null ? ph.v : st[c.k];
  if (ph.name === "hold") { if (now - ph.t0 > ph.dur) { ph.next.t0 = now; VzView.phase = ph.next; } return; }
  if (ph.name === "out") {                                // back to the start: the finished picture dissolves into the first one
    vzDraw(now); vzSwap(true, 900); put(c.min); VzView.stale = true;
    VzView.phase = { name: "hold", t0: now, dur: 1000, c, next: { name: "run", c, dir: 1, v: c.min, s0: c.min } };
    return;
  }
  if (ph.name === "in") {                                 // and fade back in
    const u = vzClamp((now - ph.t0) / 560, 0, 1); vzFade(vzEase(u));
    if (u >= 1) VzView.phase = { name: "hold", t0: now, dur: 260, c, next: { name: "run", c, dir: 1, v: c.min, s0: c.min } };
    return;
  }
  const dt = Math.min(.05, (now - (VzView.lastNow || now)) / 1000), dir = ph.dir || 1, edge = span * .1;
  const ahead = r => { let d = (r - cur) * dir; if (wraps) d = ((d % span) + span) % span; return d; };
  let nextRest = null, dRest = Infinity;
  (c.rests ? c.rests(st) : []).forEach(r => { const d = ahead(r); if (d > 1e-6 && d < dRest) { dRest = d; nextRest = r; } });
  const dEnd = wraps ? Infinity : dir > 0 ? c.max - cur : cur - c.min;
  let moved = (cur - (ph.s0 != null ? ph.s0 : cur)) * dir; if (wraps) moved = ((moved % span) + span) % span;
  // slow into a rest or an end, and ease away from where it last stopped
  const ease = (.18 + .82 * vzClamp(Math.min(dRest, c.progress ? Infinity : dEnd) / edge, 0, 1)) * (.3 + .7 * vzClamp(moved / (edge * .7), 0, 1));
  const step = vzSpeed(c, cur) * ease * dt;
  if (step >= dRest && dRest <= dEnd) {
    put(nextRest);
    VzView.phase = { name: "hold", t0: now, dur: c.restMs || 1000, c, next: { name: "run", c, dir, v: nextRest, s0: nextRest } };
  } else if (!wraps && step >= dEnd) {
    const end = dir > 0 ? c.max : c.min; put(end);
    VzView.phase = c.progress ? { name: "hold", t0: now, dur: 1000, c, next: { name: "out", c } }
      : { name: "hold", t0: now, dur: 420, c, next: { name: "run", c, dir: -dir, v: end, s0: end } };
  } else {
    let v = cur + dir * step;
    if (wraps) v = c.min + (((v - c.min) % span) + span) % span;
    put(v);
  }
}

// state keys that choose between pictures (a function, a field, a map, a region): they switch, never glide,
// or a tween from 0 to 2 would flash picture 1 on the way
const VZ_SELECTORS = ["fn", "fld", "map", "kind", "m", "cv", "reg", "set", "dim", "tab", "ord", "test"];
function vzPreset(target) {
  const st = VzView.st, def = VzView.def, from = {}, to = {};
  const isCtl = k => def.controls.some(c => c.k === k || (c.keys && c.keys.includes(k)));
  let swapped = false;
  Object.keys(target).forEach(k => {
    if (VZ_SELECTORS.includes(k) && !isCtl(k)) { if (st[k] !== target[k]) { st[k] = target[k]; swapped = true; } }
    else if (typeof target[k] === "number" && typeof st[k] === "number") { from[k] = st[k]; to[k] = target[k]; }
    else st[k] = target[k];
  });
  if (swapped) { if (def.reset) def.reset(); vzSwap(); }
  VzView.tweens = { from, to, t0: performance.now(), dur: 650 };
  vzSetPlay(null);
  vzChanged();
}

function vzChanged() { VzView.stale = true; vzSyncControls(); vzDraw(performance.now()); }

function vzSyncControls() {
  const def = VzView.def, st = VzView.st;
  if (def.sync) def.sync(st, document.querySelector(".vz-panel"));
  def.controls.forEach(c => {
    const el = document.getElementById("vz-" + c.k), out = document.getElementById("vzo-" + c.k);
    if (c.show) { const w = document.querySelector('[data-ctl="' + c.k + '"]'); if (w) w.hidden = !c.show(st); }
    if (c.type === "matrix") {                             // leave the entry being typed alone
      c.keys.forEach(k => { const inp = document.getElementById("vz-" + k); if (inp && inp !== document.activeElement && parseFloat(inp.value) !== Math.round(st[k] * 1000) / 1000) inp.value = vzMxText(st[k]); });
      return;
    }
    if (!el) return;
    if (c.type === "toggle") el.checked = !!st[c.k];
    else {
      if (Number(el.value) !== st[c.k]) el.value = st[c.k]; if (out) out.textContent = vzCtlText(c, st[c.k]);
      el.style.setProperty("--f", vzClamp((st[c.k] - c.min) / (c.max - c.min), 0, 1).toFixed(4));   // the red fill behind the thumb
    }
  });
}

/* Three layers: "static" (rebuilt only when def.staticKey(state) changes: contours, field
   arrows), "active" (rebuilt when the state changes), and "moving" (def.frame updates it in
   place every frame: particles, a turning surface). */
function vzThumb(v) {                                     // drawn once, then reused (a card never changes)
  if (v._th) return v._th;
  const st = Object.assign({}, v.state, v.thumb || {});
  return (v._th = (v.static ? v.static(st) : "") + v.draw(st, 1.2, true) + (v.frame ? v.frame(null, st, 1.2) : ""));
}
function vzDraw(now) {
  const def = VzView.def, stage = document.getElementById("vzStage");
  if (!def || !stage) return;
  const t = (now - VzView.t0) / 1000, st = VzView.st;
  if (!stage._layers) {
    stage.innerHTML = vzDefs(def.defs) + '<g clip-path="url(#vz-clip)"><g></g><g></g><g></g></g>';
    stage._layers = stage.querySelectorAll("g[clip-path] > g"); stage._key = null;
  }
  const [gs, ga, gd] = stage._layers;
  if (VzView.stale) {
    if (def.static) { const key = def.staticKey ? def.staticKey(st) : "1"; if (key !== stage._key) { gs.innerHTML = def.static(st); stage._key = key; } }
    VzView.live = true; VzView.frameNo = (VzView.frameNo || 0) + 1; VzView.labSeen = {}; VzView.keyItems = null;
    try { ga.innerHTML = def.draw(st, t, false); } finally { VzView.live = false; }
    const kh = document.getElementById("vzKeyHtml"), kj = JSON.stringify(VzView.keyItems || []);
    if (kh && kh._k !== kj) {
      kh._k = kj;
      kh.innerHTML = (VzView.keyItems || []).map(([kind, col, label]) => `<span class="vz-kh"><i class="vz-kh-${kind === "fill" ? "fill" : kind === "dot" ? "dot" : kind === "dash" ? "dash" : "line"}" style="--c:${col}"></i>${escapeHtml(label)}</span>`).join("");
    }
    const ro = document.getElementById("vzReadout");
    if (ro && def.readout) { const html = def.readout(st); if (ro._html !== html) { ro._html = html; ro.innerHTML = html; } }
  }
  if (def.frame) def.frame(gd, st, t);
  VzView.stale = !!VzView.again; VzView.again = false;       // a picture mid-way through its own little animation asks again
}

function vzTick(now) {
  VzView.raf = 0;
  const def = VzView.def, stage = document.getElementById("vzStage");
  if (!def || !stage || !stage.isConnected) return;
  const tw = VzView.tweens;
  if (tw) {
    const u = vzClamp((now - tw.t0) / tw.dur, 0, 1), e = vzEase(u);
    Object.keys(tw.to).forEach(k => { if (typeof tw.from[k] === "number") VzView.st[k] = tw.from[k] + (tw.to[k] - tw.from[k]) * e; });
    if (u >= 1) { Object.keys(tw.to).forEach(k => { VzView.st[k] = tw.to[k]; }); VzView.tweens = null; }
    VzView.stale = true; vzSyncControls();
  }
  if (VzView.playing && VzView.phase) { vzPlayStep(now); VzView.stale = true; vzSyncControls(); }
  VzView.lastNow = now;
  if (!document.hidden && (VzView.stale || def.frame)) vzDraw(now);
  VzView.raf = requestAnimationFrame(vzTick);
}
function vzStart() {
  VzView.t0 = performance.now(); VzView.lastNow = 0;
  if (!VzView.raf) VzView.raf = requestAnimationFrame(vzTick);
}
function vzStop() { if (VzView.raf) cancelAnimationFrame(VzView.raf); VzView.raf = 0; VzView.def = null; if (typeof stStop === "function") stStop(); }

/* ---------- 2. A matrix moves the whole plane ---------- */
vzAdd({
  id: "matrix", group: "Linear algebra concepts", title: "A matrix is a transformation", card: "Linear transformations",
  tagline: "What a matrix does to the whole plane.",
  blurb: "The columns of \\(A\\) are where \\(\\mathbf e_1\\) and \\(\\mathbf e_2\\) land. Everything else follows along. Drag the column tips, or slide from before to after.",
  tryIt: "Pick Reflection: the flag flips and det A turns negative.",
  state: { a: 1.2, b: 0.6, c: 0.2, d: 1.1, t: 1 },
  controls: [
    { k: "A", type: "matrix", keys: ["a", "b", "c", "d"], names: ["a (row 1, column 1)", "b (row 1, column 2)", "c (row 2, column 1)", "d (row 2, column 2)"], min: -2, max: 2, step: .1, t: "t",
      label: "<i>A</i> =", hint: "column 1 is where e₁ lands, column 2 where e₂ lands" },
    { k: "t", label: "before → after", min: 0, max: 1, step: .01, fmt: v => vzNum(v * 100, 0) + "%", play: .45, aria: "before to after" },
  ],
  presets: [["Identity", { a: 1, b: 0, c: 0, d: 1 }], ["Shear", { a: 1, b: 1, c: 0, d: 1 }], ["Rotate 45°", { a: Math.SQRT1_2, b: -Math.SQRT1_2, c: Math.SQRT1_2, d: Math.SQRT1_2 }],
            ["Reflection", { a: 1, b: 0, c: 0, d: -1 }], ["Stretch", { a: 1.8, b: 0, c: 0, d: .6 }], ["Squash (det 0)", { a: 1, b: .5, c: 2, d: 1 }]],
  handles(s) { return s.t < .999 ? [] : [{ k: "e1", x: 300 + 58 * s.a, y: 240 - 58 * s.c }, { k: "e2", x: 300 + 58 * s.b, y: 240 - 58 * s.d }]; },
  dragTo(s, k, x, y, fine) {
    const q = fine ? v => v : v => vzSnap(v, .05);
    const p = [vzClamp(q((x - 300) / 58), -2, 2), vzClamp(q((240 - y) / 58), -2, 2)];
    if (k === "e1") { s.a = p[0]; s.c = p[1]; } else { s.b = p[0]; s.d = p[1]; }
  },
  draw(s, t, thumb) {
    const tt = s.t == null ? 1 : s.t, A = { a: 1 + (s.a - 1) * tt, b: s.b * tt, c: s.c * tt, d: 1 + (s.d - 1) * tt };   // (1 − t) I + t A
    const P = vzPlane(300, 240, 58), M = (x, y) => [A.a * x + A.b * y, A.c * x + A.d * y], det = A.a * A.d - A.b * A.c;
    let g = "";
    for (let k = -9; k <= 9; k++) {
      const e1 = M(1, 0), e2 = M(0, 1);
      g += P.line(M(k, 0), e2, `stroke="${VZ.grey}" stroke-opacity="${k ? .3 : .6}" stroke-width="${k ? 1 : 1.4}"`);
      g += P.line(M(0, k), e1, `stroke="${VZ.grey}" stroke-opacity="${k ? .3 : .6}" stroke-width="${k ? 1 : 1.4}"`);
    }
    const sq = [[0, 0], M(1, 0), M(1, 1), M(0, 1)], flip = det < -1e-9, flat = Math.abs(det) < 0.02;
    let o = P.axes(.12) + g;
    o += P.poly(sq, `fill="${flip ? VZ.gold : VZ.red}" fill-opacity="${flat ? 0 : .14}" stroke="${flip ? VZ.gold : VZ.red}" stroke-width="${flat ? 3 : 1.4}" stroke-opacity=".8" stroke-linejoin="round"`);
    // an asymmetric flag shows orientation
    const flag = [[.2, .15], [.2, .85], [.62, .85], [.62, .68], [.36, .68], [.36, .15]].map(p => M(p[0], p[1]));
    o += P.poly(flag, `fill="${VZ.ink}" fill-opacity=".55" stroke="none"`);
    const e1 = M(1, 0), e2 = M(0, 1);
    if (!thumb && tt >= .999) o += vzGrip(P.X(e1[0]), P.Y(e1[1]), VZ.red, VzView.hot === "e1") + vzGrip(P.X(e2[0]), P.Y(e2[1]), VZ.ink, VzView.hot === "e2");
    o += P.arrow([0, 0], e1, "R", 3) + P.arrow([0, 0], e2, "I", 3) + P.dot([0, 0], 3.6);
    // before: e₁, e₂; after: Ae₁, Ae₂ (one set fades out, then the other fades in)
    const nb = vzClamp((.45 - tt) / .2, 0, 1), na = vzClamp((tt - .55) / .2, 0, 1);
    if (nb > .01) o += `<g opacity="${q2(nb)}">${vzTipLabels(P, [{ v: e1, html: vzB("e", "1"), col: VZ.red }, { v: e2, html: vzB("e", "2"), col: VZ.ink }])}</g>`;
    if (na > .01) o += `<g opacity="${q2(na)}">${vzTipLabels(P, [{ v: e1, html: "A" + vzB("e", "1"), col: VZ.red }, { v: e2, html: "A" + vzB("e", "2"), col: VZ.ink }])}</g>`;
    // (the item whose text can change goes last, so nothing in the key shifts sideways mid-play)
    o += vzKey([["fill", VZ.ink, "a flag, to show which way round"], ["fill", flip ? VZ.gold : VZ.red, flip ? "the unit square's image, flipped" : "the unit square's image"]]);
    return o;
  },
  readout(s) {
    const det = s.a * s.d - s.b * s.c;
    const msg = Math.abs(det) < 0.02 ? "det A = 0: squashed flat, not invertible."
      : det < 0 ? `Areas scale by |det A| = ${vzNum(-det)}, and the flag is mirrored.`
      : `Areas scale by det A = ${vzNum(det)}; the flag keeps its way round.`;
    return `<div class="vz-eq">A<b>e</b>₁ = ${vzVec([s.a, s.c].map(x => Math.round(x * 1000) / 1000))}, A<b>e</b>₂ = ${vzVec([s.b, s.d].map(x => Math.round(x * 1000) / 1000))}</div>
      <div class="vz-eq">det A = ad − bc = <b>${vzNum(det)}</b></div>
      <div class="vz-status ${Math.abs(det) < 0.02 ? "warn" : "ok"}">${msg}</div>`;
  },
});

/* ---------- 3. Two equations, two lines (Lecture 4) ----------
   The same system read two ways. Row picture: each equation is a line and the solution is where they meet.
   Column picture: Ax = b asks which amounts x, y of the two columns of A add up to b; the arrows walk x a₁ then
   y a₂ and land on b. Switching views cross-fades, so the same numbers are seen to answer both questions. */
vzAdd({
  id: "systems", group: "More linear algebra", title: "Solving a 2×2 system",
  blurb: "Each equation is a line; a solution is a point on both. Read by columns instead, \\(A\\mathbf x=\\mathbf b\\) asks for the amounts \\(x, y\\) of the columns \\(\\mathbf a_1, \\mathbf a_2\\) of \\(A\\) with \\(x\\,\\mathbf a_1+y\\,\\mathbf a_2=\\mathbf b\\). One solution, none, or infinitely many, either way.",
  tryIt: "Make the lines parallel, then switch to columns.",
  state: { t1: 30, c1: 1.2, t2: 115, c2: 0.8, vw: 0 },
  controls: [
    { k: "t1", label: "tilt of line 1", min: 0, max: 180, step: 1, unit: "°", digits: 0 },
    { k: "c1", label: "shift of line 1", min: -3, max: 3, step: 0.05, noPlay: true },
    { k: "t2", label: "tilt of line 2", min: 0, max: 180, step: 1, unit: "°", digits: 0 },
    { k: "c2", label: "shift of line 2", min: -3, max: 3, step: 0.05, noPlay: true },
  ],
  presets: [["One solution", { t1: 30, c1: 1.2, t2: 115, c2: .8 }], ["Nearly parallel", { t1: 30, c1: 1.2, t2: 36, c2: 1.5 }],
            ["No solution", { t1: 40, c1: 1.2, t2: 40, c2: -1 }], ["Same line", { t1: 40, c1: 1.2, t2: 40, c2: 1.2 }]],
  panelTop() { return `<div><div class="vz-ptop-k">Read the system as</div><div class="vz-chips"><button type="button" class="vz-chip" data-sv="0">Rows: two lines</button><button type="button" class="vz-chip" data-sv="1">Columns: x a₁ + y a₂ = b</button></div></div>`; },
  sync(s, panel) { panel && panel.querySelectorAll("[data-sv]").forEach(b => b.classList.toggle("on", +b.dataset.sv === (s.vw > .5 ? 1 : 0))); },
  onClick(el, s) { const b = el.closest("[data-sv]"); if (!b) return false; vzTweenTo({ vw: +b.dataset.sv }, 700); return true; },
  solve(s) {
    const n1 = [-Math.sin(vzRad(s.t1)), Math.cos(vzRad(s.t1))], n2 = [-Math.sin(vzRad(s.t2)), Math.cos(vzRad(s.t2))];   // normals: line i runs at angle tᵢ
    const det = n1[0] * n2[1] - n1[1] * n2[0];
    if (Math.abs(det) > 1e-3) return { n1, n2, det, kind: "one", p: [(s.c1 * n2[1] - s.c2 * n1[1]) / det, (n1[0] * s.c2 - n2[0] * s.c1) / det] };
    const same = n1[0] * n2[0] + n1[1] * n2[1] > 0 ? Math.abs(s.c1 - s.c2) < 0.03 : Math.abs(s.c1 + s.c2) < 0.03;
    return { n1, n2, det, kind: same ? "many" : "none" };
  },
  draw(s) {
    const r = this.solve(s), vw = vzClamp(s.vw || 0, 0, 1), e = vzEase(vw);
    let o = "";
    if (e < .999) o += `<g opacity="${q2(1 - e)}">${this.rows(s, r)}</g>`;
    if (e > .001) o += `<g opacity="${q2(e)}">${this.cols(s, r)}</g>`;
    return o;
  },
  // the row picture: two lines and the point on both
  rows(s, r) {
    const P = vzPlane(300, 225, 50);
    const on = (n, c) => [n[0] * c, n[1] * c], dir = n => [-n[1], n[0]];
    let o = P.axes();
    o += P.line(on(r.n1, s.c1), dir(r.n1), `stroke="${VZ.red}" stroke-width="3" stroke-linecap="round"`);
    o += P.line(on(r.n2, s.c2), dir(r.n2), `stroke="${VZ.ink}" stroke-width="${r.kind === "many" ? 1.4 : 3}" stroke-linecap="round" ${r.kind === "many" ? 'stroke-dasharray="8 7"' : ""}`);
    if (r.kind === "one") {
      // the point and its coordinates fade as the point nears the edge (lines turning parallel send it away), never pop
      const p = r.p, X = P.X(p[0]), Y = P.Y(p[1]), fade = vzClamp(Math.min(X - 10, 590 - X, Y - 10, 440 - Y) / 30, 0, 1), inView = fade > .01;
      if (inView) {
        // the coordinates go at the nearest spot where the whole label clears both lines (and the legend)
        const txt = `(${vzNum(p[0])}, ${vzNum(p[1])})`, hw = txt.length * 4.3 + 6, hh = 12;
        const lines = [r.n1, r.n2].map(n => { const d = dir(n); return [d[0], -d[1]]; });
        const clear = (cx, cy) => Math.min(...lines.map(([dx, dy]) => {
          const ds = [[-hw, -hh], [hw, -hh], [hw, hh], [-hw, hh]].map(([ox, oy]) => (cx + ox - X) * dy - (cy + oy - Y) * dx);
          return Math.min(...ds) > 0 || Math.max(...ds) < 0 ? Math.min(...ds.map(Math.abs)) : 0;
        }));
        let best = [X + 60, Y - 26], bs = -1e9;
        for (let R = 26; R <= 120; R += 8) for (let k = 0; k < 24; k++) {
          const an = k * Math.PI / 12, cx = X + Math.cos(an) * R * 1.5, cy = Y - Math.sin(an) * R;
          if (cx - hw < 8 || cx + hw > 592 || cy - hh < 8 || cy + hh > 442 || (cx - hw < 200 && cy + hh > 400)) continue;
          const c = clear(cx, cy), sc = Math.min(c, 10) * 10 - R * .6 + Math.sin(an) * 3 + Math.cos(an);
          if (sc > bs) { bs = sc; best = [cx, cy]; }
        }
        o += `<g opacity="${q2(fade)}"><circle cx="${q2(X)}" cy="${q2(Y)}" r="12" fill="${VZ.red}" opacity=".14"/>` + P.dot(p, 5.5, VZ.deep) +
          vzLabel(best[0], best[1] + 5, txt, VZ.deep, 16) + `</g>`;
      }
    }
    if (s.vw <= .5) o += vzKey([["line", VZ.red, "line 1"], ["line", VZ.ink, "line 2"]]);
    return o;
  },
  // the column picture: walk x a₁, then y a₂, and land on b
  cols(s, r) {
    const P = vzPlane(300, 225, 70), a1 = [r.n1[0], r.n2[0]], a2 = [r.n1[1], r.n2[1]], b = [s.c1, s.c2], add = (u, v) => [u[0] + v[0], u[1] + v[1]];
    const mul = (k, u) => [k * u[0], k * u[1]];
    let o = P.axes();
    // the grid of all combinations x a₁ + y a₂ (it collapses, and fades, as the columns line up)
    const gd = Math.min(1, Math.abs(r.det) * 3);
    if (gd > .03) {
      let g = ""; for (let k = -8; k <= 8; k++) if (k) g += P.line(mul(k, a1), a2, "") + P.line(mul(k, a2), a1, "");
      o += `<g stroke="${VZ.ink}" stroke-opacity="${q2(.09 * gd)}" stroke-width="1">${g}</g>`;
    }
    o += P.line([0, 0], a1, `stroke="${VZ.gold}" stroke-width="1.4" stroke-dasharray="6 6" opacity=".7"`);
    o += P.line([0, 0], a2, `stroke="${VZ.ink}" stroke-width="1.4" stroke-dasharray="6 6" opacity=".45"`);
    if (r.kind === "one") {
      const [x, y] = r.p, A = mul(x, a1), B2 = mul(y, a2);
      // the other way round the parallelogram, faint: y a₂ first, then x a₁
      o += P.path([[0, 0], B2, b], `stroke="${VZ.grey}" stroke-width="1.3" stroke-dasharray="4 5" opacity=".7"`);
      o += P.arrow([0, 0], A, "O", 3.2) + P.arrow(A, b, "I", 3.2);
      // each leg's amount, beside the middle of the leg, on the side away from the other leg
      const leg = (p0, p1, html, col, away) => {
        const m = [(P.X(p0[0]) + P.X(p1[0])) / 2, (P.Y(p0[1]) + P.Y(p1[1])) / 2], dx = P.X(p1[0]) - P.X(p0[0]), dy = P.Y(p1[1]) - P.Y(p0[1]), L = Math.hypot(dx, dy);
        if (L < 26) return "";
        let nx = -dy / L, ny = dx / L; if (nx * (away[0] - m[0]) + ny * (away[1] - m[1]) > 0) { nx = -nx; ny = -ny; }
        const w = html.replace(/<[^>]+>/g, "").length * 4.6 + 8, off = 12 + Math.abs(nx) * w;
        const g = vzGlide("leg" + html, [m[0] + nx * off, m[1] + ny * off + 5]);
        return vzLabel(g[0], g[1], html, col, 15);
      };
      o += leg([0, 0], A, `${vzNum(x)} ${vzSub("a", "1")}`, "#7A5C0F", [P.X(B2[0]), P.Y(B2[1])]);
      o += leg(A, b, `${vzNum(y)} ${vzSub("a", "2")}`, VZ.ink, [P.X(0), P.Y(0)]);
    }
    o += P.arrow([0, 0], a1, "O", 1.8) + P.arrow([0, 0], a2, "I", 1.8);
    o += `<circle cx="${q2(P.X(b[0]))}" cy="${q2(P.Y(b[1]))}" r="11" fill="${VZ.red}" opacity=".14"/>` + P.dot(b, 5.5, VZ.deep);
    o += vzTipLabels(P, [{ v: a1, html: vzSub("a", "1"), col: "#7A5C0F" }, { v: a2, html: vzSub("a", "2"), col: VZ.ink }, { v: b, html: "<tspan font-weight=\"700\">b</tspan>", col: VZ.deep, gap: 16 }]);
    if (r.kind !== "one") o += vzNote(300, 30, r.kind === "none" ? "b is off the line of the columns: no solution" : "b is on the line of the columns: many solutions", "middle", VZ.deep);
    if (s.vw > .5) o += vzKey([["line", VZ.gold, "x times column 1"], ["line", VZ.ink, "y times column 2"], ["dot", VZ.deep, "b"]]);
    return o;
  },
  readout(s) {
    const r = this.solve(s), eq = (n, c) => `${vzNum(n[0])}x ${n[1] < 0 ? "−" : "+"} ${vzNum(Math.abs(n[1]))}y = ${vzNum(c)}`;
    const col = v => `<span class="vz-nw">[${v.map(x => vzNum(x)).join(", ")}]</span>`;
    const msg = r.kind === "one" ? `Exactly one solution: (x, y) = (${vzNum(r.p[0])}, ${vzNum(r.p[1])}).`
      : r.kind === "none" ? (s.vw > .5 ? "No amounts x, y reach b: no solution." : "Parallel lines never meet: no solution.")
      : s.vw > .5 ? "Many amounts x, y reach b: infinitely many solutions." : "The same line twice: infinitely many solutions.";
    const colEq = `x ${col([r.n1[0], r.n2[0]])} + y ${col([r.n1[1], r.n2[1]])} = ${col([s.c1, s.c2])}`;
    // the system the way the picture reads it: two equations (rows) or one vector equation (columns)
    return `${s.vw > .5 ? `<div class="vz-eq">${colEq}</div>` : `<div class="vz-eq"><span style="color:${VZ.red}">${eq(r.n1, s.c1)}</span><br>${eq(r.n2, s.c2)}</div>`}
      <div class="vz-eq">det of the coefficients = <b>${vzNum(r.det)}</b></div>
      <div class="vz-status ${r.kind === "one" ? "ok" : "warn"}">${msg}</div>`;
  },
});

/* ---------- Row operations keep the solution (Lectures 4–5) ----------
   Three equations in x, y, z are three planes, and a solution is a point on all three. A row operation
   Rᵢ → Rᵢ + kRⱼ swings plane i about the line where it meets plane j, so every point on both planes, the solution
   among them, stays put; scaling a row doesn't move its plane at all. Elimination ends with the planes x = a, y = b,
   z = c, square to the axes, where the solution can be read off. A dependent system ends with a row 0 = 0: that
   plane lands on another one and then fades away, leaving a line of solutions. */
const VZ_GAUSS = [
  // (the first view keeps every axis arrow out of the up-right spot where the solution's coordinates are written)
  { chip: "One solution", A: [[1, 1, 1], [2, -1, -1], [0, 1, -1]], b: [2, 1, 3], c0: [1, 2, -1], yaw: 120, el: .85,
    ops: [["add", 1, 0, -2], ["scale", 1, -1 / 3], ["add", 0, 1, -1], ["add", 2, 1, -1], ["scale", 2, -1 / 2], ["add", 1, 2, -1]],
    start: "Three planes, one point on all three.", end: "RREF: x = 1, y = 2, z = −1." },
  { chip: "A line of solutions", A: [[1, 1, 1], [1, 2, -1], [0, -1, 2]], b: [2, 1, 1], c0: [0, 1, 1], dir: [-3, 2, 1], yaw: -52, el: .4,
    ops: [["add", 1, 0, -1], ["add", 2, 1, 1], ["add", 0, 1, -1]],
    start: "Three planes through one line: all its points solve.", end: "0 = 0: z is free, a line of solutions." },
];
const VZ_GCOL = [VZ.red, "#B8892B", "#2F7A4A"], VZ_GTXT = [VZ.deep, "#7A5C0F", "#22603A"];
const vzSubN = i => "₁₂₃"[i];
// a scale factor as you would write it: ½, −⅓, ⅕, ⅔ (vzShort writes 0.5 and 0.2 as decimals)
const vzGlyph = v => { const a = Math.abs(v), g = [[1, 2, "½"], [1, 3, "⅓"], [2, 3, "⅔"], [1, 4, "¼"], [3, 4, "¾"], [1, 5, "⅕"], [1, 6, "⅙"], [1, 8, "⅛"]].find(([p, q]) => Math.abs(a * q - p) < 1e-9); return g ? (v < 0 ? "−" : "") + g[2] : vzShort(v); };
function vzGaussOp(op) {
  if (op[0] === "scale") return `R${vzSubN(op[1])} → ${vzGlyph(op[2])}R${vzSubN(op[1])}`;
  const k = op[3]; return `R${vzSubN(op[1])} → R${vzSubN(op[1])} ${k < 0 ? "−" : "+"} ${Math.abs(k) === 1 ? "" : vzShort(Math.abs(k))}R${vzSubN(op[2])}`;
}
// the rows after x operations (part way through the next one: x is continuous)
function vzGaussRows(G, x) {
  let M = G.A.map((r, i) => r.concat([G.b[i]]));
  const N = G.ops.length, K = Math.min(N, Math.floor(x + 1e-9)), fr = K < N ? x - K : 0;
  const sc = (c, t) => (t < .5 || c > 0 ? 1 : -1) * (1 + t * (Math.abs(c) - 1));   // never 0 on the way: the plane stays put
  const apply = (M, op, t) => { M = M.map(r => r.slice()); if (op[0] === "add") { const [, i, j, k] = op; M[i] = M[i].map((v, q) => v + t * k * M[j][q]); } else { const [, i, c] = op; M[i] = M[i].map(v => v * sc(c, t)); } return M; };
  for (let q = 0; q < K; q++) M = apply(M, G.ops[q], 1);
  const op = fr > 1e-6 ? G.ops[K] : null; if (op) M = apply(M, op, vzEase(fr));
  return { M, K, fr, op };
}
// an equation in x, y, z, written the way you would: 2x − y + z = 3, 0 = 0
function vzEqn(r) {
  const nm = ["x", "y", "z"]; let t = "";
  r.slice(0, 3).forEach((v, q) => { if (Math.abs(v) < 1e-9) return; const a = Math.abs(v), c = Math.abs(a - 1) < 1e-9 ? "" : vzShort(a); t += t ? (v < 0 ? " − " : " + ") + c + nm[q] : (v < 0 ? "−" : "") + c + nm[q]; });
  return (t || "0") + " = " + (Math.abs(r[3]) < 1e-9 ? "0" : (r[3] < 0 ? "−" : "") + vzShort(Math.abs(r[3])));
}
// the three planes as discs around the solution, the lines where they meet, and the solution itself; hi: the row
// being changed now. Discs fade as a row runs out (0 = 0 is every point: no plane left to draw).
function vzGaussScene(cam, M, G, hi = -1, opt = {}) {
  const pr = p => cam(p[0], p[1], p[2]), C0 = G.c0, R = opt.R || 1.75, P2 = q => q2(q[0]) + " " + q2(q[1]), who = opt.who || [0, 1, 2], GC = i => VZ_GCOL[who[i]], GT = i => VZ_GTXT[who[i]];
  const nrm = M.map(r => r.slice(0, 3)), unit = a => { const L = Math.hypot(...a) || 1; return a.map(x => x / L); };
  const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const disks = M.map((r, i) => {
    const L = Math.hypot(...nrm[i]); if (L < 1e-6) return null;
    const u = nrm[i].map(x => x / L), off = (vzDot(nrm[i], C0) - r[3]) / L, ctr = C0.map((x, q) => x - off * u[q]);
    const ref = Math.abs(u[0]) < .8 ? [1, 0, 0] : [0, 1, 0], e1 = unit(ref.map((x, q) => x - vzDot(ref, u) * u[q])), e2 = cross(u, e1);
    const pts = []; for (let k = 0; k < 48; k++) { const a = 2 * Math.PI * k / 48; pts.push(ctr.map((x, q) => x + R * (Math.cos(a) * e1[q] + Math.sin(a) * e2[q]))); }
    return { i, pts, ctr, dep: pr(ctr)[2], op: vzClamp(L / .35, 0, 1) };
  }).filter(Boolean);
  // a small frame of axis directions through the solution, so x = a, y = b, z = c read as square to them
  let o = "";
  const busy = [], lines = [];                          // spots and lines the planes' names keep away from
  [[1, 0, 0, "x"], [0, 1, 0, "y"], [0, 0, 1, "z"]].forEach(([a, b, c, nm]) => {
    const tip = [C0[0] + 1.25 * a, C0[1] + 1.25 * b, C0[2] + 1.25 * c], T = pr(tip), S = pr(C0), L = Math.hypot(T[0] - S[0], T[1] - S[1]) || 1;
    const at = [T[0] + (T[0] - S[0]) / L * 11, T[1] + (T[1] - S[1]) / L * 11];
    o += `<g opacity=".5">${vzArrow3(cam, C0, tip, "G", 1.3)}</g>` + vzLabel(at[0], at[1] + 5, nm, VZ.grey, 14);
    busy.push(at);
  });
  disks.slice().sort((a, b) => b.dep - a.dep).forEach(D => {
    const on = D.i === hi ? (opt.hiW == null ? 1 : opt.hiW) : 0;      // the row being changed: brighter, rising and falling with its operation
    o += `<path d="M${D.pts.map(p => P2(pr(p))).join("L")}Z" fill="${GC(D.i)}" fill-opacity="${q2((.13 + .09 * on) * D.op)}" stroke="none"/>`;
  });
  // the rims on top, so two planes that coincide both show: the later one dashed over the earlier
  disks.forEach(D => {
    const on = D.i === hi ? (opt.hiW == null ? 1 : opt.hiW) : 0, same = disks.some(E => E.i < D.i && Math.hypot(...E.ctr.map((x, q) => x - D.ctr[q])) < 1e-3 && Math.abs(Math.abs(vzDot(nrm[E.i], nrm[D.i])) / (Math.hypot(...nrm[E.i]) * Math.hypot(...nrm[D.i])) - 1) < 1e-6);
    o += `<path d="M${D.pts.map(p => P2(pr(p))).join("L")}Z" fill="none" stroke="${GC(D.i)}" stroke-opacity="${q2(.75 * D.op)}" stroke-width="${q2(1.5 + .9 * on)}" stroke-linejoin="round"${same ? ' stroke-dasharray="8 7"' : ""}/>`;
  });
  // where two planes meet: a line through the solution (fading as the two planes turn parallel)
  for (let i = 0; i < 3; i++) for (let j = i + 1; j < 3; j++) {
    const Li = Math.hypot(...nrm[i]), Lj = Math.hypot(...nrm[j]); if (Li < 1e-6 || Lj < 1e-6) continue;
    const d = cross(nrm[i], nrm[j]), sn = Math.hypot(...d) / (Li * Lj); if (sn < .02) continue;
    // the point of both planes nearest the middle of the picture: C0 + a nᵢ + b nⱼ
    const g11 = vzDot(nrm[i], nrm[i]), g12 = vzDot(nrm[i], nrm[j]), g22 = vzDot(nrm[j], nrm[j]), r1 = M[i][3] - vzDot(nrm[i], C0), r2 = M[j][3] - vzDot(nrm[j], C0), det = g11 * g22 - g12 * g12;
    const a = (r1 * g22 - r2 * g12) / det, b = (g11 * r2 - g12 * r1) / det, p = C0.map((x, q) => x + a * nrm[i][q] + b * nrm[j][q]), du = unit(d);
    const op = vzClamp((sn - .02) / .15, 0, 1) * Math.min(vzClamp(Li / .35, 0, 1), vzClamp(Lj / .35, 0, 1));
    o += `<g opacity="${q2(.55 * op)}">${vzPath3(cam, [p.map((x, q) => x - R * du[q]), p.map((x, q) => x + R * du[q])], `stroke="${VZ.ink}" stroke-width="1.3" stroke-dasharray="5 4"`)}</g>`;
  }
