  else if ((m = s.match(/^([-+]?)(\d*)\.?(\d*)$/)) && (m[2] || m[3])) { if (m[3].length > 3) return { err: "den" }; q = tdetQ(BigInt(m[1] + (m[2] || "0") + m[3]), 10n ** BigInt(m[3].length)); }
  else return { err: "nan" };
