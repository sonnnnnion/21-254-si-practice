const tdetStore = q => tdetTxt(q).replace("−", "-");
// a fresh small example: integers, a few zeros, a modest determinant (or, asked for, a dependent row)
function tdetRandom(n, sing, cur) {
  const r = (a, b) => a + Math.floor(Math.random() * (b - a + 1));
  for (let t = 0; t < 600; t++) {
    let M;
    if (sing && n === 2) {
      const a = r(-4, 4), b = r(-4, 4), k = [2, -2, 3, -1][r(0, 3)];
      if (!a && !b) continue;
      M = r(0, 1) ? [a, b, k * a, k * b] : [a, k * a, b, k * b];
    } else if (sing) {
      const R1 = [0, 0, 0].map(() => r(-3, 4)), R2 = [0, 0, 0].map(() => r(-3, 4)), p = [1, 2, -1][r(0, 2)], q = [1, -1, 2][r(0, 2)];
      const R3 = R1.map((v, i) => p * v + q * R2[i]);
      if (R3.some(v => Math.abs(v) > 12) || R1.every(v => !v) || R2.every(v => !v)) continue;
      const rows = [R1, R2]; rows.splice(r(0, 2), 0, R3); M = rows.flat();
    } else {
