  // a formula as a nested svg whose baseline sits at (x, y); anchor "end" right-aligns it at x
  function texSvg(key, em, x = 378, y = 43, anchor = "end") {
    const f = HERO_TEX[key], s = em / 1000, w = f.vb[2] * s, h = f.vb[3] * s;
    return '<svg x="' + n2(anchor === "end" ? x - w : anchor === "middle" ? x - w / 2 : x) + '" y="' + n2(y + f.vb[1] * s) +
      '" width="' + n2(w) + '" height="' + n2(h) + '" viewBox="' + f.vb.join(" ") + '" overflow="visible" color="' + INK + '" aria-hidden="true">' + f.g + '</svg>';
  }
  { // the original circulation picture ships its formula as plain text; swap in the typeset one
    const f0 = svg.querySelector('text.hero-grad-label[y="46"]');
    if (f0) { f0.insertAdjacentHTML("afterend", '<g class="hero-grad-label">' + texSvg("circ", 23) + '</g>'); f0.remove(); }
  }

  /* ---------- shared frame: grid paper, arrowheads, labels ---------- */
  function defs(extra) {
    const mk = (id, fill, w, op) => '<marker id="' + id + '" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="' + w +
      '" markerHeight="' + w + '" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="' + fill + '"' + (op ? ' opacity="' + op + '"' : "") + '/></marker>';
    return '<defs><pattern id="hx-grid" width="32" height="32" patternUnits="userSpaceOnUse">' +
      '<path d="M32 0L0 0 0 32" fill="none" stroke="' + INK + '" stroke-width=".35" opacity=".18"/></pattern>' +
      '<clipPath id="hx-clip"><rect width="400" height="360" rx="20"/></clipPath>' +
      mk("hx-arrR", RED, 4.6) + mk("hx-arrD", DEEP, 4.6) + mk("hx-arrI", INK, 4.6) + mk("hx-arrM", GREY, 5, .85) +
      '<radialGradient id="hx-lg"><stop offset=".42" stop-color="#000"/><stop offset="1" stop-color="#fff"/></radialGradient>' +
      '<mask id="hx-quiet" maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="360"><rect width="400" height="360" fill="#fff"/>' +
      '<ellipse cx="302" cy="48" rx="124" ry="40" fill="url(#hx-lg)"/><ellipse cx="92" cy="342" rx="118" ry="26" fill="url(#hx-lg)"/></mask>' +
      (extra || "") + '</defs><rect width="400" height="360" rx="20" fill="url(#hx-grid)"/>';
  }
  function labels(formula, sub, caption, em) {
    return '<g data-k="labels" opacity="0">' + texSvg(formula, em || 23) +
      '<text x="378" y="67" text-anchor="end" font-family="\'Manrope\', sans-serif" font-size="11" font-weight="500" fill="' + SUB + '">' + sub + '</text>' +
      '<text x="22" y="346" font-family="\'Manrope\', sans-serif" font-size="11" font-weight="500" fill="' + SUB + '" data-k="caption">' + caption + '</text></g>';
  }
  const introLabels = t => smooth(1.0, 1.5, t);
  const setText = (el, s) => { if (el._txt !== s) { el._txt = s; el.textContent = s; } };
  // Frames set most attributes to the value they already have; only real changes reach the DOM
  const setAttr0 = Element.prototype.setAttribute;
  function quiet(el) { const last = {}; el.setAttribute = function (n, v) { v = String(v); if (last[n] !== v) { last[n] = v; setAttr0.call(this, n, v); } }; }
  const faint = (t, a, b) => .3 + .7 * smooth(a, b, t);   // intro: visible (faint) from the very first frame
  const it = s => '<tspan font-style="italic">' + s + '</tspan>';
  const bold = s => '<tspan font-weight="700" font-style="italic">' + s + '</tspan>';
  function arrowLine(k, color, marker, w) {
    return '<line data-k="' + k + '" stroke="' + color + '" stroke-width="' + w + '" stroke-linecap="round" marker-end="url(#' + marker + ')"/>';
  }
  function setLine(el, x1, y1, x2, y2) {
    el.setAttribute("x1", n2(x1)); el.setAttribute("y1", n2(y1)); el.setAttribute("x2", n2(x2)); el.setAttribute("y2", n2(y2));
  }
  // a comet-style marker like the circulation picture's particle
  const particle = k => '<g data-k="' + k + '"><circle r="10" fill="' + RED + '" opacity=".16"/><circle r="5.2" fill="' + RED + '" stroke="#FFFFFF" stroke-width="1.4"/></g>';

  /* ---------- 1. Linear map: the whole grid moves ---------- */
  const linearMap = {
    label: "A linear map reshaping the grid: the unit square becomes a parallelogram whose area is det A",
    poster: 5.4,
    build() {
      return defs() +
        '<g clip-path="url(#hx-clip)"><g mask="url(#hx-quiet)">' +
          '<path data-k="grid" fill="none" stroke="' + GREY + '" stroke-width="1" opacity="0"/>' +
          '<path data-k="axes" fill="none" stroke="' + INK + '" stroke-width="1.3" opacity="0"/></g>' +
          '<path data-k="square" fill="' + RED + '" fill-opacity=".09" stroke="' + RED + '" stroke-opacity=".55" stroke-width="1.3" stroke-linejoin="round" opacity="0"/>' +
        '</g>' +
        arrowLine("e1", RED, "hx-arrR", 3) + arrowLine("e2", INK, "hx-arrI", 3) +
        '<circle data-k="o" cx="158" cy="238" r="3.4" fill="' + INK + '" opacity="0"/>' +
        '<text data-k="l1" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + RED + '" text-anchor="middle" opacity="0">' + it("A") + bold("e") + '<tspan baseline-shift="sub" font-size="10">1</tspan></text>' +
        '<text data-k="l2" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + INK + '" text-anchor="middle" opacity="0">' + it("A") + bold("e") + '<tspan baseline-shift="sub" font-size="10">2</tspan></text>' +
        labels("linear",
               "a linear map moves the whole grid", "det A = 1.00 · how much areas scale");
    },
    // I -> A (shear + stretch) -> B (turn + shrink) -> I, with rests between
    M: [[1, 0, 0, 1], [1.4, 0.7, 0.2, 1.1], [0.8, -0.6, 0.5, 0.75], [1, 0, 0, 1]],
    seg: [[1.3, 1.9], [1.4, 1.9], [1.4, 1.7]],          // [rest, move] per step
    matrixAt(t) {
      let u = Math.max(0, t - 1.2); const total = this.seg.reduce((s, [r, m]) => s + r + m, 0);
      u %= total;
      for (let i = 0; i < this.seg.length; i++) {
        const [r, m] = this.seg[i];
        if (u < r) return this.M[i];
        if (u < r + m) { const e = ease((u - r) / m), a = this.M[i], b = this.M[i + 1]; return a.map((v, j) => v + (b[j] - v) * e); }
        u -= r + m;
      }
      return this.M[0];
    },
    frame(t, k) {
      const O = [158, 238], U = 56, M = this.matrixAt(t);
      const grow = ease(smooth(0.15, 0.95, t));
      const X = (x, y) => [O[0] + U * (M[0] * x + M[1] * y), O[1] - U * (M[2] * x + M[3] * y)];
      let g = "";
      for (let i = -6; i <= 8; i++) { if (i) { const a = X(i, -7), b = X(i, 7); g += "M" + P(a[0], a[1]) + "L" + P(b[0], b[1]); } }
      for (let j = -7; j <= 7; j++) { if (j) { const a = X(-7, j), b = X(9, j); g += "M" + P(a[0], a[1]) + "L" + P(b[0], b[1]); } }
      k.grid.setAttribute("d", g); k.grid.setAttribute("opacity", n2(.26 * faint(t, 0, .55)));
      const xa = X(-7, 0), xb = X(9, 0), ya = X(0, -7), yb = X(0, 7);
      k.axes.setAttribute("d", "M" + P(xa[0], xa[1]) + "L" + P(xb[0], xb[1]) + "M" + P(ya[0], ya[1]) + "L" + P(yb[0], yb[1]));
      k.axes.setAttribute("opacity", n2(.42 * faint(t, 0, .55)));
      const c1 = X(1, 0), c2 = X(1, 1), c3 = X(0, 1);
      k.square.setAttribute("d", "M" + P(O[0], O[1]) + "L" + P(c1[0], c1[1]) + "L" + P(c2[0], c2[1]) + "L" + P(c3[0], c3[1]) + "Z");
      k.square.setAttribute("opacity", n2(faint(t, .25, .8)));
      const e1 = [O[0] + (c1[0] - O[0]) * grow, O[1] + (c1[1] - O[1]) * grow], e2 = [O[0] + (c3[0] - O[0]) * grow, O[1] + (c3[1] - O[1]) * grow];
      setLine(k.e1, O[0], O[1], e1[0], e1[1]); setLine(k.e2, O[0], O[1], e2[0], e2[1]);
      k.e1.setAttribute("opacity", n2(smooth(.3, .6, grow))); k.e2.setAttribute("opacity", n2(smooth(.3, .6, grow)));
      k.o.setAttribute("opacity", n2(faint(t, 0, .4)));
      // tip labels sit just beyond each arrow, pushed away from the other vector
      const place = (el, tip, other) => {
        let dx = tip[0] - O[0], dy = tip[1] - O[1]; const L = Math.hypot(dx, dy) || 1; dx /= L; dy /= L;
        let px = -dy, py = dx; if ((other[0] - O[0]) * px + (other[1] - O[1]) * py > 0) { px = -px; py = -py; }
        el.setAttribute("x", n2(tip[0] + dx * 21 + px * 12)); el.setAttribute("y", n2(tip[1] + dy * 21 + py * 12 + 5));
        el.setAttribute("opacity", n2(smooth(.8, 1.2, t)));
      };
      place(k.l1, c1, c3); place(k.l2, c3, c1);
      setText(k.caption, "det A = " + (M[0] * M[3] - M[1] * M[2]).toFixed(2) + " · how much areas scale");
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 2. Eigenvectors: A v lines up with v ---------- */
  const eigen = {
    label: "A vector v sweeping the unit circle while Av traces an ellipse; along the eigenvector lines Av is a multiple of v",
    poster: 3.35,
    C: [200, 192], R: 60,
    A: [1.5, 0.7, 0.7, 1.5],                        // eigenvalues 2.2 on (1,1), 0.8 on (1,-1)
    build() {
      const [cx, cy] = this.C, R = this.R, A = this.A;
      let ticks = "";
      for (let i = 0; i < 36; i++) {
        const a = TAU * i / 36, x = Math.cos(a), y = Math.sin(a);
        const ax = A[0] * x + A[1] * y, ay = A[2] * x + A[3] * y;
        ticks += "M" + P(cx + R * x, cy - R * y) + "L" + P(cx + R * ax, cy - R * ay);
      }
      const eline = (k, dx, dy) => '<line data-k="' + k + '" x1="' + n2(cx - 158 * dx) + '" y1="' + n2(cy + 158 * dy) + '" x2="' + n2(cx + 158 * dx) +
        '" y2="' + n2(cy - 158 * dy) + '" stroke="' + GREY + '" stroke-width="2" stroke-linecap="round" stroke-dasharray=".01 6" opacity="0"/>';
      const s = Math.SQRT1_2;
      return defs() +
        '<path data-k="ticks" d="' + ticks + '" fill="none" stroke="' + GREY + '" stroke-width="1" opacity="0"/>' +
        eline("d1", s, s) + eline("d2", s, -s) +
        '<circle data-k="circle" cx="' + cx + '" cy="' + cy + '" r="' + R + '" fill="none" stroke="' + GREY + '" stroke-width="1.4" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" opacity=".7"/>' +
        '<ellipse data-k="ell" cx="' + cx + '" cy="' + cy + '" rx="' + n2(2.2 * R) + '" ry="' + n2(0.8 * R) + '" transform="rotate(-45 ' + cx + ' ' + cy + ')" fill="' + RED +
          '" fill-opacity="0" stroke="' + RED + '" stroke-opacity=".5" stroke-width="1.6" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"/>' +
        arrowLine("v", INK, "hx-arrI", 2.4) + arrowLine("av", RED, "hx-arrR", 3) +
        '<circle cx="' + cx + '" cy="' + cy + '" r="3.4" fill="' + INK + '" data-k="o" opacity="0"/>' +
        '<text data-k="lv" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + INK + '" text-anchor="middle" opacity="0">' + bold("v") + '</text>' +
        '<text data-k="lav" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + RED + '" text-anchor="middle" opacity="0">' + it("A") + bold("v") + '</text>' +
        '<g data-k="lam" opacity="0"><rect data-k="lamBg" rx="9" height="18" fill="#FFFFFF" stroke="' + RED + '" stroke-opacity=".35"/>' +
          '<text data-k="lamT" font-family="\'Manrope\', sans-serif" font-size="11" font-weight="700" fill="' + DEEP + '" text-anchor="middle"></text></g>' +
        labels("eigen",
               "eigenvectors keep their direction", "the unit circle and its image under A");
    },
    frame(t, k) {
      const [cx, cy] = this.C, R = this.R, A = this.A;
      // v sweeps counterclockwise, easing to a near-stop at each eigen-direction
      const w = TAU / 16, u = w * Math.max(0, t - .6) + .38;
      const th = u - .2 * Math.sin(4 * (u - Math.PI / 4));
      const grow = ease(smooth(.2, 1.0, t));
      const vx = Math.cos(th), vy = Math.sin(th), ax = A[0] * vx + A[1] * vy, ay = A[2] * vx + A[3] * vy;
      setLine(k.v, cx, cy, cx + R * vx * grow, cy - R * vy * grow);
      setLine(k.av, cx, cy, cx + R * ax * grow, cy - R * ay * grow);
      const vis = smooth(.1, .32, grow);                 // fade in with length: no bare arrowheads at the origin
      k.v.setAttribute("opacity", n2(vis)); k.av.setAttribute("opacity", n2(vis));
      k.circle.setAttribute("stroke-dashoffset", n2(100 * (1 - ease(smooth(0, .8, t)))));
      k.ell.setAttribute("stroke-dashoffset", n2(100 * (1 - ease(smooth(.25, 1.1, t)))));
      k.ell.setAttribute("fill-opacity", n2(.045 * smooth(.7, 1.2, t)));
      k.ticks.setAttribute("opacity", n2(.2 * faint(t, .3, .9)));
      k.o.setAttribute("opacity", n2(faint(t, 0, .4)));
      // how closely v sits on each eigenline
      const s = Math.SQRT1_2, c1 = Math.abs(vx * s + vy * s), c2 = Math.abs(vx * s - vy * s);
      const a1 = smooth(.992, .9998, c1) * smooth(1.1, 1.4, t), a2 = smooth(.992, .9998, c2) * smooth(1.1, 1.4, t);
      k.d1.setAttribute("stroke", a1 > .02 ? RED : GREY); k.d2.setAttribute("stroke", a2 > .02 ? RED : GREY);
      k.d1.setAttribute("opacity", n2((.32 + .5 * a1) * faint(t, .3, .9))); k.d2.setAttribute("opacity", n2((.32 + .5 * a2) * faint(t, .3, .9)));
      // labels ride just past each tip; as v and Av line up they slide to the upper side of the
      // shared line, so neither sits on the other arrow (the lambda pill takes the lower side)
      const a = Math.max(a1, a2), lam = a1 >= a2 ? "2.2" : "0.8";
      const tipLabel = (el, x, y, off) => {
        const L = Math.hypot(x, y) || 1, ux = x / L, uy = -y / L;
        let px = -uy, py = ux; if (py > 0) { px = -px; py = -py; }
        el.setAttribute("x", n2(cx + R * x + ux * off * (1 - .9 * a) + px * 19 * a));
        el.setAttribute("y", n2(cy - R * y + uy * off * (1 - .9 * a) + py * 19 * a + 5));
      };
      tipLabel(k.lv, vx, vy, 17); tipLabel(k.lav, ax, ay, 20);
      const sep = Math.hypot(R * (ax - vx), R * (ay - vy));          // v's label would crowd Av's when the tips are close
      k.lv.setAttribute("opacity", n2(smooth(.8, 1.2, t) * smooth(18, 34, sep)));
      k.lav.setAttribute("opacity", n2(smooth(.8, 1.2, t)));
      if (a > .001) {
        setText(k.lamT, "λ = " + lam);
        const L = Math.hypot(ax, ay), ux = ax / L, uy = -ay / L;          // screen direction of Av
        let px = -uy, py = ux; if (py < 0) { px = -px; py = -py; }         // the side facing down the page
        const bx = cx + R * ax + ux * 12 + px * 30, by = cy - R * ay + uy * 12 + py * 30;
        k.lamT.setAttribute("x", n2(bx)); k.lamT.setAttribute("y", n2(by + 4));
        k.lamBg.setAttribute("x", n2(bx - 27)); k.lamBg.setAttribute("y", n2(by - 9)); k.lamBg.setAttribute("width", 54);
      }
      k.lam.setAttribute("opacity", n2(a));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 3. Gradient ascent on a contour map ---------- */
  const ascent = {
    label: "Level curves of a function with two hills; a point climbs along the gradient, crossing each level curve at a right angle",
    poster: 3.1,
    // [x, y, height, spread along the long axis, spread across it, tilt]: the big hill is a long
    // tilted ridge, so a climber crosses it steeply and then curves along it to the top
    peaks: [[262, 146, 1, 100, 40, .5], [116, 242, .64, 54, 54, 0]],
    f(x, y) {
      let v = 0;
      for (const [px, py, h, sa, sb, an] of this.peaks) {
        const c = Math.cos(an), s = Math.sin(an), u = (x - px) * c + (y - py) * s, w = (y - py) * c - (x - px) * s;
        v += h * Math.exp(-(u * u / (2 * sa * sa) + w * w / (2 * sb * sb)));
      }
      return v;
    },
    grad(x, y) {
      let gx = 0, gy = 0;
      for (const [px, py, h, sa, sb, an] of this.peaks) {
        const c = Math.cos(an), s = Math.sin(an), u = (x - px) * c + (y - py) * s, w = (y - py) * c - (x - px) * s;
        const e = h * Math.exp(-(u * u / (2 * sa * sa) + w * w / (2 * sb * sb))), du = -u / (sa * sa) * e, dw = -w / (sb * sb) * e;
        gx += du * c - dw * s; gy += du * s + dw * c;
      }
      return [gx, gy];
    },
    contours() {
      const st = 4, nx = 100, ny = 90, F = [];
      for (let j = 0; j <= ny; j++) { const row = []; for (let i = 0; i <= nx; i++) row.push(this.f(i * st, j * st)); F.push(row); }
      const levels = [.08, .16, .25, .34, .43, .52, .61, .7, .79, .88];
      return levels.map(L => {
        let d = "";
        const lerp = (a, b, va, vb) => a + (b - a) * (L - va) / (vb - va);
        for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
          const v0 = F[j][i], v1 = F[j][i + 1], v2 = F[j + 1][i + 1], v3 = F[j + 1][i];
          const x0 = i * st, y0 = j * st, pts = [];
          if ((v0 < L) !== (v1 < L)) pts.push([lerp(x0, x0 + st, v0, v1), y0]);
          if ((v1 < L) !== (v2 < L)) pts.push([x0 + st, lerp(y0, y0 + st, v1, v2)]);
          if ((v3 < L) !== (v2 < L)) pts.push([lerp(x0, x0 + st, v3, v2), y0 + st]);
          if ((v0 < L) !== (v3 < L)) pts.push([x0, lerp(y0, y0 + st, v0, v3)]);
          if (pts.length === 2) d += "M" + P(pts[0][0], pts[0][1]) + "L" + P(pts[1][0], pts[1][1]);
          else if (pts.length === 4) d += "M" + P(pts[0][0], pts[0][1]) + "L" + P(pts[1][0], pts[1][1]) + "M" + P(pts[2][0], pts[2][1]) + "L" + P(pts[3][0], pts[3][1]);
        }
        return { L, d };
      });
    },
    path(x, y) {                                     // steepest-ascent path to the top
      // 1.5px steps; a step that would overshoot the hilltop (f stops increasing) is halved,
      // so the point settles onto the peak instead of zigzagging across it
      const pts = [[x, y]];
      let h = 1.5, fv = this.f(x, y);
      for (let n = 0; n < 1200 && h > .02; n++) {
        const [gx, gy] = this.grad(x, y), g = Math.hypot(gx, gy);
        if (g < 1e-7) break;
        const nx = x + h * gx / g, ny = y + h * gy / g, nf = this.f(nx, ny);
        if (nf <= fv) { h /= 2; continue; }
        x = nx; y = ny; fv = nf; pts.push([x, y]);
      }
      for (let i = 2; i < pts.length; i++) {         // end at the first backtrack (sub-pixel, right at the top)
        const a = pts[i - 2], b = pts[i - 1], c = pts[i];
        if ((b[0] - a[0]) * (c[0] - b[0]) + (b[1] - a[1]) * (c[1] - b[1]) < 0) { pts.length = i; break; }
      }
      const len = [0]; for (let i = 1; i < pts.length; i++) len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
      return { pts, len, L: len[len.length - 1] };
    },
    build() {
      // starts chosen (tools: a scan of every start) so each path bends a good deal as it follows the
      // hill but never turns sharply, and none skims the saddle; they alternate between the two hills
      this.runs = [[364, 352], [28, 118], [154, 10], [286, 328]].map(([x, y]) => this.path(x, y));
      const cs = this.contours();
      const shade = L => { const u = smooth(.35, .9, L); return u > 0 ? RED : GREY; };
      let arrows = "";
      for (let y = 34; y < 360; y += 48) for (let x = 28; x < 400; x += 48) {
        const [gx, gy] = this.grad(x, y), g = Math.hypot(gx, gy);
        if (g < 9e-4) continue;
        const len = 7 + Math.min(11, g * 1900), ux = gx / g, uy = gy / g;
        arrows += '<line x1="' + n2(x - ux * len / 2) + '" y1="' + n2(y - uy * len / 2) + '" x2="' + n2(x + ux * len / 2) + '" y2="' + n2(y + uy * len / 2) +
          '" stroke="' + GREY + '" stroke-width="1.25" stroke-linecap="round" marker-end="url(#hx-arrM)"/>';
      }
      return defs('<radialGradient id="hx-peak" r=".5"><stop offset="0" stop-color="' + RED + '" stop-opacity=".13"/><stop offset="1" stop-color="' + RED + '" stop-opacity="0"/></radialGradient>') +
        '<ellipse cx="262" cy="146" rx="124" ry="62" transform="rotate(28.6 262 146)" fill="url(#hx-peak)" data-k="glow" opacity="0"/>' +
        '<g mask="url(#hx-quiet)">' + cs.map((c, i) => '<path data-k="c' + i + '" d="' + c.d + '" fill="none" stroke="' + shade(c.L) + '" stroke-width="' + (1.1 + .5 * c.L).toFixed(2) +
          '" stroke-linecap="round" opacity="0"/>').join("") +
        '<g data-k="field" opacity="0">' + arrows + '</g></g>' +
        '<path data-k="trail" fill="none" stroke="' + RED + '" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000" stroke-dashoffset="1000"/>' +
        arrowLine("g", DEEP, "hx-arrD", 2.6) + particle("p") +
        '<g data-k="top" opacity="0"><circle data-k="ring" r="9" fill="none" stroke="' + RED + '" stroke-width="1.5"/></g>' +
        labels("ascent", "steepest ascent, square to every level curve", "level curves of f(x, y)");
    },
    frame(t, k) {
      const cs = 10;
      for (let i = 0; i < cs; i++) {
        const base = .16 + .05 * i;
        k["c" + i].setAttribute("opacity", n2(base * faint(t, .04 * i, .04 * i + .45)));
      }
      k.glow.setAttribute("opacity", n2(faint(t, .3, 1)));
      k.field.setAttribute("opacity", n2(.36 * faint(t, .2, .7)));
      // runs: climb, rest at the top, fade the trail, next start
      const speed = 78, rest = 1.1, fade = .55;
      const dur = this.runs.map(r => r.L / speed + rest + fade), total = dur.reduce((a, b) => a + b, 0);
      let u = Math.max(0, t - .75) % total, r = 0;
      while (u > dur[r]) { u -= dur[r]; r++; }
      const run = this.runs[r], climb = run.L / speed;
      const s = ease(clamp01(u / climb)) * run.L;
      let i = 1; while (i < run.len.length - 1 && run.len[i] < s) i++;
      const a = run.pts[i - 1], b = run.pts[i], seg = (run.len[i] - run.len[i - 1]) || 1, w = clamp01((s - run.len[i - 1]) / seg);
      const x = a[0] + (b[0] - a[0]) * w, y = a[1] + (b[1] - a[1]) * w;
      if (k.trail.dataset.run !== String(r)) {
        k.trail.dataset.run = String(r);
        k.trail.setAttribute("d", "M" + run.pts.filter((_, n) => n % 3 === 0 || n === run.pts.length - 1).map(p => P(p[0], p[1])).join("L"));
      }
      const appear = smooth(0, .25, u) * (1 - smooth(climb + rest, climb + rest + fade, u)) * smooth(.75, 1.05, t);
      k.trail.setAttribute("stroke-dashoffset", n2(1000 * (1 - s / run.L)));
      k.trail.setAttribute("opacity", n2(.85 * appear));
      k.p.setAttribute("transform", "translate(" + P(x, y) + ")"); k.p.setAttribute("opacity", n2(appear));
      const [gx, gy] = this.grad(x, y), g = Math.hypot(gx, gy), gl = 26 * smooth(0, .3, g * 900) * (1 - smooth(climb * .92, climb, u));
      setLine(k.g, x, y, x + (g ? gx / g : 0) * gl, y + (g ? gy / g : 0) * gl);
      k.g.setAttribute("opacity", n2(appear * smooth(4, 8, gl)));
      const top = smooth(climb * .97, climb + .25, u) * (1 - smooth(climb + rest * .6, climb + rest + fade, u));
      const ringR = 8 + 10 * smooth(climb, climb + rest, u);
      k.top.setAttribute("transform", "translate(" + P(x, y) + ")"); k.ring.setAttribute("r", n2(ringR));
      k.top.setAttribute("opacity", n2(top * (1 - smooth(climb + .2, climb + rest, u)) * .8));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 4. Flux out of a region (divergence theorem) ---------- */
  const flux = {
    label: "Fluid streaming out of two sources inside a region R and across its boundary C; the outward normals n measure the flux",
    poster: 4.6,
    src: [[172, 206, 1], [242, 166, .7]],
    F(x, y) { let fx = 0, fy = 0; for (const [sx, sy, q] of this.src) { const dx = x - sx, dy = y - sy, r2 = dx * dx + dy * dy + 30; fx += q * dx / r2; fy += q * dy / r2; } return [fx, fy]; },
    boundary(n) {
      const pts = [];
      for (let i = 0; i < n; i++) {
        const a = TAU * i / n, r = 100 + 9 * Math.sin(2 * a + .7) + 7 * Math.sin(3 * a - 1.2);
        pts.push([204 + 1.28 * r * Math.cos(a), 190 + .96 * r * Math.sin(a)]);
      }
      return pts;
    },
    inside(x, y, poly) {
      let c = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const [xi, yi] = poly[i], [xj, yj] = poly[j];
        if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi) c = !c;
      }
      return c;
    },
    at(ln, q) {                                       // position q seconds along a streamline
      let lo = 0, hi = ln.pts.length - 1;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (ln.pts[mid][2] < q) lo = mid; else hi = mid; }
      const a = ln.pts[lo], b = ln.pts[hi], w = clamp01((q - a[2]) / ((b[2] - a[2]) || 1));
      return [a[0] + (b[0] - a[0]) * w, a[1] + (b[1] - a[1]) * w, a[3]];
    },
    build() {
      const poly = this.boundary(160);
      // streamlines of F from each source; the flow is quick near a source and slows as it spreads
      this.lines = [];
      this.src.forEach(([sx, sy], si) => {
        const n = si ? 12 : 18, off = si ? .25 : 0;
        for (let m = 0; m < n; m++) {
          const a = TAU * (m + off) / n; let x = sx + 7 * Math.cos(a), y = sy + 7 * Math.sin(a);
          const pts = [[x, y, 0, 1]]; let time = 0, ok = false;
          for (let step = 0; step < 700; step++) {
            const [fx, fy] = this.F(x, y), g = Math.hypot(fx, fy);
            if (g < 1e-4) break;
            const v = Math.min(92, Math.max(22, 2900 * g));   // px per second
            x += 2 * fx / g; y += 2 * fy / g; time += 2 / v;
            pts.push([x, y, time, this.inside(x, y, poly) ? 1 : 0]);
            if (x < -14 || x > 414 || y < -14 || y > 374) { ok = true; break; }
          }
          if (ok) this.lines.push({ pts, T: time });
        }
      });
      this.comets = [];
      this.lines.forEach((ln, li) => { for (let c = 0; c < 2; c++) this.comets.push({ li, ph: (c / 2 + (li * .618) % 1) % 1 }); });
      const stream = this.lines.map(ln => "M" + ln.pts.filter((_, i) => i % 3 === 0 || i === ln.pts.length - 1).map(p => P(p[0], p[1])).join("L")).join("");
      const d = "M" + poly.map(p => P(p[0], p[1])).join("L") + "Z";
      const normalAt = i => {
        const a = poly[(i + 159) % 160], b = poly[(i + 1) % 160]; let tx = b[0] - a[0], ty = b[1] - a[1]; const L = Math.hypot(tx, ty);
        return [poly[i], ty / L, -tx / L];            // boundary runs clockwise on screen, so (ty, -tx) points out
      };
      let normals = "";
      [4, 26, 50, 72, 122, 144].forEach(i => {
        const [p, nx, ny] = normalAt(i);
        normals += '<line x1="' + n2(p[0]) + '" y1="' + n2(p[1]) + '" x2="' + n2(p[0] + nx * 22) + '" y2="' + n2(p[1] + ny * 22) +
          '" stroke="' + DEEP + '" stroke-width="2.2" stroke-linecap="round" marker-end="url(#hx-arrD)"/>';
        if (i === 26) normals += '<text x="' + n2(p[0] + nx * 37 + 3) + '" y="' + n2(p[1] + ny * 37 + 5) + '" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + DEEP + '" text-anchor="middle">' + bold("n") + '</text>';
      });
      const [cp, cnx, cny] = normalAt(100);
      let rl = [120, 236];                             // "R": inside, clear of the edge and the sources
      for (const c of [[120, 236], [112, 222], [132, 250], [106, 206], [150, 262]]) {
        const edge = Math.min(...poly.map(q => Math.hypot(q[0] - c[0], q[1] - c[1])));
        if (this.inside(c[0], c[1], poly) && edge > 16 && this.src.every(([sx, sy]) => Math.hypot(sx - c[0], sy - c[1]) > 34)) { rl = c; break; }
      }
      const pmark = this.src.map(([x, y]) => '<circle cx="' + x + '" cy="' + y + '" r="12" fill="' + RED + '" opacity=".12"/><circle cx="' + x + '" cy="' + y + '" r="4" fill="' + RED + '"/>').join("");
      let comets = ""; for (let i = 0; i < this.comets.length; i++) comets += '<line stroke-width="2.3" stroke-linecap="round"/>';
      return defs() +
        '<path data-k="region" d="' + d + '" fill="' + RED + '" fill-opacity=".05" stroke="none" opacity="0"/>' +
        '<path data-k="stream" d="' + stream + '" fill="none" stroke="' + GREY + '" stroke-width="1" stroke-linecap="round" opacity="0" mask="url(#hx-quiet)"/>' +
        '<g data-k="comets">' + comets + '</g>' +
        '<path data-k="curve" d="' + d + '" fill="none" stroke="' + RED + '" stroke-width="3" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000" stroke-dashoffset="1000"/>' +
        '<g data-k="normals" opacity="0">' + normals + '</g>' +
        '<g data-k="srcs" opacity="0">' + pmark + '</g>' +
        '<g data-k="names" opacity="0"><text x="' + n2(cp[0] + cnx * 16) + '" y="' + n2(cp[1] + cny * 16 + 5) + '" text-anchor="middle" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + RED + '">C</text>' +
        '<text x="' + rl[0] + '" y="' + rl[1] + '" text-anchor="middle" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + GREY + '">R</text></g>' +
        labels("flux",
               "flux out through C", "sources inside the region R");
    },
    frame(t, k) {
      if (!k.lines) k.lines = Array.from(k.comets.querySelectorAll("line"));
      k.region.setAttribute("opacity", n2(faint(t, .5, 1.1)));
      k.stream.setAttribute("opacity", n2(.2 * faint(t, .1, .8)));
      k.curve.setAttribute("stroke-dashoffset", n2(1000 * (1 - ease(smooth(.05, 1.1, t)))));
      k.normals.setAttribute("opacity", n2(smooth(1.0, 1.4, t) * (.8 + .2 * Math.sin(t * 2.2))));
      k.srcs.setAttribute("opacity", n2(faint(t, 0, .4)));
      k.names.setAttribute("opacity", n2(introLabels(t)));
      const on = smooth(.35, 1.0, t);
      for (let i = 0; i < this.comets.length; i++) {
        const c = this.comets[i], ln = this.lines[c.li], el = k.lines[i];
        const q = (t + c.ph * ln.T) % ln.T;
        const [x, y, inside] = this.at(ln, q), [x0, y0] = this.at(ln, Math.max(0, q - .15));
        const edge = Math.min(x + 14, 414 - x, y + 14, 374 - y);
        setLine(el, x0, y0, x, y);
        el.setAttribute("stroke", inside ? RED : GREY);
        el.setAttribute("opacity", n2(on * smooth(0, .1, q / ln.T) * smooth(0, 44, edge) * (inside ? .9 : .6)));
      }
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 3D helpers (x right, y into the page, z up: right-handed) ---------- */
  function camera(cx, cy, s, az, el) {
    const ca = Math.cos(az), sa = Math.sin(az), ce = Math.cos(el), se = Math.sin(el);
    const f = (x, y, z) => { const X = x * ca - y * sa, Y = x * sa + y * ca; return [cx + s * X, cy - s * (z * ce + Y * se), Y * ce - z * se]; };
    f.view = [-ce * sa, -ce * ca, se];                 // unit vector pointing at the viewer
    return f;
  }
  const dot3 = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const cross3 = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const add3 = (a, b, s = 1) => [a[0] + b[0] * s, a[1] + b[1] * s, a[2] + b[2] * s];
  const norm3 = a => { const L = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / L, a[1] / L, a[2] / L]; };
  function hull(p) {                                   // convex hull (monotone chain) of 2D points
    p = p.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    const cr = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
    const lo = [], up = [];
    for (const q of p) { while (lo.length > 1 && cr(lo[lo.length - 2], lo[lo.length - 1], q) <= 0) lo.pop(); lo.push(q); }
    for (let i = p.length - 1; i >= 0; i--) { const q = p[i]; while (up.length > 1 && cr(up[up.length - 2], up[up.length - 1], q) <= 0) up.pop(); up.push(q); }
    return lo.slice(0, -1).concat(up.slice(0, -1));
  }
  const poly = pts => "M" + pts.map(p => P(p[0], p[1])).join("L") + "Z";
  // split a sampled 3D curve into front / back path data by a visibility test on each segment's midpoint
  function splitPath(pts3, cam, isFront, out) {
    let cur = null, last = null;
    for (let i = 0; i < pts3.length - 1; i++) {
      const a = pts3[i], b = pts3[i + 1], m = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2];
      const side = isFront(m) ? "front" : "back", pa = cam(a[0], a[1], a[2]), pb = cam(b[0], b[1], b[2]);
      if (side !== cur || last !== i) out[side] += "M" + P(pa[0], pa[1]);
      out[side] += "L" + P(pb[0], pb[1]); cur = side; last = i + 1;
    }
  }
  const hexRGB = h => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  const mixA = (A, B, u) => A.map((v, i) => Math.round(v + (B[i] - v) * u));
  const rgb = A => "rgb(" + A.join(",") + ")";

  /* ---------- 5. Stokes' theorem: a dome and its rim ---------- */
  const stokes = {
    label: "A dome-shaped surface S turning slowly; a particle circulates around its rim C while curl arrows poke through the surface (Stokes' theorem)",
    poster: 3.4,
    build() {
      let extra = "";
      for (let i = 0; i < 3; i++) extra += '<path data-k="lp' + i + '" fill="none" stroke="' + RED + '" stroke-width="1.5" stroke-linecap="round" marker-end="url(#hx-arrR)" opacity="0"/>';
      for (let i = 0; i < 5; i++) extra += arrowLine("n" + i, DEEP, "hx-arrD", 2.2);
      return defs('<radialGradient id="hx-dome" cx=".4" cy=".3" r=".8"><stop offset="0" stop-color="#FFFFFF" stop-opacity=".95"/>' +
                  '<stop offset=".7" stop-color="' + RED + '" stop-opacity=".07"/><stop offset="1" stop-color="' + RED + '" stop-opacity=".14"/></radialGradient>') +
        '<path data-k="rimBack" fill="none" stroke="' + RED + '" stroke-width="2.4" stroke-linecap="round" opacity="0"/>' +
        '<path data-k="fill" fill="url(#hx-dome)" stroke="' + GREY + '" stroke-opacity=".35" stroke-width="1" opacity="0"/>' +
        '<path data-k="back" fill="none" stroke="' + GREY + '" stroke-width="1" stroke-linecap="round" stroke-dasharray=".01 4" opacity="0"/>' +
        '<path data-k="front" fill="none" stroke="' + GREY + '" stroke-width="1.1" stroke-linecap="round" opacity="0"/>' +
        extra +
        '<path data-k="rimFront" fill="none" stroke="' + RED + '" stroke-width="3" stroke-linecap="round" opacity="0"/>' +
        arrowLine("tan", DEEP, "hx-arrD", 2.6) + particle("p") +
        '<text data-k="lC" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + RED + '" text-anchor="middle" opacity="0">C</text>' +
        '<text data-k="lS" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + GREY + '" text-anchor="middle" opacity="0">S</text>' +
        labels("stokes", "circulation around the rim = curl through the surface", "surface S with boundary C", 19.5);
    },
    frame(t, k) {
      const cam = camera(198, 252, 102, -.4 + .1 * t, .4), V = cam.view;
      const isFront = q => dot3(q, V) > 0;
      const sph = (ph, la) => [Math.sin(ph) * Math.cos(la), Math.sin(ph) * Math.sin(la), Math.cos(ph)];
      const wire = { front: "", back: "" };
      for (const ph of [.55, 1.0, 1.32]) {                         // latitude circles
        const pts = []; for (let i = 0; i <= 72; i++) pts.push(sph(ph, TAU * i / 72)); splitPath(pts, cam, isFront, wire);
      }
      for (let m = 0; m < 8; m++) {                                  // meridians
        const pts = []; for (let i = 0; i <= 24; i++) pts.push(sph(Math.PI / 2 * i / 24, TAU * m / 8)); splitPath(pts, cam, isFront, wire);
      }
      const rim = { front: "", back: "" }, rp = [];
      for (let i = 0; i <= 96; i++) rp.push(sph(Math.PI / 2, TAU * i / 96));
      splitPath(rp, cam, isFront, rim);
      const sil = []; for (let a = 0; a <= 9; a++) for (let b = 0; b < 24; b++) { const q = sph(Math.PI / 2 * a / 9, TAU * b / 24), s = cam(q[0], q[1], q[2]); sil.push([s[0], s[1]]); }
      const intro = faint(t, 0, .6);
      k.fill.setAttribute("d", poly(hull(sil))); k.fill.setAttribute("opacity", n2(intro));
      k.front.setAttribute("d", wire.front); k.front.setAttribute("opacity", n2(.5 * intro));
      k.back.setAttribute("d", wire.back); k.back.setAttribute("opacity", n2(.5 * intro));
      const rimOn = smooth(.1, .9, t);
      k.rimFront.setAttribute("d", rim.front); k.rimFront.setAttribute("opacity", n2(rimOn));
      k.rimBack.setAttribute("d", rim.back); k.rimBack.setAttribute("opacity", n2(.35 * rimOn));
      // curl arrows along the outward normal, only where the surface faces us
      const nPts = [[0, 0], [.95, .8], [.95, 2.37], [.95, 3.94], [.95, 5.51]];
      nPts.forEach(([ph, la], i) => {
        const q = sph(ph, la), a = cam(q[0], q[1], q[2]), b = cam(q[0] * 1.36, q[1] * 1.36, q[2] * 1.36), fr = dot3(q, V);
        setLine(k["n" + i], a[0], a[1], b[0], b[1]);
        k["n" + i].setAttribute("opacity", n2(smooth(.05, .3, fr) * smooth(.9, 1.3, t) * (.78 + .22 * Math.sin(2.2 * t + i))));
      });
      // little circulation loops on the surface (they cancel inside, leaving only the rim)
      [[.72, 1.3], [.72, 3.4], [.72, 5.5]].forEach(([ph, la], i) => {
        const N = sph(ph, la), e1 = [-Math.sin(la), Math.cos(la), 0], e2 = cross3(N, e1), s0 = 2.1 * t;
        let d = "";
        for (let j = 0; j <= 22; j++) {
          const s = s0 + 4.3 * j / 22, q = add3(add3(N.map(v => v * 1.01), e1, .12 * Math.cos(s)), e2, .12 * Math.sin(s)), p = cam(q[0], q[1], q[2]);
          d += (j ? "L" : "M") + P(p[0], p[1]);
        }
        k["lp" + i].setAttribute("d", d);
        k["lp" + i].setAttribute("opacity", n2(.75 * smooth(.08, .35, dot3(N, V)) * smooth(1.0, 1.4, t)));
      });
      // particle on the rim, counterclockwise seen from above (matches the upward normal)
      const al = .9 * t + 2.2, q = [Math.cos(al), Math.sin(al), 0], pp = cam(q[0], q[1], q[2]);
      const tq = add3(q, [-Math.sin(al), Math.cos(al), 0], .3), tp = cam(tq[0], tq[1], tq[2]);
      const vis = isFront(q) ? 1 : .3, on = smooth(.8, 1.2, t);
      k.p.setAttribute("transform", "translate(" + P(pp[0], pp[1]) + ")"); k.p.setAttribute("opacity", n2(vis * on));
      setLine(k.tan, pp[0], pp[1], tp[0], tp[1]); k.tan.setAttribute("opacity", n2(vis * on));
      const cl = cam(Math.cos(-.9), Math.sin(-.9), 0), sl = cam(.55, -.25, .92);
      k.lC.setAttribute("x", n2(cl[0] + 14)); k.lC.setAttribute("y", n2(cl[1] + 18));
      k.lS.setAttribute("x", n2(sl[0] + 22)); k.lS.setAttribute("y", n2(sl[1]));
      k.lC.setAttribute("opacity", n2(introLabels(t))); k.lS.setAttribute("opacity", n2(introLabels(t)));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 6. Change of variables: a rectangle curls into a polar region ---------- */
  // The (r, θ) rectangle curls around the origin into the region it describes. The axes read r and θ
  // while it is flat and x and y once it has curled; two cells that start the same size (Δr Δθ) end up
  // with areas r·Δr·Δθ, so the inner one shrinks and the outer one grows.
  const polar = {
    label: "A rectangle of equal cells in the (r, θ) plane curling into a polar region in the (x, y) plane; an inner cell ends up small and an outer cell large, each with area r Δr Δθ",
    poster: 6.2,
    O: [132, 300], S: 104, K: 78, r0: .6, r1: 2, th1: 2 * Math.PI / 3,
    pos(r, th, m) {
      const [ox, oy] = this.O, xr = ox + r * this.S, yr = oy - th * this.K, xp = ox + r * Math.cos(th) * this.S, yp = oy - r * Math.sin(th) * this.S;
      return [xr + (xp - xr) * m, yr + (yp - yr) * m];
    },
    morph(t) {                                         // rest (rectangle) -> curl -> rest (polar) -> uncurl
      const u = Math.max(0, t - 1.0) % 9.2;
      if (u < 1.4) return 0; if (u < 3.8) return ease((u - 1.4) / 2.4);
      if (u < 6.8) return 1; return 1 - ease((u - 6.8) / 2.4);
    },
    build() {
      const cell = (k, op) => '<path data-k="' + k + '" fill="' + RED + '" fill-opacity="' + op + '" stroke="' + DEEP + '" stroke-width="1.4" stroke-linejoin="round" opacity="0"/>';
      const halo = ' stroke="#FBF8F4" stroke-width="4" stroke-linejoin="round" paint-order="stroke"';
      const tx = (k, s, col, anchor) => '<text data-k="' + k + '" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + col + '" text-anchor="' + (anchor || "middle") + '"' + halo + ' opacity="0">' + s + '</text>';
      const area = (k, r, anchor) => tx(k + "a", "Δr Δθ", DEEP, anchor) +
        tx(k + "b", '<tspan font-weight="700" fill="' + RED + '">' + r + '</tspan> Δr Δθ', DEEP, anchor);
      return defs() +
        '<path data-k="axes" fill="none" stroke="' + INK + '" stroke-width="1.2" opacity="0" mask="url(#hx-quiet)"/>' +
        '<path data-k="region" fill="' + RED + '" fill-opacity=".06" stroke="' + RED + '" stroke-opacity=".7" stroke-width="2.2" stroke-linejoin="round" opacity="0"/>' +
        '<path data-k="grid" fill="none" stroke="' + GREY + '" stroke-width="1" opacity="0"/>' +
        cell("c1", ".3") + cell("c2", ".3") +
        tx("ax1", "x", INK) + tx("ax2", "y", INK) + tx("ar1", "r", INK) + tx("ar2", "θ", INK) +
        area("l1", "r", "end") + area("l2", "r", "start") +          // no numbers: the picture shows the inner cell small, the outer one large
        '<circle data-k="o" cx="' + this.O[0] + '" cy="' + this.O[1] + '" r="3.4" fill="' + INK + '" opacity="0"/>' +
        labels("polar", "cells farther from the origin get stretched by r", "");      // no caption: the cells' own labels tell the story
    },
    frame(t, k) {
      const m = this.morph(t), N = 6, rv = i => this.r0 + (this.r1 - this.r0) * i / N, tv = j => this.th1 * j / N;
      let g = "";
      for (let i = 0; i <= N; i++) { let d = ""; for (let s = 0; s <= 36; s++) { const p = this.pos(rv(i), this.th1 * s / 36, m); d += (s ? "L" : "M") + P(p[0], p[1]); } g += d; }
      for (let j = 0; j <= N; j++) { const a = this.pos(this.r0, tv(j), m), b = this.pos(this.r1, tv(j), m); g += "M" + P(a[0], a[1]) + "L" + P(b[0], b[1]); }
      k.grid.setAttribute("d", g); k.grid.setAttribute("opacity", n2(.42 * faint(t, 0, .6)));
      const outline = (ra, rb, ta, tb, n) => {
        const pts = [];
        for (let s = 0; s <= n; s++) pts.push(this.pos(ra, ta + (tb - ta) * s / n, m));
        for (let s = 0; s <= n; s++) pts.push(this.pos(rb, tb - (tb - ta) * s / n, m));
        return poly(pts);
      };
      k.region.setAttribute("d", outline(this.r0, this.r1, 0, this.th1, 48)); k.region.setAttribute("opacity", n2(faint(t, .1, .8)));
      k.c1.setAttribute("d", outline(rv(0), rv(1), tv(2), tv(3), 8)); k.c2.setAttribute("d", outline(rv(5), rv(6), tv(2), tv(3), 8));
      k.c1.setAttribute("opacity", n2(smooth(.5, 1, t))); k.c2.setAttribute("opacity", n2(smooth(.5, 1, t)));
      const [ox, oy] = this.O;
      k.axes.setAttribute("d", "M" + P(ox - 110, oy) + "L" + P(384, oy) + "M" + P(ox, oy + 30) + "L" + P(ox, 60));
      k.axes.setAttribute("opacity", n2(.38 * faint(t, 0, .5)));
      const L = introLabels(t), xy = smooth(.35, .75, m), rt = 1 - smooth(.25, .65, m);   // the axes change names mid-curl
      [["ax1", 376, oy + 20, xy], ["ar1", 376, oy + 20, rt], ["ax2", ox - 12, 78, xy], ["ar2", ox - 12, 78, rt]].forEach(([key, x, y, w]) => {
        k[key].setAttribute("x", x); k[key].setAttribute("y", y); k[key].setAttribute("opacity", n2(L * w));
      });
      // each cell's area: Δr Δθ while flat, r Δr Δθ once curled (inner label inside the ring, outer label outside)
      const mid = (tv(2) + tv(3)) / 2, a1 = this.pos(rv(0) - .1, mid, m), a2 = this.pos(rv(6) + .1, mid, m), flat = 1 - smooth(.3, .6, m), curled = smooth(.7, .95, m);
      [["l1", a1], ["l2", a2]].forEach(([key, at]) => {
        ["a", "b"].forEach(v => { const el = k[key + v]; el.setAttribute("x", n2(at[0])); el.setAttribute("y", n2(at[1] + 5)); el.setAttribute("opacity", n2(L * smooth(.9, 1.4, t) * (v === "a" ? flat : curled))); });
      });
      k.o.setAttribute("opacity", n2(faint(t, 0, .4)));
      k.labels.setAttribute("opacity", n2(L));
    },
  };

  /* ---------- 7. Projection onto a plane ---------- */
  const project = {
    label: "A vector b above a plane W, its projection p in the plane, and the perpendicular piece b − p",
    poster: 2.8,
    build() {
      const u1 = norm3([1, 0, .18]), n = norm3(cross3([1, 0, .18], [0, 1, .3])), u2 = cross3(n, u1);
      Object.assign(this, { u1, u2, n });
      const tx = (k, s, col) => '<text data-k="' + k + '" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + col + '" text-anchor="middle" opacity="0">' + s + '</text>';
      return defs() +
        '<path data-k="plane" fill="' + RED + '" fill-opacity=".05" stroke="' + GREY + '" stroke-opacity=".55" stroke-width="1.2" stroke-linejoin="round" opacity="0"/>' +
        '<path data-k="grid" fill="none" stroke="' + GREY + '" stroke-width="1" opacity="0"/>' +
        '<path data-k="trace" fill="none" stroke="' + RED + '" stroke-width="1.3" stroke-dasharray=".01 5" stroke-linecap="round" opacity="0"/>' +
        '<line data-k="res" stroke="' + DEEP + '" stroke-width="2" stroke-dasharray=".01 5" stroke-linecap="round" marker-end="url(#hx-arrD)" opacity="0"/>' +
        '<path data-k="rt" fill="none" stroke="' + DEEP + '" stroke-width="1.3" opacity="0"/>' +
        arrowLine("pv", RED, "hx-arrR", 3) + arrowLine("bv", INK, "hx-arrI", 2.6) +
        '<circle data-k="o" r="3.4" fill="' + INK + '" opacity="0"/>' +
        tx("lb", bold("b"), INK) + tx("lp", bold("p"), RED) + tx("lr", bold("b") + " − " + bold("p"), DEEP) + tx("lW", it("W"), GREY) +
        labels("project", "the closest point to b in the plane W", "b − p is perpendicular to W");
    },
    frame(t, k) {
      const cam = camera(196, 236, 96, -.62 + .1 * Math.sin(.33 * t), .42), { u1, u2, n } = this;
      const at = (s, r, h = 0) => { const q = add3(add3(u1.map(v => v * s), u2, r), n, h); return cam(q[0], q[1], q[2]); };
      const E = 1.45, c = [at(-E, -E), at(E, -E), at(E, E), at(-E, E)];
      k.plane.setAttribute("d", poly(c));
      let g = ""; for (let i = 1; i < 4; i++) { const s = -E + 2 * E * i / 4, a = at(s, -E), b = at(s, E), a2 = at(-E, s), b2 = at(E, s); g += "M" + P(a[0], a[1]) + "L" + P(b[0], b[1]) + "M" + P(a2[0], a2[1]) + "L" + P(b2[0], b2[1]); }
      k.grid.setAttribute("d", g);
      const on = faint(t, 0, .6);
      k.plane.setAttribute("opacity", n2(on)); k.grid.setAttribute("opacity", n2(.3 * on));
      // b swings back and forth above the plane (on the side where p never points at the camera);
      // p follows underneath it
      const W0 = 3.75, W1 = .75, w = W0 + W1 * Math.sin(.34 * Math.max(0, t - .4)), A = .95, h = 1.05 + .22 * Math.sin(2 * w + 1.3);
      const ps = A * Math.cos(w), pr = A * Math.sin(w), grow = ease(smooth(.15, .95, t));
      const O = at(0, 0), Pp = at(ps * grow, pr * grow), B = at(ps * grow, pr * grow, h * grow);
      let tr = ""; for (let i = 0; i <= 40; i++) { const q = W0 - W1 - .12 + (2 * W1 + .24) * i / 40, a = at(A * Math.cos(q), A * Math.sin(q)); tr += (i ? "L" : "M") + P(a[0], a[1]); }
      k.trace.setAttribute("d", tr); k.trace.setAttribute("opacity", n2(.5 * smooth(.6, 1.2, t)));
      setLine(k.pv, O[0], O[1], Pp[0], Pp[1]); setLine(k.bv, O[0], O[1], B[0], B[1]);
      // b − p runs from p up to b; it stops just short of b's tip so both arrowheads stay readable
      const rx = B[0] - Pp[0], ry = B[1] - Pp[1], rl = Math.hypot(rx, ry) || 1, cut = Math.min(9, rl * .25);
      setLine(k.res, Pp[0], Pp[1], B[0] - rx / rl * cut, B[1] - ry / rl * cut);
      const vis = smooth(.3, .6, grow);
      k.pv.setAttribute("opacity", n2(vis)); k.bv.setAttribute("opacity", n2(vis)); k.res.setAttribute("opacity", n2(.9 * smooth(.8, 1.1, t)));
      // right-angle mark at p: one leg up the normal, one back toward the origin
      const ud = norm3([-ps, -pr, 0]), e = .16, r1 = at(ps, pr, e), r2 = at(ps + ud[0] * e, pr + ud[1] * e, e), r3 = at(ps + ud[0] * e, pr + ud[1] * e, 0);
      k.rt.setAttribute("d", "M" + P(r1[0], r1[1]) + "L" + P(r2[0], r2[1]) + "L" + P(r3[0], r3[1])); k.rt.setAttribute("opacity", n2(.8 * smooth(1.0, 1.3, t)));
      k.o.setAttribute("cx", n2(O[0])); k.o.setAttribute("cy", n2(O[1])); k.o.setAttribute("opacity", n2(faint(t, 0, .4)));
      const place = (el, tip, dx, dy) => { el.setAttribute("x", n2(tip[0] + dx)); el.setAttribute("y", n2(tip[1] + dy + 5)); el.setAttribute("opacity", n2(introLabels(t))); };
      const away = (tip, d) => { const vx = tip[0] - O[0], vy = tip[1] - O[1], L = Math.hypot(vx, vy) || 1; return [vx / L * d, vy / L * d]; };
      const ob = away(B, 16), op = away(Pp, 22);
      place(k.lb, B, ob[0], ob[1] - 4); place(k.lp, Pp, op[0], op[1] + 6);
      // b − p label beside the middle of its segment, on the side away from the origin
      const mid = [(B[0] + Pp[0]) / 2, (B[1] + Pp[1]) / 2];
      let nx = -ry / rl, ny = rx / rl; if (nx * (mid[0] - O[0]) + ny * (mid[1] - O[1]) < 0) { nx = -nx; ny = -ny; }
      place(k.lr, mid, nx * 30, ny * 30 - 3);
      const wl = at(E * .82, E * .88); place(k.lW, wl, 0, 0);
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 8. Cross product: area and direction ---------- */
  const crossP = {
    label: "Vectors u and v in a plane with the parallelogram they span; u × v stands perpendicular to the plane with length equal to that area",
    poster: 2.2,
    build() {
      const tx = (k, s, col) => '<text data-k="' + k + '" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + col + '" text-anchor="middle" opacity="0">' + s + '</text>';
      return defs() +
        arrowLine("xDown", DEEP, "hx-arrD", 3) +
        '<path data-k="plane" fill="' + INK + '" fill-opacity=".025" stroke="' + GREY + '" stroke-opacity=".5" stroke-width="1.2" stroke-linejoin="round" opacity="0"/>' +
        '<path data-k="grid" fill="none" stroke="' + GREY + '" stroke-width="1" opacity="0"/>' +
        '<path data-k="par" fill="' + RED + '" fill-opacity=".14" stroke="' + RED + '" stroke-opacity=".6" stroke-width="1.4" stroke-linejoin="round" opacity="0"/>' +
        '<path data-k="arc" fill="none" stroke="' + GREY + '" stroke-width="1.4" marker-end="url(#hx-arrM)" opacity="0"/>' +
        arrowLine("u", INK, "hx-arrI", 2.8) + arrowLine("v", RED, "hx-arrR", 2.8) + arrowLine("xUp", DEEP, "hx-arrD", 3) +
        '<circle data-k="o" r="3.4" fill="' + INK + '" opacity="0"/>' +
        tx("lu", bold("u"), INK) + tx("lv", bold("v"), RED) + tx("lx", bold("u") + " × " + bold("v"), DEEP) +
        tx("lth", it("θ"), GREY) +
        labels("cross", "perpendicular to both u and v", "area = |u × v| = 0.00");
    },
    frame(t, k) {
      const cam = camera(196, 228, 92, -.5 + .12 * Math.sin(.3 * t), .36), V = cam.view;
      const E = 1.6, c = [cam(-E, -E, 0), cam(E, -E, 0), cam(E, E, 0), cam(-E, E, 0)];
      k.plane.setAttribute("d", poly(c));
      let g = ""; for (let i = 1; i < 4; i++) { const s = -E + 2 * E * i / 4, a = cam(s, -E, 0), b = cam(s, E, 0), a2 = cam(-E, s, 0), b2 = cam(E, s, 0); g += "M" + P(a[0], a[1]) + "L" + P(b[0], b[1]) + "M" + P(a2[0], a2[1]) + "L" + P(b2[0], b2[1]); }
      k.grid.setAttribute("d", g);
      const on = faint(t, 0, .6);
      k.plane.setAttribute("opacity", n2(on)); k.grid.setAttribute("opacity", n2(.26 * on));
      // v swings round; it rests briefly near a right angle (biggest area) and where it lines up with u
      const w = .38 * Math.max(0, t - .3) + .5, th = w - .25 * Math.sin(2 * (w - Math.PI / 2)), grow = ease(smooth(.15, .95, t));
      const U = [1.3, 0, 0], Vv = [1.05 * Math.cos(th), 1.05 * Math.sin(th), 0], X = cross3(U, Vv), area = X[2];
      const O = cam(0, 0, 0), pu = cam(U[0] * grow, 0, 0), pv = cam(Vv[0] * grow, Vv[1] * grow, 0);
      const pw = cam((U[0] + Vv[0]) * grow, Vv[1] * grow, 0), px = cam(0, 0, .72 * area * grow);
      k.par.setAttribute("d", poly([O, pu, pw, pv])); k.par.setAttribute("opacity", n2(smooth(.4, .9, t)));
      setLine(k.u, O[0], O[1], pu[0], pu[1]); setLine(k.v, O[0], O[1], pv[0], pv[1]);
      const vis = smooth(.3, .6, grow), up = area >= 0, xl = Math.abs(.72 * area * grow);
      k.u.setAttribute("opacity", n2(vis)); k.v.setAttribute("opacity", n2(vis));
      setLine(k.xUp, O[0], O[1], px[0], px[1]); setLine(k.xDown, O[0], O[1], px[0], px[1]);
      const xo = vis * smooth(.08, .25, xl);
      k.xUp.setAttribute("opacity", n2(up ? xo : 0)); k.xDown.setAttribute("opacity", n2(up ? 0 : xo * .85));
      // theta arc from u to v in the plane
      let d = ""; const ra = .42, span = ((th % TAU) + TAU) % TAU;
      for (let i = 0; i <= 28; i++) { const a = span * i / 28, q = cam(ra * Math.cos(a), ra * Math.sin(a), 0); d += (i ? "L" : "M") + P(q[0], q[1]); }
      k.arc.setAttribute("d", d); k.arc.setAttribute("opacity", n2(.8 * smooth(1.0, 1.3, t) * smooth(.25, .6, span)));
      const mid = cam(.62 * Math.cos(span / 2), .62 * Math.sin(span / 2), 0);
      k.lth.setAttribute("x", n2(mid[0])); k.lth.setAttribute("y", n2(mid[1] + 5)); k.lth.setAttribute("opacity", n2(introLabels(t) * smooth(.35, .7, span)));
      const tip = (el, p, d0) => { const vx = p[0] - O[0], vy = p[1] - O[1], L = Math.hypot(vx, vy) || 1; el.setAttribute("x", n2(p[0] + vx / L * d0)); el.setAttribute("y", n2(p[1] + vy / L * d0 + 5)); };
      tip(k.lu, pu, 16); tip(k.lv, pv, 16);
      k.lu.setAttribute("opacity", n2(introLabels(t))); k.lv.setAttribute("opacity", n2(introLabels(t)));
      k.lx.setAttribute("x", n2(px[0] + 36)); k.lx.setAttribute("y", n2(px[1] + (up ? 2 : 12)));
      k.lx.setAttribute("opacity", n2(introLabels(t) * smooth(10, 24, Math.abs(px[1] - O[1]))));
      k.o.setAttribute("cx", n2(O[0])); k.o.setAttribute("cy", n2(O[1])); k.o.setAttribute("opacity", n2(faint(t, 0, .4)));
      setText(k.caption, "area = |u × v| = " + Math.abs(area).toFixed(2));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 9. Double integral as the limit of boxes ---------- */
  const riemann = {
    label: "Boxes over a square region whose heights follow f(x, y): one box splits into 3 by 3, then 6 by 6, then 12 by 12, approaching the surface, the double integral; then the boxes sink into the floor and one box rises to start again",
    poster: 8.9,
    levels: [1, 3, 6, 12],
    edge: st => st.n > 4 ? .5 : .65,                           // the white edges between boxes
    f(x, y) { return .22 + .78 * Math.exp(-((x - .62) ** 2 / .08 + (y - .4) ** 2 / .12)) + .3 * Math.exp(-((x - .2) ** 2 + (y - .78) ** 2) / .03); },
    build() {
      const cam = camera(198, 262, 188, -.72, .52), V = cam.view; this.cam = cam;
      const H = .5, P3 = (x, y, z) => cam(x - .5, y - .5, z);
      this.P3 = P3; this.H = H;
      const hmax = 1.05;
      this.sets = this.levels.map(n => {
        const bars = [];
        for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
          const x0 = i / n, y0 = j / n, x1 = (i + 1) / n, y1 = (j + 1) / n, v = this.f((x0 + x1) / 2, (y0 + y1) / 2);
          const top = mixA(hexRGB("#F6E3E5"), hexRGB(RED), .12 + .8 * Math.min(1, v / hmax)), dark = hexRGB("#4A0512");
          bars.push({ i, j, x0, y0, x1, y1, h: v * H, depth: P3((x0 + x1) / 2, (y0 + y1) / 2, 0)[2], delay: n > 1 ? .55 * (i + (n - 1 - j)) / (2 * (n - 1)) : 0,
                      cTop: rgb(top), cX: rgb(mixA(top, dark, .24)), cY: rgb(mixA(top, dark, .12)), cols: [mixA(top, dark, .24), mixA(top, dark, .12), top] });
        }
        bars.sort((a, b) => b.depth - a.depth);                  // far boxes first
        return { n, bars, key: null, done: false };
      });
      // each finer box starts at the height (and colour) of the coarser box it splits out of, so a refinement never jumps
      this.sets.forEach((st, si) => st.bars.forEach(b => {
        if (!si) { b.hp = 0; return; }
        const up = this.sets[si - 1], f = st.n / up.n, par = up.bars.find(q => q.i === Math.floor(b.i / f) && q.j === Math.floor(b.j / f));
        b.hp = par.h; b.pcols = par.cols;
      }));
      // which vertical faces face us: +x and -y for this camera
      this.faceX = V[0] > 0 ? 1 : 0; this.faceY = V[1] < 0 ? 0 : 1;
      let mesh = "";
      for (let a = 0; a <= 16; a++) {
        let d1 = "", d2 = "";
        for (let b = 0; b <= 32; b++) {
          const s = a / 16, r = b / 32, p1 = P3(s, r, this.f(s, r) * H), p2 = P3(r, s, this.f(r, s) * H);
          d1 += (b ? "L" : "M") + P(p1[0], p1[1]); d2 += (b ? "L" : "M") + P(p2[0], p2[1]);
        }
        mesh += d1 + d2;
      }
      const base = [P3(0, 0, 0), P3(1, 0, 0), P3(1, 1, 0), P3(0, 1, 0)];
      const groups = this.sets.map((st, si) => '<g data-k="set' + si + '" opacity="0" stroke="#FFFFFF" stroke-width=".7" stroke-linejoin="round" stroke-opacity="' + this.edge(st) + '">' +
        st.bars.map(b => ['cX', 'cY', 'cTop'].map(c => '<path fill="' + b[c] + '"/>').join("")).join("") + '</g>').join("");
      return defs() +
        '<path d="' + poly(base) + '" fill="' + INK + '" fill-opacity=".03" stroke="' + GREY + '" stroke-opacity=".6" stroke-width="1.2" stroke-linejoin="round" data-k="base" opacity="0"/>' +
        groups + '<g data-k="was" stroke="#FFFFFF" stroke-width=".7" stroke-linejoin="round" opacity="0"></g>' +
        '<path data-k="mesh" d="' + mesh + '" fill="none" stroke="' + RED + '" stroke-width="1" stroke-linejoin="round" opacity="0"/>' +
        '<text x="' + n2((P3(0, 0, 0)[0] + P3(1, 0, 0)[0]) / 2 - 16) + '" y="' + n2((P3(0, 0, 0)[1] + P3(1, 0, 0)[1]) / 2 + 22) + '" font-family="\'Fraunces\', Georgia, serif" font-size="15" font-style="italic" fill="' + GREY + '" data-k="lR" opacity="0">R</text>' +
        labels("riemann", "the limit of sums f · ΔA as the boxes shrink", "1 box");
    },
    // One set of boxes on screen at a time. One box rises from the square; it splits into 3 × 3 boxes that
    // start at its height (identical at the switch) and glide to their own heights; then each box splits into
    // 2 × 2 the same way (6 × 6), and again (12 × 12); the surface shows through and fades again. Then the round
    // ends with its own move, not the film run backwards: the boxes sink into the floor in a wave from the back
    // corner, the square sits empty for a beat, and the one box rises again to start the next round.
    T: { splits: [2.1, 4.5, 6.9], mesh: 9.3, meshOut: 11.4, drain: 12.1, sink: .7, cyc: 14.1, glide: .95 },
    paint(st, si, g, u) {
      const kids = g.children, P3 = this.P3, T = this.T; let all = true;
      st.bars.forEach((b, i) => {
        let h;
        if (!si) { const w = ease(clamp01(u / 1.05)); if (w < 1) all = false; h = b.h * w; }   // the one box rises
        else if (si === this.levels.length - 1 && u >= T.drain) {   // the reset: sink into the floor, back corner first
          const w = clamp01((u - T.drain - (.55 - b.delay) * .9) / T.sink), e = w * w * (3 - 2 * w); if (w < 1) all = false; h = b.h * (1 - e);
        } else {
          const w = ease(clamp01((u - T.splits[si - 1] - b.delay * .45) / T.glide)); if (w < 1) all = false; h = b.hp + (b.h - b.hp) * w;
          for (let c = 0; c < 3; c++) kids[3 * i + c].setAttribute("fill", rgb(mixA(b.pcols[c], b.cols[c], w)));   // colour glides with the height
        }
        h = Math.max(.002, h);
        const top = [P3(b.x0, b.y0, h), P3(b.x1, b.y0, h), P3(b.x1, b.y1, h), P3(b.x0, b.y1, h)];
        const fx = this.faceX ? [P3(b.x1, b.y0, 0), P3(b.x1, b.y1, 0), top[2], top[1]] : [P3(b.x0, b.y0, 0), P3(b.x0, b.y1, 0), top[3], top[0]];
        const fy = this.faceY ? [P3(b.x0, b.y1, 0), P3(b.x1, b.y1, 0), top[2], top[3]] : [P3(b.x0, b.y0, 0), P3(b.x1, b.y0, 0), top[1], top[0]];
        kids[3 * i].setAttribute("d", poly(fx)); kids[3 * i + 1].setAttribute("d", poly(fy)); kids[3 * i + 2].setAttribute("d", poly(top));
      });
      return all;
    },
    frame(t, k) {
      const T = this.T, tt = Math.max(0, t - .3), cycle = Math.floor(tt / T.cyc), u = tt - cycle * T.cyc;
      const last = this.levels.length - 1, lvl = T.splits.filter(x => u >= x).length, meshOn = smooth(T.mesh, T.mesh + .9, u) * (1 - smooth(T.meshOut, T.meshOut + .7, u));
      k.base.setAttribute("opacity", n2(faint(t, 0, .5)));
      // at a split the new set takes over at once (identical in shape and colour at that instant). A copy of the
      // old boxes, as they ended, sits on top and dissolves within a third of a second, before the new boxes have
      // moved much: their extra dividing edges come in softly, and nothing lingers as a ghost
      const since = lvl ? u - T.splits[lvl - 1] : 9, fade = ease(clamp01(since / .3));
      if (lvl !== this._lvl) {
        if (lvl && this._lvl === lvl - 1) { k.was.innerHTML = k["set" + (lvl - 1)].innerHTML; k.was.setAttribute("stroke-opacity", n2(this.edge(this.sets[lvl - 1]))); }
        else k.was.innerHTML = "";
        this._lvl = lvl;
      }
      k.was.setAttribute("opacity", n2(lvl && k.was.firstChild ? 1 - fade : 0));
      // the flattened tiles fade off the floor as the last boxes finish sinking; the next box fades in as it starts to rise
      const gone = smooth(T.drain + .85, T.drain + 1.45, u), rise = ease(clamp01(u / .35));
      this.sets.forEach((st, si) => {
        const on = si === lvl;
        const op = on ? (lvl === last ? (1 - .72 * meshOn) * (1 - gone) : lvl ? 1 : rise) : 0;
        k["set" + si].setAttribute("opacity", n2(op));

        if (!on) { st.key = null; return; }
        const key = cycle + ":" + si + (u >= T.drain ? "d" : "");  // repaint only while its boxes are still moving
        if (st.key !== key || !st.done) { st.key = key; st.done = this.paint(st, si, k["set" + si], u); }
      });
      k.mesh.setAttribute("opacity", n2(.75 * meshOn));
      const n = this.levels[lvl];
      setText(k.caption, u >= T.drain ? "back to one box" : meshOn > .5 ? "boxes → the surface z = f(x, y)" : n === 1 ? "1 box" : n + " × " + n + " = " + n * n + " boxes");
      k.lR.setAttribute("opacity", n2(introLabels(t)));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- 0. Circulation around C ---------- */
  // A flat picture: fluid swirls counterclockwise (quicker near the middle), a point goes once around the
  // closed curve C, and the stretch of C it has covered fills in, the running total of F · dr. F and dr are
  // drawn at the point; C glows when the loop closes and the next lap starts filling again.
  const circ = {
    label: "Fluid swirling counterclockwise through a vector field F; a point travels around the closed curve C with its velocity dr and the field F drawn at the point, and C fills in as F · dr adds up: the circulation",
    poster: 5.4,
    O: [176, 222], CC: [206, 208], LAP: 6.6, T0: 1.2, a0: -.35,   // O: centre of the swirl, set off-centre inside C so F and dr part ways
    omega(r) { return .95 / (1 + (r / 120) ** 2); },   // angular speed of the flow at radius r (px)
    C(a) { const r = 112 + 12 * Math.sin(2 * a + .6) + 8 * Math.sin(3 * a - 1.1); return [this.CC[0] + 1.22 * r * Math.cos(a), this.CC[1] - .82 * r * Math.sin(a)]; },
    rnd(i) { const x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); },
    build() {
      const [cx, cy] = this.O;
      // C by arc length, so the point moves at a steady speed and the filled stretch matches it exactly
      const N = 480, pts = []; let len = 0;
      for (let i = 0; i <= N; i++) { const q = this.C(this.a0 + TAU * i / N); if (i) len += Math.hypot(q[0] - pts[i - 1][0], q[1] - pts[i - 1][1]); pts.push([q[0], q[1], len]); }
      this.path = pts; this.len = len;
      const d = "M" + pts.map(q => P(q[0], q[1])).join("L") + "Z";
      // the field: short arrows along the flow on a staggered grid, shorter where it is slow
      let arrows = "";
      for (let row = 0, y = 34; y < 350; row++, y += 42) for (let x = 30 + (row % 2) * 24; x < 390; x += 48) {
        const dx = x - cx, dy = cy - y, r = Math.hypot(dx, dy); if (r < 26) continue;
        const sp = r * this.omega(r), L = 8 + 9 * Math.min(1, sp / 58), ux = -dy / r, uy = -dx / r;   // screen direction of (-Y, X)
        arrows += '<line x1="' + n2(x - ux * L / 2) + '" y1="' + n2(y - uy * L / 2) + '" x2="' + n2(x + ux * L / 2) + '" y2="' + n2(y + uy * L / 2) + '" stroke="' + GREY + '" stroke-width="1.25" stroke-linecap="round" marker-end="url(#hx-arrM)"/>';
      }
      let comets = ""; for (let i = 0; i < 22; i++) comets += '<path fill="none" stroke="' + GREY + '" stroke-width="2" stroke-linecap="round"/>';
      const top = this.C(Math.PI / 2 + .12);
      return defs() +
        '<g data-k="field" opacity="0" mask="url(#hx-quiet)">' + arrows + '</g>' +
        '<g data-k="comets" mask="url(#hx-quiet)">' + comets + '</g>' +
        '<path data-k="fill" d="' + d + '" fill="' + RED + '" fill-opacity=".045" stroke="none" opacity="0"/>' +
        '<path data-k="prev" d="' + d + '" fill="none" stroke="' + RED + '" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000 1" opacity="0"/>' +
        '<path data-k="trace" d="' + d + '" fill="none" stroke="' + RED + '" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1000" stroke-dasharray="0 1001" opacity="0"/>' +
        '<path data-k="curve" d="' + d + '" fill="none" stroke="' + RED + '" stroke-width="3" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000" stroke-dashoffset="1000"/>' +
        '<g data-k="pt" opacity="0">' +
          arrowLine("F", INK, "hx-arrI", 2.2) + arrowLine("dr", DEEP, "hx-arrD", 2.6) +
          '<circle data-k="halo" r="11" fill="' + RED + '" opacity=".14"/><circle data-k="dot" r="5.2" fill="' + RED + '" stroke="#FFFFFF" stroke-width="1.4"/>' +
          '<text data-k="lF" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + INK + '" text-anchor="middle" stroke="#FBF8F4" stroke-width="4" stroke-linejoin="round" paint-order="stroke">' + bold("F") + '</text>' +
          '<text data-k="ldr" font-family="\'Fraunces\', Georgia, serif" font-size="15" fill="' + DEEP + '" text-anchor="middle" stroke="#FBF8F4" stroke-width="4" stroke-linejoin="round" paint-order="stroke">' + it("d") + bold("r") + '</text>' +
        '</g>' +
        '<text data-k="lC" x="' + n2(top[0] - 4) + '" y="' + n2(top[1] - 12) + '" text-anchor="middle" font-family="\'Fraunces\', Georgia, serif" font-size="16" font-style="italic" fill="' + RED + '" opacity="0">C</text>' +
        labels("circ", "circulation around C", "add up F · dr once around C");
    },
    at(f) {                                            // point, unit tangent at fraction f of the way round
      const L = f * this.len, pts = this.path; let lo = 0, hi = pts.length - 1;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (pts[mid][2] < L) lo = mid; else hi = mid; }
      const a = pts[lo], b = pts[hi], w = clamp01((L - a[2]) / ((b[2] - a[2]) || 1)), tx = b[0] - a[0], ty = b[1] - a[1], tl = Math.hypot(tx, ty) || 1;
      return [a[0] + tx * w, a[1] + ty * w, tx / tl, ty / tl];
    },
    frame(t, k) {
      const [cx, cy] = this.O;
      if (!k.cm) { k.cm = Array.from(k.comets.children); k.cm.forEach(quiet); }
      k.field.setAttribute("opacity", n2(.42 * faint(t, 0, .7)));
      k.fill.setAttribute("opacity", n2(smooth(.6, 1.3, t)));
      k.curve.setAttribute("stroke-dashoffset", n2(1000 * (1 - ease(smooth(.05, 1.1, t)))));
      // the flow: each comet rides a circle for a few seconds, then fades and comes back somewhere else
      const on = smooth(.3, 1.1, t);
      for (let i = 0; i < k.cm.length; i++) {
        const life = 3.4 + 1.6 * this.rnd(i), q = t / life + this.rnd(i + 50), gen = Math.floor(q), ph = q - gen;
        const r = 34 + 170 * Math.sqrt(this.rnd(i * 7 + gen * 13 + 1)), th0 = TAU * this.rnd(i * 3 + gen * 5 + 2), w = this.omega(r);
        const th = th0 + w * ph * life, tail = Math.min(.5, 20 / r);
        let d = "";
        for (let j = 0; j <= 4; j++) { const a = th - tail * j / 4; d += (j ? "L" : "M") + P(cx + r * Math.cos(a), cy - r * Math.sin(a)); }
        const x = cx + r * Math.cos(th), y = cy - r * Math.sin(th), edge = Math.min(x, 400 - x, y, 360 - y);
        k.cm[i].setAttribute("d", d);
        k.cm[i].setAttribute("opacity", n2(on * .62 * Math.sin(Math.PI * ph) * smooth(0, 30, edge)));
      }
      // the point on C, its lap, and the filled stretch (last lap's fill fades as the new one starts)
      const u = Math.max(0, t - this.T0) / this.LAP, lap = Math.floor(u), f = u - lap, sinceLap = f * this.LAP;
      const show = smooth(this.T0 - .2, this.T0 + .3, t);
      k.trace.setAttribute("stroke-dasharray", n2(1000 * f) + " 1001");
      k.trace.setAttribute("opacity", n2(.26 * show));
      k.prev.setAttribute("opacity", n2(lap ? .26 * (1 - smooth(0, .9, sinceLap)) : 0));
      k.curve.setAttribute("stroke-width", n2(3 + (lap ? 1.6 * (1 - smooth(0, .9, sinceLap)) : 0)));
      const [x, y, tx, ty] = this.at(f), dx = x - cx, dy = cy - y, r = Math.hypot(dx, dy) || 1;
      const sp = r * this.omega(r), FL = 22 + 22 * Math.min(1, sp / 58), fx = -dy / r, fy = -dx / r;
      setLine(k.F, x, y, x + fx * FL, y + fy * FL);
      setLine(k.dr, x, y, x + tx * 30, y + ty * 30);
      k.dot.setAttribute("cx", n2(x)); k.dot.setAttribute("cy", n2(y)); k.halo.setAttribute("cx", n2(x)); k.halo.setAttribute("cy", n2(y));
      // labels sit beyond each arrow's tip, pushed a little outward from C
      const nx = ty, ny = -tx, out = (dx * nx - dy * ny) > 0 ? 1 : -1;
      k.lF.setAttribute("x", n2(x + fx * (FL + 11) + nx * out * 5)); k.lF.setAttribute("y", n2(y + fy * (FL + 11) + ny * out * 5 + 5));
      k.ldr.setAttribute("x", n2(x + tx * 16 - nx * out * 15)); k.ldr.setAttribute("y", n2(y + ty * 16 - ny * out * 15 + 5));   // beside dr, on the inner side
      k.pt.setAttribute("opacity", n2(show));
      k.lC.setAttribute("opacity", n2(introLabels(t)));
      k.labels.setAttribute("opacity", n2(introLabels(t)));
    },
  };

  /* ---------- rotation, mounting and the clock ---------- */
  const ORIGINAL = { html: svg.innerHTML, label: svg.getAttribute("aria-label") };
  const HEROES = [circ, linearMap, eigen, ascent, flux, stokes, polar, project, crossP, riemann];
  // A first visit opens on the Riemann boxes; each later visit moves to the next picture.
  const FIRST = HEROES.indexOf(riemann);
  let idx = FIRST, hero = null, keys = null, t0 = null, raf = 0, timer = 0;
  try {
    const prev = parseInt(localStorage.getItem("pl254:hero"), 10);
    idx = Number.isInteger(prev) ? (prev + 1) % HEROES.length : FIRST;
    localStorage.setItem("pl254:hero", String(idx));
  } catch (_) { idx = FIRST; }
  if (TEST) idx = TEST.h;

  function mount(i) {
    hero = HEROES[i];
    if (!hero) { svg.innerHTML = ORIGINAL.html; svg.setAttribute("aria-label", ORIGINAL.label); keys = null; return; }
    svg.innerHTML = hero.build();
    svg.setAttribute("aria-label", hero.label);
    keys = {}; svg.querySelectorAll("[data-k]").forEach(el => { keys[el.dataset.k] = el; quiet(el); });
    hero.frame(reduce ? hero.poster : TEST ? TEST.t : 0, keys);
    t0 = null;
  }
  // The picture's clock advances by the time between frames, capped at two frames, so a busy moment
  // (or a hidden tab, which gets no frames at all) slows it briefly instead of making it jump ahead.
  // ...and it rests while scrolled out of sight (no drawing during a scroll past it, on phones especially)
  let onScreen = true;
  if (window.IntersectionObserver) new IntersectionObserver(es => { onScreen = es.some(e => e.isIntersecting); }).observe(svg);
  function visible() { return onScreen && svg.getClientRects().length > 0; }
  let ht = 0, last = 0;
  function tick(now) {
    raf = 0;
    if (!hero || !keys || reduce || TEST) return;
    if (!visible()) { t0 = null; timer = setTimeout(() => { timer = 0; raf = requestAnimationFrame(tick); }, 400); return; }
    if (t0 === null) { t0 = now; ht = 0; last = now; }  // (re)entering home replays the intro, like the CSS one
    ht += Math.min(now - last, 34); last = now;
    hero.frame(ht / 1000, keys);
    raf = requestAnimationFrame(tick);
  }
  function start() { if (!raf && !timer && hero && !reduce && !TEST) raf = requestAnimationFrame(tick); }
  mount(idx); start();
  if (TEST) window.__heroFrame = (i, t) => { if (HEROES[i] !== hero) mount(i); if (hero) hero.frame(t, keys); };  // harness only

  // click / tap: move on to the next picture
  svg.style.cursor = "pointer";
  svg.addEventListener("click", () => {
    if (svg.dataset.swapping) return;
    svg.dataset.swapping = "1";
    svg.style.transition = "opacity .22s ease"; svg.style.opacity = "0";
    setTimeout(() => {
      idx = (idx + 1) % HEROES.length;
      try { localStorage.setItem("pl254:hero", String(idx)); } catch (_) {}
      mount(idx); start();
      svg.style.opacity = "1";
      setTimeout(() => { delete svg.dataset.swapping; }, 240);
    }, 230);
  });
})();
        </script>
      </div>

      <div id="homeError"></div>

      <div class="home-modules" id="homeModules">
        <div class="module module-progress">
          <div class="module-kicker">Your Progress</div>
          <div class="progress-row">
            <svg class="progress-ring" viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="50" fill="none" stroke="var(--border)" stroke-width="8"/>
              <circle id="progressRingFill" cx="60" cy="60" r="50" fill="none"
                      stroke="var(--red)" stroke-width="8" stroke-linecap="round"
                      stroke-dasharray="314.159" stroke-dashoffset="314.159"
                      transform="rotate(-90 60 60)"/>
              <text id="progressRingText" x="60" y="58" text-anchor="middle"
                    font-family="var(--font-display)" font-size="28" font-weight="600"
                    fill="var(--ink)">0%</text>
              <text x="60" y="78" text-anchor="middle" font-family="var(--font-sans)"
                    font-size="11" font-weight="500" fill="var(--ink-mute)"
                    letter-spacing="0.08em">MASTERED</text>
            </svg>
            <div class="progress-detail">
              <div class="progress-line">
                <span class="progress-num" id="progressGotNum">0</span>
                <span class="progress-total" id="progressTotalNum">/ —</span>
              </div>
              <p class="progress-label">problems marked <span class="nw">“Got it”</span></p>
            </div>
          </div>
          <div class="progress-help" id="progressHelp">Mark problems as you finish. Your progress is saved in this browser.</div>
        </div>

        <div class="module module-cooked">
          <div class="module-kicker">Section Difficulty <span class="cooked-legend"><span class="leg leg-1"></span><span class="leg leg-2"></span><span class="leg leg-3"></span><span class="leg leg-4"></span> <em>chill → cooked</em></span></div>
          <div class="cooked-grid" id="cookedGrid"></div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         VIEW: TOPICS (Browser + Exam Highlighting)
         ============================================================ -->
    <section class="view" id="view-topics">
      <div class="section-head">
        <div>
          <div class="kicker">Practice</div>
          <h2>Browse all topics</h2>
          <p>Pick an exam to see which sections it covers.</p>
        </div>
      </div>

      <div class="exam-tabs" id="examTabs" role="tablist" aria-label="Filter by exam">
        <button class="exam-tab active" data-exam="all">All Topics</button>
        <button class="exam-tab" data-exam="1">Exam 1</button>
        <button class="exam-tab" data-exam="2">Exam 2</button>
        <button class="exam-tab" data-exam="3">Exam 3</button>
        <button class="exam-tab" data-exam="4">Exam 4</button>
        <button class="exam-tab final" data-exam="final">Final Exam</button>
      </div>
      <div class="exam-explain" id="examExplain"></div>

      <div class="cards" id="topicCards"></div>
    </section>

    <!-- ============================================================
         VIEW: SECTION (problem list inside one section)
         ============================================================ -->
    <section class="view" id="view-section">
      <button class="breadcrumb" data-route="/topics"><span class="arr">→</span> Back to topics</button>
      <div class="section-detail-head">
        <div class="section-art" id="sectionArt" aria-hidden="true"></div>
        <div class="kicker" id="sectionDetailKicker"></div>
        <h2 id="sectionDetailTitle" style="font-family:var(--font-display); font-size:clamp(26px,3.4vw,36px); letter-spacing:-.022em; margin:0 0 8px; font-weight:600; color:var(--ink); line-height:1.1;"></h2>
        <p id="sectionDetailDesc" style="margin:0 0 12px; color:var(--ink-mute); max-width:680px;"></p>
        <div class="section-meta" id="sectionDetailMeta"></div>
      </div>

      <div class="filters">
        <div class="field search">
          <span class="field-label">Search</span>
          <input class="input" type="search" id="filterSearch" placeholder="Title, skills, problem text…" autocomplete="off" />
        </div>
        <div class="field">
          <span class="field-label">Difficulty</span>
          <select class="select" id="filterDifficulty">
            <option value="">All</option>
          </select>
        </div>
        <div class="field">
          <span class="field-label">Status</span>
          <select class="select" id="filterStatus">
            <option value="">All</option>
            <option value="got">Got it</option>
            <option value="review">Need review</option>
            <option value="none">Not yet</option>
          </select>
        </div>
        <div class="field">
          <span class="field-label">Sort</span>
          <select class="select" id="filterSort">
            <option value="default">Original order</option>
            <option value="difficulty">By difficulty</option>
            <option value="minutes">By est. minutes</option>
          </select>
        </div>
        <button class="btn btn-ghost btn-sm random-btn" id="randomBtn">Random</button>
      </div>

      <div class="prob-list" id="problemList"></div>
    </section>

    <!-- ============================================================
         VIEW: PROBLEM (study view)
         ============================================================ -->
    <section class="view" id="view-problem">
      <button class="breadcrumb" id="problemBackBtn"><span class="arr">→</span> Back to section</button>
      <div class="study-wrap">
        <article class="study-main" id="studyMain"></article>
        <aside class="study-side" id="studySide"></aside>
      </div>
    </section>

    <!-- ============================================================
         VIEW: EXAM MODE
         ============================================================ -->
    <!-- ============================================================
         VIEW: VISUALIZE
         ============================================================ -->
    <section class="view" id="view-visualize"><div id="vizRoot"></div></section>

    <section class="view" id="view-exam">
      <div class="section-head">
        <div>
          <div class="kicker">Timed practice</div>
          <h2>Exam Mode</h2>
          <p>A short set of problems from one exam's lectures, with a clock running.</p>
        </div>
      </div>

      <div id="examSetContainer"></div>

      <div class="exam-setup" id="examSetup">
        <h2>Build a practice exam</h2>
        <p>Pick an exam and a size. The clock starts when you do.</p>

        <span class="group-label">Exam</span>
        <div class="choice-row" id="examChoiceRow">
          <button class="choice selected" data-exam-pick="1">Exam 1</button>
          <button class="choice" data-exam-pick="2">Exam 2</button>
          <button class="choice" data-exam-pick="3">Exam 3</button>
          <button class="choice" data-exam-pick="4">Exam 4</button>
          <button class="choice red" data-exam-pick="final">Final Exam</button>
        </div>

        <span class="group-label">Number of problems</span>
        <div class="choice-row" id="examSizeRow">
          <button class="choice" data-size-pick="5">5</button>
          <button class="choice selected" data-size-pick="8">8</button>
          <button class="choice" data-size-pick="10">10</button>
        </div>

        <div style="margin-top: 24px; display:flex; gap:10px; flex-wrap: wrap;">
          <button class="btn btn-red" id="examGenerate">Start practice exam <span class="arrow">→</span></button>
        </div>

        <div class="exam-disclaimer">Practice problems from this site, not an official exam.</div>
      </div>

    </section>

    <!-- EXAM RUN: one question at a time with a running clock -->
    <section class="view" id="view-examrun">
      <div id="examRun"></div>
      <div class="exam-clock" id="examClock" hidden title="Time so far. Turns red at 50 minutes.">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13.5" r="7.5"/><path d="M12 13.5V9.5M10 2.5h4M18.2 6.8l1.3-1.3"/></svg>
        <span id="examClockT">0:00</span>
      </div>
    </section>

    <!-- ============================================================
         VIEW: NEED REVIEW
         ============================================================ -->
    <section class="view" id="view-review">
      <div class="section-head">
        <div>
          <div class="kicker">Your List</div>
          <h2>Need Review</h2>
          <p>Problems you've flagged to come back to. Clear them as you study.</p>
        </div>
        <div class="section-head-actions">
          <button class="btn btn-ghost btn-sm" id="reviewRandomBtn">Random from Review</button>
        </div>
      </div>
      <div id="reviewContent"></div>
    </section>

    <!-- ============================================================
         VIEW: SI WALKTHROUGHS — Dashboard
         ============================================================ -->
    <section class="view" id="view-walkthroughs">
      <div class="walk-head">
        <div class="walk-kicker">SI Leader Mode</div>
        <h1 class="walk-title">SI <em>Walkthroughs</em></h1>
        <p class="walk-sub">Whiteboard-ready teaching guides for 21-254 Practice Lab.</p>
        <div class="walk-note">Leader-facing teaching guides. Not student worksheets.</div>
      </div>

      <div class="walk-cards">
      <div class="walk-usage wu-full">
        <div class="wu-body">
          <div class="wu-kicker">Site usage</div>
          <div class="wu-stats" id="walkUsageStats" hidden></div>
          <div class="wu-charts" id="walkUsageCharts" hidden></div>
          <p class="wu-note" id="walkUsageNote">Anonymous, cookie-free counts from GoatCounter. They include your own visits and can lag a few hours. <a class="wu-ext" href="https://mbocksta.goatcounter.com/?filter=Practice+Lab" target="_blank" rel="noopener">Full dashboard &#8599;</a></p>
        </div>

      </div>

      <div class="walk-usage walk-reports">
        <div class="wu-body">
          <div class="wu-kicker">Reported issues</div>
          <div class="wr-list" id="walkReports" hidden></div>
          <p class="wu-note">Students flag a problem with its <strong>Report a problem</strong> button, or any page from the footer (anonymous). Mark one fixed and it stays hidden until someone reports it again.</p>
        </div>
      </div>
      </div>

      <div id="walkLoadStatus"></div>

      <div class="walk-toolbar">
        <input type="search" id="walkSearch" placeholder="Search sessions…" autocomplete="off"/>
        <select id="walkType">
          <option value="">All sessions</option>
          <option value="general">General sessions</option>
          <option value="exam-review">Exam reviews</option>
        </select>
        <select id="walkSection">
          <option value="">All Practice Lab sections</option>
        </select>
        <select id="walkSort">
          <option value="number">Sort: Session #</option>
          <option value="duration">Sort: Duration</option>
          <option value="section">Sort: First section</option>
        </select>
        <div class="walk-toolbar-spacer"></div>
        <div class="walk-toolbar-count" id="walkCount"></div>
      </div>

      <div class="walk-grid" id="walkGrid">
        <div class="walk-empty">Loading walkthroughs…</div>
      </div>
    </section>

    <!-- ============================================================
         VIEW: SI WALKTHROUGHS — Single Session Detail
         ============================================================ -->
    <section class="view" id="view-walkthrough">
      <div id="walkDetail">
        <div class="walk-empty">Loading session…</div>
      </div>
    </section>

  </div>
</main>

<footer>
  <div class="foot-brand"><span class="num">21-254</span> Practice Lab</div>
  <div class="foot-lead"><strong>Independent SI practice resource.</strong> Original practice problems, not official course materials.</div>
  <div class="foot-notes"><span class="foot-ai">Problems, hints, and solutions were developed with the assistance of AI and may contain occasional errors.</span> <span class="foot-ai">Anonymous, cookie-free usage statistics. No personal data is collected.</span></div>
  <div class="foot-links">
    <button type="button" id="reportFooterBtn">Report a problem</button>
    <span aria-hidden="true">·</span>
    <button type="button" id="aboutTrigger">About this resource</button>
    <span aria-hidden="true">·</span>
    <button type="button" id="qrFooterBtn">QR code</button>
    <span aria-hidden="true">·</span>
    <a href="mailto:mbocksta@andrew.cmu.edu?subject=21-254%20Practice%20Lab%20Feedback">Send feedback</a>
  </div>
</footer>

<!-- Floating QR button + modal: shows a scannable code to the public site -->
<button class="qr-fab" id="qrFab" type="button" aria-label="Show a QR code to this site" title="Show QR code">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M4 4h6v6H4V4zm2 2v2h2V6H6z"/>
    <path d="M14 4h6v6h-6V4zm2 2v2h2V6h-2z"/>
    <path d="M4 14h6v6H4v-6zm2 2v2h2v-2H6z"/>
    <path d="M13 13h2v2h-2zM17 13h3v3h-3zM13 17h3v3h-3zM18 18h2v2h-2z"/>
  </svg>
</button>
<div class="qr-modal shortcuts-help" id="qrModal" hidden>
  <div class="shortcuts-card qr-card" role="dialog" aria-label="QR code to the Practice Lab">
    <div class="shortcuts-head">
      <span class="shortcuts-kicker">Scan to open</span>
