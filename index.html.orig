      const pr = op === 1 && ww > 1e-12 ? F.mul(w, F.dot(v, w) / ww) : null, c = F.cross(v, w), lc = F.len(c), big = 1.3 * Math.max(lv, lw, 1e-9);
      const short = op === 2 && lc > big * 1.0001, cd = short ? F.mul(c, big / lc) : c;
      const cam = this.cam3([Z, v, w].concat(pr ? [pr] : [], op === 2 ? [F.add(v, w), cd] : []), yaw, s.el), sc = cam.sc, O = cam(0, 0, 0);
      o += this.axes3(cam, [v, w].concat(op === 2 ? [cd] : []).map(p => cam(...p)));
      const tips = [{ v, html: vzB("v"), col: VZ.ink }].concat(pr ? [] : [{ v: w, html: vzB("w"), col: VZ.red }]);
      let labs = "";
      if (pr) {
        const uw = F.unit(w), K = cam.R * 1.7, perp = F.sub(v, pr), pl = F.len(pr) * sc, ql = F.len(perp) * sc, sg = F.dot(v, w) < 0 ? -1 : 1;
        o += vzPath3(cam, [F.mul(uw, -K), F.mul(uw, K)], `stroke="${VZ.grey}" stroke-width="1.2" stroke-dasharray="6 6" opacity=".7"`);
        if (pl > 2) o += `<g opacity=".55">${vzArrow3(cam, Z, pr, "O", 10)}</g>`;
        if (ql > 2) {
