    "The unit square goes to the parallelogram spanned by the columns of A. Its area is |det A|, and the sign of det A says whether orientation is kept.");
};

SKETCH["transdet-007"] = () => {
  const n = [-1, 1, -1], p = [1, 1, 0], q = sk3.add(p, n), O = [0, 0, 0];
  const { S, P } = sk3D([p, q, sk3.mul(n, 1.8), sk3.mul(n, -1.8)], { axis: 2, yaw: -2.3, pitch: .34 });
  skLine3(S, P, O, n, -1.9, 1.9, { color: SKC.red, dash: "6 4", w: 1.8 });
  S.label("\\ker T", P(sk3.mul(n, 1.85)), { color: SKC.red, size: 14.5 });
  skVec3(S, P, O, p, { color: SKC.ink, label: "p" }); skVec3(S, P, O, q, { color: SKC.ink, label: "p+n", dir: [0, -1] });
  S.path([P(p), P(q)], { stroke: SKC.red, w: 1.3, dash: "3 3", free: true });
  S.point(P(O), { r: 3 });
  S.note("n in ker T means T(p + n) = T(p)", 392, 238, { anchor: "end", color: SKC.deep });
  return skDone("The kernel: every input that T sends to 0", S.svg("Kernel of T"),
    "Solve T(x) = 0 to find ker T. If it holds more than 0, moving an input along it never changes the output. For onto, compare the rank with the dimension of the outputs.");
};

SKETCH["transdet-008"] = () => {
  const a = [1, .15, 0], b = [.2, 1, .1], c = [.05, .25, .95], O = [0, 0, 0];
