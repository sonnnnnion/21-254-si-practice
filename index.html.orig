  blocks(76, [{ name: "A^T", r: 3, c: 2 }, { sym: "\\cdot" }, { name: "A", r: 2, c: 3 }, { sym: "=" }, { name: "A^TA", r: 3, c: 3, color: SKC.red, q: true }], 96);
