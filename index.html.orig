  6: '<path class="g" style="--i:0" d="M7.2 3.5H4.5V20.5H7.2" pathLength="1"/><path class="g" style="--i:0" d="M16.8 3.5H19.5V20.5H16.8" pathLength="1"/><path class="g g-dot g-acc" style="--i:1" d="M7.68 7.7a0.72 0.72 0 1 0 1.45 0a0.72 0.72 0 1 0 -1.45 0"/><path class="g g-dot g-acc" style="--i:2" d="M11.28 12a0.72 0.72 0 1 0 1.45 0a0.72 0.72 0 1 0 -1.45 0"/><path class="g g-dot g-acc" style="--i:3" d="M14.88 16.3a0.72 0.72 0 1 0 1.45 0a0.72 0.72 0 1 0 -1.45 0"/>',
  7: '<path class="g" style="--i:0" d="M3 14a7 5 0 1 0 14 0a7 5 0 1 0 -14 0" pathLength="1"/><path class="g" style="--i:1" d="M6.6 14a3.4 2.3 0 1 0 6.8 0a3.4 2.3 0 1 0 -6.8 0" pathLength="1"/><path class="g g-acc" style="--i:2" d="M14.5 10.17L17.82 4.63" pathLength="1"/><path class="g g-dot g-head g-acc" style="--i:3" d="M18.1 4.17L18 5.15L17.28 4.72Z"/><path class="g g-dot g-acc" style="--i:4" d="M14.05 10.17a0.45 0.45 0 1 0 0.9 0a0.45 0.45 0 1 0 -0.9 0"/>',
  8: '<path class="g" style="--i:0" d="M3.5 7L7.01 5.42" pathLength="1"/><path class="g g-dot g-head" style="--i:1" d="M7.5 5.2L6.85 5.95L6.51 5.19Z"/><path class="g" style="--i:1" d="M11 5.6L14.51 4.02" pathLength="1"/><path class="g g-dot g-head" style="--i:2" d="M15 3.8L14.35 4.55L14.01 3.79Z"/><path class="g g-acc" style="--i:2" d="M3.5 19C8 8 14 21 20.2 9" pathLength="1"/><path class="g g-dot g-head g-acc" style="--i:3" d="M20.2 9L20.16 9.99L19.41 9.61Z"/>',
