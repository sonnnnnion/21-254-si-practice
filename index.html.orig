      <div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px">
        <span class="vz-ptop-k" style="margin:0 2px 0 0">Size</span>
        <span class="vz-seg" role="group" aria-label="Rows">${[2, 3, 4].map(r => `<button type="button" data-rr="rows" data-v="${r}" style="padding:5px 10px" aria-label="${r} rows">${r}</button>`).join("")}</span>
        <span aria-hidden="true" style="color:var(--ink-mute)">×</span>
        <span class="vz-seg" role="group" aria-label="Columns">${[2, 3, 4, 5].map(c => `<button type="button" data-rr="cols" data-v="${c}" style="padding:5px 10px" aria-label="${c} columns">${c}</button>`).join("")}</span>
      </div>
