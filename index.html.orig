      C.red[j] = vzClamp(1 - d, 0, 1);                       // the rows a step changed are red while it is the newest step
      const op = d < 0 ? vzClamp(1 + d, 0, 1) : d <= 1 ? 1 - (1 - dim) * d : dim * vzClamp(1 - 2 * (d - 1), 0, 1);
      const top = OFF + Y[j], cy = top + B.box.up;
      // the step's operations, between this matrix and the one before (only while both are in view)
      const lo = (d <= 0 ? vzClamp(1 + d, 0, 1) : vzClamp(1 - 2 * d, 0, 1)) * tdetEdge(top - LG / 2);
      if (j && lo > .02) {
        const ly = top - LG / 2, l0 = B.sans ? f * .72 : f * .9, lf = Math.min(l0, l0 * 520 / tdetW(B.op, l0)), ax = 300 - tdetW(B.op, lf) / 2 - 16;
        o += `<g opacity="${q2(lo)}">${tdetText(300, ly + lf * .35, B.op, lf, { col: B.sans ? VZ.grey : VZ.deep, sans: B.sans, wt: B.sans ? 600 : null })}${vzArrow(ax, ly - LG * .3, ax, ly + LG * .3, "D", 1.6)}</g>`;
      }
      if (op < .02) return;
      if (!j) o += C.lab.d(xm - 8 - C.lab.w, cy, op * tdetEdge(cy));
      o += B.box.d(B.x, cy, op * (j <= m ? 1 : tdetEdge(cy)));
      if (B.cap) { const yc = top + B.box.up + B.box.dn + 10 + B.cap.up; o += B.cap.d(300 - B.cap.w / 2, yc, op * tdetEdge(yc)); }
      // reading off: the right half of the last matrix, ringed
      if (j === m && k > m) {
        const g = B.box.geo(B.x, cy), ro = vzClamp(d, 0, 1) * (d <= 1 ? 1 : vzClamp(1 - 2 * (d - 1), 0, 1)) * tdetEdge(cy);
        const x0 = g.xs[3] - g.cw[3] / 2 - 2, x1 = g.xs[5] + g.cw[5] / 2 + 2;
        if (ro > .02) o += `<rect x="${q2(x0)}" y="${q2(g.top - 3)}" width="${q2(x1 - x0)}" height="${q2(g.bot - g.top + 6)}" rx="10" fill="${VZ.red}" fill-opacity=".05" stroke="${VZ.red}" stroke-width="2" opacity="${q2(Math.min(1, ro))}"/>`;
      }
    });
    return o;
  },
  readout(s) {
    const W = this.work(s), p = W.inv ? Math.round(vzClamp(+s.pg || 0, 0, 1)) : 0, N = p ? W.N1 : W.N0, k = vzClamp(Math.round(+(p ? s.k1 : s.k0) || 0), 0, N - 1);
    const say = (p ? W.say1 : W.say0)[k] || "", B = this._bad && VzView.def === this ? this._bad : null;
    const where = B ? `Row ${Math.floor(B.i / B.m) + 1}, column ${B.i % B.m + 1}: ` : "";
    const bad = B ? `<div class="vz-status warn">${where}${B.err === "big" ? "keep entries between −99 and 99." : B.err === "den" ? "keep the bottom of a fraction at 100 or less." : B.err === "zero" ? "a fraction can't have 0 on the bottom." : "type a number like 3, −2 or 1/2."}</div>` : "";
    return bad + `<div class="vz-status ${!p && k === N - 1 && !W.inv ? "warn" : "ok"}">${say}</div>`;
  },
});
// (spacer 12.1)
// (spacer 12.2)
// (spacer 12.3)
// (spacer 12.4)
// (spacer 12.5)
// (spacer 12.6)
// (spacer 12.7)
/* ---------- Check your own work: eigenvalues of your own matrix (2 × 2 or 3 × 3) ----------
   TEIG_M does the algebra exactly, the way it is done by hand: BigInt fractions, numbers a + b√r for eigenvalues
   that need a square root, det(A − λI) by cofactors, roots by factoring / the rational root test / the quadratic
   formula, row reduction of A − λI with the row operations recorded, eigenvectors scaled to small whole numbers.
   solve(A) returns the numbers (for the picture and the answer) and the working as TeX steps (for the board). */
const TEIG_M = (() => {
  // ---------- fractions ----------
  const big = x => typeof x === "bigint" ? x : BigInt(x);
  const gcd = (a, b) => { if (a < 0n) a = -a; if (b < 0n) b = -b; while (b) { const t = a % b; a = b; b = t; } return a; };
  const lcm = (a, b) => { if (a < 0n) a = -a; if (b < 0n) b = -b; return a && b ? a / gcd(a, b) * b : a || b; };
  const Q = (n, d = 1n) => { n = big(n); d = big(d); if (d < 0n) { n = -n; d = -d; } const g = gcd(n, d) || 1n; return { n: n / g, d: d / g }; };
  const Q0 = Q(0), Q1 = Q(1);
  const qadd = (x, y) => Q(x.n * y.d + y.n * x.d, x.d * y.d), qsub = (x, y) => Q(x.n * y.d - y.n * x.d, x.d * y.d);
  const qmul = (x, y) => Q(x.n * y.n, x.d * y.d), qdiv = (x, y) => Q(x.n * y.d, x.d * y.n);
  const qneg = x => ({ n: -x.n, d: x.d }), qz = x => x.n === 0n, qeq = (x, y) => x.n === y.n && x.d === y.d;
  const qsgn = x => x.n > 0n ? 1 : x.n < 0n ? -1 : 0, qnum = x => Number(x.n) / Number(x.d), qabs = x => x.n < 0n ? qneg(x) : x, qint = x => x.d === 1n;

  // ---------- numbers a + b√r (r = 1: plain fractions, b stays 0) ----------
  const Fcache = {};
  const F = r => Fcache[r] || (Fcache[r] = (() => {
    const R = Q(r), mk = (a, b = Q0) => ({ a, b: r === 1n ? Q0 : b });
    const f = {
      r, mk, zero: mk(Q0), one: mk(Q1), of: q => mk(q),
      add: (x, y) => mk(qadd(x.a, y.a), qadd(x.b, y.b)), sub: (x, y) => mk(qsub(x.a, y.a), qsub(x.b, y.b)),
      neg: x => mk(qneg(x.a), qneg(x.b)),
      mul: (x, y) => mk(qadd(qmul(x.a, y.a), qmul(qmul(x.b, y.b), R)), qadd(qmul(x.a, y.b), qmul(x.b, y.a))),
      inv: x => { const n = qsub(qmul(x.a, x.a), qmul(qmul(x.b, x.b), R)); return mk(qdiv(x.a, n), qneg(qdiv(x.b, n))); },
      z: x => qz(x.a) && qz(x.b), eq: (x, y) => qeq(x.a, y.a) && qeq(x.b, y.b),
      num: x => qnum(x.a) + qnum(x.b) * Math.sqrt(Number(r)),
    };
    f.div = (x, y) => f.mul(x, f.inv(y));
    f.sgn = x => { const v = f.num(x); return f.z(x) ? 0 : v > 0 ? 1 : -1; };
    return f;
  })());

  // ---------- polynomials in λ (fraction coefficients, lowest power first) ----------
  const ptrim = p => { p = p.slice(); while (p.length > 1 && qz(p[p.length - 1])) p.pop(); return p; };
  const padd = (p, q) => ptrim(Array.from({ length: Math.max(p.length, q.length) }, (_, i) => qadd(p[i] || Q0, q[i] || Q0)));
  const psub = (p, q) => padd(p, q.map(qneg));
  const pmul = (p, q) => { const o = Array.from({ length: p.length + q.length - 1 }, () => Q0); p.forEach((a, i) => q.forEach((b, j) => { o[i + j] = qadd(o[i + j], qmul(a, b)); })); return ptrim(o); };
  const pscale = (p, c) => ptrim(p.map(a => qmul(a, c)));
  const pdeg = p => { p = ptrim(p); return p.length === 1 && qz(p[0]) ? -1 : p.length - 1; };
  const peval = (p, x) => p.reduceRight((acc, c) => qadd(qmul(acc, x), c), Q0);
  const pmonic = p => { p = ptrim(p); const l = p[p.length - 1]; return p.map(c => qdiv(c, l)); };
  const pderiv = p => ptrim(p.length > 1 ? p.slice(1).map((c, i) => qmul(c, Q(i + 1))) : [Q0]);
  const pdivmod = (p, q) => {
    p = ptrim(p).slice(); q = ptrim(q);
    const dq = q.length - 1, out = Array.from({ length: Math.max(1, p.length - dq) }, () => Q0);
    for (let i = p.length - 1; i >= dq; i--) { const c = qdiv(p[i], q[dq]); out[i - dq] = c; for (let j = 0; j <= dq; j++) p[i - dq + j] = qsub(p[i - dq + j], qmul(c, q[j])); }
    return [ptrim(out), ptrim(p.slice(0, Math.max(1, dq)))];
  };
  const pgcd = (p, q) => { p = ptrim(p); q = ptrim(q); while (pdeg(q) >= 0) { const r = pdivmod(p, q)[1]; p = q; q = r; } return pmonic(p); };

  // N = s²·r with r squarefree
  const sqrtSplit = N => {
    if (N < 9007199254740991n) {
      let m = Number(N), s = 1, r = 1;
      for (let p = 2; p * p <= m; p += p === 2 ? 1 : 2) { while (m % (p * p) === 0) { m /= p * p; s *= p; } if (m % p === 0) { m /= p; r *= p; } }
      return [BigInt(s), BigInt(r) * BigInt(m)];
    }
    let m = N, s = 1n, r = 1n;
    for (let p = 2n; p * p <= m && p < 2000000n; p += p === 2n ? 1n : 2n) { while (m % (p * p) === 0n) { m /= p * p; s *= p; } if (m % p === 0n) { m /= p; r *= p; } }
    return [s, r * m];
  };

  // ---------- reading what the student typed ----------
  // whole numbers, decimals and fractions (−3, 0.25, 3/4, −1/2, 1.5/2); returns { q } or { err }
  const parse = raw => {
    const s = String(raw == null ? "" : raw).trim().replace(/[−–—]/g, "-").replace(/\s+/g, "");
    if (!s) return { err: "empty" };
    const m = s.match(/^([+-]?)(\d*\.?\d*)(?:\/([+-]?)(\d*\.?\d*))?$/);
    if (!m || !/\d/.test(m[2]) || (m[3] !== undefined && m[4] !== undefined && s.includes("/") && !/\d/.test(m[4]))) return { err: "bad" };
    const dec = t => { const [w, f = ""] = t.split("."); if (f.length > 4) return null; return Q(BigInt((w || "0") + f), 10n ** BigInt(f.length)); };
    let q = dec(m[2]); if (!q) return { err: "bad" };
    if (m[1] === "-") q = qneg(q);
    if (s.includes("/")) {
      const d = dec(m[4]); if (!d) return { err: "bad" }; if (qz(d)) return { err: "zero" };
      q = qdiv(q, m[3] === "-" ? qneg(d) : d);
    }
    if (Math.abs(qnum(q)) > 99) return { err: "big" };
    if (q.d > 99n) return { err: "den" };
    return { q };
  };

  // ---------- TeX ----------
  const tq = q => q.d === 1n ? String(q.n) : (q.n < 0n ? "-" : "") + `\\tfrac{${(q.n < 0n ? -q.n : q.n)}}{${q.d}}`;
  const tqParen = q => qsgn(q) < 0 ? `(${tq(q)})` : tq(q);
  // a + b√r as one fraction over a common denominator: 2+\sqrt3, \frac{5+\sqrt{33}}{2}, -\frac{\sqrt2}{2}
  const sq = r => `\\sqrt{${r}}`;
  const tf = (f, x) => {
    if (qz(x.b)) return tq(x.a);
    const D = lcm(x.a.d, x.b.d), A = x.a.n * (D / x.a.d), B = x.b.n * (D / x.b.d), Bab = B < 0n ? -B : B;
    const rt = (Bab === 1n ? "" : String(Bab)) + sq(f.r);
    if (A === 0n) return (B < 0n ? "-" : "") + (D === 1n ? rt : `\\frac{${rt}}{${D}}`);
    const num = `${A}${B < 0n ? "-" : "+"}${rt}`;
    return D === 1n ? num : `\\frac{${num}}{${D}}`;
  };
  const twoPart = x => !qz(x.a) && !qz(x.b);
  const tfParen = (f, x) => twoPart(x) || f.sgn(x) < 0 ? `(${tf(f, x)})` : tf(f, x);
  // a coefficient written against a symbol: R_1, -R_1, 2R_1, \tfrac12R_1, (1+\sqrt2)R_1, \sqrt2\,R_1
  const tcoef = (f, x, sym) => {
    if (f.eq(x, f.one)) return sym;
    if (f.eq(x, f.neg(f.one))) return "-" + sym;
    const t = tf(f, x);
    if (twoPart(x) && !t.startsWith("\\frac")) return `(${t})${sym}`;
    return t + (qz(x.b) ? "" : "\\,") + sym;
  };
  // c₁x + c₂y + c₃z with the signs folded in
  const tlin = (f, cs, names) => {
    let o = "";
    cs.forEach((c, i) => {
      if (f.z(c)) return;
      const neg = !twoPart(c) && f.sgn(c) < 0, body = tcoef(f, neg ? f.neg(c) : c, names[i]);
      o += o ? (neg ? "-" : "+") + body : (neg ? "-" : "") + body;
    });
    return o || "0";
  };
  const tpoly = (p, v = "\\lambda") => {
    p = ptrim(p); let o = "";
    if (p.length === 2 && !qz(p[0]) && qsgn(p[1]) < 0) return tq(p[0]) + "-" + (qeq(p[1], qneg(Q1)) ? "" : tq(qneg(p[1]))) + v;   // 3 − λ, as in A − λI
    for (let k = p.length - 1; k >= 0; k--) {
      const c = p[k]; if (qz(c)) continue;
      const neg = qsgn(c) < 0, a = qabs(c), pw = k === 0 ? "" : k === 1 ? v : `${v}^${k}`;
      const body = k === 0 ? tq(a) : qeq(a, Q1) ? pw : tq(a) + pw;
      o += o ? (neg ? "-" : "+") + body : (neg ? "-" : "") + body;
    }
    return o || "0";
  };
  const tpolyP = p => pdeg(p) <= 0 ? (qsgn(p[0]) < 0 ? `(${tpoly(p)})` : tpoly(p)) : `(${tpoly(p)})`;
  const tmat = (rows, cell = x => x) => `\\begin{bmatrix}${rows.map(r => r.map(cell).join("&")).join("\\\\")}\\end{bmatrix}`;
  const tvm = rows => `\\begin{vmatrix}${rows.map(r => r.join("&")).join("\\\\")}\\end{vmatrix}`;
  const tcol = (f, v) => tmat(v.map(x => [tf(f, x)]));
  const tentry = (a, diag) => diag ? (qz(a) ? "-\\lambda" : `${tq(a)}-\\lambda`) : tq(a);
  const tentryP = (a, diag) => diag ? `(${tentry(a, true)})` : tqParen(a);
  const VARS = ["x", "y", "z"], SUBS = ["_1", "_2", "_3"];
  const RED = "#C8102E";
  // [A − λI | 0] with the rows a row operation just changed in red
  const taug = (f, M, hl = []) => {
    const n = M.length, spec = "c".repeat(n) + "|c";
    return `\\left[\\begin{array}{${spec}}${M.map((row, i) => row.concat([f.zero]).map(x => hl.includes(i) ? `\\color{${RED}}{${tf(f, x)}}` : tf(f, x)).join("&")).join("\\\\")}\\end{array}\\right]`;
  };
  // "A − 3I", "A + 2I", "A − \tfrac12 I", "A − (2+√3)I", "A" (λ = 0)
  const tAminus = (f, lam) => f.z(lam) ? "A-0I" : twoPart(lam) ? `A-\\left(${tf(f, lam)}\\right)I` : f.sgn(lam) < 0 ? `A+${tcoef(f, f.neg(lam), "I")}` : `A-${tcoef(f, lam, "I")}`;
  const par = t => /\\frac/.test(t) ? `\\left(${t}\\right)` : `(${t})`;
  const topLabel = (f, op) => {
    const R = i => `R_${i + 1}`;
    if (op.t === "swap") return `${R(op.i)}\\leftrightarrow ${R(op.j)}`;
    if (op.t === "scale") return tcoef(f, op.m, R(op.i));
    const neg = !twoPart(op.m) && f.sgn(op.m) < 0;
    return `${R(op.i)}${neg ? "-" : "+"}${tcoef(f, neg ? f.neg(op.m) : op.m, R(op.j))}`;
  };

  // ---------- HTML (the short answer in the panel) ----------
  const hq = q => (q.n < 0n ? "−" : "") + (q.n < 0n ? -q.n : q.n) + (q.d === 1n ? "" : "/" + q.d);
  const hroot = r => "√" + r;
  const hf = (f, x) => {
    if (qz(x.b)) return hq(x.a);
    const D = lcm(x.a.d, x.b.d), A = x.a.n * (D / x.a.d), B = x.b.n * (D / x.b.d), Bab = B < 0n ? -B : B;
    const rt = (Bab === 1n ? "" : String(Bab)) + hroot(f.r);
    const num = A === 0n ? (B < 0n ? "−" : "") + rt : `${A < 0n ? "−" + (-A) : A} ${B < 0n ? "−" : "+"} ${rt}`;
    return D === 1n ? num : (A === 0n ? num + "/" + D : `(${num})/${D}`);
  };
  const hvec = (f, v) => `[${v.map(x => hf(f, x)).join(", ")}]`;

  // ---------- numbers: real roots of a polynomial, for finding the exact ones ----------
  const fnum = p => ptrim(p).map(qnum);
  const fev = (c, x) => c.reduceRight((a, k) => a * x + k, 0);
  const realRootsNum = p => {           // all real roots of a polynomial with float coefficients (degree ≤ 3), sorted
    const c = fnum(p), d = c.length - 1;
    if (d < 1) return [];
    if (d === 1) return [-c[0] / c[1]];
    const dc = c.slice(1).map((k, i) => k * (i + 1)), crit = realRootsNum(dc.map(x => Q(BigInt(Math.round(x * 1e6)), 1000000n))).filter(Number.isFinite);
    const B = 1 + Math.max(...c.slice(0, d).map(k => Math.abs(k / c[d])));
    const pts = [-B, ...crit.filter(x => x > -B && x < B), B], out = [];
    for (let i = 0; i + 1 < pts.length; i++) {
      let a = pts[i], b = pts[i + 1], fa = fev(c, a), fb = fev(c, b);
      if (Math.abs(fa) < 1e-12 * (1 + Math.abs(a) ** d)) { out.push(a); continue; }
      if (fa * fb > 0) continue;
      for (let k = 0; k < 200 && b - a > 1e-14 * (1 + Math.abs(a)); k++) { const m = (a + b) / 2, fm = fev(c, m); if (fa * fm <= 0) { b = m; fb = fm; } else { a = m; fa = fm; } }
      out.push((a + b) / 2);
    }
    if (Math.abs(fev(c, B)) < 1e-12) out.push(B);
    return out.filter((x, i) => !out.slice(0, i).some(y => Math.abs(x - y) < 1e-9 * (1 + Math.abs(x))));
  };
  const divisors = N => {               // positive divisors of a positive BigInt (its prime factors are small here)
    if (N < 0n) N = -N; let ds = [1n], m = N;
    for (let p = 2n; p * p <= m && p < 100000n; p++) {
      if (m % p) continue; let e = 0; while (m % p === 0n) { m /= p; e++; }
      const nd = []; ds.forEach(d => { let x = d; for (let k = 0; k <= e; k++) { nd.push(x); x *= p; } }); ds = nd;
    }
    if (m > 1n) ds = ds.concat(ds.map(d => d * m));
    return ds.sort((a, b) => (a < b ? -1 : 1));
  };
  // the distinct rational roots of a monic polynomial: a repeated root is always rational (it is a root of
  // gcd(p, p′)), and the others are found near the numerical roots, with denominators that divide the lcm
  const ratRoots = p => {
    const out = [], add = c => { if (qz(peval(p, c)) && !out.some(o => qeq(o, c))) out.push(c); };
    const g = pgcd(p, pderiv(p));
    if (pdeg(g) === 1) add(qneg(g[0])); else if (pdeg(g) === 2) add(qdiv(qneg(g[1]), Q(2)));
    add(Q0);
    const L = ptrim(p).reduce((a, c) => lcm(a, c.d), 1n), ds = divisors(L);
    realRootsNum(p).forEach(x => ds.forEach(q => { if (Math.abs(x * Number(q)) < 1e15) add(Q(BigInt(Math.round(x * Number(q))), q)); }));
    return out.sort((a, b) => Math.abs(qnum(a)) - Math.abs(qnum(b)) || qnum(b) - qnum(a));   // the one a student finds first: small, positive
  };

  // ---------- the quadratic λ² + Bλ + C ----------
  const quad = (B, C) => {
    const D = qsub(qmul(B, B), qmul(Q(4), C)), mid = qdiv(qneg(B), Q(2));
    if (qz(D)) return { kind: "double", D, root: mid };
    const neg = qsgn(D) < 0, Da = qabs(D), [s, r] = sqrtSplit(Da.n * Da.d), half = Q(s, 2n * Da.d);   // √|D| / 2 = half·√r
    if (neg) return { kind: "complex", D, a: mid, b: half, r };
    if (r === 1n) return { kind: "rational", D, roots: [qadd(mid, half), qsub(mid, half)] };
    return { kind: "surd", D, a: mid, b: half, r };
  };
  // how a student solves it: factor when the roots are whole numbers, else the quadratic formula with whole
  // coefficients (multiply through first if there are fractions); returns TeX lines and a reason
  const quadWork = (B, C, opt = {}) => {
    const R = quad(B, C), poly = [C, B, Q1], lines = [], pre = opt.pre || "";
    const intCoef = qint(B) && qint(C);
    const pair = (a, b, r, i) => {           // a ± b√r (i: times i)
      const f = F(r === 1n && !i ? 1n : r), x = f.mk(a, b);
      const D = lcm(a.d, b.d), A = a.n * (D / a.d), Bn = b.n * (D / b.d), rt = (Bn === 1n ? "" : String(Bn)) + (r === 1n ? "" : sq(r) + (i ? "\\," : "")) + (i ? "i" : "");
      const body = (A === 0n ? "" : String(A)) + "\\pm " + (rt || "1");
      void x; return D === 1n ? (A === 0n ? "\\pm " + (rt || "1") : body) : `\\frac{${body}}{${D}}`;
    };
    if (R.kind === "double") {
      lines.push(`${pre}${tpoly(poly)}=\\left(\\lambda${qsgn(R.root) < 0 ? "+" + tq(qneg(R.root)) : qz(R.root) ? "" : "-" + tq(R.root)}\\right)^2=0`);
      return { R, lines, why: "A perfect square: one eigenvalue, repeated (a double root).", how: "square" };
    }
    if (R.kind === "rational" && intCoef && R.roots.every(qint)) {
      const fac = r => qz(r) ? "\\lambda" : `(\\lambda${qsgn(r) < 0 ? "+" + tq(qneg(r)) : "-" + tq(r)})`;
      lines.push(`${pre}${tpoly(poly)}=${fac(R.roots[0])}${fac(R.roots[1])}=0`);
      const [r1, r2] = R.roots;
      const why = qz(C) ? `No constant term, so \\(\\lambda\\) factors out.` : `Two numbers that multiply to \\(${tq(C)}\\) and add to \\(${tq(B)}\\): \\(${tq(qneg(r1))}\\) and \\(${tq(qneg(r2))}\\).`;
      return { R, lines, why, how: "factor" };
    }
    // quadratic formula on a λ² + b λ + c with whole a, b, c
    const L = lcm(B.d, C.d), a = L, b = B.n * (L / B.d), c = C.n * (L / C.d), g = gcd(gcd(a, b), c) || 1n;
    const A2 = a / g, B2 = b / g, C2 = c / g;
    if (L > 1n) lines.push(`\\text{clear fractions: }${tpoly([Q(C2), Q(B2), Q(A2)])}=0`);
    const disc = B2 * B2 - 4n * A2 * C2, twoA = 2n * A2;
    const bsq = B2 < 0n ? `(${B2})^2` : `${B2}^2`, fourac = `4${A2 === 1n ? "" : `(${A2})`}${C2 < 0n ? `(${C2})` : `(${C2})`}`;
    lines.push(`\\lambda=\\dfrac{${-B2}\\pm\\sqrt{${bsq}-${fourac}}}{${twoA}}`, `=\\dfrac{${-B2}\\pm\\sqrt{${disc}}}{${twoA}}`);
    const da = disc < 0n ? -disc : disc, [s, r] = sqrtSplit(da);
    if (R.kind === "rational") {
      lines.push(`=\\dfrac{${-B2}\\pm ${s}}{${twoA}}`, `\\lambda_1=${tq(R.roots[0])},\\qquad\\lambda_2=${tq(R.roots[1])}`);
      return { R, lines, why: `It doesn't factor with whole numbers, so use the quadratic formula with \\(a=${A2},\\ b=${B2},\\ c=${C2}\\).`, how: "formula" };
    }
    const rt = (s === 1n ? "" : String(s)) + (r === 1n ? "" : sq(r)) + (disc < 0n ? (r === 1n ? "i" : "\\,i") : "");
    const mid = `\\dfrac{${-B2}\\pm ${rt || "1"}}{${twoA}}`, fin = pair(R.a, R.b, R.r, disc < 0n);
    if (s !== 1n || disc < 0n) lines.push(`=${mid}${mid.replace(/\\dfrac/g, "\\frac") === fin ? "" : "=" + fin}`);
    else if (fin !== `\\frac{${-B2}\\pm ${rt}}{${twoA}}`) lines.push(`=${fin}`);
    const why = disc < 0n ? `The number under the square root is negative, so the eigenvalues are complex: a conjugate pair.`
      : `It doesn't factor with whole numbers, so use the quadratic formula with \\(a=${A2},\\ b=${B2},\\ c=${C2}\\).`;
    return { R, lines, why, how: "formula", pm: fin };
  };

  // ---------- row reduction of A − λI (exact, with the operations a student would write) ----------
  const reduce = (f, M0) => {
    const n = M0.length, M = M0.map(r => r.slice()), stages = [], piv = [];
    const isOne = x => f.eq(x, f.one) || f.eq(x, f.neg(f.one));
    let r = 0;
    for (let c = 0; c < n && r < n; c++) {
      let p = -1;
      if (!f.z(M[r][c])) p = r;
      else { for (let i = r + 1; i < n; i++) if (!f.z(M[i][c]) && (p < 0 || (isOne(M[i][c]) && !isOne(M[p][c])))) p = i; }
      if (p < 0) continue;
      const ops = [], hl = [];
      if (p !== r) { [M[r], M[p]] = [M[p], M[r]]; ops.push({ t: "swap", i: r, j: p }); hl.push(r, p); }
      for (let i = r + 1; i < n; i++) if (!f.z(M[i][c])) {
        const m = f.div(M[i][c], M[r][c]);
        M[i] = M[i].map((v, k) => f.sub(v, f.mul(m, M[r][k]))); M[i][c] = f.zero;
        ops.push({ t: "add", i, j: r, m: f.neg(m) }); if (!hl.includes(i)) hl.push(i);
      }
      if (ops.length) stages.push({ ops, M: M.map(x => x.slice()), hl });
      piv.push([r, c]); r++;
    }
    if (piv.length >= 2) {                     // two or more equations left: finish to reduced form, then read off
      const ops = [], hl = [];
      piv.forEach(([i, c]) => { if (!f.eq(M[i][c], f.one)) { const s = f.inv(M[i][c]); M[i] = M[i].map(v => f.mul(v, s)); ops.push({ t: "scale", i, m: s }); hl.push(i); } });
      if (ops.length) stages.push({ ops, M: M.map(x => x.slice()), hl });
      const ops2 = [], hl2 = [];
      for (let q = piv.length - 1; q >= 0; q--) {
        const [i, c] = piv[q];
        for (let k = 0; k < i; k++) if (!f.z(M[k][c])) { const m = M[k][c]; M[k] = M[k].map((v, t) => f.sub(v, f.mul(m, M[i][t]))); M[k][c] = f.zero; ops2.push({ t: "add", i: k, j: i, m: f.neg(m) }); if (!hl2.includes(k)) hl2.push(k); }
      }
      if (ops2.length) stages.push({ ops: ops2, M: M.map(x => x.slice()), hl: hl2 });
    }
    return { M, piv, stages, rank: piv.length };
  };
  // a vector of numbers a + b√r scaled to the smallest whole numbers (same direction)
  const scaleVec = (f, v) => {
    let L = 1n; v.forEach(x => { L = lcm(L, x.a.d); L = lcm(L, x.b.d); });
    let w = v.map(x => f.mk(qmul(x.a, Q(L)), qmul(x.b, Q(L))));
    let g = 0n; w.forEach(x => { g = gcd(g, x.a.n); g = gcd(g, x.b.n); });
    if (g > 1n) w = w.map(x => f.mk(qdiv(x.a, Q(g)), qdiv(x.b, Q(g))));
    return { v: w, k: Q(L, g || 1n) };
  };

  // ---------- the whole solution ----------
  const solve = A => {
    const n = A.length, f1 = F(1n);
    const tr = A.reduce((s, r, i) => qadd(s, r[i]), Q0);
    const Pm = A.map((row, i) => row.map((a, j) => i === j ? [a, qneg(Q1)] : [a]));   // A − λI, entries as polynomials
    const det2 = m => psub(pmul(m[0][0], m[1][1]), pmul(m[0][1], m[1][0]));
    const minor = (m, i, j) => m.filter((_, r) => r !== i).map(row => row.filter((_, c) => c !== j));
    const isZ = p => pdeg(p) < 0;
    const upper = A.every((row, i) => row.every((a, j) => j >= i || qz(a))), lower = A.every((row, i) => row.every((a, j) => j <= i || qz(a)));
    const tri = upper || lower;
    const AmL = tmat(A.map((row, i) => row.map((a, j) => tentry(a, i === j))));
    const steps = [];
    let charP, factors = null;                // factors: [[a, mult]] when det(A − λI) came out factored (triangular / one term)
    // Step 1 and 2: det(A − λI)
    if (n === 2) {
      const [[a, b], [c, d]] = A;
      charP = det2(Pm);
      if (tri) {
        factors = [[a, 1], [d, 1]];
        steps.push({ t: "Set up det(A − λI) = 0", why: `\\(\\lambda\\) is an eigenvalue exactly when \\(A-\\lambda I\\) sends some nonzero vector to \\(\\mathbf 0\\), so its determinant is 0. Here \\(A-\\lambda I\\) is triangular: its determinant is the product down the diagonal.`,
          lines: [`A-\\lambda I=${AmL}`, `\\det(A-\\lambda I)=(${tentry(a, true)})(${tentry(d, true)})`] });
      } else {
        steps.push({ t: "Set up det(A − λI) = 0", why: `\\(\\lambda\\) is an eigenvalue exactly when \\(A-\\lambda I\\) sends some nonzero vector to \\(\\mathbf 0\\), so its determinant is 0.`,
          lines: [`A-\\lambda I=${AmL}`, `\\det(A-\\lambda I)=(${tentry(a, true)})(${tentry(d, true)})-(${tq(b)})(${tq(c)})`] });
        const prod = pmul(Pm[0][0], Pm[1][1]), bc = qmul(b, c);
        steps.push({ t: "Multiply out: the characteristic polynomial", why: `Multiply out slowly. Check: the \\(\\lambda\\) term is \\(-(\\text{trace})\\,\\lambda\\) and the constant is \\(\\det A\\).`,
          lines: [`=(${tpoly(prod)})${qsgn(bc) < 0 ? "+" + tq(qneg(bc)) : "-" + tq(bc)}`, `=${tpoly(charP)}`] });
      }
    } else {
      // expand along the row or column with the most zeros (fewest terms); triangular: the diagonal
      let best = { zeros: -1 };
      for (let k = 0; k < 3; k++) {
        const zr = [0, 1, 2].filter(j => isZ(Pm[k][j])).length, zc = [0, 1, 2].filter(i => isZ(Pm[i][k])).length;
        if (zr > best.zeros) best = { zeros: zr, row: true, k };
        if (zc > best.zeros) best = { zeros: zc, row: false, k };
      }
      const cells = [0, 1, 2].map(t => best.row ? [best.k, t] : [t, best.k]).filter(([i, j]) => !isZ(Pm[i][j]));
      const terms = cells.map(([i, j]) => ({ i, j, s: (i + j) % 2 ? -1 : 1, e: Pm[i][j], diag: i === j, a: A[i][j], M: minor(Pm, i, j) }));
      terms.forEach(T => { T.m = det2(T.M); T.prod = pscale(pmul(T.e, T.m), Q(T.s)); });
      charP = terms.reduce((s, T) => padd(s, T.prod), [Q0]);
      const why1 = `\\(\\lambda\\) is an eigenvalue exactly when \\(A-\\lambda I\\) sends some nonzero vector to \\(\\mathbf 0\\), so its determinant is 0.`;
      if (tri) {
        factors = [[A[0][0], 1], [A[1][1], 1], [A[2][2], 1]];
        steps.push({ t: "Set up det(A − λI) = 0", why: why1 + ` Here \\(A-\\lambda I\\) is triangular: its determinant is the product down the diagonal.`,
          lines: [`A-\\lambda I=${AmL}`, `\\det(A-\\lambda I)=${[0, 1, 2].map(i => `(${tentry(A[i][i], true)})`).join("")}`] });
      } else {
        const line = best.row ? `row ${best.k + 1}` : `column ${best.k + 1}`;
        const tminor = T => tvm(T.M.map(row => row.map(p => pdeg(p) >= 1 ? tpoly(p) : tq(p[0]))));
        const head = T => T.diag ? `(${tentry(T.a, true)})` : (() => { const c = qmul(T.a, Q(T.s)); return qeq(qabs(c), Q1) ? (qsgn(c) < 0 ? "-" : "+") : (qsgn(c) < 0 ? "-" : "+") + tq(qabs(c)); })();
        const joinT = parts => parts.map((p, k) => k === 0 ? p.replace(/^\+/, "") : /^[+-]/.test(p) ? p : "+" + p).join("");
        steps.push({ t: "Set up det(A − λI) = 0", why: why1 + ` ${best.zeros ? `Expand along ${line}: it has the most zeros, so the fewest terms (the 0 entries drop out).` : `Expand along ${line}.`} The signs go \\(+\\,-\\,+\\).`,
          lines: [`A-\\lambda I=${AmL}`, terms.length < 2 ? `\\det(A-\\lambda I)=${joinT(terms.map(T => head(T) + tminor(T)))}`
            : `\\begin{aligned}\\det(A-\\lambda I)&=${head(terms[0]) + tminor(terms[0])}\\\\&\\quad${terms.slice(1).map(T => { const t = head(T) + tminor(T); return /^[+-]/.test(t) ? t : "+" + t; }).join("")}\\end{aligned}`] });
        // evaluate each 2 × 2 determinant, then multiply out
        const evalT = T => {
          const mm = T.m;
          if (T.diag) return `(${tentry(T.a, true)})${tpolyP(mm)}`;
          const c = qmul(T.a, Q(T.s)), sgn = qsgn(c) < 0 ? "-" : "+", ab = qabs(c);
          const lead = qeq(ab, Q1) && pdeg(mm) >= 1 ? sgn : sgn + tq(ab) + (pdeg(mm) >= 1 ? "" : "\\cdot");
          return lead + tpolyP(mm);
        };
        const brk = parts => parts.length < 2 ? `=${joinT(parts)}` : `\\begin{aligned}&=${parts[0]}\\\\&\\quad${parts.slice(1).map(t => /^[+-]/.test(t) ? t : "+" + t).join("")}\\end{aligned}`;
        const lines2 = [brk(terms.map(evalT))];
        if (terms.length === 1) {
          const T = terms[0];
          factors = null;
          steps.push({ t: "Work out the 2 × 2 determinant", why: `A \\(2\\times2\\) determinant is \\(ad-bc\\). Leave the factor \\((${tentry(T.a, true)})\\) alone: it already gives one eigenvalue.`, lines: lines2, single: T });
        } else {
          if (terms.length > 1) lines2.push(brk(terms.map(T => { const t = tpoly(T.prod); return pdeg(T.prod) >= 1 ? `(${t})` : (qsgn(T.prod[0]) < 0 ? t : "+" + t); })));
          lines2.push(`=${tpoly(charP)}`);
          steps.push({ t: "Multiply out: the characteristic polynomial", why: `Each \\(2\\times2\\) determinant is \\(ad-bc\\). Then multiply out and collect powers of \\(\\lambda\\). Check: the \\(\\lambda^2\\) coefficient is \\(\\operatorname{tr}A\\) and the constant is \\(\\det A\\).`, lines: lines2 });
        }
      }
    }
    const detA = peval(charP, Q0);

    // Step 3: the roots
    const mono = pmonic(charP);                 // λⁿ + … (same roots)
    const eig = [];                            // { kind: "q" | "s" | "c" | "x" | "xc", ... , am }
    const addQ = (q, k = 1) => { const e = eig.find(e => e.kind === "q" && qeq(e.q, q)); if (e) e.am += k; else eig.push({ kind: "q", q, am: k }); };
    const addQuad = (W) => {
      const R = W.R;
      if (R.kind === "double") addQ(R.root, 2);
      else if (R.kind === "rational") R.roots.forEach(q => addQ(q));
      else if (R.kind === "surd") { eig.push({ kind: "s", a: R.a, b: R.b, r: R.r, sg: 1, am: 1 }); eig.push({ kind: "s", a: R.a, b: R.b, r: R.r, sg: -1, am: 1 }); }
      else { eig.push({ kind: "c", a: R.a, b: R.b, r: R.r, sg: 1, am: 1 }); eig.push({ kind: "c", a: R.a, b: R.b, r: R.r, sg: -1, am: 1 }); }
    };
    const rootStep = { t: "Solve for λ", lines: [], why: "" };
    if (factors) {
      factors.forEach(([a]) => addQ(a));
      const names = eigList();
      rootStep.t = "Read off the eigenvalues";
      rootStep.lines.push(`${factors.map(([a]) => `(${tentry(a, true)})`).join("")}=0\\quad\\Rightarrow\\quad${names}`);
      rootStep.why = "Each factor gives one eigenvalue: the diagonal entries of a triangular matrix are its eigenvalues.";
    } else if (n === 2) {
      const W = quadWork(mono[1], mono[0]);
      addQuad(W); rootStep.lines = W.lines; rootStep.why = W.why;
      if (W.R.kind === "rational" || W.R.kind === "double") rootStep.lines.push(eigList());
    } else if (steps[steps.length - 1].single) {
      const T = steps[steps.length - 1].single, mq = pmonic(T.m);   // (a − λ)·(minor) with the minor quadratic
      addQ(T.a);
      const W = quadWork(mq[1], mq[0]);
      rootStep.lines.push(`(${tentry(T.a, true)})${tpolyP(T.m)}=0`);
      if (!qeq(mq[2], Q1) || !ptrim(T.m).every((c, i) => qeq(c, mq[i]))) rootStep.lines.push(`${tpoly(mq)}=0`);
      W.lines.forEach(L => rootStep.lines.push(L));
      addQuad(W);
      rootStep.why = `The factor \\((${tentry(T.a, true)})\\) gives \\(\\lambda=${tq(T.a)}\\). ` + W.why;
      rootStep.lines.push(eigList());
    } else {
      // a cubic: −(λ³ + …) = 0. Rational root test, divide, then the quadratic
      rootStep.lines.push(`${tpoly(charP)}=0`, `\\text{times }-1:\\quad ${tpoly(mono)}=0`);
      const rr = ratRoots(mono);
      if (rr.length) {
        const r = rr[0], [quo] = pdivmod(mono, [qneg(r), Q1]);
        const L = mono.reduce((a, c) => lcm(a, c.d), 1n), intP = mono.map(c => qmul(c, Q(L)));
        if (L === 1n && qint(r)) {
          const parts = [3, 2, 1, 0].map(k => qmul(mono[k], Q(r.n ** BigInt(k)))).filter(x => !qz(x));
          rootStep.lines.push(`\\lambda=${tq(r)}:\\quad ${parts.map((x, i) => (i && qsgn(x) >= 0 ? "+" : "") + tq(x)).join("")}=0\\ \\checkmark`);
          rootStep.why = `Try whole numbers that divide the constterm ${tq(mono[0])}`.replace("constterm", "constant term") + `; \\(\\lambda=${tq(r)}\\) works. Divide by \\((${r.n === 0n ? "\\lambda" : "\\lambda" + (qsgn(r) < 0 ? "+" + tq(qneg(r)) : "-" + tq(r))})\\) to get a quadratic.`;
          rootStep.why = rootStep.why.replace(/divide the constant term (.*?);/, (m0, c) => `divide the constant term \\(${c}\\);`);
        } else {
          if (L > 1n) rootStep.lines.push(`\\text{clear fractions: }${tpoly(intP)}=0`);
          rootStep.lines.push(`\\lambda=${tq(r)}\\ \\text{makes it }0\\ \\checkmark`);
          rootStep.why = `Rational root test: a root \\(\\tfrac pq\\) has \\(p\\) dividing the constant and \\(q\\) dividing the leading coefficient; \\(\\lambda=${tq(r)}\\) works. Divide to get a quadratic.`;
        }
        const lin = qz(r) ? "\\lambda" : `(\\lambda${qsgn(r) < 0 ? "+" + tq(qneg(r)) : "-" + tq(r)})`;
        rootStep.lines.push(`\\begin{aligned}&${tpoly(mono)}\\\\&\\quad=${lin}(${tpoly(quo)})\\end{aligned}`);
        addQ(r);
        const W = quadWork(quo[1], quo[0]);
        W.lines.forEach(Lx => rootStep.lines.push(Lx));
        addQuad(W);
        rootStep.why += " " + W.why;
        rootStep.lines.push(eigList());
      } else {
        // no rational root: a cubic that can't be factored by hand. Give the roots as decimals.
        const xs = realRootsNum(mono);
        if (xs.length === 3) xs.sort((a, b) => b - a).forEach(x => eig.push({ kind: "x", x, am: 1 }));
        else {
          const x = xs[0], c = fnum(mono), B2 = c[2] + x, C2 = c[1] + x * B2, re = -B2 / 2, im = Math.sqrt(Math.max(0, C2 - B2 * B2 / 4));
          eig.push({ kind: "x", x, am: 1 }, { kind: "xc", re, im, am: 1 }, { kind: "xc", re, im: -im, am: 1 });
        }
        const L = mono.reduce((a, c) => lcm(a, c.d), 1n), c0 = qmul(mono[0], Q(L));
        rootStep.t = "Look for a root";
        rootStep.lines.push({ html: `No rational number is a root (the rational root test${L === 1n ? `: none of the divisors of \\(${tq(c0)}\\) works` : ""}), so this cubic doesn't factor by hand. Its roots are irrational; to 3 decimal places:` });
        eig.forEach((e, i) => rootStep.lines.push(`\\lambda_${i + 1}\\approx ${e.kind === "x" ? fx(e.x) : fx(e.re) + (e.im < 0 ? "-" : "+") + fx(Math.abs(e.im)) + "i"}`));
        rootStep.why = "Exam problems are built so a root can be found; this matrix isn't. Change an entry to get a nicer one.";
      }
    }
    steps.push(rootStep);
    function fx(x) { const s = (Math.round(x * 1000) / 1000).toFixed(3).replace(/\.?0+$/, ""); return s === "-0" ? "0" : s; }

    // order: real eigenvalues from largest to smallest, then the complex pair
    const val = e => e.kind === "q" ? qnum(e.q) : e.kind === "s" ? qnum(e.a) + e.sg * qnum(e.b) * Math.sqrt(Number(e.r)) : e.kind === "x" ? e.x : -Infinity;
    if (!eig.some(e => e.kind === "x" || e.kind === "xc")) eig.sort((u, v) => (u.kind === "c") - (v.kind === "c") || val(v) - val(u) || v.sg - u.sg);
    eig.forEach(e => {
      if (e.kind === "q") { e.f = f1; e.x = f1.of(e.q); }
      if (e.kind === "s") { e.f = F(e.r); e.x = e.f.mk(e.a, e.sg > 0 ? e.b : qneg(e.b)); }
      e.real = e.kind === "q" || e.kind === "s" || e.kind === "x";
      e.num = e.kind === "x" ? e.x : e.real ? e.f.num(e.x) : null;
    });
    function eigList() {
      // the eigenvalues found so far, as the student writes them (pairs as ±)
      const parts = [];
      eig.forEach(e => {
        if (e.kind === "q") parts.push(e.am > 1 ? `\\lambda=${tq(e.q)}\\ (\\text{twice})`.replace("twice", e.am === 3 ? "three times" : "twice") : `\\lambda=${tq(e.q)}`);
      });
      const pr = eig.find(e => e.kind === "s" || e.kind === "c");
      if (pr) parts.push(`\\lambda=${pmTex(pr)}`);
      return parts.join(",\\qquad ");
    }
    function pmTex(e) {                         // a ± b√r or a ± b√r i
      const D = lcm(e.a.d, e.b.d), A0 = e.a.n * (D / e.a.d), Bn = e.b.n * (D / e.b.d);
      const rt = (Bn === 1n ? "" : String(Bn)) + (e.r === 1n ? "" : sq(e.r) + (e.kind === "c" ? "\\," : "")) + (e.kind === "c" ? "i" : "");
      const body = (A0 === 0n ? "" : String(A0)) + "\\pm " + (rt || "1");
      return D === 1n ? body : `\\frac{${body}}{${D}}`;
    }
    const lamTex = e => e.kind === "q" ? tq(e.q) : e.kind === "s" ? tf(e.f, e.x) : e.kind === "c" ? cTex(e.a, e.sg > 0 ? e.b : qneg(e.b), e.r) : e.kind === "x" ? fx(e.x) : fx(e.re) + (e.im < 0 ? "-" : "+") + fx(Math.abs(e.im)) + "i";
    function cTex(a, b, r) {                    // a + b√r i over a common denominator
      const D = lcm(a.d, b.d), A0 = a.n * (D / a.d), Bn = b.n * (D / b.d), Bab = Bn < 0n ? -Bn : Bn;
      const im = (Bab === 1n ? "" : String(Bab)) + (r === 1n ? "" : sq(r) + "\\,") + "i";
      const num = (A0 === 0n ? (Bn < 0n ? "-" : "") : `${A0}${Bn < 0n ? "-" : "+"}`) + im;
      return D === 1n ? num : `\\frac{${num}}{${D}}`;
    }

    // Step 4: the free check
    const exact = !eig.some(e => e.kind === "x" || e.kind === "xc");
    const all = []; eig.forEach(e => { for (let k = 0; k < e.am; k++) all.push(e); });
    {
      const lines = [];
      const sumT = all.map((e, i) => { const t = lamTex(e); return e.kind === "q" ? (qsgn(e.q) < 0 && i > 0 ? `(${t})` : t) : par(t); });
      const prodT = all.map(e => { const t = lamTex(e); return e.kind === "q" && qsgn(e.q) >= 0 ? t : par(t); });
      const pr = eig.filter(e => e.kind === "s" || e.kind === "c");
      if (exact) {
        const two = (a, b) => pr.length ? `\\begin{aligned}&${a}\\\\&\\quad${b}\\end{aligned}` : a + b;
        lines.push(two(`${all.map((_, i) => "\\lambda_" + (i + 1)).join("+")}=${sumT.join("+")}`, `=${tq(tr)}=\\operatorname{tr}A\\ \\checkmark`));
        let mid = "";
        if (pr.length) {                         // (a + b√r)(a − b√r) = a² ∓ b²r
          const p = pr[0], a2 = qmul(p.a, p.a), b2r = qmul(qmul(p.b, p.b), Q(p.r)), rest = all.filter(e => e.kind === "q");
          const pairV = p.kind === "s" ? qsub(a2, b2r) : qadd(a2, b2r), pairT = `(${tq(a2)}${p.kind === "s" ? "-" : "+"}${tq(b2r)})`;
          mid = "=" + rest.map(e => qsgn(e.q) < 0 ? `(${tq(e.q)})` : tq(e.q)).concat([pairT]).join("\\cdot ");
          if (rest.length === 0) mid = "=" + pairT.slice(1, -1);
          void pairV;
        }
        lines.push(two(`${all.map((_, i) => "\\lambda_" + (i + 1)).join("")}=${prodT.join("\\cdot ")}`, `${mid}=${tq(detA)}=\\det A\\ \\checkmark`));
      } else {
        const s = all.reduce((t, e) => t + (e.kind === "x" ? e.x : e.re), 0);
        lines.push(`\\lambda_1+\\lambda_2+\\lambda_3\\approx ${fx(s)}=${tq(tr)}=\\operatorname{tr}A`);
        lines.push(`\\lambda_1\\lambda_2\\lambda_3\\approx ${fx(xprod(all))}=${tq(detA)}=\\det A`);
      }
      steps.push({ t: "Check: trace and determinant", why: `The eigenvalues (with repeats) add up to the trace and multiply to the determinant.${exact ? " Both match." : ""}`, lines });
    }
    function xprod(es) { let re = 1, im = 0; es.forEach(e => { const a = e.kind === "x" ? e.x : e.re, b = e.kind === "x" ? 0 : e.im; [re, im] = [re * a - im * b, re * b + im * a]; }); return re; }

    // Steps 5…: an eigenvector for each real eigenvalue
    const vecs = [];                            // { e, f, v, num } in order: v₁, v₂, …
    let first = true;
    eig.filter(e => e.kind === "q" || e.kind === "s").forEach(e => {
      const f = e.f, lam = e.x;
      const M = A.map((row, i) => row.map((a, j) => i === j ? f.sub(f.of(a), lam) : f.of(a)));
      const R = reduce(f, M), lines = [], Am = tAminus(f, lam);
      const zeroM = M.every(row => row.every(x => f.z(x)));
      lines.push(`\\left[${Am}\\mid\\mathbf 0\\right]=${taug(f, M)}`);
      R.stages.forEach(S => lines.push(`\\xrightarrow{${S.ops.map(op => topLabel(f, op)).join(",\\ ")}}${taug(f, S.M, S.hl)}`));
      const free = [...Array(n).keys()].filter(c => !R.piv.some(p => p[1] === c));
