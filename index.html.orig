}
// a row operation in the course's notation: R₂ → R₂ − 3R₁, R₁ ↔ R₃, R₂ → ½R₂
function tdetOp(op) {
  const R = i => "R" + "₁₂₃"[i], GL = { "1/2": "½", "1/3": "⅓", "1/4": "¼", "2/3": "⅔", "3/4": "¾" };
