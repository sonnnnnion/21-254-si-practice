    const bw = Math.max(x1 - x0, 1.5), bh = Math.max(y1 - y0, 1.5), u = Math.min(430 / bw, 280 / bh, 92);
    const P = vzPlane(300 - u * (x0 + x1) / 2, 240 + u * (y0 + y1) / 2, u), lv = F.len(v), lw = F.len(w);
