  const corner = vzProjPatch(G), [a0, a1, b0, b1] = corner.ab, at = (a, b) => add(mul(a, G.w1), mul(b, G.w2)), gid = opt.gid || "vzPPfill";
  const cq = corner.map(pr), nearC = cq.reduce((a, q) => q[2] < a[2] ? q : a), farC = cq.reduce((a, q) => q[2] > a[2] ? q : a);
  plane += `<defs><linearGradient id="${gid}" gradientUnits="userSpaceOnUse" x1="${q2(nearC[0])}" y1="${q2(nearC[1])}" x2="${q2(farC[0])}" y2="${q2(farC[1])}"><stop offset="0" stop-color="${VZ.gold}" stop-opacity="${above ? .24 : .14}"/><stop offset="1" stop-color="${VZ.gold}" stop-opacity="${above ? .08 : .05}"/></linearGradient></defs>`;
  plane += `<path d="M${cq.map(P2).join("L")}Z" fill="url(#${gid})" stroke="${VZ.gold}" stroke-opacity=".7" stroke-width="1.5" stroke-linejoin="round"/>`;
  if (basis > .01) {
    let lat = "";
    for (let a = Math.ceil(a0); a <= a1; a++) if (a) lat += `M${P2(pr(at(a, b0)))}L${P2(pr(at(a, b1)))}`;
    for (let b = Math.ceil(b0); b <= b1; b++) if (b) lat += `M${P2(pr(at(a0, b)))}L${P2(pr(at(a1, b)))}`;
    plane += `<path d="${lat}" stroke="${VZ.gold}" stroke-opacity="${q2(.32 * basis)}" stroke-width="1" fill="none"/>`;
    // the lines of w₁ and w₂ across P: what the shadows fall on (brighter while their take is on)
    const lineOn = (w, a, b, col, k) => `<path d="M${P2(pr(mul(a, w)))}L${P2(pr(mul(b, w)))}" stroke="${col}" stroke-width="${q2(1.3 + k)}" stroke-dasharray="7 6" opacity="${q2((.3 + .45 * k) * basis)}" fill="none"/>`;
    plane += lineOn(G.w1, a0, a1, VZ.red, dropA * fadeA) + lineOn(G.w2, b0, b1, VZ.green, dropB * fadeB);
  }

  // ---- in P: the shadows, tip to tail, and their sum
  const thick = 6.5, shOp = 1 - .5 * dim;
  if (shA > 0 && len(G.p1) > .02) flat += `<g opacity="${q2(.55 * shOp)}">${vzArrow3(cam, O, mul(shA, G.p1), "R", thick)}</g>`;
  if (shB > 0 && len(G.p2) > .02) flat += `<g opacity="${q2(.55 * shOp)}">${vzArrow3(cam, O, mul(shB, G.p2), "N", thick)}</g>`;
  if (slide > 0 && len(G.p2) > .02) {                     // a copy of the second shadow slides to start at the tip of the first
    const st = mul(slide, G.p1);
    flat += `<g opacity="${q2(.55 * Math.min(1, slide * 3))}">${vzArrow3(cam, st, add(st, G.p2), "N", thick)}</g>`;
    flat += `<g opacity="${q2(.5 * slide)}">${vzPath3(cam, [G.p2, G.sum], `stroke="${VZ.red}" stroke-width="1.4" stroke-dasharray="4 5"`)}</g>`;
  }
  if (basis > .01) flat += `<g opacity="${q2(basis)}">${vzArrow3(cam, O, G.w1, "R", 2.4)}${vzArrow3(cam, O, G.w2, "N", 2.4)}</g>`;
  if (sumG > 0 && len(G.sum) > .02) flat += vzArrow3(cam, O, mul(sumG, G.sum), "O", 4.2);
