      o += P.line([0, 0], w, `stroke="${VZ.grey}" stroke-width="1.2" stroke-dasharray="6 6" opacity=".75"`);
      if (pl > 2) o += `<g opacity=".55">${P.arrow([0, 0], pr, "O", 11)}</g>`;
      if (ql > 2) {
        o += `<line x1="${q2(P.X(pr[0]))}" y1="${q2(P.Y(pr[1]))}" x2="${q2(P.X(v[0]))}" y2="${q2(P.Y(v[1]))}" stroke="${VZ.deep}" stroke-width="2" stroke-dasharray="5 4"/>`;
        if (pl > 14 && ql > 14) o += P.rightAngle(pr, F.unit(perp), [-sg * uw[0], -sg * uw[1]], 12 / u);
      }
