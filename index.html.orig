        <script>
/* ============================================================
   ROTATING HERO VISUALS
   Ten course pictures share the hero frame; each visit shows the next one
   (first-ever visit: the Riemann boxes). The static circulation picture in
   the markup is only the no-script fallback. Clicking the picture
   also moves on. The new pictures are pure functions of time, drawn with
   requestAnimationFrame only while the home page is on screen; with reduced
   motion each shows one still frame.
   ============================================================ */
(function () {
  "use strict";
  const svg = document.getElementById("heroArt");
  if (!svg) return;
  const TEST = window.HERO_TEST || null;                 // harness only: { h, t }
  const RED = "#C8102E", DEEP = "#9A0B22", GREY = "#6B7682", INK = "#1F2933", SUB = "#4F5965";   // SUB: small print, darker for contrast
  const TAU = Math.PI * 2;
  const reduce = !!(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches);
  const clamp01 = x => x < 0 ? 0 : x > 1 ? 1 : x;
  const smooth = (a, b, x) => { const u = clamp01((x - a) / (b - a)); return u * u * (3 - 2 * u); };
  const ease = x => x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
  const n2 = v => Math.round(v * 100) / 100;
  const P = (x, y) => n2(x) + " " + n2(y);

  /* Hero formulas, typeset ahead of time by the site's own MathJax (tools/hero_tex.mjs) so the
     pictures carry real math typography with no runtime dependency. {vb: viewBox, g: glyph paths} */
