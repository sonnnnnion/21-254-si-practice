  return `${R(op[1])} → ${R(op[1])} ${op[3].n < 0n ? "−" : "+"} ${mag(op[3])}${R(op[2])}`;
}

/* The board's typesetting: boxes {w, up, dn, d(x, cy, op)} that know their size (from a table of character widths
