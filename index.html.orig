  },
  // the view that shows the scene best: its main plane (v and w's, or the plane itself) seen at a slant, so the
  // normal still stands out; among views about as good, the one nearest the current view (so a change turns it little)
  bestView(s) {
    const F = TVEC_F, op = this.op(s), g = k => Number.isFinite(+s[k]) ? +s[k] : 0, V = ks => ks.map(g);
    let n, along = null, target = 52, show = [];                // show: arrows that should not be seen end-on
    if (op <= 2) { const v = V(["v1", "v2", "v3"]), w = V(["w1", "w2", "w3"]); n = F.cross(v, w); along = F.len(v) > F.len(w) ? v : w; target = op < 2 ? 32 : 40; show = [v, w]; }
    else if (op === 3) { const P = V(["p1", "p2", "p3"]), u = F.sub(V(["q1", "q2", "q3"]), P), w = F.sub(V(["r1", "r2", "r3"]), P); n = F.cross(u, w); along = F.len(u) > F.len(w) ? u : w; show = [u, w]; }
    else {
