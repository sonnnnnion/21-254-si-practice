    "The meeting points (dots) give the range of x; each vertical strip runs from the parabola up to the line. Integrate x + y along each strip, then add up the strips.", { formula: "\\iint_D(x+y)\\,dA=\\int_{a}^{b}\\!\\int_{x^2}^{2-x}(x+y)\\,dy\\,dx" });
};

SKETCH["doublegreen-004"] = () => {
  const { S, P } = sk2D([[-2.2, 0], [.4, 2.2]], { xr: [-2.5, .9], yr: [-.4, 2.5] });
  const ring = (r0, r1, a0, a1, o) => { const pts = []; for (let i = 0; i <= 30; i++) { const t = a0 + (a1 - a0) * i / 30; pts.push(P([r1 * Math.cos(t), r1 * Math.sin(t)])); }
    for (let i = 30; i >= 0; i--) { const t = a0 + (a1 - a0) * i / 30; pts.push(P([r0 * Math.cos(t), r0 * Math.sin(t)])); } S.region(pts, o); };
  ring(1, 2, Math.PI / 2, Math.PI, { fop: .09 });
  for (let k = 1; k < 4; k++) { const t = Math.PI / 2 + k * Math.PI / 8; S.line(P([Math.cos(t), Math.sin(t)]), P([2 * Math.cos(t), 2 * Math.sin(t)]), { color: SKC.red, w: .8, op: .3, free: true }); }
  [1.25, 1.5, 1.75].forEach(r => skCurve(S, P, t => [r * Math.cos(t), r * Math.sin(t)], Math.PI / 2, Math.PI, { color: SKC.red, w: .8, op: .3, free: true }));
  skPolarCell(S, P, 1.35, 1.75, 2.2, 2.6);
  S.label("r=1", P([Math.cos(2.95), Math.sin(2.95)]), { color: SKC.red, dir: [1, 0], size: 13 }); S.label("r=2", P([2 * Math.cos(1.72), 2 * Math.sin(1.72)]), { color: SKC.red, dir: [.3, -1], size: 13 });
  S.note("a polar cell: sides dr and r dθ, so dA = r dr dθ", 392, 238, { anchor: "end" });
  return skDone("An annular sector is a rectangle in polar coordinates", S.svg("Annular sector"),
    "Describe D with a range of r and a range of θ, then use x² + y² = r² and dA = r dr dθ.", { formula: "\\iint_D(x^2+y^2)\\,dA=\\int_{\\theta_1}^{\\theta_2}\\!\\int_{r_1}^{r_2}r^2\\cdot r\\,dr\\,d\\theta" });
};

SKETCH["doublegreen-005"] = () => {
  const { S, P } = sk2D([[0, 0], [2, 2]], { xr: [-.4, 2.7], yr: [-.4, 2.6] });
  const pts = [P([0, 0])]; for (let i = 0; i <= 40; i++) { const t = Math.PI / 2 * i / 40; pts.push(P([2 * Math.cos(t), 2 * Math.sin(t)])); }
  S.region(pts, { fop: .09 });
  for (let k = 1; k < 4; k++) { const t = k * Math.PI / 8; S.line(P([0, 0]), P([2 * Math.cos(t), 2 * Math.sin(t)]), { color: SKC.red, w: .8, op: .3, free: true }); }
  [.5, 1, 1.5].forEach(r => skCurve(S, P, t => [r * Math.cos(t), r * Math.sin(t)], 0, Math.PI / 2, { color: SKC.red, w: .8, op: .3, free: true }));
  skPolarCell(S, P, 1.1, 1.5, .55, .95);
  S.label("y=\\sqrt{4-x^2}", P([2 * Math.cos(1.25), 2 * Math.sin(1.25)]), { color: SKC.red, dir: [1, -.4], size: 13.5 });
  S.note("a polar cell: sides dr and r dθ, so dA = r dr dθ", 392, 238, { anchor: "end" });
  return skDone("The region is a quarter disk: describe it with r and θ", S.svg("Quarter disk in polar"),
    "x² + y² = r² turns e^{x²+y²} into e^{r²}, and the extra r in dA = r dr dθ is exactly what makes it integrable (substitute u = r²).", { formula: "x^2+y^2=r^2,\\qquad dA=r\\,dr\\,d\\theta" });
};

SKETCH["doublegreen-006"] = () => {
  const S = skNew(400, 250); S.grid();
  const Puv = skFit2([[-.3, -.3], [2.6, 3.4]], 170, 210, { pad: 22 }), L = p => { const q = Puv(p); return [q[0] + 4, q[1] + 26]; };
  const xy = (u, v) => [(u + v) / 2, (u - v) / 2];
  const Pxy0 = skFit2([[-.3, -1.8], [2.8, .8]], 180, 210, { pad: 22 }), R = p => { const q = Pxy0(p); return [q[0] + 214, q[1] + 26]; };
  const axes = (Pf, xr, yr, nx, ny) => { S.arrow(Pf([xr[0], 0]), Pf([xr[1], 0]), { color: SKC.faint, w: 1.1, head: 7 }); S.arrow(Pf([0, yr[0]]), Pf([0, yr[1]]), { color: SKC.faint, w: 1.1, head: 7 });
    S.label(nx, Pf([xr[1], 0]), { size: 13, color: SKC.grey, dir: [.4, 1], dist: 4 }); S.label(ny, Pf([0, yr[1]]), { size: 13, color: SKC.grey, dir: [1, .2], dist: 4 }); };
  axes(L, [-.3, 2.5], [-.3, 3.4], "u", "v"); axes(R, [-.3, 2.8], [-1.8, .8], "x", "y");
  S.region([L([0, 1]), L([2, 1]), L([2, 3]), L([0, 3])], { fill: SKC.ink, fop: .08, stroke: SKC.ink, w: 1.5 });
  S.region([[0, 1], [2, 1], [2, 3], [0, 3]].map(p => R(xy(...p))), { fop: .12 });
  S.arrow([178, 110], [206, 110], { color: SKC.grey, w: 1.6 });
  S.label("\\text{area }4", L([1, 2]), { at: L([1, 2]), size: 13.5, color: SKC.ink });
  S.label("\\text{area}\\times|J|", R(xy(1, 2)), { at: R(xy(1, 2)), size: 13.5, color: SKC.deep });
  S.note("solve for x and y in terms of u and v, then find J = ∂(x, y)/∂(u, v)", 200, 242, { anchor: "middle", color: SKC.deep });
  return skDone("The uv rectangle maps onto the parallelogram", S.svg("Linear change of variables"),
    "0 ≤ u ≤ 2 and 1 ≤ v ≤ 3 describe the parallelogram exactly. Every area gets multiplied by the Jacobian |J|, and the integrand x + y is just u.", { scaled: false, formula: "\\iint_D(x+y)\\,dA=\\iint_R u\\,\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|du\\,dv" });
};

SKETCH["doublegreen-007"] = () => {
  const S = skNew(400, 250); S.grid();
  const L0 = skFit2([[-1.3, -1.3], [1.3, 1.3]], 160, 210, { pad: 22 }), L = p => { const q = L0(p); return [q[0] + 10, q[1] + 26]; };
  const R0 = skFit2([[-2.4, -3.3], [2.4, 3.3]], 190, 210, { pad: 14 }), R = p => { const q = R0(p); return [q[0] + 206, q[1] + 26]; };
  const circ = (Pf, a, b, o) => skCurve(S, Pf, t => [a * Math.cos(t), b * Math.sin(t)], 0, 2 * Math.PI, Object.assign({ free: true, n: 120, close: true }, o));
  [.33, .67].forEach(r => { circ(L, r, r, { color: SKC.ink, w: .8, op: .35 }); circ(R, 2 * r, 3 * r, { color: SKC.red, w: .8, op: .35 }); });
  circ(L, 1, 1, { color: SKC.ink, w: 1.6, fill: SKC.ink, fop: .06 }); circ(R, 2, 3, { color: SKC.red, w: 1.6, fill: SKC.red, fop: .1 });
  S.arrow([174, 118], [206, 118], { color: SKC.grey, w: 1.6 });
  S.label("r\\le 1", L([0, 0]), { at: L([0, 0]), size: 14 }); S.label("\\tfrac{x^2}4+\\tfrac{y^2}9\\le1", R([0, 0]), { at: R([0, 0]), size: 13.5, color: SKC.deep });
  S.note("x = 2r cos θ, y = 3r sin θ: how much does it stretch areas?", 200, 242, { anchor: "middle", color: SKC.deep });
  return skDone("Stretch the unit disk by 2 across and 3 up: the ellipse", S.svg("Ellipse from a disk"),
    "The substitution turns the ellipse into r ≤ 1 and the integrand x²/4 + y²/9 into r². Compute the Jacobian and integrate over 0 ≤ r ≤ 1, 0 ≤ θ ≤ 2π.", { scaled: false, formula: "dA=\\left|\\frac{\\partial(x,y)}{\\partial(r,\\theta)}\\right|dr\\,d\\theta" });
};

SKETCH["doublegreen-008"] = () => {
  const { S, P } = sk2D([[0, 1], [2, 3]], { xr: [-.5, 2.8], yr: [-.3, 3.6] });
  const n = 8; for (let i = 0; i < n; i++) { const x0 = 2 * i / n, x1 = 2 * (i + 1) / n; S.region([P([x0, 1]), P([x1, 1]), P([x1, 3]), P([x0, 3])], { fill: SKC.red, fop: .04 + .3 * (x0 + x1) / 4, stroke: false, w: 0 }); }
  const r = t => t < .25 ? [8 * t, 1] : t < .5 ? [2, 1 + 8 * (t - .25)] : t < .75 ? [2 - 8 * (t - .5), 3] : [0, 3 - 8 * (t - .75)];
  S.path([P([0, 1]), P([2, 1]), P([2, 3]), P([0, 3])], { stroke: SKC.ink, w: 2, close: true, free: true });
  skFlowArrows(S, P, r, [.125, .375, .625, .875], SKC.ink);
  S.label("Q_x-P_y", P([1, 2]), { at: P([1, 2]), size: 14, color: SKC.deep, halo: 3 });
  S.note("darker = more spin: more circulation", 392, 238, { anchor: "end" });
  return skDone("Green's theorem: add up the spin Q_x − P_y inside the rectangle", S.svg("Green's theorem on a rectangle"),
    "The boundary runs counterclockwise, so the line integral equals the double integral of Q_x − P_y over the rectangle. Find Q_x − P_y first.", { formula: "\\oint_C P\\,dx+Q\\,dy=\\iint_R(Q_x-P_y)\\,dA" });
};

SKETCH["doublegreen-009"] = () => {
  const { S, P } = sk2D([[-2.2, -2.2], [2.2, 2.2]], { xr: [-2.6, 2.8], yr: [-2.5, 2.6] });
  skCurve(S, P, t => [2 * Math.cos(t), 2 * Math.sin(t)], 0, 2 * Math.PI, { color: SKC.red, w: 2, free: true, n: 120, close: true, fill: SKC.red, fop: .08 });
  skFlowArrows(S, P, t => [2 * Math.cos(-2 * Math.PI * t), 2 * Math.sin(-2 * Math.PI * t)], [.1, .35, .6, .85], SKC.red);
  S.label("\\text{clockwise}", P([2 * Math.cos(-.5), 2 * Math.sin(-.5)]), { color: SKC.red, dir: [1, .3], size: 13.5 });
  S.label("Q_x-P_y", P([0, .3]), { at: P([0, .25]), size: 15, color: SKC.deep, halo: 3 });
  S.note("Green's theorem assumes counterclockwise; clockwise flips the sign", 392, 238, { anchor: "end", color: SKC.deep });
  return skDone("Clockwise is the negative orientation, so Green's answer flips sign", S.svg("Orientation in Green's theorem"),
    "Compute Q_x − P_y and integrate it over the disk for the counterclockwise value; going clockwise gives the negative of that.", { formula: "\\oint_{C,\\ \\text{clockwise}}=-\\iint_D(Q_x-P_y)\\,dA" });
};

SKETCH["doublegreen-010"] = () => {
  const { S, P } = sk2D([[-2.2, 0], [2.2, 2.2]], { xr: [-2.6, 2.8], yr: [-.5, 2.6] });
  const n = 7; for (let i = 0; i < n; i++) { const y0 = 2 * i / n, y1 = 2 * (i + 1) / n, band = []; const half = y => Math.sqrt(Math.max(0, 4 - y * y));
    for (let k = 0; k <= 10; k++) { const y = y0 + (y1 - y0) * k / 10; band.push(P([half(y), y])); } for (let k = 10; k >= 0; k--) { const y = y0 + (y1 - y0) * k / 10; band.push(P([-half(y), y])); }
    S.region(band, { fill: SKC.red, fop: .04 + .3 * (y0 + y1) / 4, stroke: false, w: 0 }); }
  const r = t => t < .6 ? [2 * Math.cos(Math.PI * t / .6), 2 * Math.sin(Math.PI * t / .6)] : [-2 + 4 * (t - .6) / .4, 0];
  const pts = []; for (let i = 0; i <= 80; i++) pts.push(P(r(i / 80)));
  S.path(pts, { stroke: SKC.ink, w: 2, free: true });
  skFlowArrows(S, P, r, [.15, .45, .8], SKC.ink);
  S.label("Q_x-P_y", P([0, .9]), { at: P([0, .85]), size: 15, color: SKC.deep, halo: 3 });
  S.note("the flat edge (y = 0) contributes nothing: −y²/2 = 0 there", 392, 238, { anchor: "end" });
  return skDone("Green turns the boundary integral into a double integral over the half-disk", S.svg("Green's theorem on a half-disk"),
    "Here P = −y²/2 and Q = 0. Compute Q_x − P_y, then integrate it over the half-disk in polar coordinates.", { formula: "\\oint_C P\\,dx+Q\\,dy=\\iint_D(Q_x-P_y)\\,dA" });
};

/* ---------- SI walkthrough board sketches ----------
   One drawing per visualSpec type in walkthroughs/*.json, built from the spec's own numbers with the
   same kit as the problem sketches (paper grid, TeX labels from SK_TEX, labels that steer clear of
   lines). renderVisualSpec() uses WALK_SKETCH[type](spec) when it exists. Where a spec leaves out the
   function or field, the sketch carries the one from its problem (noted beside it). */
const WALK_SKETCH = {};
// draw one board sketch with its labels a size up (they are read from across a room, and on phones)
function walkSketch(type, spec) {
  SK_LS = 1.16;
  try { return WALK_SKETCH[type](spec); } finally { SK_LS = 1; }
}
const wsTup = v => "(" + v.map(x => String(x)).join(",") + ")";
const wsDir = (P, a, b) => [P(b)[0] - P(a)[0], P(b)[1] - P(a)[1]];
const wsPerp = d => [d[1], -d[0]];
// a camera that looks straight at the plane spanned by a and b, turned a little so it still reads as 3-D
function wsFace(a, b, tilt = .16) {
  let n = sk3.unit(sk3.cross(a, b)); if (n[2] < 0) n = n.map(v => -v);
  return { yaw: Math.atan2(-n[0], -n[1]) + tilt, pitch: Math.max(.08, Math.asin(Math.min(1, n[2])) - tilt * .8) };
}
// a label pinned in a corner of the frame (row counts down from the top or up from the bottom)
function wsTag(S, tex, corner, o = {}) {
  const size = o.size || 14, [w, h] = skTexBox(tex, size * SK_LS), m = 10, row = o.row || 0;
  const x = corner[1] === "r" ? S.W - m - w / 2 : m + w / 2;
  const y = corner[0] === "t" ? m + h / 2 + row * (h + 6) : S.H - m - h / 2 - row * (h + 6);
  S.raw("label", `<rect x="${skN(x - w / 2 - 5)}" y="${skN(y - h / 2 - 3)}" width="${skN(w + 10)}" height="${skN(h + 6)}" rx="5" fill="${SKC.paper}" fill-opacity=".94"/>`);
  S.label(tex, [x, y], { at: [x, y], size, color: o.color || SKC.deep });
}
// arc at c (world) from direction u toward direction v, radius r (world)
function wsArc3(S, P, c, u, v, r, o = {}) {
  const uu = sk3.unit(u), vu = sk3.unit(v), ww = sk3.unit(sk3.sub(vu, sk3.mul(uu, sk3.dot(vu, uu))));
  const th = Math.acos(Math.max(-1, Math.min(1, sk3.dot(uu, vu)))), n = 24, pts = [];
  for (let i = 0; i <= n; i++) { const t = th * i / n; pts.push(P(sk3.add(c, sk3.add(sk3.mul(uu, r * Math.cos(t)), sk3.mul(ww, r * Math.sin(t)))))); }
  S.path(pts, { stroke: o.color || SKC.grey, w: o.w || 1.4, free: true });
  return pts;
}
// a circle of radius r around axis a through c, drawn with the right-hand rule (counterclockwise seen from the tip of a)
function wsSpin3(S, P, c, a, r, o = {}) {
  const k = sk3.unit(a), t = Math.abs(k[2]) < .9 ? [0, 0, 1] : [1, 0, 0];
  const e1 = sk3.unit(sk3.cross(k, t)), e2 = sk3.cross(k, e1), pts = [];
  for (let i = 0; i <= 40; i++) { const s = (.15 + 1.62 * i / 40) * Math.PI; pts.push(P(sk3.add(c, sk3.add(sk3.mul(e1, r * Math.cos(s)), sk3.mul(e2, r * Math.sin(s)))))); }
  S.path(pts, { stroke: o.color || SKC.red, w: 1.6, free: true });
  S.arrow(pts[37], pts[40], { color: o.color || SKC.red, w: 1.6, head: 8 });
}
// unit square (left) and its image under the matrix with columns c1, c2 (right)
function wsSquareMap(c1, c2, o = {}) {
  const S = skNew(400, 250); S.grid();
  const Pl = skPanel2(S, 6, 18, 150, 214, [-.45, 1.5], [-.45, 1.5]);
  const xs = [0, c1[0], c2[0], c1[0] + c2[0]], ys = [0, c1[1], c2[1], c1[1] + c2[1]];
  const Pr = skPanel2(S, 196, 12, 200, 226, [Math.min(...xs) - .6, Math.max(...xs) + .7], [Math.min(...ys) - .6, Math.max(...ys) + .7]);
  S.region([Pl([0, 0]), Pl([1, 0]), Pl([1, 1]), Pl([0, 1])], { fill: SKC.grey, fop: .12, stroke: SKC.grey, w: 1.2, free: true });
  S.region([Pr([0, 0]), Pr(c1), Pr(sk3.add(c1, c2)), Pr(c2)], { fop: .1, w: 1.3, free: true });
  skVec2(S, Pl, [0, 0], [1, 0], { color: SKC.red, label: "e_1", dir: [.3, 1] });
  skVec2(S, Pl, [0, 0], [0, 1], { color: SKC.gold, label: "e_2", dir: [-1, -.2] });
  skVec2(S, Pr, [0, 0], c1, { color: SKC.red, label: o.l1 || "Ae_1" });
  skVec2(S, Pr, [0, 0], c2, { color: SKC.gold, label: o.l2 || "Ae_2" });
  S.arrow([158, 125], [192, 125], { color: SKC.ink, w: 1.8 });
  S.label(o.map || "A", [175, 125], { dir: [0, -1], size: 15, dist: 8 });
  S.note("area 1", ...(p => [p[0], p[1] + 4])(Pl([.5, .5])), { anchor: "middle", size: 12 });
  const m = Pr(sk3.mul(sk3.add(c1, c2), .5));
  S.note(o.area, m[0], m[1] + 4, { anchor: "middle", size: 12, color: SKC.deep });
  return { S, Pl, Pr };
}

/* ---- vectors ---- */
WALK_SKETCH.point_to_vector_3d = s => {
  const A = s.points.A, B = s.points.B, O = [0, 0, 0];
  const { S, P } = sk3D([A, B], { pad: 30 });
  S.line(P(O), P(A), { color: SKC.faint, w: 1.2, dash: "4 4" });
  S.line(P(O), P(B), { color: SKC.faint, w: 1.2, dash: "4 4" });
  S.arrow(P(A), P(B), { color: SKC.red, w: 2.5 });
  S.point(P(A)); S.point(P(B));
  S.label("A", P(A), { dir: [-1, -.5] }); S.label("B", P(B), { dir: [1, .3] });
  S.label("\\overrightarrow{AB}=B-A", P(sk3.mul(sk3.add(A, B), .5)), { color: SKC.red, size: 14, dir: wsPerp(wsDir(P, A, B)) });
  return S.svg("The arrow from A to B");
};

WALK_SKETCH.perpendicular_vectors_2d_exact = s => {
  const u = s.vectors.u, v = s.vectors.v_after_solving || s.vectors.v, O = [0, 0];
  const { S, P } = sk2D([u, v], { pad: 22 });
  S.rightAngle(P(O), P(u), P(v), 10);
  skVec2(S, P, O, u, { color: SKC.red, label: "u=" + wsTup(u) });
  skVec2(S, P, O, v, { color: SKC.ink, label: "v=" + wsTup(v) });
  S.point(P(O), { r: 3 });
  S.label("u\\cdot v=0", P(O), { color: SKC.deep, size: 14, dir: [1, 1.4], dist: 16 });
  return S.svg("u and v at a right angle");
};

WALK_SKETCH.subspace_plane_through_origin = s => {
  const [b1, b2] = s.basisVectors, n = s.normalVector, O = [0, 0, 0], ru = [-1, 1.35], rv = [-1, 1.35];
  const at = (a, b) => sk3.add(sk3.mul(b1, a), sk3.mul(b2, b));
  const f = wsFace(b1, b2, .6);
  const { S, P } = sk3D([at(ru[0], rv[0]), at(ru[1], rv[0]), at(ru[1], rv[1]), at(ru[0], rv[1])], { yaw: f.yaw, pitch: f.pitch, pad: 26 });
  skPatch3(S, P, O, b1, b2, { ru, rv, fop: .08 });
  const edge = [at(ru[0], rv[0]), at(ru[1], rv[0]), at(ru[1], rv[1]), at(ru[0], rv[1])].map(P);
  edge.forEach((q, i) => S.line(q, edge[(i + 1) % 4], { w: 0, op: 0 }));                  // labels keep off the plane's edges
  skVec3(S, P, O, b1, { color: SKC.red, label: wsTup(b1), size: 14 });
  skVec3(S, P, O, b2, { color: SKC.gold, label: wsTup(b2), size: 14 });
  S.point(P(O), { r: 3 });
  wsTag(S, "W:\\ " + (s.equation || "").replace(/\s+/g, ""), "tr");
  return S.svg("The plane W through the origin");
};

WALK_SKETCH.three_vectors_span_r3 = s => {
  const { v1, v2, v3, b } = s.vectors, O = [0, 0, 0];
  const { S, P } = sk3D([v1, v2, v3, b], { yaw: -1.95, pitch: .3, pad: 28 });
  skVec3(S, P, O, b, { color: SKC.grey, w: 1.8, dash: "6 4", label: "b", labelColor: SKC.grey });
  skVec3(S, P, O, v1, { color: SKC.red, label: "v_1" });
  skVec3(S, P, O, v2, { color: SKC.gold, label: "v_2" });
  skVec3(S, P, O, v3, { color: SKC.ink, label: "v_3" });
  S.point(P(O), { r: 3 });
  return S.svg("Three vectors and the target b");
};

WALK_SKETCH.basis_coordinate_system_3d = s => {
  const { b1, b2, b3 } = s.basisVectors, v = s.targetVector, c = s.coordinateVector || [], O = [0, 0, 0];
  const bs = [b1, b2, b3], cols = [SKC.red, SKC.gold, SKC.green], names = ["b_1", "b_2", "b_3"];
  const { S, P } = sk3D([b1, b2, b3, v], { yaw: -2.75, pitch: .42, pad: 28 });
  bs.forEach((b, i) => skVec3(S, P, O, b, { color: cols[i], label: names[i], size: 14.5 }));
  skVec3(S, P, O, v, { color: SKC.ink, w: 2.6, label: "v" });
  S.point(P(O), { r: 3 });
  if (c.length === 3) wsTag(S, "[v]_B=" + wsTup(c), "tr");
  return S.svg("v built from the basis vectors");
};

WALK_SKETCH.linear_transformation_standard_matrix_2d = s => {
  const { S } = wsSquareMap(s.basisImages.e1, s.basisImages.e2, { l1: "T(e_1)", l2: "T(e_2)", map: "T", area: "area " + Math.abs(s.determinant) });
  return S.svg("The unit square and its image under T");
};

WALK_SKETCH.linear_transform_area_scaling_2d = s => {
  const A = s.matrix, c1 = [A[0][0], A[1][0]], c2 = [A[0][1], A[1][1]], d = s.determinant;
  const { S, Pl, Pr } = wsSquareMap(c1, c2, { area: "area " + Math.abs(d) });
  // turning direction: e1 to e2 is counterclockwise; if det < 0, Ae1 to Ae2 turns the other way
  const a = v => Math.atan2(-v[1], v[0]);
  S.arc(Pl([0, 0]), 20, a([1, 0]) - .12, a([0, 1]) + .25, { color: SKC.grey, arrow: true });
  S.arc(Pr([0, 0]), 22, a(c1) + (d < 0 ? .1 : -.1), a(c2) + (d < 0 ? -.2 : .2), { color: d < 0 ? SKC.deep : SKC.grey, arrow: true });
  if (d < 0) S.note("det A < 0: the turn from Ae₁ to Ae₂ flips", 392, 242, { anchor: "end", size: 11.5, color: SKC.deep });
  return S.svg("The unit square and its image under A");
};

WALK_SKETCH.vector_arithmetic_dot_angle = s => {
  const { u, v } = s.vectors, O = [0, 0, 0], f = wsFace(u, v);
  const { S, P } = sk3D([u, v, O], { yaw: f.yaw, pitch: f.pitch, noAxes: true, pad: 34 });
  const r = Math.min(sk3.len(u), sk3.len(v)) * .28, arc = wsArc3(S, P, O, u, v, r, { color: SKC.deep });
  skVec3(S, P, O, u, { color: SKC.red, label: "u" });
  skVec3(S, P, O, v, { color: SKC.ink, label: "v" });
  S.point(P(O), { r: 3 });
  const mid = arc[12];
  S.label("\\theta", mid, { color: SKC.deep, size: 14, dir: [mid[0] - P(O)[0], mid[1] - P(O)[1]], dist: 6 });
  wsTag(S, "u\\cdot v=" + s.dotProduct + "<0", "br");
  S.note("so θ is " + (s.angleType || "obtuse"), 390, 214, { anchor: "end", size: 12, color: SKC.deep });
  return S.svg("The angle between u and v");
};

WALK_SKETCH.eigenvector_invariant_directions = s => {
  const E = Object.entries(s.eigenvectors).map(([k, v]) => ({ lam: +String(k).replace(/\D/g, ""), v }));
  const cols = [SKC.red, SKC.gold], big = Math.max(...E.map(e => e.lam));
  // drawn not to scale: each v is shortened so that Av = λv fits beside the other direction
  const { S, P } = skEigen2(E.map((e, i) => {
    const u = sk3.unit(e.v), L = 1.1 + 2.6 * e.lam / big;
    return { v: u.map(c => c * L / e.lam), lam: e.lam, color: cols[i], vTex: wsTup(e.v), AvTex: e.lam + "\\," + wsTup(e.v) };
  }));
  E.forEach((e, i) => { const u = sk3.unit(e.v).map(c => -c * 1.7); S.label("\\lambda=" + e.lam, P(u), { color: cols[i], size: 15, dir: wsPerp(wsDir(P, [0, 0], u)) }); });
  return S.svg("The two eigenvector directions");
};

WALK_SKETCH.projection_2d_exact = s => {
  const { a, b, projection: p, perpendicular: q } = s.vectors, O = [0, 0];
  const { S, P } = sk2D([a, b, p], { pad: 24 });
  const u = sk3.unit(a), R = Math.max(sk3.len(p), sk3.len(b)) * 1.15;
  S.line(P(u.map(c => -c * R * .25)), P(u.map(c => c * R)), { color: SKC.faint, w: 1.1, dash: "5 5" });
  S.rightAngle(P(p), P(O), P(b), 9);
  skVec2(S, P, O, p, { color: SKC.red, w: 3, label: "\\operatorname{proj}_a b", dir: [.6, 1] });
  skVec2(S, P, O, a, { color: SKC.ink, label: "a", dir: wsPerp(wsDir(P, O, a)).map(c => -c) });
  skVec2(S, P, O, b, { color: SKC.ink, label: "b" });
  S.arrow(P(p), P(b), { color: SKC.gold, w: 2, dash: "5 4" });
  S.label("b_{\\perp}", P(sk3.mul(sk3.add(p, b), .5)), { color: SKC.gold, dir: [1, 0] });
  S.point(P(O), { r: 3 });
  return S.svg("b split into a part along a and a part perpendicular to a");
};

WALK_SKETCH.projection_3d_concept = s => {
  const { u, v, projection: p } = s.vectors, O = [0, 0, 0], f = wsFace(u, v);
  const { S, P } = sk3D([u, v, p, O], { yaw: f.yaw, pitch: f.pitch, noAxes: true, pad: 30 });
  const uu = sk3.unit(u), R = Math.max(sk3.len(p), sk3.len(v)) * 1.12;
  skLine3(S, P, O, uu, -R * .22, R, { color: SKC.faint });
  skRight3(S, P, p, sk3.mul(u, -1), sk3.sub(v, p), .45);
  skVec3(S, P, O, p, { color: SKC.red, w: 3, label: "\\operatorname{proj}_u v" });
  skVec3(S, P, O, u, { color: SKC.ink, label: "u" });
  skVec3(S, P, O, v, { color: SKC.ink, label: "v" });
  S.arrow(P(p), P(v), { color: SKC.gold, w: 2, dash: "5 4" });
  S.label("v_{\\perp}", P(sk3.mul(sk3.add(p, v), .5)), { color: SKC.gold, dir: wsPerp(wsDir(P, p, v)) });
  S.point(P(O), { r: 3 });
  return S.svg("v split into a part along u and a part perpendicular to u");
};

WALK_SKETCH.point_to_line_distance_3d = s => {
  const Pt = s.point.P, Q = s.point.Q, d = s.direction.d, QP = sk3.sub(Pt, Q);
  const F = sk3.add(Q, sk3.mul(d, sk3.dot(QP, d) / sk3.dot(d, d))), f = wsFace(d, QP);
  const { S, P } = sk3D([Q, Pt, F, sk3.add(Q, sk3.mul(d, 1.5)), sk3.add(Q, sk3.mul(d, -.5))], { yaw: f.yaw, pitch: f.pitch, noAxes: true, pad: 30 });
  skLine3(S, P, Q, d, -.55, 1.55, { color: SKC.grey, dash: "none", w: 1.3 });
  S.label("L", P(sk3.add(Q, sk3.mul(d, 1.55))), { color: SKC.grey, dir: wsDir(P, Q, sk3.add(Q, d)), dist: 5 });
  skRight3(S, P, F, sk3.mul(d, -1), sk3.sub(Pt, F), .4);
  skVec3(S, P, Q, F, { color: SKC.red, w: 2.8, label: "\\operatorname{proj}_d\\overrightarrow{QP}", size: 13.5 });
  skVec3(S, P, Q, Pt, { color: SKC.ink, label: "\\overrightarrow{QP}", size: 14 });
  S.line(P(F), P(Pt), { color: SKC.gold, w: 2.4 });
  S.label("\\text{distance}", P(sk3.mul(sk3.add(F, Pt), .5)), { color: SKC.gold, size: 13.5, dir: wsPerp(wsDir(P, F, Pt)).map(c => -c) });
  S.point(P(Q)); S.point(P(Pt));
  S.label("Q", P(Q), { dir: [-1, .6] }); S.label("P", P(Pt), { dir: [0, -1] });
  return S.svg("The distance from P to the line L");
};

WALK_SKETCH.plane_through_three_points = s => {
  const { A, B, C } = s.points, AB = sk3.sub(B, A), AC = sk3.sub(C, A), n = s.vectors.normal;
  const N = sk3.add(A, sk3.mul(sk3.unit(n), 1.15 * Math.max(sk3.len(AB), sk3.len(AC))));
  const pts = [N, sk3.add(A, sk3.add(sk3.mul(AB, -.35), sk3.mul(AC, -.35))), sk3.add(A, sk3.add(sk3.mul(AB, 1.35), sk3.mul(AC, 1.35))), sk3.add(A, sk3.mul(AB, 1.35)), sk3.add(A, sk3.mul(AC, 1.35))];
  const { S, P } = sk3D(pts.concat([A, B, C]), { yaw: skGrazeYaw(n, .35, .45), pitch: .35, noAxes: true, pad: 28 });
  skPatch3(S, P, A, AB, AC, { ru: [-.35, 1.35], rv: [-.35, 1.35], fop: .07 });
  skRight3(S, P, A, AB, n, .35);
  skVec3(S, P, A, B, { color: SKC.red, label: "\\overrightarrow{AB}", size: 14 });
  skVec3(S, P, A, C, { color: SKC.gold, label: "\\overrightarrow{AC}", size: 14 });
  skVec3(S, P, A, N, { color: SKC.ink, label: "n=\\overrightarrow{AB}\\times\\overrightarrow{AC}", size: 14 });
  [["A", A], ["B", B], ["C", C]].forEach(([t, p]) => S.point(P(p)));
  S.label("A", P(A), { dir: [-1, .5] }); S.label("B", P(B), { dir: [1, .6] }); S.label("C", P(C), { dir: [-1, -.2] });
  return S.svg("The plane through A, B and C with its normal");
};

WALK_SKETCH.cross_product_area = s => {
  const { a, b, cross } = s.vectors, O = [0, 0, 0];
  const N = sk3.mul(sk3.unit(cross), .9 * Math.max(sk3.len(a), sk3.len(b)));
  const { S, P } = sk3D([a, b, sk3.add(a, b), N, O], { yaw: skGrazeYaw(cross, .35, .45), pitch: .35, noAxes: true, pad: 30 });
  S.region([P(O), P(a), P(sk3.add(a, b)), P(b)], { fop: .12, w: 1.3, free: true });
  skRight3(S, P, O, a, N, .3);
  skVec3(S, P, O, a, { color: SKC.red, label: "a" });
  skVec3(S, P, O, b, { color: SKC.gold, label: "b" });
  skVec3(S, P, O, N, { color: SKC.ink, label: "a\\times b" });
  const c = P(sk3.mul(sk3.add(a, b), .5));
  S.label("\\text{area}=\\|a\\times b\\|", c, { at: c, size: 13, color: SKC.deep });
  S.point(P(O), { r: 3 });
  return S.svg("The parallelogram on a and b, with a × b normal to it");
};

/* ---- curves ---- */
WALK_SKETCH.parametric_curve_tangent_exact_point = s => {
  const r = t => [t * t, t * t * t - 3 * t, 2 * t], t0 = s.parameter == null ? 1 : +s.parameter;   // the problem's r(t)
  const p = s.point || r(t0), v = s.velocity, tip = sk3.add(p, sk3.mul(v, .9)), ts = [];
  for (let i = 0; i <= 30; i++) ts.push(r(-1.45 + 3.1 * i / 30));
  const { S, P } = sk3D(ts.concat([tip]), { yaw: -2.75, pitch: .28, pad: 26 });
  skCurve(S, P, r, -1.45, 1.65, { color: SKC.ink, w: 1.8 });
  skFlowArrows(S, P, t => r(-1.45 + 3.1 * t), [.2], SKC.ink, 1.8);
  skVec3(S, P, p, tip, { color: SKC.red, label: "r'(" + t0 + ")" });
  S.point(P(p), { color: SKC.red, r: 4 });
  S.label("r(" + t0 + ")=" + wsTup(p), P(p), { dir: [-1, .6], size: 14 });
  return S.svg("The tangent vector at t = " + t0);
};

WALK_SKETCH.line_segment_3d = s => {
  const { A, B } = s.points;
  const { S, P } = sk3D([A, B], { pad: 30 });
  skLine3(S, P, A, sk3.sub(B, A), -.3, 1.3, { color: SKC.faint });
  S.arrow(P(A), P(B), { color: SKC.red, w: 2.5 });
  S.point(P(A)); S.point(P(B));
  S.label("A\\;(t=0)", P(A), { dir: [-1, .4], size: 14 }); S.label("B\\;(t=1)", P(B), { dir: [1, -.3], size: 14 });
  S.label("\\overrightarrow{AB}=B-A", P(sk3.mul(sk3.add(A, B), .5)), { color: SKC.red, size: 14, dir: wsPerp(wsDir(P, A, B)) });
  return S.svg("The segment from A to B");
};

WALK_SKETCH.helix_arc_length = s => {
  const m = /\(\s*(\d*)\s*cos\s*t\s*,\s*(\d*)\s*sin\s*t\s*,\s*(\d*)\s*t\s*\)/.exec(s.curve || "") || [], R = +(m[1] || 1), c = +(m[3] || 1);
  const T = /2\s*pi/.test(String(s.interval[1])) ? 2 * Math.PI : /pi/.test(String(s.interval[1])) ? Math.PI : +s.interval[1];
  const kz = Math.min(1, 2.6 * R / (c * T)), r = t => [R * Math.cos(t), R * Math.sin(t), kz * c * t];   // height squeezed to fit: not to scale
  const pts = []; for (let i = 0; i <= 40; i++) pts.push(r(T * i / 40));
  const { S, P } = sk3D(pts.concat([[0, 0, kz * c * T * 1.12]]), { yaw: -2.2, pitch: .2, pad: 24, noAxes: true });
  S.arrow(P([0, 0, 0]), P([0, 0, kz * c * T * 1.12]), { color: SKC.faint, w: 1.1, head: 7, layer: "back" });
  S.label("z", P([0, 0, kz * c * T * 1.12]), { color: SKC.grey, size: 12.5, dir: [0, -1], dist: 4 });
  skCurve(S, P, r, 0, T, { color: SKC.red, w: 2, n: 120 });
  skFlowArrows(S, P, t => r(t * T), [.3, .62], SKC.red, 2);
  S.line(P([0, 0, 0]), P(r(0)), { color: SKC.grey, w: 1.3, dash: "4 3" });
  S.label(String(R), P(r(0).map(x => x / 2)), { color: SKC.grey, size: 14, dir: [0, 1], dist: 5 });
  const t1 = T * .45, d = [-R * Math.sin(t1), R * Math.cos(t1), kz * c], tip = sk3.add(r(t1), sk3.mul(sk3.unit(d), R * .85));
  skVec3(S, P, r(t1), tip, { color: SKC.ink, w: 2.2 });
  const sp = typeof s.speed === "number" ? String(s.speed) : String(s.speed).replace(/sqrt\((\d+)\)/, "\\sqrt{$1}");
  S.label("\\|r'(t)\\|=" + sp, P(tip), { dir: wsDir(P, r(t1), tip), size: 14 });
  return S.svg("One helix, constant speed");
};

/* ---- scalar functions ---- */
WALK_SKETCH.gradient_directional_derivative = s => {
  const f = (x, y) => x * x * y + Math.exp(x * y);                          // the problem's f
  const p = s.point, g = s.gradient, u = s.unitDirection, gl = Math.hypot(...g), gs = 1.1 / gl;
  const G = [p[0] + g[0] * gs, p[1] + g[1] * gs], U = [p[0] + u[0], p[1] + u[1]];
  const { S, P } = sk2D([[p[0] - 1.4, p[1] - .9], [p[0] + 1.4, p[1] + 1.25]], { xr: [p[0] - 1.4, p[0] + 1.4], yr: [p[1] - .9, p[1] + 1.25], noAxes: true, pad: 16 });
  skContours(S, P, f, [p[0] - 1.4, p[0] + 1.4], [p[1] - .9, p[1] + 1.25], [.55, .75, 1, 1.35, 1.8, 2.4], { color: (L) => L === 1 ? SKC.grey : SKC.faint, op: L => L === 1 ? .9 : .55 });
  // the drop from the tip of u onto the gradient line: its foot is how far u goes along the gradient
  const gu = [g[0] / gl, g[1] / gl], k = u[0] * gu[0] + u[1] * gu[1], foot = [p[0] + gu[0] * k, p[1] + gu[1] * k];
  S.line(P(U), P(foot), { color: SKC.gold, w: 1.2, dash: "4 3", free: true });
  S.rightAngle(P(foot), P(p), P(U), 7);
  skVec2(S, P, p, G, { color: SKC.red, label: "\\nabla f" + wsTup(p) + "=" + wsTup(g), size: 14 });
  skVec2(S, P, p, U, { color: SKC.gold, label: "u" });
  S.point(P(p), { r: 3.6 });
  S.label(wsTup(p), P(p), { dir: [-.2, 1], size: 13.5, color: SKC.grey });
  wsTag(S, "D_uf=\\nabla f\\cdot u=" + s.directionalDerivative, "br");
  S.note("grey: level curves of f", 12, 242, { size: 11.5 });
  return S.svg("The gradient and the direction u at the point");
};

const WS_FNS = {                                                     // functions named in the specs
  "x^2+xy+2y^2": (x, y) => x * x + x * y + 2 * y * y,
  "x^2+xy+y^2-3x-3y": (x, y) => x * x + x * y + y * y - 3 * x - 3 * y,
  "x^2-2xy+2y^2-4y": (x, y) => x * x - 2 * x * y + 2 * y * y - 4 * y,
  "x^2+y^2-2x-4y": (x, y) => x * x + y * y - 2 * x - 4 * y,
  "xe^y+y^2": (x, y) => x * Math.exp(y) + y * y,
};
const wsFn = str => WS_FNS[String(str || "").replace(/^\s*(f\s*(\(x,\s*y\))?\s*=)?/, "").replace(/\s+/g, "")];

WALK_SKETCH.tangent_plane_graph = s => {
  const f = wsFn(s.function), [a, b, c] = s.basePoint, [fx, fy] = s.gradientAtBase, kz = .22;   // heights squeezed: not to scale
  const X = (x, y, z) => [x, y, z * kz], L = (x, y) => c + fx * (x - a) + fy * (y - b);
  const lo = .25, hi = 1.75, pts = [];
  for (const x of [lo, hi]) for (const y of [lo, hi]) pts.push(X(x, y, f(x, y)));
  const { S, P } = sk3D(pts, { yaw: -2.45, pitch: .36, noAxes: true, pad: 30 });
  for (let i = 0; i <= 6; i++) {
    const t = lo + (hi - lo) * i / 6;
    skCurve(S, P, s2 => X(t, s2, f(t, s2)), lo, hi, { color: SKC.faint, w: 1, free: true, n: 30 });
    skCurve(S, P, s2 => X(s2, t, f(s2, t)), lo, hi, { color: SKC.faint, w: 1, free: true, n: 30 });
  }
  const d = .5, q = [[a - d, b - d], [a + d, b - d], [a + d, b + d], [a - d, b + d]].map(([x, y]) => P(X(x, y, L(x, y))));
  S.region(q, { fop: .16, w: 1.3, free: true });
  const [ax, ay] = s.approximationPoint || [];
  S.point(P(X(a, b, c)), { color: SKC.red, r: 4 });
  S.label(wsTup([a, b, c]), P(X(a, b, c)), { dir: [-1, -.6], size: 14 });
  if (ax != null) {
    S.point(P(X(ax, ay, L(ax, ay))), { color: SKC.gold, r: 3.6 });
    S.label("L" + wsTup([ax, ay]) + "=" + s.linearApproximation, P(X(ax, ay, L(ax, ay))), { color: SKC.gold, dir: [1, .5], size: 13.5 });
  }
  wsTag(S, "f_x=" + fx + ",\\ f_y=" + fy, "br");
  S.note("grey: the surface · red: the tangent plane", 12, 20, { size: 11.5 });
  return S.svg("The tangent plane at the base point");
};

WALK_SKETCH.critical_point_classification = s => {
  const f = wsFn(s.function), [a, b] = s.criticalPoint, h = 1e-3;
  const fxx = (f(a + h, b) - 2 * f(a, b) + f(a - h, b)) / h / h, fyy = (f(a, b + h) - 2 * f(a, b) + f(a, b - h)) / h / h;
  const fxy = (f(a + h, b + h) - f(a + h, b - h) - f(a - h, b + h) + f(a - h, b - h)) / 4 / h / h, D = Math.round(fxx * fyy - fxy * fxy);
  const xr = [Math.min(-.4, a - 2), a + 2], yr = [Math.min(-.4, b - 1.6), b + 1.6];
  const { S, P } = sk2D([[xr[0], yr[0]], [xr[1], yr[1]]], { xr, yr, pad: 18 });
  const m = f(a, b); skContours(S, P, f, xr, yr, [.25, .8, 1.6, 2.7, 4].map(t => m + t), { color: () => SKC.red, op: (L, i) => .75 - i * .1 });
  S.point(P([a, b]), { color: SKC.red, r: 4.2 });
  S.label(wsTup([a, b]), P([a, b]), { dir: [1, -1], size: 14 });
  wsTag(S, "D=" + D + ">0,\\ f_{xx}=" + Math.round(fxx) + ">0", "tr");
  S.note("bowl-shaped level curves: " + (s.classification || "local minimum"), 390, 242, { anchor: "end", size: 12, color: SKC.deep });
  return S.svg("Level curves around the critical point");
};

WALK_SKETCH.rectangle_optimization = s => {
  const f = wsFn(s.function), g = s.region, c = s.interiorCriticalPoint;
  const { S, P } = sk2D([[g.xMin, g.yMin], [g.xMax, g.yMax]], { xr: [g.xMin - .7, g.xMax + 1.1], yr: [g.yMin - .6, g.yMax + .6], pad: 16 });
  const box = [[g.xMin, g.yMin], [g.xMax, g.yMin], [g.xMax, g.yMax], [g.xMin, g.yMax]];
  S.region(box.map(P), { fop: .06, w: 1.6 });
  skContours(S, P, f, [g.xMin, g.xMax], [g.yMin, g.yMax], [-4.5, -3, -1, 1.5], { color: () => SKC.faint, op: () => .7 });
  const vals = Object.values(s.cornerValues || {}), top = Math.max(...vals);
  box.forEach(q => {
    const v = f(q[0], q[1]), isMax = Math.abs(v - top) < 1e-9;
    S.ring(P(q), 9, { color: isMax ? SKC.red : SKC.grey, w: 1.6 });
    S.label(String(v), P(q), { dir: [q[0] === g.xMin ? -1 : 1, q[1] === g.yMin ? .6 : -.6], size: 14, color: isMax ? SKC.red : SKC.grey, dist: 12 });
  });
  S.point(P(c), { color: SKC.gold, r: 4.2 });
  S.label("f" + wsTup(c) + "=" + s.interiorValue, P(c), { dir: [1, -.5], size: 14, color: SKC.gold });
  S.note("max 3 at two corners · min −5 inside", 390, 242, { anchor: "end", size: 12, color: SKC.deep });
  return S.svg("Check inside, then the edges and corners");
};

WALK_SKETCH.gradient_tangent_plane_combo = s => {
  const f = wsFn(s.function), [a, b] = s.basePoint, g = s.gradientAtBase, u = s.unitDirection, dv = s.directionVector;
  const to = [a + dv[0], b + dv[1]];
  const { S, P } = sk2D([[a, b], to, [a + g[0], b + g[1]]], { xr: [-.4, to[0] + .6], yr: [-.8, to[1] + .6], pad: 16 });
  skContours(S, P, f, [-.4, to[0] + .6], [-.8, to[1] + .6], [0, 1, 2.5, 5, 9, 15], { color: () => SKC.faint, op: () => .6 });
  S.line(P([a, b]), P(to), { color: SKC.grey, w: 1.1, dash: "5 4" });
  S.point(P(to), { r: 3, color: SKC.grey }); S.label(wsTup(to), P(to), { dir: [1, -.4], size: 13.5, color: SKC.grey });
  skVec2(S, P, [a, b], [a + g[0], b + g[1]], { color: SKC.red, label: "\\nabla f=" + wsTup(g), size: 14, dir: [-1, -.3] });
  skVec2(S, P, [a, b], [a + u[0], b + u[1]], { color: SKC.gold, label: "u=\\left(\\tfrac35,\\tfrac45\\right)", size: 14, dir: [1, .2] });
  S.point(P([a, b]), { r: 3.6 }); S.label(wsTup([a, b]), P([a, b]), { dir: [0, 1], size: 13.5 });
  wsTag(S, "D_uf=" + String(s.directionalDerivative).replace(/^(\d+)\/(\d+)$/, "\\tfrac{$1}{$2}"), "br", { row: 1 });
  if (s.tangentPlane) wsTag(S, "\\text{tangent plane: }" + s.tangentPlane.replace(/\s+/g, ""), "br");
  return S.svg("Gradient and direction at the base point");
};

/* ---- vector fields and line integrals ---- */
const WS_FIELDS = {
  "x^2y,xy^2": (x, y) => [x * x * y, x * y * y],
  "x^2-y,xy": (x, y) => [x * x - y, x * y],
  "y,x": (x, y) => [y, x],
};
const wsField = str => WS_FIELDS[String(str || "").replace(/\\[()]|\\,|\s/g, "").replace(/^F=/, "").replace(/\\langle|</, "").replace(/\\rangle|>$/, "")];

WALK_SKETCH.vector_field_div_curl_2d = s => {
  const F = wsField(s.field), [a, b] = s.point, xr = [a - 1.3, a + 1.3], yr = [b - 1, b + 1];
  const { S, P } = sk2D([[xr[0], yr[0]], [xr[1], yr[1]]], { xr, yr, noAxes: true, pad: 14 });
  skField(S, P, F, xr, yr, [9, 7], { color: SKC.faint });
  const c = P([a, b]);
  if (s.curlAtPoint) skSpin(S, c, 17, s.curlAtPoint > 0, SKC.red);
  S.point(c, { color: SKC.red, r: 4.2 });
  S.label(wsTup([a, b]), c, { color: SKC.red, dir: [.8, 1], dist: 20, size: 14 });
  wsTag(S, "\\operatorname{div}F=" + s.divergenceAtPoint, "tl", { color: SKC.ink });
  wsTag(S, "\\operatorname{curl}F=" + s.curlAtPoint, "tl", { row: 1, color: SKC.ink });
  return S.svg("The field near the point");
};

WALK_SKETCH.vector_field_div_curl_3d = s => {
  const p = s.point, cu = s.curlAtPoint, top = sk3.add(p, sk3.mul(sk3.unit(cu), 2));
  const { S, P } = sk3D([p, top, [p[0], p[1], 0], [0, p[1], 0], [p[0], 0, 0]], { yaw: skGrazeYaw(cu, .38, .62), pitch: .38, pad: 30 });
  // the dashed box that locates the point
  const [x, y, z] = p, dash = { color: SKC.faint, w: 1, dash: "3 3", free: true };
  S.line(P([x, 0, 0]), P([x, y, 0]), dash); S.line(P([0, y, 0]), P([x, y, 0]), dash); S.line(P([x, y, 0]), P(p), dash);
  wsSpin3(S, P, p, cu, .75);
  skVec3(S, P, p, top, { color: SKC.red, label: "\\nabla\\times F=" + wsTup(cu), size: 14 });
  S.point(P(p), { r: 4 });
  S.label(wsTup(p), P(p), { dir: [1, .35], size: 14, dist: 34, fixed: true });
  wsTag(S, "\\operatorname{div}F=" + s.divergenceAtPoint, "br", { color: SKC.ink });
  return S.svg("The curl vector is the spin axis at the point");
};

WALK_SKETCH.scalar_line_integral_segment = s => {
  const A = s.start, B = s.end;
  const { S, P } = sk2D([A, B], { pad: 26 });
  S.arrow(P(A), P(B), { color: SKC.red, w: 2.5 });
  for (let i = 1; i < 6; i++) S.point(P([A[0] + (B[0] - A[0]) * i / 6, A[1] + (B[1] - A[1]) * i / 6]), { r: 2.6, color: SKC.deep });
  S.point(P(A)); S.point(P(B));
  S.label(wsTup(A), P(A), { dir: [-1, .8], size: 14 }); S.label(wsTup(B), P(B), { dir: [1, -.3], size: 14 });
  S.label("r(t)=(3t,4t)", P([(A[0] + B[0]) / 2, (A[1] + B[1]) / 2]), { color: SKC.red, dir: [1, .5], size: 14 });
  wsTag(S, "ds=\\|r'(t)\\|\\,dt=" + s.speed + "\\,dt", "tl");
  S.note("dots: where x + y is sampled", 390, 242, { anchor: "end", size: 11.5 });
  return S.svg("The segment, with sample points along it");
};

WALK_SKETCH.vector_line_integral_curve = s => {
  const F = wsField(s.field), A = s.start, B = s.end, r = t => [t, t * t];            // the problem's curve
  const xr = [-.35, 1.4], yr = [-.35, 1.4];
  const { S, P } = sk2D([A, B], { xr, yr, pad: 18 });
  skField(S, P, F, [-.25, 1.3], [-.25, 1.3], [7, 7], { color: SKC.faint });
  skCurve(S, P, r, 0, 1, { color: SKC.red, w: 2.4 });
  skFlowArrows(S, P, r, [.45, .8], SKC.red, 2.4);
  S.point(P(A)); S.point(P(B));
  S.label(wsTup(A), P(A), { dir: [-1, .9], size: 13.5 }); S.label(wsTup(B), P(B), { dir: [.4, -1], size: 13.5 });
  S.label("y=x^2", P(r(.62)), { color: SKC.red, dir: [1, .6], size: 14 });
  wsTag(S, "\\int_C F\\cdot dr=\\int_0^1 F(r(t))\\cdot r'(t)\\,dt", "tl", { size: 13 });
  return S.svg("The parabola through the field");
};

WALK_SKETCH.conservative_field_endpoints = s => {
  const A = s.start, B = s.end, dx = B[0] - A[0], dy = B[1] - A[1], nx = -dy, ny = dx, L = Math.hypot(dx, dy);
  const bend = (k) => t => [A[0] + dx * t + nx / L * k * Math.sin(Math.PI * t), A[1] + dy * t + ny / L * k * Math.sin(Math.PI * t)];
  const c1 = bend(.9), c2 = bend(-.7);
  const pts = []; for (let i = 0; i <= 10; i++) pts.push(c1(i / 10), c2(i / 10));
  const { S, P } = sk2D(pts, { pad: 24 });
  skCurve(S, P, c1, 0, 1, { color: SKC.red, w: 2.2 }); skFlowArrows(S, P, c1, [.5], SKC.red, 2.2);
  skCurve(S, P, c2, 0, 1, { color: SKC.gold, w: 2.2 }); skFlowArrows(S, P, c2, [.5], SKC.gold, 2.2);
  S.label("C_1", P(c1(.3)), { color: SKC.red, size: 14 }); S.label("C_2", P(c2(.3)), { color: SKC.gold, size: 14, dir: [-1, 1] });
  S.point(P(A)); S.point(P(B));
  S.label("\\text{start }" + wsTup(A), P(A), { dir: [-1, .3], size: 13.5 }); S.label("\\text{end }" + wsTup(B), P(B), { dir: [1, .3], size: 13.5 });
  wsTag(S, "\\text{both: }\\phi(\\text{end})-\\phi(\\text{start})=" + s.integralValue, "br", { size: 13.5 });
  return S.svg("Two paths with the same endpoints");
};

/* ---- double integrals and Green's theorem ---- */
WALK_SKETCH.double_integral_region_switch_order = s => {
  const S = skNew(400, 250); S.grid();
  const tri = [[0, 0], [2, 2], [0, 2]];                                     // y = x, y = 2, x = 0
  const Pl = skPanel2(S, 8, 26, 184, 214, [-.5, 2.6], [-.5, 2.6]), Pr = skPanel2(S, 208, 26, 184, 214, [-.5, 2.6], [-.5, 2.6]);
  [Pl, Pr].forEach(P => S.region(tri.map(P), { fop: .09, w: 1.5 }));
  skStrip(S, Pl, "v", 1.05, 1.05, 2, { width: "dx", w: .2 });
  skStrip(S, Pr, "h", 1.2, 0, 1.2, { width: "dy", w: .2 });
  S.label("y=x", Pl([1.55, 1.55]), { color: SKC.red, size: 13, dir: [1, .5] }); S.label("y=2", Pl([.5, 2]), { color: SKC.red, size: 13, dir: [0, -1] });
  S.label("x=0", Pr([0, .9]), { color: SKC.red, size: 13, dir: [-1, 0] }); S.label("x=y", Pr([1.7, 1.7]), { color: SKC.red, size: 13, dir: [1, .5] });
  S.note("dy dx: vertical strips", 100, 16, { anchor: "middle", size: 12, color: SKC.ink });
  S.note("dx dy: horizontal strips", 300, 16, { anchor: "middle", size: 12, color: SKC.ink });
  return S.svg("The same triangle sliced two ways");
};

WALK_SKETCH.polar_half_disk = s => {
  const R = +(s.bounds && s.bounds.r && s.bounds.r[1]) || 2;
  const { S, P } = sk2D([[-R, 0], [R, R]], { xr: [-R - .5, R + .6], yr: [-.45, R + .45], pad: 16 });
  const pts = []; for (let i = 0; i <= 60; i++) pts.push(P([R * Math.cos(Math.PI * i / 60), R * Math.sin(Math.PI * i / 60)]));
  S.region(pts, { fop: .08, w: 1.6 });
  skPolarCell(S, P, R * .55, R * .78, .95, 1.3);
  S.arc(P([0, 0]), 26, 0, -Math.PI + .08, { color: SKC.gold, arrow: true, w: 1.6 });
  S.label("\\theta:\\ 0\\to\\pi", P([-.2, .5]), { color: SKC.gold, dir: [-1, -.6], size: 13.5, dist: 22 });
  S.label("r=" + R, P([R * Math.cos(.35), R * Math.sin(.35)]), { color: SKC.red, dir: [1, -.3], size: 14 });
  wsTag(S, "dA=r\\,dr\\,d\\theta", "tr");
  return S.svg("The upper half disk in polar coordinates");
};

WALK_SKETCH.greens_theorem_rectangle = s => {
  const g = s.region, box = [[g.xMin, g.yMin], [g.xMax, g.yMin], [g.xMax, g.yMax], [g.xMin, g.yMax]];
  const { S, P } = sk2D(box, { xr: [g.xMin - .5, g.xMax + .7], yr: [g.yMin - .5, g.yMax + .5], pad: 16 });
  const cw = parseOrientCW(s.orientation, false), seq = cw ? box.slice().reverse() : box;
  S.region(box.map(P), { fop: .09, w: 2 });
  seq.forEach((q, i) => { const n = seq[(i + 1) % 4], m = [(q[0] + n[0]) / 2, (q[1] + n[1]) / 2], d = [(n[0] - q[0]) * .04, (n[1] - q[1]) * .04]; S.arrow(P([m[0] - d[0], m[1] - d[1]]), P([m[0] + d[0], m[1] + d[1]]), { color: SKC.red, w: 2, head: 11 }); });
  const c = P([(g.xMin + g.xMax) / 2, (g.yMin + g.yMax) / 2]);
  S.label("D", c, { at: c, size: 17, color: SKC.deep });
  S.label(wsTup([g.xMax, g.yMax]), P([g.xMax, g.yMax]), { dir: [1, -1], size: 13.5, color: SKC.grey });
  if (s.integrand) wsTag(S, s.integrand.replace(/\s+/g, ""), "tr", { size: 13.5 });
  return S.svg("The rectangle with its boundary counterclockwise");
};

WALK_SKETCH.greens_triangle_clockwise = s => {
  const V = s.vertices, cw = parseOrientCW(s.orientation, true);
  const { S, P } = sk2D(V, { xr: [Math.min(...V.map(v => v[0])) - .45, Math.max(...V.map(v => v[0])) + .5], yr: [-.4, Math.max(...V.map(v => v[1])) + .45], pad: 16 });
  S.region(V.map(P), { fop: .09, w: 2 });
  // the counterclockwise order of the vertices, reversed for a clockwise boundary
  const area2 = V.reduce((t, v, i) => { const n = V[(i + 1) % V.length]; return t + v[0] * n[1] - n[0] * v[1]; }, 0);
  let seq = area2 > 0 ? V.slice() : V.slice().reverse(); if (cw) seq = seq.reverse();
  seq.forEach((q, i) => { const n = seq[(i + 1) % seq.length], m = [(q[0] + n[0]) / 2, (q[1] + n[1]) / 2], d = [(n[0] - q[0]) * .05, (n[1] - q[1]) * .05]; S.arrow(P([m[0] - d[0], m[1] - d[1]]), P([m[0] + d[0], m[1] + d[1]]), { color: SKC.red, w: 2, head: 11 }); });
  V.forEach(v => { S.point(P(v)); S.label(wsTup(v), P(v), { size: 13.5, color: SKC.grey, dir: [v[0] > 0 ? 1 : -1, v[1] > 0 ? -1 : 1] }); });
  S.note(cw ? "clockwise: the negative of Green's orientation" : "counterclockwise", 390, 40, { anchor: "end", size: 11.5, color: SKC.deep });
  return S.svg("The triangle with its boundary " + (cw ? "clockwise" : "counterclockwise"));
};

/* ---- surfaces and solids ---- */
WALK_SKETCH.scalar_surface_integral_graph = s => {
  const g = s.baseRegion, z = (x, y) => .45 * (x + 2 * y);                 // the problem's surface z = x + 2y, heights squeezed
  const base = [[g.xMin, g.yMin, 0], [g.xMax, g.yMin, 0], [g.xMax, g.yMax, 0], [g.xMin, g.yMax, 0]], top = base.map(([x, y]) => [x, y, .6 + z(x, y)]);
  const { S, P } = sk3D(top.concat(base), { yaw: -2.0, pitch: .42, pad: 24 });
  S.region(base.map(P), { fill: SKC.grey, fop: .14, stroke: SKC.grey, w: 1.2, free: true });
  base.forEach((b, i) => S.line(P(b), P(top[i]), { color: SKC.faint, w: 1, dash: "3 3", free: true }));
  S.region(top.map(P), { fop: .14, w: 1.5, free: true });
  S.label("D", P([(g.xMin + g.xMax) / 2, (g.yMin + g.yMax) / 2, 0]), { at: P([(g.xMin + g.xMax) / 2, (g.yMin + g.yMax) / 2, 0]), size: 15, color: SKC.grey });
  S.label("S:\\ z=x+2y", P(top[2]), { color: SKC.deep, size: 14, dir: [1, -.3] });
  wsTag(S, "dS=" + String(s.dSFactor || "").replace(/sqrt\((\d+)\)/, "\\sqrt{$1}") + "\\,dA", "br");
  return S.svg("The slanted surface over the rectangle D");
};

WALK_SKETCH.flux_graph_upward_paraboloid = s => {
  const z = (x, y) => 4 - x * x - y * y, kz = .5, X = (x, y, h) => [x, y, h * kz];     // heights squeezed: not to scale
  const circ = (r, h) => t => X(r * Math.cos(t), r * Math.sin(t), h);
  const { S, P } = sk3D([X(1.1, 0, 0), X(-1.1, 0, 0), X(0, 1.1, 0), X(0, -1.1, 0), X(0, 0, 5.8), X(1.2, 0, 4.2)], { yaw: -2.2, pitch: .42, pad: 20, noAxes: true });
  skCurve(S, P, circ(1, 0), 0, 2 * Math.PI, { color: SKC.grey, w: 1.2, fill: SKC.grey, fop: .12, free: true, n: 60 });
  [0, 1.57, 3.14, 4.71].forEach(t => S.line(P(circ(1, 0)(t)), P(circ(1, 3)(t)), { color: SKC.faint, w: 1, dash: "3 3", free: true }));
  for (const r of [1, .7, .4]) skCurve(S, P, circ(r, 4 - r * r), 0, 2 * Math.PI, { color: SKC.red, w: r === 1 ? 1.6 : 1, op: r === 1 ? 1 : .55, free: true, n: 60 });
  for (let k = 0; k < 6; k++) { const t = k * Math.PI / 3; skCurve(S, P, r => X(r * Math.cos(t), r * Math.sin(t), 4 - r * r), 0, 1, { color: SKC.red, w: 1, op: .45, free: true, n: 16 }); }
  [[0, 0], [.7, 0], [-.35, .6], [-.35, -.6]].forEach(([x, y]) => {
    const n = sk3.unit([2 * x, 2 * y, 1 / kz]), p0 = X(x, y, z(x, y));
    S.arrow(P(p0), P(sk3.add(p0, sk3.mul(n, .75))), { color: SKC.gold, w: 1.9 });
  });
  let tl = 0; for (let q = 0; q < 360; q++) { const t = q * Math.PI / 180; if (P(circ(1, 3)(t))[0] < P(circ(1, 3)(tl))[0]) tl = t; }
  S.label("S", P(circ(1, 3)(tl)), { color: SKC.deep, size: 15, dir: [-1, -.1], dist: 8, fixed: true });
  S.label("n", P(sk3.add(X(0, 0, 4), [0, 0, .75])), { color: SKC.gold, size: 15, dir: [1, -.3] });
  S.label("x^2+y^2\\le1", P(X(0, -1, 0)), { color: SKC.grey, size: 13.5, dir: [1, .7] });
  wsTag(S, "\\text{up: }\\langle 2x,2y,1\\rangle\\,dA", "br");
  return S.svg("The paraboloid cap with upward normals");
};

WALK_SKETCH.stokes_disk_upward = s => {
  const R = 2, H = 3, circ = t => [R * Math.cos(t), R * Math.sin(t), H];
  const { S, P } = sk3D([[R, 0, H], [-R, 0, H], [0, R, H], [0, -R, H], [0, 0, H + 1.7], [1.1, .3, H + 1.7]], { yaw: -2.2, pitch: .42, pad: 24, axis: 2.6, axisLabels: false });
  skCurve(S, P, circ, 0, 2 * Math.PI, { color: SKC.red, w: 1.8, fill: SKC.red, fop: .1, free: true, n: 80 });
  skFlowArrows(S, P, t => circ(t * 2 * Math.PI), [.08, .58], SKC.red, 2.2);
  [[0, 0], [1.1, .3], [-.6, -1]].forEach(([x, y]) => S.arrow(P([x, y, H]), P([x, y, H + 1.3]), { color: SKC.gold, w: 1.9 }));
  S.label("n", P([0, 0, H + 1.3]), { color: SKC.gold, size: 15, dir: [1, -.3] });
  S.label("\\partial S", P(circ(-.7)), { color: SKC.red, size: 15, dir: [1, .4] });
  S.label("S", P([-.9, .9, H]), { at: P([-.9, .9, H]), color: SKC.deep, size: 15 });
  wsTag(S, "\\operatorname{curl}F\\cdot n=2", "tl", { size: 13.5 });
  wsTag(S, "\\iint_S\\operatorname{curl}F\\cdot n\\,dS=2\\cdot 4\\pi", "br", { size: 13.5 });
  return S.svg("The disk with its upward normal and counterclockwise edge");
};

WALK_SKETCH.cylindrical_triple_integral = s => {
  const R = 2, kz = .42, X = (x, y, h) => [x, y, h * kz];                               // heights squeezed: not to scale
  const circ = (r, h) => t => X(r * Math.cos(t), r * Math.sin(t), h);
  const fit = []; for (let k = 0; k < 8; k++) { const t = k * Math.PI / 4; fit.push(circ(R, 0)(t), circ(R, R * R)(t)); }
  const { S, P } = sk3D(fit, { yaw: -2.2, pitch: .38, pad: 24, noAxes: true });
  // the cylinder wall between its silhouette lines (the solid fills it up to the rim of the bowl)
  let tl = 0, tr = 0; for (let k = 0; k < 360; k++) { const t = k * Math.PI / 180, x = P(circ(R, 0)(t))[0]; if (x < P(circ(R, 0)(tl))[0]) tl = t; if (x > P(circ(R, 0)(tr))[0]) tr = t; }
  const front = []; let t1 = tr; if (t1 < tl) t1 += 2 * Math.PI;
  const lower = P(circ(R, 0)((tl + t1) / 2))[1] > P(circ(R, 0)((tl + t1) / 2 + Math.PI))[1];
  const a0 = lower ? tl : t1 - 2 * Math.PI, a1 = lower ? t1 : tl;
  for (let i = 0; i <= 40; i++) front.push(P(circ(R, 0)(a0 + (a1 - a0) * i / 40)));
  for (let i = 40; i >= 0; i--) front.push(P(circ(R, R * R)(a0 + (a1 - a0) * i / 40)));
  S.region(front, { fop: .07, stroke: false, free: true });
  skCurve(S, P, circ(R, 0), 0, 2 * Math.PI, { color: SKC.grey, w: 1.2, fill: SKC.grey, fop: .1, free: true, n: 72 });
  [tl, tr].forEach(t => S.line(P(circ(R, 0)(t)), P(circ(R, R * R)(t)), { color: SKC.red, w: 1.3, free: true }));
  // the bowl z = r²: rim, two rings and a few profiles down to its bottom at the origin
  for (const r of [1.4, .8]) skCurve(S, P, circ(r, r * r), 0, 2 * Math.PI, { color: SKC.red, w: 1, op: .5, free: true, n: 60 });
  for (let k = 0; k < 6; k++) { const t = k * Math.PI / 3; skCurve(S, P, r => X(r * Math.cos(t), r * Math.sin(t), r * r), 0, R, { color: SKC.red, w: 1, op: .4, free: true, n: 20 }); }
  skCurve(S, P, circ(R, R * R), 0, 2 * Math.PI, { color: SKC.red, w: 1.7, free: true, n: 72 });
  let tf = 0; for (let k = 0; k < 360; k++) { const t = k * Math.PI / 180; if (P(circ(R, 0)(t))[1] > P(circ(R, 0)(tf))[1]) tf = t; }
  S.line(P(X(0, 0, 0)), P(circ(R, 0)(tf + .5)), { color: SKC.grey, w: 1.2, dash: "4 3" });
  S.label("r=2", P(circ(R * .6, 0)(tf + .5)), { color: SKC.grey, size: 13.5, dir: [1, .7] });
  S.label("z=r^2", P(circ(R, R * R)(tr)), { color: SKC.deep, size: 14, dir: [1, -.2] });
  S.label("z=0", P(circ(R, 0)(tr)), { color: SKC.grey, size: 13.5, dir: [1, .3] });
  wsTag(S, "dV=r\\,dz\\,dr\\,d\\theta", "br");
  S.note("the solid: under the bowl, above z = 0, inside r = 2", 12, 20, { size: 11.5 });
  return S.svg("The solid under z = r² inside the cylinder r = 2");
};

/* ---------- Interactive 3-D scenes built from each problem's numbers ---------- */
(() => {
  if (typeof Viz3D === "undefined" || !Viz3D.addScene) return;
  const { theme, floorGrid, axesPrims, meshQuads, ringSegs, curveSegs, add, sub, scl, cross, norm } = Viz3D.kit;
  // the engine centres on the world origin at a fixed scale, so recentre and rescale each scene to fill the canvas
  const fit = (sc, ext) => {
    const pts = []; sc.prims.forEach(p => { if (p.pts) pts.push(...p.pts); if (p.a) pts.push(p.a); if (p.b) pts.push(p.b); if (p.p) pts.push(p.p); });
    const lo = [0, 1, 2].map(i => Math.min(...pts.map(q => q[i]))), hi = [0, 1, 2].map(i => Math.max(...pts.map(q => q[i])));
    const c = lo.map((v, i) => (v + hi[i]) / 2), half = Math.max(...hi.map((v, i) => (v - lo[i]) / 2)) || 1, k = (ext || 1.45) / half;
    const T = q => [(q[0] - c[0]) * k, (q[1] - c[1]) * k, (q[2] - c[2]) * k];
    sc.prims = sc.prims.map(p => { const o = Object.assign({}, p); if (o.pts) o.pts = o.pts.map(T); if (o.a) o.a = T(o.a); if (o.b) o.b = T(o.b); if (o.p) o.p = T(o.p); return o; });
    return sc;
  };
  const scene = (id, fn, ext) => Viz3D.addScene("p:" + id, () => fit(fn(), ext));
  const fallback = name => { try { return CONCEPT[name]().svg; } catch (_) { return ""; } };
  const entry = (id, fb, title, caption, extra) => {
    SKETCH[id] = () => Object.assign({ kicker: "Visual idea", title, caption, svg: fallback(fb), viz3d: "p:" + id, plain: true, scaled: true }, extra || {});
  };
  const faces3 = (a, b, c, T, o = {}) => {                      // parallelepiped faces spanned by a, b, c
    const V = (...vs) => vs.reduce(add, [0, 0, 0]);
    return [[[0, 0, 0], a, V(a, b), b], [[0, 0, 0], a, V(a, c), c], [[0, 0, 0], b, V(b, c), c], [c, V(a, c), V(a, b, c), V(b, c)], [b, V(a, b), V(a, b, c), V(b, c)], [a, V(a, b), V(a, b, c), V(a, c)]]
      .map(pts => ({ type: "poly", pts, fill: o.fill || T.redTint, opacity: o.opacity || .55, shade: true, stroke: T.redSoft, lw: 1, decal: true }));
  };
  const orientArrows = (r, ts, T, color) => ts.map(t => ({ type: "arrow", a: r(t - .06), b: r(t + .06), color: color || T.redDeep, lw: 2.4, head: 8 }));

  /* ----- Section 3 ----- */
  scene("basis-007", () => {
    const T = theme(), K = .37, v1 = [1, 2, 1], v2 = [0, 1, -1], b = [1.5, 4, .5], b0 = [0, 4, 2], s = p => scl(p, K);
    const plane = (a, c) => s(add(scl(v1, a), scl(v2, c)));
    return { prims: [
      ...meshQuads(plane, -.35, 1.85, -.6, 1.4, 7, 7, { fill: T.redTint, opacity: .5, shade: false, stroke: T.redSoft, lw: .7, decal: true }),
      { type: "line", a: [0, 0, 0], b: s(scl(v1, 1.5)), color: T.gold, lw: 1.5, dash: [5, 4] }, { type: "line", a: s(scl(v1, 1.5)), b: s(b), color: T.gold, lw: 1.5, dash: [5, 4] },
      { type: "arrow", a: [0, 0, 0], b: s(v1), color: T.ink, lw: 2.5, label: "v_1" }, { type: "arrow", a: [0, 0, 0], b: s(v2), color: T.ink, lw: 2.5, label: "v_2" },
      { type: "arrow", a: [0, 0, 0], b: s(b0), color: T.inkFaint, lw: 1.8, label: "b_0", labelColor: T.inkMute, size: 13, ldy: 16 },
      { type: "arrow", a: [0, 0, 0], b: s(b), color: T.red, lw: 2.8, label: "b_h\\ (h=\\,?)" },
      { type: "label", p: plane(1.7, -.45), text: "\\operatorname{span}\\{v_1,v_2\\}", color: T.redDeep, size: 13, anchor: "center" },
      { type: "point", p: [0, 0, 0], color: T.ink, r: 3 }], yaw: -1.15, pitch: .5 };
  });
  entry("basis-007", "spanPlane", "One value of h puts b_h in the plane of v₁ and v₂",
    "Set b_h = c₁v₁ + c₂v₂ and compare entries: two of them fix c₁ and c₂, and the third decides which h works. The faint b₀ (h = 0) shows a typical h sticking out of the plane.", { formula: "b_h=c_1v_1+c_2v_2" });

  /* ----- Section 6 ----- */
  scene("diagprojcross-008", () => {
    const T = theme(), K = .4, u = scl([1, 2, -1], K), v = scl([3, 0, 2], K), n = scl([4, -5, -6], K * .5);
    return { prims: [...axesPrims(1.6, T),
      { type: "poly", pts: [[0, 0, 0], u, add(u, v), v], fill: T.redTint, opacity: .8, stroke: T.redSoft, lw: 1, decal: true },
      { type: "arrow", a: [0, 0, 0], b: u, color: T.ink, lw: 2.5, label: "u" }, { type: "arrow", a: [0, 0, 0], b: v, color: T.ink, lw: 2.5, label: "v" },
      { type: "arrow", a: [0, 0, 0], b: n, color: T.red, lw: 2.8, label: "\\tfrac12\\,u\\times v" },
      { type: "label", p: scl(add(u, v), .5), text: "\\text{area}=\\|u\\times v\\|", color: T.redDeep, size: 13, anchor: "center" },
      { type: "point", p: [0, 0, 0], color: T.ink, r: 3 }], yaw: -.4, pitch: .35 };
  });
  entry("diagprojcross-008", "crossProduct", "u × v stands perpendicular to u and v; its length is the parallelogram's area",
    "Compute u × v with the 3 × 3 determinant (drawn here at half length), check that it dots to 0 with u and v, and take its length for the area. The triangle has half of it.", { formula: "u\\times v=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\1&2&-1\\\\3&0&2\\end{vmatrix}" });

  scene("diagprojcross-009", () => {
    const T = theme(), K = .36, A = [1, 0, 2], B = [3, -1, 1], C = [0, 2, 4], s = p => scl(p, K);
    const at = (p, q) => s(add(A, add(scl(sub(B, A), p), scl(sub(C, A), q))));
    const G = scl(add(add(A, B), C), 1 / 3), nrm = norm([0, -1, 1]);
    return { prims: [...axesPrims(1.7, T),
      ...meshQuads(at, -.35, 1.35, -.35, 1.35, 6, 6, { fill: T.redTint, opacity: .45, shade: false, stroke: T.redSoft, lw: .6, decal: true }),
      { type: "poly", pts: [s(A), s(B), s(C)], fill: T.redSoft, opacity: .8, stroke: T.red, lw: 1.4, decal: true },
      { type: "arrow", a: s(G), b: add(s(G), scl(nrm, .75)), color: T.red, lw: 2.8, label: "\\mathbf n" },
      ...[[A, "A"], [B, "B"], [C, "C"]].map(([p, t]) => ({ type: "point", p: s(p), color: T.ink, r: 3.6 })),
      ...[[A, "A"], [B, "B"], [C, "C"]].map(([p, t]) => ({ type: "label", p: s(p), text: t, color: T.ink, size: 14, dx: 6, dy: -6 })),
      { type: "label", p: at(1.2, -.2), text: "\\text{plane }ABC", color: T.redDeep, size: 13, anchor: "center" }], yaw: -.35, pitch: .3 };
  });
  entry("diagprojcross-009", "crossProduct", "Two edge vectors give the normal; any of the three points fixes the plane",
    "Take the edge vectors AB and AC; their cross product is a normal n. Then n · ((x, y, z) − A) = 0 is the plane, and B and C should satisfy it too.", { formula: "\\mathbf n=\\overrightarrow{AB}\\times\\overrightarrow{AC},\\qquad \\mathbf n\\cdot\\big((x,y,z)-A\\big)=0" });

  scene("diagprojcross-010", () => {
    const T = theme(), K = .36, u = scl([1, 2, 0], K), v = scl([-1, 1, 3], K), w = scl([2, 0, 1], K);
    return { prims: [...floorGrid(1.5, .5, T), ...faces3(u, v, w, T),
      { type: "arrow", a: [0, 0, 0], b: u, color: T.red, lw: 2.6, label: "u" }, { type: "arrow", a: [0, 0, 0], b: v, color: T.ink, lw: 2.6, label: "v" },
      { type: "arrow", a: [0, 0, 0], b: w, color: T.gold, lw: 2.6, label: "w" }, { type: "point", p: [0, 0, 0], color: T.ink, r: 3 }], yaw: -.5, pitch: .4 };
  });
  entry("diagprojcross-010", "tripleProduct", "u · (v × w) is the signed volume of this box",
    "Compute the 3 × 3 determinant; its absolute value is the volume. A triple product of 0 would mean the box is flat, so the vectors would be coplanar.", { formula: "u\\cdot(v\\times w)=\\det\\begin{bmatrix}1&2&0\\\\-1&1&3\\\\2&0&1\\end{bmatrix}" });

  /* ----- Section 7 ----- */
  scene("curvgradopt-001", () => {
    const T = theme(), K = .15, z0 = -.95, r = t => [3 * K * Math.cos(t), 3 * K * Math.sin(t), z0 + 4 * K * t];
    const t1 = Math.PI / 2, p = r(t1), Tv = [-.6 * Math.sin(t1), .6 * Math.cos(t1), .8];
    return { prims: [...floorGrid(1.2, .6, T, z0), ...ringSegs([0, 0], 3 * K, z0, T.inkFaint, 1, [3, 4], 40, undefined, true),
      { type: "arrow", a: [0, 0, z0], b: [0, 0, z0 + 2.2], color: T.inkFaint, lw: 1.1, head: 7, label: "z", size: 12, labelColor: T.inkMute },
      ...curveSegs(r, 0, Math.PI, 70, T.red, 2.6),
      { type: "arrow", a: p, b: add(p, scl(Tv, .6)), color: T.ink, lw: 2.5, label: "\\mathbf T(t)" },
      { type: "point", p, color: T.redDeep, r: 3.8 }, { type: "point", p: r(0), color: T.red, r: 3.2 }, { type: "point", p: r(Math.PI), color: T.red, r: 3.2 },
      { type: "label", p: r(Math.PI), text: "t=\\pi", color: T.red, size: 13, dx: 8, dy: -4 }, { type: "label", p: r(0), text: "t=0", color: T.red, size: 13, dx: 8, dy: 12 }], yaw: -.5, pitch: .3 };
  });
  entry("curvgradopt-001", "parametricCurve", "Half a turn of a helix: how fast is it traced?",
    "Differentiate each component for r′(t), take its length for the speed, and divide r′ by the speed for T(t). Arc length is the integral of the speed.", { formula: "L=\\int_0^\\pi\\|\\mathbf r'(t)\\|\\,dt,\\qquad \\mathbf T=\\frac{\\mathbf r'}{\\|\\mathbf r'\\|}" });

  scene("curvgradopt-002", () => {
    const T = theme(), K = .42, r = t => [2 * K * Math.cos(t), 2 * K * Math.sin(t), K * (2 * Math.cos(t) + 1)];
    const cyl = [];
    for (let z = -1.4; z <= 3.5; z += .7) cyl.push(...ringSegs([0, 0], 2 * K, z * K, T.inkFaint, .9, [3, 3], 48));
    const plane = (x, y) => [x, y, x + K];
    return { prims: [...axesPrims(1.4, T), ...cyl,
      ...meshQuads(plane, -2.3 * K, 2.3 * K, -2.3 * K, 2.3 * K, 6, 6, { fill: T.redTint, opacity: .45, shade: false, stroke: T.redSoft, lw: .6 }),
      ...curveSegs(r, 0, 2 * Math.PI, 80, T.red, 2.8), ...orientArrows(r, [.8, 2.4, 4, 5.6], T),
      { type: "label", p: r(2.4), text: "\\mathbf r(t)", color: T.redDeep, size: 14, dx: -30, dy: -6 },
      { type: "label", p: [2 * K, -2 * K, 3.3 * K], text: "z=x+1", color: T.redDeep, size: 13 },
      { type: "label", p: [2 * K * .48, -2 * K * .88, -1.2 * K], text: "x^2+y^2=4", color: T.inkMute, size: 13, dx: 6 }], yaw: -.5, pitch: .3 };
  });
  entry("curvgradopt-002", "parametricCurve", "Where the tilted plane cuts the cylinder: a tilted ellipse",
    "Parametrize the circle x² + y² = 4 first, counterclockwise from above; then the plane's equation tells you z at each point.");

  scene("curvgradopt-006", () => {
    const T = theme(), K = .38, P = [1, 2, -1], Q = [3, 3, -1], g = [4, 2, -4], u = norm([2, 1, 0]), s = p => scl(p, K);
    return { prims: [...floorGrid(.9, .3, T, s(P)[2]).map(p => Object.assign(p, { a: add(p.a, [s(P)[0], s(P)[1], 0]), b: add(p.b, [s(P)[0], s(P)[1], 0]) })),
      { type: "line", a: s(P), b: s(Q), color: T.inkMute, lw: 1.3, dash: [4, 4] },
      { type: "arrow", a: s(P), b: add(s(P), scl(g, K * .3)), color: T.red, lw: 2.8, label: "\\nabla f(P)" },
      { type: "arrow", a: s(P), b: add(s(P), scl(u, K * 1.25)), color: T.ink, lw: 2.5, label: "\\mathbf u", ldy: -14 },
      { type: "point", p: s(P), color: T.ink, r: 3.8 }, { type: "point", p: s(Q), color: T.ink, r: 3.4 },
      { type: "label", p: s(P), text: "P", color: T.ink, size: 14, dx: -18, dy: 4 }, { type: "label", p: s(Q), text: "Q", color: T.ink, size: 14, dx: 8, dy: 4 }], yaw: -.45, pitch: .32 };
  });
  entry("curvgradopt-006", "gradient", "∇f points the fastest way up; D_u f measures how much of it lies along u",
    "Compute the three partials at P for ∇f(P). For D_u f, u must be a unit vector pointing from P toward Q.", { formula: "D_{\\mathbf u}f(P)=\\nabla f(P)\\cdot\\mathbf u,\\qquad \\mathbf u=\\frac{Q-P}{\\|Q-P\\|}" });

  scene("curvgradopt-007", () => {
    const T = theme(), K = .42, R = Math.sqrt(10), z = (x, y) => Math.sqrt(Math.max(0, 10 - x * x - y * y));
    const dome = (rr, th) => scl([rr * Math.cos(th), rr * Math.sin(th), z(rr * Math.cos(th), rr * Math.sin(th))], K);
    const p0 = [1, 2, Math.sqrt(5)], fx = -1 / Math.sqrt(5), fy = -2 / Math.sqrt(5);
    const tp = (sx, sy) => scl([1 + sx, 2 + sy, Math.sqrt(5) + fx * sx + fy * sy + .03], K);
    const n = norm([1, 2, Math.sqrt(5)]);
    return { prims: [...floorGrid(1.5, .5, T, -.02),
      ...meshQuads(dome, .01, R * .999, 0, 2 * Math.PI, 8, 28, { fill: "#F4EFE7", shade: true, stroke: "#D8D0C0", lw: .45, opacity: .92 }),
      ...meshQuads(tp, -1, 1, -1, 1, 5, 5, { fill: T.redTint, opacity: .6, shade: false, stroke: T.redSoft, lw: .6 }),
      { type: "arrow", a: scl(p0, K), b: add(scl(p0, K), scl(n, .7)), color: T.redDeep, lw: 2.5, label: "\\mathbf n" },
      { type: "point", p: scl(p0, K), color: T.redDeep, r: 3.8 },
      { type: "label", p: scl(p0, K), text: "(1,2,f(1,2))", color: T.redDeep, size: 13, anchor: "center", dy: 40 }], yaw: -.35, pitch: .38, lift: 24 };
  });
  entry("curvgradopt-007", "tangentPlane", "Near (1, 2) the dome is almost its tangent plane",
    "Evaluate f, f_x and f_y at (1, 2) and put them into the tangent plane formula; then plug in (0.9, 2.1).", { formula: "z=f(a,b)+f_x(a,b)(x-a)+f_y(a,b)(y-b)" });

  /* ----- Section 10 ----- */
  scene("surfstokes-001", () => {
    const T = theme(), K = .25, r = (u, v) => { const x = 2 * u, y = 2 * (1 - u) * v; return scl([x, y, 6 - 2 * x - y], K); };
    const n = norm([2, 1, 1]), c = r(.35, .45);
    return { prims: [...axesPrims([1, 1, 1.8], T),
      { type: "poly", pts: [[0, 0, 0], scl([2, 0, 0], K), scl([0, 2, 0], K)], fill: T.border, opacity: .9, stroke: T.inkFaint, lw: 1, decal: true },
      ...[[0, 0], [2, 0], [0, 2]].map(([x, y]) => ({ type: "line", a: scl([x, y, 0], K), b: scl([x, y, 6 - 2 * x - y], K), color: T.inkFaint, lw: 1, dash: [3, 3] })),
      ...meshQuads(r, 0, 1, 0, 1, 6, 6, { fill: T.redTint, opacity: .85, shade: true, stroke: T.redSoft, lw: .6 }),
      { type: "arrow", a: c, b: add(c, scl(n, .7)), color: T.red, lw: 2.6, label: "\\mathbf r_x\\times\\mathbf r_y" },
      { type: "label", p: scl([.5, .5, 0], K), text: "D", color: T.inkMute, size: 13, anchor: "center" }, { type: "label", p: r(.6, .2), text: "S", color: T.redDeep, size: 15 }], yaw: -.55, pitch: .32, center: [.25, .25, .7] };
  });
  entry("surfstokes-001", "surfacePatch", "The tilted triangle S sits over the flat triangle D",
    "Parametrize S by (x, y) over D. The length of r_x × r_y says how much each bit of D is stretched; integrate it over D for the area.", { formula: "\\text{Area}(S)=\\iint_D\\|\\mathbf r_x\\times\\mathbf r_y\\|\\,dA" });

  scene("surfstokes-002", () => {
    const T = theme(), K = .34, r = (u, v) => { const x = 2 * u, y = 2 * (1 - u) * v; return scl([x, y, 4 - x - y], K); };
    const n = norm([1, 1, 1]), c = r(.35, .45);
    return { prims: [...axesPrims([1.15, 1.15, 1.65], T),
      { type: "poly", pts: [[0, 0, 0], scl([2, 0, 0], K), scl([0, 2, 0], K)], fill: T.border, opacity: .9, stroke: T.inkFaint, lw: 1, decal: true },
      ...[[0, 0], [2, 0], [0, 2]].map(([x, y]) => ({ type: "line", a: scl([x, y, 0], K), b: scl([x, y, 4 - x - y], K), color: T.inkFaint, lw: 1, dash: [3, 3] })),
      ...meshQuads(r, 0, 1, 0, 1, 6, 6, { fill: T.redTint, opacity: .85, shade: true, stroke: T.redSoft, lw: .6 }),
      { type: "arrow", a: c, b: add(c, scl(n, .6)), color: T.red, lw: 2.6, label: "\\mathbf r_x\\times\\mathbf r_y" },
      { type: "label", p: scl([.55, .55, 0], K), text: "D", color: T.inkMute, size: 13, anchor: "center" }, { type: "label", p: r(.55, .25), text: "S", color: T.redDeep, size: 15 }], yaw: -.55, pitch: .32, center: [.3, .3, .6] };
  });
  entry("surfstokes-002", "surfacePatch", "On S, write everything in terms of x and y",
    "Substitute z = 4 − x − y into the integrand, find ‖r_x × r_y‖, then integrate over the triangle D.", { formula: "\\iint_S g\\,dS=\\iint_D g(x,y,4-x-y)\\,\\|\\mathbf r_x\\times\\mathbf r_y\\|\\,dA" });

  scene("surfstokes-003", () => {
    // only the cap matters (z from 3 to 4): frame it, with its base circle at z = 3 for reference
    const T = theme(), z = rr => 4 - rr * rr, cap = (rr, th) => [rr * Math.cos(th), rr * Math.sin(th), z(rr)];
    const arrows = [];
    [[.75, .3], [.75, 2.4], [.75, 4.5], [0, 0], [.45, 1.3]].forEach(([rr, th]) => { const p = cap(rr, th); arrows.push({ type: "arrow", a: p, b: add(p, scl(norm(p), .5)), color: T.inkSoft, lw: 1.7, head: 7 }); });
    return { prims: [...ringSegs([0, 0], 1, 3, T.inkMute, 1.2, [3, 3], 48),
      ...meshQuads(cap, .001, 1, 0, 2 * Math.PI, 5, 26, { fill: T.redTint, shade: true, stroke: T.redSoft, lw: .45, opacity: .88 }),
      ...arrows, { type: "arrow", a: [0, 0, 4], b: [0, 0, 4.7], color: T.redDeep, lw: 2.5, label: "\\mathbf n" },
      { type: "label", p: [1, -1, 3], text: "x^2+y^2=1,\\ z=3", color: T.inkMute, size: 12.5 }, { type: "label", p: [-1, .3, 4.4], text: "\\mathbf F=(x,y,z)", color: T.inkSoft, size: 13 }], yaw: -.5, pitch: .45 };
  });
  entry("surfstokes-003", "flux", "F = (x, y, z) streams out through the upward-facing cap",
    "For a graph z = g(x, y) oriented upward, dS = (−g_x, −g_y, 1) dA. Dot F with it, then switch to polar coordinates over the unit disk.", { formula: "\\iint_S\\mathbf F\\cdot d\\mathbf S=\\iint_D\\mathbf F\\cdot(-g_x,-g_y,1)\\,dA" });

  scene("surfstokes-004", () => {
    const T = theme(), K = .38, side = (th, zz) => scl([2 * Math.cos(th), 2 * Math.sin(th), zz], K);
    const arrows = [];
    // normals only on the side facing the viewer, so none seems to point inward
    [.75, 2.07, 3.4].forEach(th => [.8, 2.2].forEach(zz => { const p = [2 * Math.cos(th), 2 * Math.sin(th), zz]; arrows.push({ type: "arrow", a: scl(p, K), b: add(scl(p, K), scl(norm([p[0], p[1], 0]), .4)), color: T.redDeep, lw: 2, head: 7 }); }));
    return { prims: [...floorGrid(1.2, .6, T, -.01),
      ...meshQuads(side, 0, 2 * Math.PI, 0, 3, 28, 4, { fill: T.redTint, shade: true, stroke: T.redSoft, lw: .45, opacity: .8 }),
      ...ringSegs([0, 0], 2 * K, 0, T.red, 1.4), ...ringSegs([0, 0], 2 * K, 3 * K, T.red, 1.4), ...arrows,
      { type: "label", p: side(2.6, 3.4), text: "\\mathbf n", color: T.redDeep, size: 13 }], yaw: -.5, pitch: .3 };
  });
  entry("surfstokes-004", "flux", "On the side of the cylinder only the horizontal part of F crosses it",
    "The outward normal on the side points straight away from the z-axis. Find F · n there; if it is constant, multiply it by the area of the side.", { formula: "\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS" });

  scene("surfstokes-005", () => {
    const T = theme(), K = .33, cap = (rr, th) => scl([rr * Math.cos(th), rr * Math.sin(th), 4 - rr * rr], K);
    const rim = t => scl([2 * Math.cos(t), 2 * Math.sin(t), 0], K);
    return { prims: [...floorGrid(1.2, .6, T, -.01),
      ...meshQuads(cap, .001, 2, 0, 2 * Math.PI, 8, 28, { fill: T.redTint, shade: true, stroke: T.redSoft, lw: .45, opacity: .82 }),
      ...curveSegs(rim, 0, 2 * Math.PI, 60, T.red, 2.6), ...orientArrows(rim, [.4, 2, 3.6, 5.2], T),
      { type: "arrow", a: scl([0, 0, 4], K), b: add(scl([0, 0, 4], K), [0, 0, .55]), color: T.redDeep, lw: 2.5, label: "\\operatorname{curl}\\mathbf F" },
      { type: "label", p: rim(4.2), text: "C", color: T.red, size: 15, dy: 18 }], yaw: -.5, pitch: .38 };
  });
  entry("surfstokes-005", "stokes", "Stokes: the circulation around the rim equals the curl through any cap",
    "Compute curl F. Every surface with boundary C gives the same flux of curl F, so pick the easiest one: the flat disk inside the rim.", { formula: "\\oint_C\\mathbf F\\cdot d\\mathbf r=\\iint_S(\\nabla\\times\\mathbf F)\\cdot\\mathbf n\\,dS" });

  scene("surfstokes-006", () => {
    const T = theme(), K = 1.25, A = [K, 0, 0], B = [0, K, 0], C = [0, 0, K], G = scl(add(add(A, B), C), 1 / 3), n = norm([1, 1, 1]);
    const edge = (p, q) => t => add(scl(p, 1 - t), scl(q, t));
    return { prims: [...axesPrims(1.7, T),
      { type: "poly", pts: [A, B, C], fill: T.redTint, opacity: .8, shade: true, stroke: T.redSoft, lw: 1, decal: true },
      { type: "line", a: A, b: B, color: T.red, lw: 2.4 }, { type: "line", a: B, b: C, color: T.red, lw: 2.4 }, { type: "line", a: C, b: A, color: T.red, lw: 2.4 },
      ...orientArrows(edge(A, B), [.5], T), ...orientArrows(edge(B, C), [.5], T), ...orientArrows(edge(C, A), [.5], T),
      { type: "arrow", a: G, b: add(G, scl(n, .6)), color: T.ink, lw: 2.4, label: "\\mathbf n" },
      { type: "arrow", a: G, b: add(G, scl(n, -.6)), color: T.gold, lw: 2.4, label: "\\operatorname{curl}\\mathbf F" }], yaw: -.6, pitch: .35 };
  });
  entry("surfstokes-006", "stokes", "Compare curl F with the upward normal of the triangle",
    "Compute curl F and the upward unit normal of x + y + z = 1 (upward matches counterclockwise from above). If their dot product is constant, multiply it by the triangle's area.", { formula: "\\oint_C\\mathbf F\\cdot d\\mathbf r=\\iint_S(\\nabla\\times\\mathbf F)\\cdot\\mathbf n\\,dS" });

  scene("surfstokes-007", () => {
    const T = theme(), K = .62, O = [0, 0, 0], X = [2 * K, 0, 0], Y = [0, K, 0], Z = [0, 0, 2 * K];
    return { prims: [...floorGrid(1.4, .7, T),
      { type: "poly", pts: [O, X, Y], fill: T.redSoft, opacity: .85, shade: true, stroke: T.red, lw: 1, decal: true },
      { type: "poly", pts: [O, X, Z], fill: "#FFFFFF", opacity: .6, shade: true, stroke: T.red, lw: 1, decal: true },
      { type: "poly", pts: [O, Y, Z], fill: "#FFFFFF", opacity: .6, shade: true, stroke: T.red, lw: 1, decal: true },
      { type: "poly", pts: [X, Y, Z], fill: T.redTint, opacity: .85, shade: true, stroke: T.red, lw: 1.3, decal: true },
      ...axesPrims(1.7, T),
      { type: "label", p: scl(add(add(X, Y), Z), .38), text: "x+2y+z=2", color: T.redDeep, size: 13, anchor: "center" },
      { type: "label", p: X, text: "(2,0,0)", color: T.inkSoft, size: 12, dx: -8, dy: 16 }, { type: "label", p: Y, text: "(0,1,0)", color: T.inkSoft, size: 12, dx: 6, dy: 14 }, { type: "label", p: Z, text: "(0,0,2)", color: T.inkSoft, size: 12, dx: 8 }], yaw: -.45, pitch: .38 };
  }, 1.85);                                              // a small object: fill more of the frame
  entry("surfstokes-007", "tripleRegion", "The tetrahedron under x + 2y + z = 2",
    "z runs from 0 up to the plane, over the triangle x + 2y ≤ 2 in the floor. Set the bounds in that order, then integrate x.", { formula: "\\iiint_E x\\,dV=\\iint_D\\int_0^{\\text{top}(x,y)}x\\,dz\\,dA" });

  scene("surfstokes-008", () => {
    const T = theme(), K = .32, bowl = (rr, th) => scl([rr * Math.cos(th), rr * Math.sin(th), rr * rr], K), lid = (rr, th) => scl([rr * Math.cos(th), rr * Math.sin(th), 4], K);
    return { prims: [...floorGrid(1.2, .6, T, -.01), ...axesPrims(1.6, T),
      ...meshQuads(bowl, .001, 2, 0, 2 * Math.PI, 8, 28, { fill: T.redTint, shade: true, stroke: T.redSoft, lw: .45, opacity: .8 }),
      ...meshQuads(lid, .001, 2, 0, 2 * Math.PI, 3, 28, { fill: "#FFFFFF", shade: false, stroke: T.redSoft, lw: .45, opacity: .55 }),
      ...ringSegs([0, 0], 2 * K, 4 * K, T.red, 1.8),
      { type: "label", p: [0, 0, 2.6 * K], text: "E", color: T.redDeep, size: 16, anchor: "center" }, { type: "label", p: [2 * K, 0, 4 * K], text: "z=4", color: T.redDeep, size: 13, dx: 8 },
      { type: "label", p: [-1.5 * K, 0, 2.25 * K], text: "z=r^2", color: T.redDeep, size: 13, dx: -46 }], yaw: -.5, pitch: .3 };
  });
  entry("surfstokes-008", "tripleRegion", "Between the bowl z = r² and the lid z = 4",
    "In cylindrical coordinates the bowl is z = r² and the lid is z = 4; find where they meet to get the range of r. Remember dV = r dz dr dθ.", { formula: "V=\\iiint_E dV=\\int_0^{2\\pi}\\!\\!\\int_0^{R}\\!\\!\\int_{r^2}^{4}r\\,dz\\,dr\\,d\\theta" });

  scene("surfstokes-009", () => {
    const T = theme(), K = .42, sph = (ph, th) => scl([3 * Math.sin(ph) * Math.cos(th), 3 * Math.sin(ph) * Math.sin(th), 3 * Math.cos(ph)], K);
    const arrows = [];
    [[.5, .3], [1.2, 1.2], [1.3, 3], [1.1, 4.6], [2.2, .8], [2.3, 3.8]].forEach(([ph, th]) => { const p = sph(ph, th); arrows.push({ type: "arrow", a: p, b: add(p, scl(norm(p), .45)), color: T.redDeep, lw: 2, head: 7 }); });
    return { prims: [...meshQuads(sph, .01, Math.PI - .01, 0, 2 * Math.PI, 12, 24, { fill: T.redTint, shade: true, stroke: T.redSoft, lw: .4, opacity: .7 }), ...arrows,
      { type: "label", p: [0, 0, 0], text: "\\operatorname{div}\\mathbf F", color: T.redDeep, size: 14, anchor: "center" }], yaw: -.5, pitch: .35 };
  });
  entry("surfstokes-009", "flux", "The Divergence Theorem: total outflow = divergence × volume",
    "Compute div F. When it is constant, the flux is that constant times the volume of the ball.", { formula: "\\iint_S\\mathbf F\\cdot d\\mathbf S=\\iiint_E\\operatorname{div}\\mathbf F\\,dV" });

  scene("surfstokes-010", () => {
    const T = theme(), K = .62, disk = (rr, th) => scl([rr * Math.cos(th), rr * Math.sin(th), 2], K), rim = t => scl([Math.cos(t), Math.sin(t), 2], K);
    return { prims: [...floorGrid(1.2, .6, T, 0), ...axesPrims(1.7, T),
      ...meshQuads(disk, .001, 1, 0, 2 * Math.PI, 4, 28, { fill: T.redTint, shade: false, stroke: T.redSoft, lw: .45, opacity: .75 }),
      ...curveSegs(rim, 0, 2 * Math.PI, 60, T.red, 2.6), ...orientArrows(rim, [.5, 2.1, 3.7, 5.3], T),
      { type: "arrow", a: scl([0, 0, 2], K), b: add(scl([0, 0, 2], K), [0, 0, .5]), color: T.redDeep, lw: 2.5, label: "\\mathbf k" },
      { type: "label", p: rim(4.4), text: "C", color: T.red, size: 15, dy: 18 }], yaw: -.5, pitch: .4 };
  }, 1.85);                                              // a small object: fill more of the frame
  entry("surfstokes-010", "stokes", "Stokes on the flat disk: only the vertical curl component matters",
    "Use the flat unit disk at z = 2 with n = k. Only the k-component of curl F matters there; integrate it over the disk in polar coordinates.", { formula: "\\oint_C\\mathbf F\\cdot d\\mathbf r=\\iint_D(\\nabla\\times\\mathbf F)\\cdot\\mathbf k\\,dA" });

  /* ----- Vector problems as simple interactive scenes (round 8) -----
     The same idea as the static sketch, with as few pieces as possible; dragging to rotate removes the
     3-D guesswork. Titles, captions and formulas come from the static sketch, which stays as the fallback. */
  // a yaw near the usual view that shows a plane with normal n well open (not edge-on): |cos| about .6
  const openYaw = (n, pitch) => { const L = Math.hypot(...n); let best = -.5, sc = 1e9;
    for (let y = -Math.PI; y <= Math.PI; y += .01) { const c = [Math.sin(y) * Math.cos(pitch), Math.cos(y) * Math.cos(pitch), Math.sin(pitch)];
      const v = Math.abs(Math.abs(c[0] * n[0] + c[1] * n[1] + c[2] * n[2]) / L - .6) + .05 * Math.abs(y + .5); if (v < sc) { sc = v; best = y; } }
    return best; };
  const vec3 = spec => () => {
    const T = theme(), K = spec.K || .35, s = p => scl(p, K), col = c => T[c || "ink"] || c, prims = [];
    if (!spec.noAxes) prims.push(...axesPrims(spec.axis || 1.5, T, spec.names));
    (spec.planes || []).forEach(pl => prims.push(...meshQuads((a, b) => s(add(add(pl.o || [0, 0, 0], scl(pl.u, a)), scl(pl.v, b))), pl.ru[0], pl.ru[1], pl.rv[0], pl.rv[1], 6, 6,
      { fill: pl.fill || T.redSoft, opacity: .6, shade: false, stroke: pl.stroke || "#EDB9C1", lw: .7, decal: true })));
    (spec.lines || []).forEach(l => prims.push({ type: "line", a: s(l.a), b: s(l.b), color: col(l.c || "inkFaint"), lw: l.lw || 1.5, dash: l.solid ? undefined : [5, 4] }));
    (spec.rights || []).forEach(([c, d1, d2, sz]) => {                    // a small right-angle mark at c between directions d1 and d2
      const u1 = scl(norm(d1), sz || .3), u2 = scl(norm(d2), sz || .3);
      prims.push({ type: "line", a: s(add(c, u1)), b: s(add(add(c, u1), u2)), color: T.inkMute, lw: 1.2 }, { type: "line", a: s(add(add(c, u1), u2)), b: s(add(c, u2)), color: T.inkMute, lw: 1.2 });
    });
    // an arrow lying along one of the scene's lines gets its label beside the tip, not on the line
    const along = a => (spec.lines || []).some(l => { const d = sub(l.b, l.a), v = sub(a.to, a.from || [0, 0, 0]), c = cross(d, v); return Math.hypot(...c) < 1e-6 * Math.hypot(...d) * Math.hypot(...v) + 1e-12; });
    (spec.arrows || []).forEach(a => prims.push({ type: "arrow", a: s(a.from || [0, 0, 0]), b: s(a.to), color: col(a.c), lw: a.lw || 2.7, label: a.label, labelColor: a.lc ? col(a.lc) : undefined, size: a.size || 15, ldx: a.ldx, ldy: a.ldy, side: a.side || along(a) }));
    (spec.points || []).forEach(q => prims.push({ type: "point", p: s(q.p), color: col(q.c), r: q.r || 3.6 }));
    (spec.labels || []).forEach(l => prims.push({ type: "label", p: s(l.p), text: l.text, color: col(l.c || "inkMute"), size: l.size || 14, anchor: l.anchor || "center", dx: l.dx, dy: l.dy }));
    prims.push({ type: "point", p: [0, 0, 0], color: T.ink, r: 3 });
    const pitch = spec.pitch == null ? .32 : spec.pitch;
    return { prims, yaw: spec.yaw != null ? spec.yaw : spec.n ? openYaw(spec.n, pitch) : -.5, pitch };
  };
  const as3D = (id, spec, ext) => {
    const old = SKETCH[id];
    if (!old) return;
    scene(id, vec3(spec), ext);
    SKETCH[id] = () => Object.assign({}, old(), { kicker: "Visual idea", viz3d: "p:" + id, plain: true, scaled: true });
  };
  const mid = (a, b) => scl(add(a, b), .5);

  { const a = [2, -1, 3], b = [-1, 4, 2];
    as3D("vecmat-001", { K: .36, n: cross(a, b), pitch: .32, arrows: [{ to: a, c: "red", label: "a" }, { to: b, label: "b" }, { from: b, to: a, c: "gold", lw: 2.4 }], labels: [{ p: mid(a, b), text: "a-b", c: "gold", dy: -14 }] }); }
  // vecmat-002 keeps its static sketch: seen straight on, the right angle reads better than any 3-D view
  { const p1 = [1, 0, 1], p2 = [0, 1, 1], z = [1.1, .6, 1.7], bad = [-.1, 1.3, 2.7], foot = [.4, 1.8, 2.2];
    as3D("rref-004", { K: .5, names: ["a", "b", "c"], planes: [{ u: p1, v: p2, ru: [-.35, 1.5], rv: [-.35, 2.05] }],
      arrows: [{ to: z, c: "red", label: "z" }, { to: bad, c: "inkMute", lw: 2.2, label: "z'" }], lines: [{ a: bad, b: foot, c: "inkMute" }],
      points: [{ p: foot, c: "inkMute", r: 3 }], labels: [{ p: add(scl(p1, 1.45), scl(p2, .95)), text: "\\text{Col}\\,A", c: "redDeep" }] }); }
  { const v1 = [1, -1, 2], v2 = [2, 0, 1], w = [0, 0, 1];
    as3D("basis-001", { K: .4, planes: [{ u: v1, v: v2, ru: [-.3, 1.3], rv: [-.3, 1.3] }], arrows: [{ to: v1, label: "v_1" }, { to: v2, label: "v_2" },
      { to: add(v1, v2), c: "gold", label: "c_1v_1+c_2v_2", size: 13 }, { to: w, c: "red", label: "w" }], lines: [{ a: v1, b: add(v1, v2), c: "gold" }, { a: v2, b: add(v1, v2), c: "gold" }] }); }
  { const v1 = [1, 0, 2], v2 = [0, 1, -1], v3 = [3, 2, 4], v3b = [3, 5, 4];
    as3D("basis-002", { K: .28, yaw: -2.49, pitch: .35, planes: [{ u: v1, v: v2, ru: [-.2, 3.4], rv: [-.3, 2.6] }], arrows: [{ to: v1, label: "v_1" }, { to: v2, label: "v_2" },
      { to: v3, c: "gold", label: "v_3\\ (a=\\,?)" }, { to: v3b, c: "inkMute", lw: 2, label: "v_3\\ (\\text{most }a)", size: 13 }],
      lines: [{ a: scl(v1, 3), b: v3, c: "gold" }, { a: scl(v2, 2), b: v3, c: "gold" }] }); }
  { const b1 = [1, 1, 0], b2 = [0, 1, 1], b3 = [1, 0, 1], m2 = [1, 4, 3], x = [3, 4, 5];
    // the walk alone shows the three directions: c1 b1 along b1, then c2 b2 along b2, then c3 b3 along b3
    as3D("basis-005", { K: .3, arrows: [{ to: b1, c: "ink" }, { from: b1, to: m2, c: "red" }, { from: m2, to: x, c: "gold" }],
      lines: [{ a: [0, 0, 0], b: x, c: "inkMute" }], points: [{ p: x }],
      labels: [{ p: x, text: "x=(3,4,5)", c: "ink", dy: -16 }, { p: mid([0, 0, 0], b1), text: "c_1b_1", c: "ink", dx: 16, dy: 12 },
               { p: mid(b1, m2), text: "c_2b_2", c: "red", dx: -24 }, { p: mid(m2, x), text: "c_3b_3", c: "gold", dx: -26, dy: -6 }] }); }
  { const v1 = [1.6, 0, .1], v2 = [.1, 1.5, 0], v3 = [.2, .3, 1.3], c = [.7, .8, .9], a = scl(v1, c[0]), b = add(a, scl(v2, c[1])), v4 = add(b, scl(v3, c[2]));
    as3D("basis-008", { K: 1, noAxes: true, arrows: [{ to: v1, label: "v_1" }, { to: v2, label: "v_2" }, { to: v3, label: "v_3" }, { to: v4, c: "red", label: "v_4" }],
      lines: [{ a: [0, 0, 0], b: a, c: "gold" }, { a, b, c: "gold" }, { a: b, b: v4, c: "gold" }] }); }
  { const a = [2, -1, 2], b = [5, 1, 0];
    as3D("diagprojcross-005", { K: .3, arrows: [{ to: b, label: "b" }, { to: a, c: "gold", label: "b_\\parallel" }, { from: a, to: b, c: "red" }],
      lines: [{ a: scl(a, -.5), b: scl(a, 1.6), c: "gold", lw: 1.2 }], rights: [[a, scl(a, -1), [3, 2, -2], .45]], labels: [{ p: scl(a, 1.6), text: "\\text{line of }a", c: "gold", dy: -12 }, { p: mid(a, b), text: "b_\\perp", c: "red", dx: 14, dy: -10 }] }); }
  { const u = [1, 2, 2], p = [4, 1, 3], q = [4 / 3, 8 / 3, 8 / 3];
    as3D("diagprojcross-006", { K: .3, lines: [{ a: scl(u, -.4), b: scl(u, 2.2), c: "ink", lw: 2, solid: true }, { a: [0, 0, 0], b: p, c: "inkFaint" }, { a: p, b: q, c: "red", lw: 2.6, solid: true }],
      rights: [[q, scl(u, -1), [p[0] - q[0], p[1] - q[1], p[2] - q[2]], .45]], points: [{ p }, { p: q, c: "red" }],
      labels: [{ p: scl(u, 2.3), text: "L", c: "ink", size: 15 }, { p, text: "p=(4,1,3)", c: "ink", dy: -16 }, { p: q, text: "q", c: "red", dx: -12, dy: 10 }, { p: mid(p, q), text: "\\text{distance}", c: "red", dy: 16 }] }); }
  { const n = [-1, 1, -1], p = [1, 1, 0], q = add(p, n);
    as3D("transdet-007", { K: .55, yaw: .4, pitch: .35, lines: [{ a: scl(n, -1.9), b: scl(n, 1.9), c: "red", lw: 1.8 }, { a: p, b: q, c: "red", lw: 1.3 }], arrows: [{ to: p, label: "p" }, { to: q, label: "p+n" }],
      labels: [{ p: scl(n, 1.95), text: "\\ker T", c: "red", dy: -12 }] }); }
  { const p = [1, -2, 3], c = [2, -3, -1], Fp = [-2, -6, 3], nn = norm(c), e1 = norm(cross(nn, [0, 0, 1])), e2 = cross(nn, e1), ring = [];
    for (let i = 0; i <= 28; i++) { const t = 2 * Math.PI * i / 28 * .85; ring.push(add(add(p, scl(nn, .55)), add(scl(e1, .6 * Math.cos(t)), scl(e2, .6 * Math.sin(t))))); }
    as3D("vecfieldline-002", { K: .6, noAxes: true, arrows: [{ from: p, to: add(p, scl(norm(Fp), 1.8)), c: "inkMute", lw: 2, label: "\\mathbf F" }, { from: p, to: add(p, scl(nn, 2)), c: "red", label: "\\operatorname{curl}\\mathbf F" },
      { from: ring[25], to: ring[28], c: "red", lw: 1.4 }], lines: ring.slice(0, 26).map((q, i) => i ? { a: ring[i - 1], b: q, c: "red", lw: 1.4, solid: true } : null).filter(Boolean),
      points: [{ p }], labels: [{ p, text: "(1,-2,3)", c: "ink", dx: -34, dy: 12 }] }); }

  /* ----- Eigenspaces as clean interactive scenes (round 9): solid lines and planes, plain arrows ----- */
  const eigLine = (d, c, text, len) => { const u = norm(d), L = len || 2; return { line: { a: scl(u, -L), b: scl(u, L), c, lw: 1.6, solid: true }, label: { p: scl(u, -L * 1.26), text, c } }; };   // named past the empty end
  const withLines = (spec, ls) => { spec.lines = (spec.lines || []).concat(ls.map(l => l.line)); spec.labels = (spec.labels || []).concat(ls.map(l => l.label)); return spec; };
  as3D("eig-002", withLines({ K: .5, noAxes: true, yaw: -.35, pitch: .3, arrows: [{ to: [1, 0, 0], label: "e_1" }, { to: [0, 0, 1], label: "e_3" },
      { to: [0, 1, 0], c: "inkMute", lw: 2, label: "e_2", lc: "inkMute" }, { to: [1, 2, 0], c: "inkMute", lw: 2, label: "Ae_2", lc: "inkMute" }] },
    [eigLine([1, 0, 0], "red", "E_{\\lambda_1}", 1.6), eigLine([0, 0, 1], "gold", "E_{\\lambda_2}", 1.6)]));
  as3D("diagprojcross-003", withLines({ K: .5, noAxes: true, yaw: -.35, pitch: .3, arrows: [{ to: [1, 0, 0], label: "e_1" }, { to: [0, 0, 1], label: "e_3" },
      { to: [0, 1, 0], c: "inkMute", lw: 2, label: "e_2", lc: "inkMute" }, { to: [.4, 1.6, 0], c: "inkMute", lw: 2, label: "Ae_2\\ (\\text{scaled})", lc: "inkMute", size: 13 }] },
    [eigLine([1, 0, 0], "red", "E_{\\lambda_1}", 1.6), eigLine([0, 0, 1], "gold", "E_{\\lambda_2}", 1.6)]));
  as3D("eig-004", withLines({ K: .7, noAxes: true, yaw: .2, pitch: .4, planes: [{ u: [1, 0, 0], v: [0, 1, 1], ru: [-1.2, 1.3], rv: [-1.1, 1.3] }],
      arrows: [{ to: [1, 0, 0], label: "v_1" }, { to: [0, 1, 1], label: "v_2" }, { to: [0, 2, 1], c: "gold", label: "v_3" }],
      labels: [{ p: add(scl([1, 0, 0], -1.3), scl([0, 1, 1], -1.05)), text: "E_{\\lambda_1}", c: "redDeep" }] },
    [eigLine([0, 2, 1], "gold", "E_{\\lambda_2}", 2.35)]));
  as3D("eig-007", withLines({ K: .6, noAxes: true, n: [1, 1, 0], pitch: .35, planes: [{ u: [1, -1, 0], v: [0, 0, 1], ru: [-1.1, 1.1], rv: [-1.1, 1.2], fill: "#F6EEDB", stroke: "#E2CF95" }],
      arrows: [{ to: [1, 1, 0], c: "red", label: "v_1" }, { to: [1, -1, 0], label: "v_2" }, { to: [0, 0, 1], label: "v_3" }],
      labels: [{ p: add(scl([1, -1, 0], -1), scl([0, 0, 1], 1.1)), text: "E_{\\lambda_2}", c: "gold" }] },
    [eigLine([1, 1, 0], "red", "E_{\\lambda_1}", 1.6)]));
  as3D("eig-008", withLines({ K: .5, noAxes: true, yaw: -.35, pitch: .3, arrows: [{ to: scl(norm([2, -3, 1]), 1.3), c: "red", label: "v" }, { to: [0, 0, 1.2], c: "gold", label: "w" }] },
    [eigLine([2, -3, 1], "red", "E_2", 1.7), eigLine([0, 0, 1], "gold", "E_{-1}", 1.6)]));
  as3D("eig-010", { K: .62, noAxes: true, n: [1, 0, -1], pitch: .35, planes: [{ u: [1, 0, 1], v: [0, 1, 0], ru: [-1, 1.2], rv: [-1.2, 1.4], fill: "#EDEFF2", stroke: "#C9CFD6" }],
      arrows: [{ to: [1, 0, 1], c: "gold", label: "v_1" }, { to: [-1, 0, 1], c: "red", label: "v_2" }, { to: [1, 0, -1], c: "red", lw: 2, label: "Av_2" }, { to: [0, 1, 0], label: "v_3" }],
      labels: [{ p: add(scl([1, 0, 1], -.95), scl([0, 1, 0], 1.35)), text: "\\text{mirror }x=z", c: "inkMute", size: 13 }] });
  as3D("diagprojcross-002", withLines({ K: .6, noAxes: true, n: [0, 1, 1], pitch: .35, planes: [{ u: [1, 0, 0], v: [0, 1, -1], ru: [-1.2, 1.3], rv: [-1.1, 1.2] }],
      arrows: [{ to: [1, 0, 0], label: "v_1" }, { to: [0, 1, -1], label: "v_2" }, { to: [0, 1, 1], c: "gold", label: "v_3" }],
      labels: [{ p: add(scl([1, 0, 0], -1.1), scl([0, 1, -1], 1.1)), text: "E_{\\lambda_1}", c: "redDeep" }] },
    [eigLine([0, 1, 1], "gold", "E_{\\lambda_2}", 1.7)]));
})();
/*SKETCHES_END*/

const VISUAL_OVERRIDES = {
  "basis-001":        "linearIndep",
  "basis-002":        "linearIndep",
  "basis-005":        "basisCoords",
  "transdet-001":     "transformation",
  "vecfieldline-008": "lineIntegral",
  "vecfieldline-009": "lineIntegral",
};

function pickConceptVisual(p) {
  if (!p) return null;
  // a drawing made for this problem (its own numbers) comes first
  if (SKETCH[p.id]) { try { return SKETCH[p.id](); } catch (_) { /* fall back to the topic sketch below */ } }
  const forced = VISUAL_OVERRIDES[p.id];
  if (forced && CONCEPT[forced]) return CONCEPT[forced]();
  const skills = (p.skills || []).map(s => String(s).toLowerCase());
  const title  = String(p.title || "").toLowerCase();
  const text   = String(p.problemLatex || "").toLowerCase();
  const flav   = String(p.examFlavor || "").toLowerCase();
  const all    = [title, text, flav].concat(skills);

  const has = (...kws) => kws.some(kw =>
    all.some(s => s.includes(kw))
  );

  // Vector calculus — most specific first
  if (has("stokes")) return CONCEPT.stokes();
  if (has("divergence theorem", "flux through a closed surface")) return CONCEPT.flux();
  if (has("flux", "vector surface integral", "outward orientation")) return CONCEPT.flux();
  if (has("scalar surface integral", "surface area", "{r_u × r_v}", "parameterize a graph surface", "parameterize a cylindrical surface", "graph parametrization", "parametric surface")) return CONCEPT.surfacePatch();
  if (has("triple integral", "tetrahedral", "cylindrical-coordinate", "cylindrical coordinates")) return CONCEPT.tripleRegion();
  if (has("green's theorem", "greens theorem", "green theorem", "q_x-p_y", "q_x − p_y")) return CONCEPT.greens();
  if (has("change of variable", "jacobian", "transform a parallelogram", "elliptical region", "scaled polar")) return CONCEPT.changeOfVars();
  if (has("polar coordinates", "polar double integral", "polar integral", "da=r", "quarter disk")) return CONCEPT.polarRegion();
  if (has("double integral", "iterated integral", "vertically simple", "switch the order", "non-rectangular region", "sketch a region")) return CONCEPT.doubleRegion();
  if (has("conservative", "potential function", "gradient field", "path independence", "path-dependent", "fundamental theorem of line integrals")) return CONCEPT.conservative();
  if (has("line integral", "parametrize a line segment", "piecewise paths", "parametrize a circle with orientation")) return CONCEPT.lineIntegral();
  if (has("curl", "divergence", "source/sink", "local rotation")) return CONCEPT.curlVis();
  if (has("vector field")) return CONCEPT.vectorField();

  // Multivariable calculus
  if (has("critical point", "second derivative test", "absolute extrema", "boundary behavior on a closed", "interior critical")) return CONCEPT.extrema();
  if (has("tangent plane", "linearization")) return CONCEPT.tangentPlane();
  if (has("gradient", "directional derivative", "direction of maximum increase", "use the gradient as a normal")) return CONCEPT.gradient();
  if (has("level curve", "level set", "describe level curves", "interpret a scalar function geometrically")) return CONCEPT.levelCurves();
  if (has("vector-valued curve", "speed and unit tangent", "arc length", "parametrize a circle in the xy-plane", "differentiate a vector-valued curve")) return CONCEPT.parametricCurve();
  // partial derivatives & chain rule fall through to no visual

  // Linear algebra: geometry-rich first
  if (has("complex eigen")) return CONCEPT.complexEigen();
  if (has("eigen")) return CONCEPT.eigenvector();
  if (has("cross product", "scalar triple product", "parallelepiped", "signed volume", "parallelogram and triangle area")) {
    if (has("scalar triple product", "parallelepiped", "signed volume")) return CONCEPT.tripleProduct();
    return CONCEPT.crossProduct();
  }
  if (has("projection", "split a vector into parallel and perpendicular", "scalar component", "closest point", "perpendicular component", "vector components parallel and perpendicular")) return CONCEPT.projection();
  if (has("determinant as an area scale factor", "area scale", "sign and magnitude of a determinant")) return CONCEPT.determinant();
  if (has("determinant", "invertibility", "singular", "row replacement", "row swap", "scalar multiplication determinant", "determinant of a transpose", "determinant of an inverse", "determinant product rule", "values that make a matrix singular", "compute a 3 by 3 inverse", "solve ax=b using an inverse")) return CONCEPT.determinant();
  if (has("standard matrix of a transformation", "linear map", "kernel", "image/range", "transformation equation", "evaluate a transformation", "matrix of a transformation", "apply a linear map", "linearity")) return CONCEPT.transformation();
  if (has("rref", "row reduce", "pivot", "rank", "null space", "column space", "row space", "rank and nullity", "augmented matrix", "parametric vector solution", "consistency", "inconsistent")) return CONCEPT.rref();
  if (has("linear independ", "linear depend", "dependence relation", "redundant vectors")) return CONCEPT.linearIndep();
  if (has("coordinate vector", "coordinates in a basis", "verify a basis", "determine the dimension of a span")) return CONCEPT.basisCoords();
  if (has("subspace", "homogeneous solution set", "parametrize a subspace", "test closure", "recognize a homogeneous solution set")) return CONCEPT.subspace();
  if (has("plane", "use a normal vector to describe a plane", "write a plane equation")) return CONCEPT.spanPlane();
  if (has("span", "spanning", "linear combination", "vector is in a span", "remove redundant", "write a vector as a linear combination")) {
    // single-vector span feels like a line; multi-vector span like a plane.
    if (has("two direction vectors", "spanning set", "remove redundant", "linear combination of others")) return CONCEPT.spanPlane();
    return CONCEPT.spanLine();
  }
  if (has("perpendicular", "orthogonal", "angle between", "geometric condition", "dot product")) return CONCEPT.dotProduct();
  if (has("symmetric matrix", "m^t=m")) return CONCEPT.symmetric();
  if (has("multiply", "matrix product", "product dimensions", "track matrix dimensions", "matrix powers", "(ab)", "noncommutativity")) return CONCEPT.matrixDims();
  if (has("add and scale vectors", "magnitude", "find magnitudes and distances", "vector arithmetic")) return CONCEPT.vectorAdd();

  return null;
}


/* ============================================================
   RENDER: PROBLEM (study view)
   ============================================================ */

const GOT_CHECK = '<svg class="got-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.4 8.5l3 3 6.2-6.8" pathLength="1"/></svg>';
/* ============================================================
   REPORT ISSUE
   One tap flags a problem. The flag is kept in this browser (so the
   problem shows an "Issue reported" tag) and sent as an anonymous
   GoatCounter event at report/<problem id>, which the SI leader sees from
   the Walkthroughs page. Email stays available for longer notes.
   ============================================================ */
const REPORT_KINDS = {
  answer: "A wrong answer or step",
  typo: "A typo",
  confusing: "It's confusing",
  display: "Math or a picture looks broken",
  other: "Something else",
};
function getReport(id) { return lsGetMap(LS.REPORTED)[id] || null; }
function setReport(id, kind) {
  const map = lsGetMap(LS.REPORTED);
  if (kind) map[id] = { kind, at: Date.now() }; else delete map[id];
  lsSet(LS.REPORTED, map);
}
function sendReportEvent(p, kind) {
  try {
    if (window.goatcounter && typeof window.goatcounter.count === "function")
    { window.goatcounter.count({ path: "report/" + p.id, title: "Issue report · " + p.id, event: true });
      window.goatcounter.count({ path: "report/" + p.id + "/" + kind, title: "Issue report · " + p.id + " · " + (REPORT_KINDS[kind] || kind), event: true }); }
  } catch (_) { /* reporting must never break the page */ }
}
function reportPanelHtml(p, mailto) {
  const r = getReport(p.id);
  return `
    <div class="report-panel no-print" id="reportPanel" hidden>
      <div class="rp-ask"${r ? " hidden" : ""}>
        <div class="rp-head">What looks wrong?</div>
        <div class="rp-chips" role="radiogroup" aria-label="Kind of issue">
          ${Object.entries(REPORT_KINDS).map(([k, label]) => `<button type="button" class="rp-chip" role="radio" aria-checked="false" data-kind="${k}">${label}</button>`).join("")}
        </div>
        <div class="rp-foot">
          <button class="btn btn-red btn-sm" id="reportSend" type="button" disabled>Send report</button>
          <a class="rp-mail" href="${mailto}">Email details instead</a>
        </div>
        <p class="rp-note">Anonymous. It flags this problem for the SI leader to check and fix.</p>
      </div>
      <div class="rp-done"${r ? "" : " hidden"}>
        <div class="rp-head">Thanks, this problem is flagged.</div>
        <p class="rp-note">The SI leader sees which problems were reported. To explain what's wrong, <a class="rp-mail" href="${mailto}">email the details</a>.</p>
        <button class="rp-undo" id="reportUndo" type="button">Remove my tag</button>
      </div>
    </div>`;
}
function wireReport(p) {
  const btn = $("#reportBtn"), panel = $("#reportPanel");
  if (!btn || !panel) return;
  const ask = panel.querySelector(".rp-ask"), done = panel.querySelector(".rp-done"), send = $("#reportSend");
  const chips = Array.from(panel.querySelectorAll(".rp-chip"));
  let kind = null;
  const paint = () => {
    const r = getReport(p.id);
    btn.classList.toggle("is-reported", !!r);
    btn.innerHTML = r ? "Reported &#10003;" : "Report a problem";
    ask.hidden = !!r; done.hidden = !r;
    let pill = $("#reportPill");
    if (r && !pill) {
      pill = document.createElement("span"); pill.className = "pill status-report"; pill.id = "reportPill"; pill.textContent = "Issue reported";
      $("#studyMeta")?.appendChild(pill);
    } else if (!r && pill) pill.remove();
  };
  btn.addEventListener("click", () => {
    panel.hidden = !panel.hidden;
    btn.setAttribute("aria-expanded", String(!panel.hidden));
    if (!panel.hidden) {
      panel.classList.remove("enter"); void panel.offsetWidth; panel.classList.add("enter");
      requestAnimationFrame(() => { const b = panel.getBoundingClientRect(); if (b.bottom > window.innerHeight - 12) window.scrollBy({ top: b.bottom - window.innerHeight + 24, behavior: "smooth" }); });
    }
  });
  chips.forEach(c => c.addEventListener("click", () => {
    kind = c.dataset.kind;
    chips.forEach(x => { const on = x === c; x.classList.toggle("on", on); x.setAttribute("aria-checked", String(on)); });
    send.disabled = false;
  }));
  send.addEventListener("click", () => {
    if (!kind) return;
    setReport(p.id, kind); sendReportEvent(p, kind); paint();
    showToast("Reported. Thanks for flagging it!", "got", 1800);
  });
  $("#reportUndo")?.addEventListener("click", () => {
    setReport(p.id, null); kind = null;
    chips.forEach(x => { x.classList.remove("on"); x.setAttribute("aria-checked", "false"); });
    send.disabled = true; paint();
    showToast("Tag removed", "neutral", 1400);
  });
}

/* Report a problem, from the footer. On a problem page it opens that problem's own report panel;
   anywhere else it flags the page itself (id "page-…", e.g. page-visualize-subspace), through the same
   anonymous report/<id> events, so the SI leader sees page reports in the same Reported issues list. */
function reportPageId() {
  const parts = (location.hash.replace(/^#\/?/, "") || "home").split("/").filter(Boolean), h = parts[0] || "home";
  if (h === "visualize") return "page-visualize" + (parts[1] && VZ_BY_ID[parts[1]] ? "-" + parts[1] : "");
  if (h === "walkthroughs") return "page-walkthroughs" + (/^si-\d+$/.test(parts[1] || "") ? "-" + parts[1] : "");
  if (h === "section" && /^\d+$/.test(parts[1] || "")) return "page-section-" + parts[1];
  return "page-" + (["topics", "exam", "review"].includes(h) ? h : "home");
}
function reportPageLabel(id) {
  const k = id.replace(/^page-/, "");
  if (k.startsWith("visualize-")) { const v = VZ_BY_ID[k.slice(10)]; return "Visualize: " + (v ? v.title : k.slice(10)); }
  if (k.startsWith("walkthroughs-si-")) return "SI guide, session " + parseInt(k.slice(16), 10);
  if (k.startsWith("section-")) return "Section " + k.slice(8) + " problem list";
  return { home: "Home page", topics: "Practice page", exam: "Exam mode", review: "Need review", walkthroughs: "SI walkthroughs", visualize: "Visualize page" }[k] || k;
}
function reportPageRoute(id) {
  const k = id.replace(/^page-/, "");
  if (k.startsWith("visualize-")) return "/visualize/" + k.slice(10);
  if (k.startsWith("walkthroughs-")) return "/walkthroughs/" + k.slice(13);
  if (k.startsWith("section-")) return "/section/" + k.slice(8);
  return "/" + k;
}
// every page that can be reported, so the leader's list can ask GoatCounter about each one
function reportPageIds() {
  const ids = ["home", "topics", "exam", "review", "walkthroughs", "visualize"].map(k => "page-" + k);
  VZ_LIST.forEach(v => ids.push("page-visualize-" + v.id));
  for (let n = 1; n <= 22; n++) ids.push("page-walkthroughs-si-" + String(n).padStart(2, "0"));
  SECTIONS.forEach(x => ids.push("page-section-" + x.pos));
  return ids;
}
function openPageReport() {
  const onProblem = $("#reportBtn") && $("#view-problem")?.classList.contains("active");
  if (onProblem) {                                       // the problem's own panel, opened and brought into view
    const btn = $("#reportBtn"), panel = $("#reportPanel");
    if (panel && panel.hidden) btn.click();
    (panel || btn).scrollIntoView({ behavior: "smooth", block: "center" });
    return;
  }
  const id = reportPageId(), label = reportPageLabel(id), p = { id };
  const mailto = "mailto:mbocksta@andrew.cmu.edu?subject=" + encodeURIComponent("21-254 Practice Lab: a problem on " + label) +
    "&body=" + encodeURIComponent("Page: " + location.href + "\n\nWhat looks wrong:\n");
  let modal = $("#pageReport");
  if (modal) modal.remove();
  modal = document.createElement("div");
  modal.id = "pageReport"; modal.className = "shortcuts-help";
  const r = getReport(id);
  modal.innerHTML = `
    <div class="shortcuts-card pr-card" role="dialog" aria-modal="true" aria-labelledby="prTitle">
      <div class="shortcuts-head">
        <span class="shortcuts-kicker" id="prTitle">Report a problem</span>
        <button class="shortcuts-close" aria-label="Close">×</button>
      </div>
      <p class="pr-where">On: <strong>${escapeHtml(label)}</strong></p>
      <div class="rp-ask"${r ? " hidden" : ""}>
        <div class="rp-head">What looks wrong?</div>
        <div class="rp-chips" role="radiogroup" aria-label="Kind of problem">
          ${Object.entries(REPORT_KINDS).map(([k, t]) => `<button type="button" class="rp-chip" role="radio" aria-checked="false" data-kind="${k}">${t}</button>`).join("")}
        </div>
        <div class="rp-foot">
          <button class="btn btn-red btn-sm" id="prSend" type="button" disabled>Send report</button>
          <a class="rp-mail" href="${mailto}">Email details instead</a>
        </div>
        <p class="rp-note">Anonymous. It flags this page for review, and the SI leader corrects it. To say exactly what's wrong, email the details.</p>
      </div>
      <div class="rp-done"${r ? "" : " hidden"}>
        <div class="rp-head">Thanks, this page is flagged for review.</div>
        <p class="rp-note">To explain what's wrong, <a class="rp-mail" href="${mailto}">email the details</a>.</p>
        <button class="rp-undo" id="prUndo" type="button">Remove my flag</button>
      </div>
    </div>`;
  document.body.appendChild(modal);
  const ask = modal.querySelector(".rp-ask"), done = modal.querySelector(".rp-done"), send = modal.querySelector("#prSend"), chips = [...modal.querySelectorAll(".rp-chip")];
  let kind = null;
  const close = () => { modal.remove(); $("#reportFooterBtn")?.focus(); };
  modal.addEventListener("click", e => { if (e.target === modal || e.target.classList.contains("shortcuts-close")) close(); });
  chips.forEach(c => c.addEventListener("click", () => {
    kind = c.dataset.kind;
    chips.forEach(x => { const on = x === c; x.classList.toggle("on", on); x.setAttribute("aria-checked", String(on)); });
    send.disabled = false;
  }));
  send.addEventListener("click", () => {
    if (!kind) return;
    setReport(id, kind); sendReportEvent(p, kind);
    ask.hidden = true; done.hidden = false;
    showToast("Reported. Thanks for flagging it!", "got", 1800);
  });
  modal.querySelector("#prUndo").addEventListener("click", () => { setReport(id, null); ask.hidden = false; done.hidden = true; kind = null; chips.forEach(x => { x.classList.remove("on"); x.setAttribute("aria-checked", "false"); }); send.disabled = true; });
  (r ? modal.querySelector("#prUndo") : chips[0])?.focus();
}

function statusButtons(status) {
  return {
    got: { cls: "btn " + (status === "got" ? "btn-primary" : "btn-ghost"),
           html: status === "got" ? GOT_CHECK + "<span>Got it</span>" : "Mark as Got It" },
    rev: { cls: "btn " + (status === "review" ? "btn-red" : "btn-ghost"),
           html: status === "review" ? "★ Flagged for review" : "Mark as Need Review" },
  };
}
function sectionMapHtml(section, currentId) {
  const map = getStatusMap();
  const segs = section.problems.map((q, i) => {
    const st = map[q.id];
    const cls = "sec-map-seg" + (st === "got" ? " is-got" : st === "review" ? " is-review" : "") + (q.id === currentId ? " is-current" : "");
    return '<a class="' + cls + '" href="#/problem/' + q.id + '" aria-label="Problem ' + (i + 1) + (st === "got" ? ", got it" : st === "review" ? ", flagged for review" : "") + '"></a>';
  }).join("");
  const idx = section.problems.findIndex(q => q.id === currentId);
  const got = sectionProgress(section).got;
  return '<div class="sec-map" role="navigation" aria-label="Problems in this section">' + segs + '</div>' +
    '<div class="sec-map-cap"><span>Problem <b>' + (idx + 1) + '</b> of ' + section.problems.length + '</span>' +
    '<span id="secMapGot"><b>' + got + '</b> got it</span></div>' +
    '<div class="sec-map-key" aria-hidden="true"><span><i></i>Got it</span><span><i class="k-rev"></i>Review</span><span><i class="k-cur"></i>This one</span></div>';
}
function paintStatus(p, status, celebrate) {
  const s = statusButtons(status);
  const got = $("#markGot"), rev = $("#markReview"), clr = $("#clearStatus");
  if (got) { got.className = s.got.cls; got.innerHTML = s.got.html; }
  if (rev) { rev.className = s.rev.cls; rev.innerHTML = s.rev.html; }
  if (clr) clr.hidden = !status;
  const seg = document.querySelector("#view-problem .sec-map-seg.is-current");
  if (seg) {
    seg.classList.toggle("is-got", status === "got");
    seg.classList.toggle("is-review", status === "review");
  }
  const section = State.sectionsByPos.get(p.sectionPos);
  const cap = $("#secMapGot");
  if (cap && section) cap.innerHTML = "<b>" + sectionProgress(section).got + "</b> got it";
  if (celebrate && status === "got" && got) { got.classList.remove("pop"); void got.offsetWidth; got.classList.add("pop"); }
}

function conceptPanelHtml(p) {
  const cv = pickConceptVisual(p);
  if (!cv) return "";
  const interactive = cv.viz3d && typeof Viz3D !== "undefined" && Viz3D.supported() && Viz3D.hasScene(cv.viz3d);
  return `
    <div class="concept-panel">
      <div class="concept-panel-header">
        <span class="concept-panel-kicker">${interactive ? "Interactive 3-D" : cv.kicker}</span>
        <h3 class="concept-panel-title">${cv.plain ? renderTextOrLatex(cv.title) : cv.title}</h3>
        <span class="concept-panel-tag">${interactive ? "Drag to rotate" : cv.plain ? (cv.scaled ? "Drawn to scale" : "") : "Concept sketch, not to scale"}</span>
      </div>
      ${interactive
        ? `<div class="viz3d-wrap" data-viz3d="${cv.viz3d}"></div>`
        : `<div class="concept-svg-wrap">${cv.svg}</div>`}
      ${cv.formula ? `<div class="concept-formula tex2jax_process">\\[${cv.formula}\\]</div>` : ""}
      <p class="concept-caption">${cv.plain ? renderTextOrLatex(cv.caption) : cv.caption}</p>
    </div>`;
}

function renderProblem(problemId) {
  const p = State.problemsById.get(problemId);
  const run = $("#examRun"); if (run) run.innerHTML = "";   // one guided solution on the page at a time
  if (!p) {
    if (State.sectionsData.length === 0) {
      // Still loading — show shimmer; init() will call handleRoute() again.
      $("#studyMain").innerHTML = `
        <div class="skeleton" style="height: 24px; width: 30%; margin-bottom: 12px;"></div>
        <div class="skeleton" style="height: 36px; width: 70%; margin-bottom: 24px;"></div>
        <div class="skeleton" style="height: 140px; width: 100%; margin-bottom: 18px;"></div>
        <div class="skeleton" style="height: 50px; width: 100%; margin-bottom: 10px;"></div>
        <div class="skeleton" style="height: 50px; width: 100%; margin-bottom: 10px;"></div>`;
      $("#studySide").innerHTML = "";
      return;
    }
    $("#studyMain").innerHTML = `<div class="error-state">
      <h3>Problem not found</h3><div>This problem ID isn't in the loaded library.</div>
    </div>`;
    $("#studySide").innerHTML = "";
    return;
  }
  State.currentProblem = p;
  // Remember for "Resume where you left off" on the home page
  lsSet(LS.LAST_PROBLEM, p.id);

  // Back button target
  $("#problemBackBtn").onclick = () => navigate(`/section/${p.sectionPos}`);

  // Compute neighbor problems
  const section = State.sectionsByPos.get(p.sectionPos);
  const idx = section.problems.findIndex(x => x.id === p.id);
  const prev = idx > 0 ? section.problems[idx - 1] : null;
  const next = idx < section.problems.length - 1 ? section.problems[idx + 1] : null;

  const status  = getStatus(p.id);

  // Mailto for report
  const subject = encodeURIComponent(`21-254 Practice Lab Issue: ${p.id}`);
  const body    = encodeURIComponent(
    `Problem ID: ${p.id}\nSection: ${p.section}\nTitle: ${p.title}\n\nWhat seems incorrect or confusing?\n`
  );
  const mailto  = `mailto:mbocksta@andrew.cmu.edu?subject=${subject}&body=${body}`;

  $("#studyMain").innerHTML = `
    <div class="study-section-tag">Section ${String(p.sectionPos).padStart(2,'0')} · ${escapeHtml(p.section)}</div>
    <h1 class="study-title">${escapeHtml(p.title)}</h1>

    <div class="study-metabar" id="studyMeta">
      ${p.difficulty ? `<span class="pill ${classForDifficulty(p.difficulty)}">${escapeHtml(p.difficulty)}</span>` : ""}
      ${p.estimatedMinutes ? `<span class="pill">~${p.estimatedMinutes} min</span>` : ""}
      ${lectureOf(p.id) ? `<span class="pill pill-lec" title="Matching lecture on the Fall 2026 schedule">${lectureOf(p.id).short} · ${escapeHtml(lectureOf(p.id).topic)}</span>` : ""}
      ${p.topic ? `<span class="pill">${escapeHtml(p.topic)}</span>` : ""}
      ${status === "got" ? `<span class="pill status-got">Got it</span>` : ""}
      ${status === "review" ? `<span class="pill status-review">Review</span>` : ""}
      ${getReport(p.id) ? `<span class="pill status-report" id="reportPill">Issue reported</span>` : ""}
    </div>

    ${p.skills && p.skills.length ? `
      <p class="skills-line"><strong>Skills</strong>${p.skills.map(s => escapeHtml(s)).join(" &middot; ")}</p>` : ""}

    <div class="problem-statement">
      <div class="math-block tex2jax_process">${p.problemLatex || "<em style='color:var(--ink-mute)'>No problem statement.</em>"}</div>
    </div>

    ${p.thinkFirst ? `
      <details class="think-first">
        <summary>Not sure where to start?</summary>
        <div class="math-block">${p.thinkFirst}</div>
      </details>` : ""}

    ${guideHtml(p)}

    ${conceptPanelHtml(p)}

    <div class="study-actions">
      <button class="${statusButtons(status).got.cls}" id="markGot">${statusButtons(status).got.html}</button>
      <button class="${statusButtons(status).rev.cls}" id="markReview">${statusButtons(status).rev.html}</button>
      ${next ? `<button class="btn btn-ghost" id="nextProblemBtn" type="button" data-route="/problem/${escapeHtml(next.id)}">Next problem <span class="arrow" aria-hidden="true">→</span></button>` : ""}
      <button class="btn btn-ghost btn-sm" id="clearStatus"${status ? "" : " hidden"}>Clear status</button>
      <span class="study-actions-minor">
        <button class="btn btn-ghost btn-sm" id="copyLinkBtn" type="button">Copy link</button>
        <button class="btn btn-ghost btn-sm${getReport(p.id) ? " is-reported" : ""}" id="reportBtn" type="button" aria-expanded="false" aria-controls="reportPanel">${getReport(p.id) ? "Reported &#10003;" : "Report a problem"}</button>
      </span>
    </div>
    ${reportPanelHtml(p, mailto)}
  `;

  // Sidebar: moving through the section and finding something else (the section, lecture, level and time are in
  // the chips under the title; the id travels with a report on its own)
  $("#studySide").innerHTML = `
    <div class="side-card">
      <h4>Move Through Section</h4>
      <div class="study-nav">
        <button class="btn btn-ghost btn-sm" id="studyPrev" ${prev ? `data-go="${prev.id}"` : "disabled"}>← Prev</button>
        <button class="btn btn-ghost btn-sm" id="studyNext" ${next ? `data-go="${next.id}"` : "disabled"}>Next →</button>
      </div>
      ${sectionMapHtml(section, p.id)}
      <button class="shortcuts-hint" id="shortcutsTrigger" type="button" aria-label="Show keyboard shortcuts">
        Tip: press <kbd>?</kbd> for keyboard shortcuts
      </button>
    </div>
    <div class="side-card">
      <h4>Find Something Else</h4>
      <div style="display:flex; flex-direction:column; gap:6px;">
        <button class="btn btn-ghost btn-sm btn-block" id="sideRandom">Random Problem</button>
        <button class="btn btn-ghost btn-sm btn-block" id="sideRandomSection">Random from Section</button>
        <button class="btn btn-ghost btn-sm btn-block" data-route="/section/${p.sectionPos}">Back to Section</button>
      </div>
    </div>
  `;

  wireProblemView(p, prev, next);

  // Bring any interactive 3-D concept panels to life
  if (typeof Viz3D !== "undefined") Viz3D.mountAll($("#view-problem"));

  // Re-render math
  typesetMath($("#view-problem"));
}

/* ============================================================
   GUIDED SOLUTION
   One path through a problem: hints, then the setup, the worked steps and the
   final answer. Students open one step at a time along a rail that shows where
   they are and what is left. Steps they have opened are remembered for this
   visit, so leaving a problem and coming back keeps their place.
   ============================================================ */
const GuideMemory = new Map();                 // problem id -> { shown: [i...], passed: [i...] }
let GuideCtl = null;                           // the guide on screen (keyboard shortcuts use it)
const GUIDE_PHASES = [["hint", "Hints"], ["setup", "Setup"], ["step", "Worked solution"], ["answer", "Answer"]];
const G_CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const G_AGAIN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v5h-5"/></svg>';

// The public address, so a copied link works for anyone (even when copied from a local copy)
const SITE_URL = "https://sonnnnnion.github.io/21-254-si-practice/";
function copyText(text) {
  const fallback = () => {
    try {
      const ta = document.createElement("textarea");
      ta.value = text; ta.setAttribute("readonly", ""); ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select(); const ok = document.execCommand("copy"); ta.remove(); return ok;
    } catch (_) { return false; }
  };
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text).then(() => true, () => fallback());
  return Promise.resolve(fallback());
}

function guideSteps(p) {
  const steps = [], hints = p.hints || [], sol = p.solutionSteps || [];
  hints.forEach((h, i) => steps.push({ kind: "hint", n: i + 1, kick: hints.length > 1 ? `Hint ${i + 1} of ${hints.length}` : "Hint", html: h }));
  if (p.setupLatex) steps.push({ kind: "setup", n: "S", kick: "Setup", html: p.setupLatex });
  sol.forEach((st, i) => steps.push({ kind: "step", n: i + 1, kick: `Step ${i + 1} of ${sol.length}`, name: st.label || "", html: st.latex || st.text || "" }));
  if (p.finalAnswerLatex) steps.push({ kind: "answer", n: G_CHECK, kick: "Final answer", html: p.finalAnswerLatex });
  return steps;
}

function guideHtml(p) {
  const steps = guideSteps(p);
  if (!steps.length) return "";
  const phases = GUIDE_PHASES.filter(([k]) => steps.some(s => s.kind === k));
  const cls = { hint: "g-hint", setup: "g-setup", step: "g-step-k", answer: "g-answer" };
  const items = steps.map((s, i) => `
      <li class="g-step ${cls[s.kind]}" data-kind="${s.kind}" data-i="${i}" aria-hidden="true">
        <div class="g-inner">
          <span class="g-node" aria-hidden="true">${s.n}</span>
          <div class="g-title"><div class="g-kick">${escapeHtml(s.kick)}</div>${s.name ? `<div class="g-name">${escapeHtml(s.name)}</div>` : ""}</div>
          <div class="g-content">${s.kind === "answer"
            ? `<div class="final-answer-box"><div class="math-block">${s.html}</div></div>`
            : `<div class="math-block">${s.html}</div>`}</div>
        </div>
      </li>`).join("");
  return `
    <section class="guide" id="guide" aria-label="Guided solution">
      <div class="guide-head">
        <div>
          <div class="guide-kicker">Guided solution</div>
          <p class="guide-sub">Work it out first, then open one step at a time.</p>
        </div>
        <div class="guide-tools">
          <button class="g-link" id="guideAll" type="button">Show all</button>
          <button class="g-link" id="guideReset" type="button" hidden>Start over</button>
        </div>
      </div>
      <div class="guide-track" aria-hidden="true">
        ${phases.map(([k, name]) => `<div class="gt-seg" data-kind="${k}"><div class="gt-bar"><i></i></div><span>${name}</span></div>`).join("")}
      </div>
      <ol class="g-rail" aria-live="polite">${items}</ol>
      <div class="g-next-row" id="guideNextRow">
        <span class="g-ghost" aria-hidden="true"></span>
        <button class="btn btn-red g-next" id="guideNext" type="button"><span class="g-label">Show a hint</span> <span class="arrow" aria-hidden="true">→</span></button>
        <button class="g-link" id="guideSkip" type="button">Skip to the solution</button>
      </div>
      <div class="g-end" id="guideEnd" hidden>
        <span class="g-node" aria-hidden="true">${G_AGAIN}</span>
        ${p.similarProblemPrompt
          ? `<div class="g-kick">Try one more</div><div class="g-content"><div class="math-block">${p.similarProblemPrompt}</div></div>
             <p class="g-end-note">Then mark this one below: Got it, or Need review.</p>`
          : `<div class="g-kick">That's the whole solution</div><p class="g-end-note">Mark this one below: Got it, or Need review.</p>`}
      </div>
    </section>`;
}

function wireGuide(p) {
  GuideCtl = null;
  const guide = document.getElementById("guide");
  if (!guide) return;
  const steps = Array.from(guide.querySelectorAll(".g-step")), kinds = steps.map(el => el.dataset.kind), total = steps.length;
  const mem = GuideMemory.get(p.id) || { shown: [], passed: [] };
  const shown = new Set(mem.shown), passed = new Set(mem.passed);
  const row = $("#guideNextRow"), next = $("#guideNext"), label = next.querySelector(".g-label"), skip = $("#guideSkip");
  const all = $("#guideAll"), reset = $("#guideReset"), end = $("#guideEnd");
  const segs = Array.from(guide.querySelectorAll(".gt-seg"));
  const hasSolution = kinds.some(k => k !== "hint");

  const nextIndex = () => { for (let i = 0; i < total; i++) if (!shown.has(i) && !passed.has(i)) return i; return -1; };
  const save = () => GuideMemory.set(p.id, { shown: [...shown], passed: [...passed] });
  function labelFor(i) {
    const k = kinds[i], el = steps[i];
    if (k === "hint") { const n = kinds.filter(x => x === "hint").length; return n > 1 ? `Show hint ${el.querySelector(".g-node").textContent}` : "Show a hint"; }
    if (k === "setup") return "Show the setup";
    if (k === "step") { const n = kinds.filter(x => x === "step").length, s = el.querySelector(".g-node").textContent;
                        return s === "1" ? "Start the worked solution" : `Next step (${s} of ${n})`; }
    return "Reveal the final answer";
  }
  function paint(fresh, stagger) {
    fresh = fresh || [];
    steps.forEach((el, i) => {
      const on = shown.has(i);
      el.classList.toggle("shown", on);
      el.setAttribute("aria-hidden", on ? "false" : "true");
      const k = fresh.indexOf(i);
      if (k >= 0) {
        const d = stagger ? k * 90 : 0;
        el.style.setProperty("--d", d + "ms");
        el.style.transitionDelay = d ? d + "ms" : "";
        el.classList.remove("enter"); void el.offsetWidth; el.classList.add("enter");
        clearTimeout(el._gT); el._gT = setTimeout(() => { el.classList.remove("enter"); el.style.transitionDelay = ""; }, d + 1600);
      }
    });
    const ni = nextIndex();
    let last = -1; shown.forEach(i => { if (i > last) last = i; });
    steps.forEach((el, i) => el.classList.toggle("tail", i === last && ni === -1));
    row.hidden = ni === -1;
    if (ni !== -1) {
      const txt = labelFor(ni);
      if (label.textContent !== txt) { label.textContent = txt; label.classList.remove("swap"); void label.offsetWidth; label.classList.add("swap"); }
      skip.hidden = !(kinds[ni] === "hint" && hasSolution);
    }
    const wasEnd = !end.hidden;
    end.hidden = ni !== -1 || shown.size === 0;
    if (!end.hidden && !wasEnd && fresh.length) { end.classList.remove("enter"); void end.offsetWidth; end.classList.add("enter"); }
    all.hidden = shown.size === total;
    reset.hidden = shown.size === 0;
    segs.forEach(seg => {
      const k = seg.dataset.kind, idx = kinds.map((x, i) => x === k ? i : -1).filter(i => i >= 0);
      const on = idx.filter(i => shown.has(i)).length;
      seg.querySelector("i").style.setProperty("--fill", (100 * on / idx.length).toFixed(1) + "%");
      seg.classList.toggle("on", on > 0);
      seg.classList.toggle("now", ni !== -1 && kinds[ni] === k);
    });
  }
  // keep the newly opened step (and the button under it) in view, without jumping past its start
  function follow(i) {
    const el = steps[i], inner = el.querySelector(".g-inner");
    requestAnimationFrame(() => {
      const top = el.getBoundingClientRect().top, h = inner.scrollHeight, rowH = row.hidden ? 0 : 56;
      const overflow = top + h + rowH + 24 - window.innerHeight, room = top - 96;
      if (overflow > 0 && room > 0) window.scrollBy({ top: Math.min(overflow, room), behavior: "smooth" });
    });
  }
  function advance() {
    const i = nextIndex(); if (i === -1) return false;
    shown.add(i); save(); paint([i]); follow(i);
    return true;
  }
  function showAll() {
    const fresh = []; for (let i = 0; i < total; i++) if (!shown.has(i)) { shown.add(i); fresh.push(i); }
    passed.clear(); save(); paint(fresh, true);
  }
  function startOver() {
    shown.clear(); passed.clear(); save(); paint();
    const top = guide.getBoundingClientRect().top;
    if (top < 80) window.scrollBy({ top: top - 96, behavior: "smooth" });
  }
  next.addEventListener("click", advance);
  // Skip: pass over the unopened hints and open the whole worked solution and answer at once
  function skipToSolution() {
    const fresh = [];
    kinds.forEach((k, i) => { if (k === "hint") { if (!shown.has(i)) passed.add(i); } else if (!shown.has(i)) { shown.add(i); fresh.push(i); } });
    save(); paint(fresh, true);
    if (!fresh.length) return;
    const first = steps[fresh[0]];
    requestAnimationFrame(() => {
      const top = first.getBoundingClientRect().top;
      if (top < 80 || top > window.innerHeight * 0.45) window.scrollBy({ top: top - 110, behavior: "smooth" });
    });
  }
  skip.addEventListener("click", skipToSolution);
  all.addEventListener("click", showAll);
  reset.addEventListener("click", startOver);

  // first paint (restored steps appear without animating in)
  guide.classList.add("no-anim"); paint();
  requestAnimationFrame(() => requestAnimationFrame(() => guide.classList.remove("no-anim")));
  GuideCtl = { advance, toggleAll: () => (shown.size < total ? showAll() : startOver()) };
}

function wireProblemView(p, prev, next) {
  wireGuide(p);

  wireReport(p);

  $("#copyLinkBtn")?.addEventListener("click", () => {
    copyText(SITE_URL + "#/problem/" + p.id).then(ok => showToast(ok ? "Link copied" : "Couldn't copy the link", ok ? "got" : "neutral", 1600));
  });

  // Status actions update in place: the guide's open steps and typeset math stay put
  $("#markGot")?.addEventListener("click", () => {
    const next = getStatus(p.id) === "got" ? null : "got";
    setStatus(p.id, next);
    showToast(next === "got" ? "Marked as Got It" : "Removed Got It", next === "got" ? "got" : "neutral");
    paintStatus(p, next, true);
  });
  $("#markReview")?.addEventListener("click", () => {
    const next = getStatus(p.id) === "review" ? null : "review";
    setStatus(p.id, next);
    showToast(next === "review" ? "Added to Need Review" : "Removed from Need Review");
    paintStatus(p, next, false);
  });
  $("#clearStatus")?.addEventListener("click", () => {
    setStatus(p.id, null);
    showToast("Status cleared", "neutral");
    paintStatus(p, null, false);
  });

  // Sidebar nav
  $$("#view-problem .study-nav button[data-go]").forEach(b => {
    b.addEventListener("click", () => navigate(`/problem/${b.dataset.go}`));
  });
  $("#sideRandom")?.addEventListener("click", () => {
    const all = Array.from(State.problemsById.values());
    const pick = all[Math.floor(Math.random() * all.length)];
    if (pick) navigate(`/problem/${pick.id}`);
  });
  $("#sideRandomSection")?.addEventListener("click", () => {
    const section = State.sectionsByPos.get(p.sectionPos);
    const pick = section.problems[Math.floor(Math.random() * section.problems.length)];
    if (pick) navigate(`/problem/${pick.id}`);
  });
  $("#shortcutsTrigger")?.addEventListener("click", toggleShortcutsHelp);
}

/* ============================================================
   RENDER: EXAM MODE
   ============================================================ */

function renderExamSetup() {
  // Sync UI to State
  $$("[data-exam-pick]").forEach(b => {
    b.classList.toggle("selected", b.dataset.examPick === State.examChoice);
  });
  $$("[data-size-pick]").forEach(b => {
    b.classList.toggle("selected", Number(b.dataset.sizePick) === State.examSize);
  });
  renderExamResume();
}

// Problems for an exam, grouped by lecture (course order)
function examPool(choice) {
  const cfg = EXAM_MAP[choice], groups = [], seen = new Set();
  if (!cfg) return groups;
  const [lo, hi] = cfg.lectures;
  COURSE_LECTURES.forEach(([n, date, topic, ids]) => {
    if (n < lo || n > hi) return;
    const ps = ids.map(id => State.problemsById.get(id)).filter(p => p && !seen.has(p.id));
    ps.forEach(p => seen.add(p.id));
    if (ps.length) groups.push({ n, topic, problems: ps });
  });
  return groups;
}

function generateExamSet() {
  const cfg = EXAM_MAP[State.examChoice];
  if (!cfg) return;
  const groups = examPool(State.examChoice);
  if (!groups.length) {
    $("#examSetContainer").innerHTML = `<div class="error-state">
      <h3>No problems available</h3>
      <div>The problems for these lectures haven't loaded yet.</div></div>`;
    return;
  }
  // Spread the set across lectures: shuffle each lecture's problems, visit lectures in a random
  // order, take one from each in turn, then show the set in course order.
  const bags = shuffle(groups.map(g => ({ n: g.n, left: shuffle(g.problems) })));
  const total = groups.reduce((t, g) => t + g.problems.length, 0), n = Math.min(State.examSize, total), picked = [];
  while (picked.length < n) {
    for (const bag of bags) { if (picked.length >= n) break; const p = bag.left.pop(); if (p) picked.push(p); }
  }
  const order = p => { const L = lectureOf(p.id); return L ? L.first : 99; };
  startExamRun(picked.sort((a, b) => order(a) - order(b)).map(p => p.id));
}

/* ============================================================
   EXAM RUN
   Generating a review set starts a timed run: one question per page, a
   stopwatch in the corner that keeps going across every question and turns
   red at 50 minutes, arrow keys or Next to move on, and a summary at the end
   to check solutions and mark each problem. The run is saved in this
   browser, so switching tabs or reloading picks up where you were.
   ============================================================ */
const EXAM_RUN_KEY = "pl254:examRun";
const EXAM_LATE_SEC = 50 * 60;
const EXAM_CLOCK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13.5" r="7.5"/><path d="M12 13.5V9.5M10 2.5h4M18.2 6.8l1.3-1.3"/></svg>';
let examTick = null;
function getExamRun() {
  const r = lsGet(EXAM_RUN_KEY, null);
  return r && Array.isArray(r.ids) && r.ids.length && r.startedAt ? r : null;
}
const saveExamRun = r => lsSet(EXAM_RUN_KEY, r);
const examElapsed = r => Math.max(0, ((r.endedAt || Date.now()) - r.startedAt) / 1000);
function fmtClock(sec) {
  sec = Math.floor(sec);
  const h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60), ss = String(sec % 60).padStart(2, "0");
  return h ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
}
function startExamRun(ids) {
  saveExamRun({ choice: State.examChoice, ids, idx: 0, startedAt: Date.now(), endedAt: null, peeked: [], seen: [0] });
  navigate("/exam/run/1");
}
function finishExamRun() {
  const r = getExamRun();
  if (r && !r.endedAt) { r.endedAt = Date.now(); saveExamRun(r); }
  navigate("/exam/run/done");
}
function startExamClock() {
  stopExamClock();
  const box = $("#examClock"), t = $("#examClockT");
  const paint = () => {
    const r = getExamRun();
    if (!r || r.endedAt) { stopExamClock(); box.hidden = true; return; }
    const sec = examElapsed(r), late = sec >= EXAM_LATE_SEC;
    t.textContent = fmtClock(sec);
    const bar = document.querySelector(".er-bar-clock");  // the same clock, inside the exam bar on smaller screens
    if (bar) { bar.querySelector(".er-bar-t").textContent = t.textContent; bar.classList.toggle("is-late", late); }
    if (late && !box.classList.contains("is-late")) { box.classList.add("is-late", "just-late"); setTimeout(() => box.classList.remove("just-late"), 1400); }
    else if (!late) box.classList.remove("is-late");
  };
  box.hidden = false; paint();
  examTick = setInterval(paint, 1000);
}
function stopExamClock() { if (examTick) { clearInterval(examTick); examTick = null; } }

// Setup page: offer to resume a run in progress, or show the last result
function renderExamResume() {
  const box = $("#examSetContainer"), r = getExamRun();
  if (!box) return;
  if (!r || !State.problemsById.size) { box.innerHTML = ""; return; }
  const cfg = EXAM_MAP[r.choice] || { title: "Practice exam" };
  box.innerHTML = r.endedAt
    ? `<div class="er-resume"><div><div class="er-kick">Last practice exam</div><strong>${escapeHtml(cfg.title)} · ${r.ids.length} questions · ${fmtClock(examElapsed(r))}</strong></div>
         <div class="er-resume-btns"><button class="btn btn-ghost btn-sm" data-route="/exam/run/done">See results</button>
         <button class="er-clear" id="erClear" type="button">Clear</button></div>
         <div class="er-confirm" id="erConfirm" hidden role="alertdialog" aria-label="Clear this exam"><span>Clear this exam and its results? This can't be undone.</span>
           <button class="btn btn-red btn-sm" id="erClearYes" type="button">Clear it</button><button class="btn btn-ghost btn-sm" id="erClearNo" type="button">Keep it</button></div></div>`
    : `<div class="er-resume is-live"><div><div class="er-kick">Exam in progress</div><strong>${escapeHtml(cfg.title)} · question ${r.idx + 1} of ${r.ids.length} · ${fmtClock(examElapsed(r))} so far</strong></div>
         <div class="er-resume-btns"><button class="btn btn-red btn-sm" data-route="/exam/run/${r.idx + 1}">Resume <span class="arrow">→</span></button>
         <button class="btn btn-ghost btn-sm" id="erDiscard" type="button">End it</button></div></div>`;
  $("#erDiscard")?.addEventListener("click", () => { r.endedAt = Date.now(); saveExamRun(r); renderExamResume(); });
  // clearing asks first, in place (no pop-up): the card shows the question with Clear it / Keep it
  const card = box.querySelector(".er-resume"), ask = $("#erConfirm");
  $("#erClear")?.addEventListener("click", () => { card.classList.add("asking"); ask.hidden = false; $("#erClearNo").focus(); });
  $("#erClearNo")?.addEventListener("click", () => { card.classList.remove("asking"); ask.hidden = true; $("#erClear").focus(); });
  $("#erClearYes")?.addEventListener("click", () => {
    try { localStorage.removeItem(EXAM_RUN_KEY); } catch (_) {}
    card.classList.add("clearing"); setTimeout(() => { renderExamResume(); showToast("Exam cleared", "neutral", 1800); }, 280);
  });
}

function renderExamRun(which) {
  const root = $("#examRun"), clock = $("#examClock");
  GuideCtl = null;
  if (!State.problemsById.size) {  // data still loading; init() routes again when it's ready
    root.innerHTML = `<div class="skeleton" style="height:56px;margin-bottom:18px"></div><div class="skeleton" style="height:220px"></div>`;
    clock.hidden = true; return;
  }
  const r = getExamRun();
  const ps = r ? r.ids.map(id => State.problemsById.get(id)).filter(Boolean) : [];
  if (!r || !ps.length) { navigate("/exam", { replace: true }); return; }
  if (r.endedAt || which === "done") {
    if (!r.endedAt) { r.endedAt = Date.now(); saveExamRun(r); }
    renderExamSummary(r, ps); return;
  }
  let i = parseInt(which, 10) - 1;
  if (!(i >= 0)) i = r.idx;
  i = Math.min(i, ps.length - 1);
  r.idx = i; if (!r.seen.includes(i)) r.seen.push(i); saveExamRun(r);
  // Only one guided solution may be on the page (its controls use fixed ids), so drop the study view's
  $("#studyMain").innerHTML = ""; $("#studySide").innerHTML = "";
  const p = ps[i], cfg = EXAM_MAP[r.choice] || { title: "Practice exam" }, last = i === ps.length - 1;
  const peeked = r.peeked.includes(p.id);
  root.innerHTML = `
    <div class="er-bar">
      <div class="er-where"><span class="er-kick">${escapeHtml(cfg.title)} practice</span><strong>Question ${i + 1} <span>of ${ps.length}</span></strong></div>
      <nav class="er-dots" aria-label="Questions">${ps.map((q, k) => `<button type="button" class="er-dot${k === i ? " is-now" : ""}${r.seen.includes(k) ? " is-seen" : ""}${r.peeked.includes(q.id) ? " is-peek" : ""}" data-q="${k + 1}" aria-label="Question ${k + 1}"${k === i ? ' aria-current="step"' : ""}>${k + 1}</button>`).join("")}</nav>
      <span class="er-bar-clock" aria-hidden="true">${EXAM_CLOCK_ICON}<span class="er-bar-t">${fmtClock(examElapsed(r))}</span></span>
      <button type="button" class="btn btn-ghost btn-sm er-end" id="erEnd">Finish exam</button>
    </div>
    <article class="er-card">
      <div class="problem-statement"><div class="math-block tex2jax_process">${p.problemLatex || ""}</div></div>
      <p class="er-note">Work it out on paper. The clock keeps running across every question.</p>
      <div class="er-nav">
        <button class="btn btn-ghost" id="erPrev" type="button"${i === 0 ? " disabled" : ""}><span class="arrow">←</span> Previous</button>
        <button class="btn btn-red" id="erNext" type="button">${last ? "Finish exam" : "Next question"} <span class="arrow">→</span></button>
      </div>
      <div class="er-peek">
        <button class="g-link" id="erPeek" type="button"${peeked ? " hidden" : ""}>Stuck? Show the solution</button>
        <div id="erSolution">${peeked ? conceptPanelHtml(p) + guideHtml(p) : ""}</div>
      </div>
    </article>`;
  const go = k => navigate("/exam/run/" + (k + 1));
  root.querySelectorAll(".er-dot").forEach(b => b.addEventListener("click", () => go(+b.dataset.q - 1)));
  $("#erPrev").addEventListener("click", () => { if (i > 0) go(i - 1); });
  $("#erNext").addEventListener("click", () => (last ? finishExamRun() : go(i + 1)));
  const end = $("#erEnd");
  end.addEventListener("click", () => {
    if (end.classList.contains("armed") || r.seen.length === ps.length) return finishExamRun();
    end.classList.add("armed"); end.textContent = "Tap again to finish";
    clearTimeout(end._t); end._t = setTimeout(() => { end.classList.remove("armed"); end.textContent = "Finish exam"; }, 3000);
  });
  const wireSolution = () => { wireGuide(p); if (typeof Viz3D !== "undefined") Viz3D.mountAll(root); };
  $("#erPeek").addEventListener("click", () => {
    const run = getExamRun(); if (run && !run.peeked.includes(p.id)) { run.peeked.push(p.id); saveExamRun(run); }
    $("#erPeek").hidden = true;
    const sol = $("#erSolution"); sol.innerHTML = conceptPanelHtml(p) + guideHtml(p);
    root.querySelector(`.er-dot[data-q="${i + 1}"]`)?.classList.add("is-peek");
    wireSolution(); typesetMath(sol);
  });
  if (peeked) wireSolution();
  startExamClock();
  typesetMath(root);
}

function renderExamSummary(r, ps) {
  stopExamClock(); $("#examClock").hidden = true;
  const root = $("#examRun"), cfg = EXAM_MAP[r.choice] || { title: "Practice exam" };
  const sec = examElapsed(r), late = sec >= EXAM_LATE_SEC;
  root.innerHTML = `
    <div class="er-done">
      <div class="er-kick">${escapeHtml(cfg.title)} practice · finished</div>
      <h2>Nice work. Now check it.</h2>
      <div class="er-time${late ? " is-late" : ""}"><strong>${fmtClock(sec)}</strong><span>${late ? "over the 50-minute mark" : "total time"}</span></div>
      <p class="er-note">Open each question's full solution, compare with your paper, then mark it Got it or Need review.</p>
      <div class="prob-list">
        ${ps.map((p, k) => {
          const st = getStatus(p.id);
          return `<button class="prob-row" data-problem-id="${escapeHtml(p.id)}">
            <div class="prob-row-main">
              <div class="prob-row-title">${String(k + 1).padStart(2, "0")}. ${escapeHtml(p.title)}</div>
              <div class="prob-row-sub">
                ${lectureOf(p.id) ? `<span class="lec-tag">${lectureOf(p.id).short}</span>` : ""}
                ${p.estimatedMinutes ? `<span>~${p.estimatedMinutes} min</span>` : ""}
                ${r.peeked.includes(p.id) ? `<span>solution viewed during the exam</span>` : ""}
              </div>
            </div>
            <div class="prob-row-right">
              ${st === "got" ? `<span class="pill status-got">Got it</span>` : ""}
              ${st === "review" ? `<span class="pill status-review">Review</span>` : ""}
              <span class="er-open">Check solution <span class="arrow">→</span></span>
            </div>
          </button>`;
        }).join("")}
      </div>
      <div class="er-done-actions">
        <button class="btn btn-red" id="erNew" type="button">New practice exam</button>
        <button class="btn btn-ghost" id="erRetake" type="button">Retake these questions</button>
      </div>
    </div>`;
  $("#erNew").addEventListener("click", () => navigate("/exam"));
  $("#erRetake").addEventListener("click", () => { State.examChoice = r.choice; startExamRun(r.ids); });
  typesetMath(root);
}

/* ============================================================
   RENDER: NEED REVIEW
   ============================================================ */

function getReviewProblems() {
  const status = getStatusMap();
  const out = [];
  State.sectionsData.forEach(s => {
    s.problems.forEach(p => { if (status[p.id] === "review") out.push(p); });
  });
  return out;
}

function updateReviewNavBadge() {
  const badge = document.getElementById("navReviewBadge");
  if (!badge) return;
  const n = getReviewProblems().length;
  if (n > 0) {
    badge.textContent = String(n);
    badge.hidden = false;
  } else {
    badge.hidden = true;
  }
}

function renderReview() {
  updateReviewNavBadge();
  const review = getReviewProblems();
  const content = $("#reviewContent");
  if (!content) return;

  if (!review.length) {
    content.innerHTML = `
      <div class="empty" style="text-align:center; padding: 48px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);">
        ${emptyArt("calm")}
        <h3 style="font-family: var(--font-display); font-weight: 500; margin: 0 0 8px;">No problems flagged for review</h3>
        <p style="color: var(--ink-mute); margin: 0 auto 18px; max-width: 440px; line-height: 1.55;">
          On any problem, tap &ldquo;Mark as Need Review&rdquo; to add it here<span class="kbd-tip"> (or press <kbd style="padding: 1px 6px; font-size: 12px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 4px;">R</kbd>)</span>.
        </p>
        <button class="btn btn-red" data-route="/topics">Browse problems <span class="arrow">→</span></button>
      </div>`;
    return;
  }
  content.innerHTML = `
    <div class="prob-list">
      ${review.map((p, i) => `
        <button class="prob-row" data-problem-id="${escapeHtml(p.id)}">
          <div class="prob-row-main">
            <div class="prob-row-title">${String(i+1).padStart(2,'0')}. ${escapeHtml(p.title)}</div>
            <div class="prob-row-sub">
              ${lectureOf(p.id) ? `<span class="lec-tag">${lectureOf(p.id).short}</span>` : ""}
              <span>Section ${p.sectionPos} · ${escapeHtml((State.sectionsByPos.get(p.sectionPos) || {}).nick || p.section)}</span>
              ${p.estimatedMinutes ? `<span>~${p.estimatedMinutes} min</span>` : ""}
              ${(p.skills || []).slice(0, 2).map(s => `<span class="prob-skill">${escapeHtml(s)}</span>`).join("")}
            </div>
          </div>
          <div class="prob-row-right">
            ${p.difficulty ? `<span class="pill ${classForDifficulty(p.difficulty)}">${escapeHtml(p.difficulty)}</span>` : ""}
            <span class="pill status-review">Review</span>
          </div>
        </button>`).join("")}
    </div>
  `;
  typesetMath(content);
}

/* ============================================================
   VISUALIZE
   Slider-driven pictures of the course's core ideas, with as few
   words as possible. Each entry draws an SVG from a small state
   object; sliders and presets change the state (presets glide), and
   a few entries animate while they are on screen.
   ============================================================ */
const VZ_LIST = [], VZ_BY_ID = {};
const VZ_W = 600, VZ_H = 450;
const VZ = { red: "#C8102E", deep: "#9A0B22", ink: "#1F2933", grey: "#6B7682", faint: "#95A0AB", gold: "#B89642",
             tint: "#FCEFF1", soft: "#F7DEE2", paper: "#FBF8F4" };
// The index is organized by idea; each picture belongs to one group (VZ_GROUP_OF), in VZ_ORDER.
const VZ_GROUP_OF = {
  "Methods, step by step": ["m-matmul", "m-gauss", "m-nullcol", "m-subspace", "m-span", "m-reflect", "m-det3", "m-inverse", "m-eigen", "m-complex", "m-markov", "m-planedist", "m-plane3", "m-dirderiv", "m-extrema", "m-wire", "m-potential", "m-square", "m-switch", "m-green", "m-surfarea", "m-flux", "m-dome", "m-cylinder"],
  "Check your own work": ["tool-rref", "tool-det", "tool-eigen", "tool-vec"],
  "Vectors, span, and subspaces": ["vectors", "span", "independence", "coords", "subspace"],
  "Matrices as maps": ["transpose", "matrix", "compose", "det", "inverse", "nullcol", "systems", "gauss"],
  "Dot and cross products": ["projection", "projplane", "cross"],
  "Eigenvalues and eigenvectors": ["eigen", "diag", "powers"],
  "Curves": ["curves", "spacecurve", "arclength"],
  "Functions of two variables": ["level", "partials", "chain", "gradient", "critical"],
  "Double integrals": ["riemann", "fubini", "order", "polar", "jacobian"],
  "Vector fields and line integrals": ["gradfield", "fields", "curtain", "work", "conservative", "green", "greenarea"],
  "Surfaces and flux": ["surface", "orient", "flux", "stokes", "divthm"],
};
const VZ_GROUPS = Object.keys(VZ_GROUP_OF);
const VZ_ORDER = VZ_GROUPS.flatMap(g => VZ_GROUP_OF[g]);
function vzAdd(def) { VZ_LIST.push(def); VZ_BY_ID[def.id] = def; }
const q2 = v => Math.round(v * 100) / 100;
function vzNum(v, d = 2) {
  const s = (Math.abs(v) < 0.5 * Math.pow(10, -d) ? 0 : v).toFixed(d);
  return s[0] === "-" ? "−" + s.slice(1) : s;
}
const vzClamp = (x, a, b) => x < a ? a : x > b ? b : x;
// the in-between of a whole-number slider (boxes, cells, pieces): mostly steady, eased a little at each whole number,
// so Play flows on instead of stopping at every count
const vzMorph = f => .6 * f + .4 * vzEase(f);
// show √2/2, √3/2, √2, √3 when a value is exactly one of them (presets), decimals otherwise
function vzExact(v, d = 2) {
  for (const [x, t] of [[Math.SQRT1_2, "√2/2"], [Math.sqrt(3) / 2, "√3/2"], [Math.SQRT2, "√2"], [Math.sqrt(3), "√3"]])
    if (Math.abs(Math.abs(v) - x) < 5e-4) return (v < 0 ? "−" : "") + t;
  return vzNum(v, d);
}
// a multiple of π: π/2, 3π/4, 2π exactly; otherwise 0.37π
function vzPi(v) {
  const k = v / Math.PI, n = Math.round(k * 12);
  if (Math.abs(k * 12 - n) > 1e-6) return vzNum(k) + "π";
  if (!n) return "0";
  const g = (a, b) => b ? g(b, a % b) : a, d = g(Math.abs(n), 12), p = n / d, q = 12 / d;
  return (p < 0 ? "−" : "") + (Math.abs(p) === 1 ? "" : Math.abs(p)) + "π" + (q === 1 ? "" : "/" + q);
}
const vzEase = x => x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
const vzRad = d => d * Math.PI / 180;

function vzDefs(extra) {
  const mk = (id, c) => `<marker id="vz-${id}" viewBox="0 0 10 10" refX="8.6" refY="5" markerWidth="4.6" markerHeight="4.6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="${c}"/></marker>`;
  return `<defs>${mk("R", VZ.red)}${mk("D", VZ.deep)}${mk("I", VZ.ink)}${mk("G", VZ.grey)}${mk("O", VZ.gold)}
    <pattern id="vz-paper" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0L0 0 0 30" fill="none" stroke="${VZ.ink}" stroke-width=".35" opacity=".13"/></pattern>
    <clipPath id="vz-clip"><rect width="${VZ_W}" height="${VZ_H}" rx="18"/></clipPath>${extra || ""}</defs>
    <rect width="${VZ_W}" height="${VZ_H}" rx="18" fill="url(#vz-paper)"/>`;
}
const VZ_COL = { R: VZ.red, D: VZ.deep, I: VZ.ink, G: VZ.grey, O: VZ.gold };
function vzArrow(x1, y1, x2, y2, key, w, extra) {
  const L = Math.hypot(x2 - x1, y2 - y1);
  if (L < 3) return "";
  w = w || 2.6;
  const c = VZ_COL[key], ux = (x2 - x1) / L, uy = (y2 - y1) / L, h = Math.min(5 + 2.6 * w, L * .5), hw = h * .42;
  const bx = x2 - ux * h, by = y2 - uy * h, sx = x2 - ux * h * .75, sy = y2 - uy * h * .75;   // the shaft stops inside the head
  return `<g ${extra || ""}><line x1="${q2(x1)}" y1="${q2(y1)}" x2="${q2(sx)}" y2="${q2(sy)}" stroke="${c}" stroke-width="${w}" stroke-linecap="round"/>` +
    `<path d="M${q2(x2)} ${q2(y2)}L${q2(bx - uy * hw)} ${q2(by + ux * hw)}L${q2(bx + uy * hw)} ${q2(by - ux * hw)}Z" fill="${c}" stroke="${c}" stroke-width=".8" stroke-linejoin="round"/></g>`;
}
// On the live picture, a label (or a pill's width) that would jump in one frame, because it switched sides
// to stay clear of an arrow, glides to its new place over ~0.2 s instead; ordinary motion is followed exactly.
// Keyed by the label's text with the numbers taken out (and how many times that text appeared this frame).
function vzGlide(name, vals, jump = 14) {
  if (!VzView.live) return vals;
  const seen = VzView.labSeen, base = String(name).replace(/<[^>]+>/g, "").replace(/[−-]?\d[\d.,/]*/g, "#"), n = seen[base] = (seen[base] || 0) + 1, key = base + "|" + n;
  const L = VzView.labs || (VzView.labs = {}), f = VzView.frameNo, p = L[key];
  if (!p || p.f < f - 1) { L[key] = { v: vals.slice(), f, g: false }; return vals; }
  p.f = f;
  const d = Math.hypot(...vals.map((v, i) => v - p.v[i]));
  if (!p.g && d > jump) { p.g = true; p.s = p.v.slice(); p.f0 = f; }
  if (p.g) {
    const u = Math.min(1, (f - p.f0) / 13), e = vzEase(u);
    p.v = vals.map((v, i) => p.s[i] + (v - p.s[i]) * e);
    if (u >= 1) p.g = false; else VzView.again = true;
  } else p.v = vals.slice();
  return p.v;
}
function vzLabel(x, y, html, col, size, anchor) {
  if (VzView.live) {                                       // keep the whole label on the picture (an arrow may run off; its name stays)
    const sz = size || 17, w = String(html).replace(/<[^>]+>/g, "").length * sz * .55, a = anchor || "middle";
    const lo = a === "start" ? 8 : a === "end" ? 8 + w : 8 + w / 2, hi = a === "start" ? 592 - w : a === "end" ? 592 : 592 - w / 2;
    x = vzClamp(x, lo, Math.max(lo, hi)); y = vzClamp(y, sz + 4, 444);
  }
  [x, y] = vzGlide(html, [x, y]);
  return `<text x="${q2(x)}" y="${q2(y)}" font-family="'Fraunces', Georgia, serif" font-size="${size || 17}" font-style="italic" fill="${col || VZ.ink}" text-anchor="${anchor || "middle"}" stroke="${VZ.paper}" stroke-width="4" stroke-linejoin="round" paint-order="stroke" style="font-variant-numeric:tabular-nums">${html}</text>`;
}
function vzTip(ox, oy, tx, ty, html, col, gap) {         // label just past an arrow tip
  const dx = tx - ox, dy = ty - oy, L = Math.hypot(dx, dy) || 1;
  if (L < 3) return "";
  return vzLabel(tx + dx / L * (gap || 17), ty + dy / L * (gap || 17) + 5, html, col);
}
const vzB = (n, s) => `<tspan font-weight="700">${n}</tspan>${s ? `<tspan baseline-shift="sub" font-size="12.5">${s}</tspan>` : ""}`;
