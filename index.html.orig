const TEIG_EX = {
  2: [["Two λ", "1|2|1|0"], ["One λ, twice", "4|-1|1|2"], ["Square roots", "3|1|2|1"], ["Complex λ", "1|-2|1|3"]],
  3: [["A double λ", "2|0|0|1|3|1|1|1|3"], ["Three λ", "2|-1|-1|-2|3|-3|-1|1|1"], ["Not diagonalizable", "1|0|1|-2|2|2|2|-1|2"], ["Complex λ", "2|0|0|0|1|-1|0|1|1"]],
