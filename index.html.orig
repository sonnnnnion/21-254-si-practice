}
// a camera framed on the scene: its middle c, and a scale that fits a ball of everything into radius R px
function vzProjFit(G, R) {
  const ps = vzProjPatch(G).concat([G.v, [0, 0, 0]]);
  const lo = [0, 1, 2].map(i => Math.min(...ps.map(p => p[i]))), hi = [0, 1, 2].map(i => Math.max(...ps.map(p => p[i])));
  const c = lo.map((x, i) => (x + hi[i]) / 2), r = Math.max(...ps.map(p => Math.hypot(p[0] - c[0], p[1] - c[1], p[2] - c[2])));
