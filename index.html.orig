      return o;
    }
    if (op === 3) {                                           // the plane through P, Q, R
      const P = [D.p1, D.p2, D.p3], Q = [D.q1, D.q2, D.q3], R = [D.r1, D.r2, D.r3], u = F.sub(Q, P), w = F.sub(R, P), n = F.cross(u, w);
      const G = F.mul(F.add(P, F.add(Q, R)), 1 / 3), rad = Math.max(F.len(F.sub(P, G)), F.len(F.sub(Q, G)), F.len(F.sub(R, G)), .4), h = 1.15 * rad;
      const flat = F.len(n) < 1e-9 * Math.max(1, F.len(u) * F.len(w)), nh = F.unit(n), tip = F.add(G, F.mul(nh, .62 * h));
      let pts = [P, Q, R];
