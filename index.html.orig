  S.point(P([0, 0]), { color: SKC.red, r: 3.5 }); S.point(P([4, 2]), { color: SKC.red, r: 3.5 });
  S.label("\\mathbf r(t)=(t^2,t)", P([2.25, 1.5]), { color: SKC.red, dir: [-.3, -1], size: 14 });
  S.label("(4,2)", P([4, 2]), { color: SKC.red, dir: [1, -.4], size: 13.5 });
  return skDone("Add up F · r′ along the curve", S.svg("Line integral along x = y²"),
    "Substitute x = t², y = t into F, dot with r′(t), and integrate over 0 ≤ t ≤ 2.", { formula: "\\int_C\\mathbf F\\cdot d\\mathbf r=\\int_0^2\\mathbf F(\\mathbf r(t))\\cdot\\mathbf r'(t)\\,dt" });
};

SKETCH["vecfieldline-006"] = () => {
  // a curtain over the segment from (1, 0) to (3, 4) whose height is f = x + 2y - z (z = 2 on the segment)
  const cam = skCam(-2.35, .5), A = [1, 0], B = [3, 4], f = t => -1 + 10 * t, k = .35;
  const pts3 = [[1, 0, 0], [3, 4, 0], [3, 4, 9 * k], [1, 0, -k], [0, 0, 0], [4, 5, 0]];
  const P = skFit3(cam, pts3, 400, 250, { pad: 36 }), S = skNew(400, 250); S.grid();
  for (let i = 0; i <= 5; i++) { S.line(P([i * .8, 0, 0]), P([i * .8, 5, 0]), { color: SKC.faint, w: .7, op: .6, free: true, layer: "back" }); S.line(P([0, i, 0]), P([4, i, 0]), { color: SKC.faint, w: .7, op: .6, free: true, layer: "back" }); }
  const at = t => [A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t], t0 = .1;   // f < 0 before t = 0.1
  const band = (ta, tb, color) => { const top = [], bot = []; for (let i = 0; i <= 20; i++) { const t = ta + (tb - ta) * i / 20, [x, y] = at(t); top.push(P([x, y, f(t) * k])); bot.push(P([x, y, 0])); }
    S.region(top.concat(bot.reverse()), { fill: color, fop: .2, stroke: color, w: 1.2 }); };
  band(0, t0, SKC.gold); band(t0, 1, SKC.red);
  S.line(P([1, 0, 0]), P([3, 4, 0]), { color: SKC.ink, w: 2.2, free: true });
  S.point(P([1, 0, 0]), { r: 3.5 }); S.point(P([3, 4, 0]), { r: 3.5 });
  S.label("P", P([1, 0, 0]), { dir: [-.4, 1], size: 14 }); S.label("Q", P([3, 4, 0]), { dir: [1, .4], size: 14 });
  S.label("f(Q)", P([3, 4, 9 * k]), { color: SKC.red, dir: [1, 0], size: 13.5 }); S.label("f(P)", P([1, 0, -k]), { color: SKC.gold, dir: [-1, .3], size: 13.5 });
  S.note("curtain height = f along the segment (drawn in the plane z = 2)", 392, 238, { anchor: "end" });
  return skDone("∫ f ds is the signed area of a curtain standing on the path", S.svg("Scalar line integral as area"),
    "Parametrize the segment from P to Q, write f in terms of t, and use ds = ‖r′(t)‖ dt.", { scaled: false, formula: "\\int_C f\\,ds=\\int_0^1 f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,dt" });
};

SKETCH["vecfieldline-007"] = () => {
  const { S, P } = sk2D([[-.6, -.4], [1.6, 2.4]], { xr: [-.7, 1.8], yr: [-.5, 2.6] });
  skContours(S, P, (x, y) => x * x + y, [-.7, 1.8], [-.5, 2.6], [.5, 1, 1.5, 2, 2.5, 3, 3.5], { color: () => SKC.red, op: () => .4 });
  skCurve(S, P, t => [t, 2 * t], 0, 1, { color: SKC.ink, w: 2, arrowAt: .6 });
  skCurve(S, P, t => [t + .5 * Math.sin(Math.PI * t), 2 * t * t], 0, 1, { color: SKC.gold, w: 2, arrowAt: .5 });
  S.point(P([0, 0]), { r: 4 }); S.point(P([1, 2]), { r: 4 });
  S.label("(0,0)", P([0, 0]), { dir: [-1, .5], size: 13.5 }); S.label("(1,2)", P([1, 2]), { dir: [1, -.3], size: 13.5 });
  S.note("red curves: level curves of the potential f", 392, 238, { anchor: "end" });
  return skDone("F = ∇f, so any path from (0, 0) to (1, 2) gives f(1, 2) − f(0, 0)", S.svg("Fundamental theorem for line integrals"),
    "Find a potential f with ∇f = F (the exponent is a strong hint); then no parametrization is needed, and both paths give the same value.", { formula: "\\int_C\\nabla f\\cdot d\\mathbf r=f(1,2)-f(0,0)" });
};

SKETCH["vecfieldline-008"] = () => {
  const { S, P } = sk2D([[-3.3, -3.3], [3.3, 3.3]], { xr: [-3.8, 4], yr: [-3.6, 3.8] });
  skField(S, P, (x, y) => [-y, x], [-3.4, 3.4], [-3.4, 3.4], [7, 7], { color: SKC.faint });
  skCurve(S, P, t => [3 * Math.cos(t), 3 * Math.sin(t)], 0, 2 * Math.PI, { color: SKC.red, w: 2.2, free: true, n: 120 });
  [0, 1, 2, 3].forEach(k => { const t = k * Math.PI / 2 + .35; S.arrow(P([3 * Math.cos(t - .12), 3 * Math.sin(t - .12)]), P([3 * Math.cos(t), 3 * Math.sin(t)]), { color: SKC.red, w: 2, head: 10 }); });
  const q = [3 * Math.cos(.8), 3 * Math.sin(.8)];
  skVec2(S, P, q, [q[0] - 1.1 * Math.sin(.8), q[1] + 1.1 * Math.cos(.8)], { color: SKC.ink, w: 2.2, label: "\\mathbf F", dir: [1, -.2] });
  S.label("C:\\ r=3", P([3 * Math.cos(-.7), 3 * Math.sin(-.7)]), { color: SKC.red, dir: [1, .4], size: 14 });
  return skDone("On the circle, F points along the path", S.svg("Circulation around a circle"),
    "F = (−y, x) is tangent to every circle about 0. If F · T is constant on C, the work is that constant times the circumference; otherwise parametrize the circle.", { formula: "\\oint_C\\mathbf F\\cdot d\\mathbf r=\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds" });
};

SKETCH["vecfieldline-009"] = () => {
  const { S, P } = sk2D([[0, 0], [2, 1]], { xr: [-.3, 2.5], yr: [-.3, 1.45] });
  skField(S, P, (x, y) => [y, x * x], [0, 2.4], [0, 1.35], [8, 5], { color: SKC.faint });
