    }
    const C = W._chain, { f, blocks, Y, LG, xm } = C;
    // the view: the matrix before (faint) and the one now, centred; between steps it glides
    const off = j => { const top = Y[Math.max(0, j - 1)], bot = Y[j] + blocks[j].h; return 225 - (top + bot) / 2; };
    const j0 = Math.floor(k), fr = k - j0, OFF = fr > 1e-6 ? off(j0) + (off(Math.min(j0 + 1, blocks.length - 1)) - off(j0)) * fr : off(j0);
    let o = "";
