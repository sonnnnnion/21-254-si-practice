};
function sectionGlyph(pos, extraClass, large) {
  const g = (large ? SECTION_ART : SECTION_GLYPHS)[pos];
  return g ? '<svg class="glyph' + (extraClass ? " " + extraClass : "") + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + g + '</svg>' : "";
}

/* Empty-state illustrations: a calm, uniform field (nothing flagged) and an empty
   filter region with every point outside it (no matches). */
function emptyArt(kind) {
  const arrow = (x, y, dx, dy, cls, i) => {
    const L = Math.hypot(dx, dy), ux = dx / L, uy = dy / L, s = 4.2, a = 0.5;
    const hx = (c, sn) => (x + dx - (ux * c - uy * sn) * s).toFixed(1), hy = (c, sn) => (y + dy - (ux * sn + uy * c) * s).toFixed(1);
    return '<path class="ea ' + cls + '" style="--i:' + i + '" d="M' + x + ' ' + y + 'L' + (x + dx) + ' ' + (y + dy) +
           'M' + hx(Math.cos(a), Math.sin(a)) + ' ' + hy(Math.cos(a), Math.sin(a)) + 'L' + (x + dx) + ' ' + (y + dy) +
           'L' + hx(Math.cos(-a), Math.sin(-a)) + ' ' + hy(Math.cos(-a), Math.sin(-a)) + '"/>';
  };
  let body = "", i = 0;
  if (kind === "calm") {
    for (let r = 0; r < 3; r++) for (let c = 0; c < 6; c++) {
      if (r === 1 && (c === 3 || c === 4)) continue;
      body += arrow(12 + c * 29, 24 + r * 25, 13, -3.5, "ea-soft", i++);
    }
    body += '<circle class="ea ea-red ea-soft" style="--i:' + (i + 2) + '" cx="120" cy="46" r="9"/>' +
            '<circle class="ea ea-redfill" style="--i:' + (i + 3) + '" cx="120" cy="46" r="3.4"/>';
  } else {
    body += '<path class="ea ea-soft" style="--i:0" d="M14 84H166M14 84V8"/>';
    [[30, 30], [38, 66], [142, 22], [154, 56], [100, 76], [22, 50], [134, 74]].forEach(([x, y]) => {
      body += '<circle class="ea ea-dot" style="--i:' + (++i) + '" cx="' + x + '" cy="' + y + '" r="2.6"/>';
    });
    body += '<rect class="ea ea-red" style="--i:' + (i + 2) + '" x="60" y="24" width="64" height="40" rx="7" stroke-dasharray="5 4"/>';
  }
  return '<svg class="empty-art" viewBox="0 0 180 96" aria-hidden="true" focusable="false">' + body + '</svg>';
}

// Count a number up/down in place (falls back to the final value if frames are paused)
function tweenNumber(el, from, to, suffix, ms) {
  if (!el) return;
  ms = ms || 900; suffix = suffix || "";
  const token = (el._tween = (el._tween || 0) + 1);
  const finish = () => { if (el._tween === token) el.textContent = to + suffix; };
  const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (from === to || reduce) return finish();
  const t0 = performance.now(), ease = t => 1 - Math.pow(1 - t, 3);
  const step = now => {
    if (el._tween !== token) return;
    const t = Math.min(1, (now - t0) / ms);
    el.textContent = Math.round(from + (to - from) * ease(t)) + suffix;
    if (t < 1) requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
  setTimeout(finish, ms + 80);
}

/* Scroll memory. Each history entry gets a key; Back/Forward returns to that entry's
   exact scroll position, and list pages reopen where you left them. Detail pages
   start at the top. Jumps are instant (html uses smooth scrolling for in-page links,
   which made every route change glide or stall). */
/* Scans of the SI QR code (…/?qr) land on the home page like any other visit. The
   landing view is counted as "/qr" (see countRoute) so SI can see how many students
   came from the code, and the query is removed at once so it never lingers in the
   address bar or in bookmarks. #/si was briefly the QR target; it is treated the same. */
const QR_ARRIVAL = /(^|&)qr(=|&|$)/.test(location.search.slice(1)) || location.hash === "#/si";
if (QR_ARRIVAL) {
  try { history.replaceState(null, "", location.pathname + (location.hash === "#/si" ? "" : location.hash)); } catch (_) {}
}
const NAV_BOOT = Date.now().toString(36);
const LIST_ROUTE = /^\/(topics|section\/\d+|review|walkthroughs|visualize)$/;
const scrollByEntry = new Map(), scrollByRoute = new Map();
let navSeq = 0, currentNavKey = null, currentNavRoute = null;
try { if ("scrollRestoration" in history) history.scrollRestoration = "manual"; } catch (_) {}
function beginNavigation(route) {
  if (currentNavKey) scrollByEntry.set(currentNavKey, window.scrollY);
  if (currentNavRoute) scrollByRoute.set(currentNavRoute, window.scrollY);
  const st = history.state;
  let target = 0;
  if (st && typeof st.navKey === "string" && st.navKey.indexOf(NAV_BOOT + ":") === 0) {
    currentNavKey = st.navKey;                         // Back / Forward (or a re-render of this entry)
    target = scrollByEntry.get(currentNavKey) || 0;
  } else {
    currentNavKey = NAV_BOOT + ":" + (++navSeq);
    try { history.replaceState({ navKey: currentNavKey }, "", location.href); } catch (_) {}
    target = LIST_ROUTE.test(route) ? (scrollByRoute.get(route) || 0) : 0;
  }
  currentNavRoute = route;
  return target;
}
function jumpTo(y) {
  // The new view was just rendered: flush layout first, or Chrome defers the scroll to
  // the next frame, by which time smooth scrolling is back on and the jump glides/stalls.
  const html = document.documentElement;
  html.style.scrollBehavior = "auto";
  void html.scrollHeight;
  try { window.scrollTo({ top: y, left: 0, behavior: "instant" }); } catch (_) { window.scrollTo(0, y); }
  clearTimeout(jumpTo._t);
  jumpTo._t = setTimeout(() => { html.style.scrollBehavior = ""; }, 60);
}

function normalizeProse(s) {
  if (!s || typeof s !== "string") return s;
  // 1) Some source files contain literal "\n" (backslash + n) rather than real
  //    newlines, so they render as visible text. Convert to HTML breaks.
  //    Be careful to only match outside LaTeX delimiters; "\(" and "\[" must
  //    stay intact for MathJax.
  let out = s
    .replace(/\\n\\n/g, "<br><br>")
    .replace(/(?<!\\)\\n(?![a-zA-Z\[\(])/g, "<br>");
  // 2) Some editors auto-correct "(c)" → "©", "(r)" → "®", "(tm)" → "™".
  //    Reverse these in problem prose; none of them belong in a math problem.
  out = out
    .replace(/©/g, "(c)")
    .replace(/®/g, "(r)")
    .replace(/™/g, "(tm)");
  // 3) Real newlines. HTML collapses them, so blank-line paragraph breaks in the
  //    source ("(a) ...\n\n(b) ...") rendered as one run-on line. Turn them into
  //    <br><br> in prose only: never inside a math span (a <br> would split the
  //    TeX) and not beside display math, which already starts on its own line.
  const parts = out.split(/(\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]|\$\$[\s\S]*?\$\$)/);
  out = parts.map((seg, i) => {
    if (i % 2) return seg;                                    // math span: untouched
    return seg.replace(/\n[ \t]*(?:\n[ \t]*)+/g, (m, off) => {
      const afterDisplay  = i > 0 && !seg.slice(0, off).trim() && /^(\\\[|\$\$)/.test(parts[i - 1]);
      const beforeDisplay = i + 1 < parts.length && !seg.slice(off + m.length).trim() && /^(\\\[|\$\$)/.test(parts[i + 1]);
      return (afterDisplay || beforeDisplay) ? m : "<br><br>";
    });
  }).join("");
  return out;
}

function normalizeProblem(raw, sectionMeta) {
  return {
    id:                 raw.id || raw.problemId || cryptoId(),
    title:              raw.title || "Untitled problem",
    unit:               raw.unit || sectionMeta.title,
    section:            sectionMeta.title,
    sectionPos:         sectionMeta.pos,
    topic:              raw.topic || "",
    subtopic:           raw.subtopic || "",
    difficulty:         raw.difficulty || "",
    estimatedMinutes:   raw.estimatedMinutes || raw.estMinutes || null,
    skills:             Array.isArray(raw.skills) ? raw.skills : [],
    examFlavor:         raw.examFlavor || "",
    problemLatex:       normalizeProse(raw.problemLatex || raw.problem || ""),
    thinkFirst:         normalizeProse(raw.thinkFirst || raw.thinkFirstPrompt || ""),
    hints:              (Array.isArray(raw.hints) ? raw.hints : []).map(normalizeProse),
    setupLatex:         normalizeProse(raw.setupLatex || raw.setup || ""),
    solutionSteps:      (Array.isArray(raw.solutionSteps) ? raw.solutionSteps : []).map(step => ({
                          ...step,
                          label: normalizeProse(step.label || ""),
                          latex: normalizeProse(step.latex || step.body || "")
                        })),
    finalAnswerLatex:   normalizeProse(raw.finalAnswerLatex || raw.finalAnswer || ""),
    commonMistakes:     (Array.isArray(raw.commonMistakes) ? raw.commonMistakes : []).map(normalizeProse),
    similarProblemPrompt: normalizeProse(raw.similarProblemPrompt || raw.similarProblemIdea || ""),
    _raw: raw
  };
}
function cryptoId() {
  return "p-" + Math.random().toString(36).slice(2, 10);
}

async function loadAllSections() {
  const results = await Promise.allSettled(
    SECTIONS.map(s => fetchFirst(s.files).then(json => ({ s, json })))
  );

  State.sectionsData = [];
  State.problemsById.clear();
  State.sectionsByPos.clear();
  State.loadErrors = [];

  results.forEach((res, i) => {
    const meta = SECTIONS[i];
    if (res.status === "fulfilled") {
      const d = res.value.json;
      const sec = {
        pos: meta.pos,
        title: d.sectionTitle || meta.title,
        short: d.studentFacingDescription || meta.short,
        nick: meta.nick,                                  // a short name for tiles and lists
        sectionId: d.sectionId || `sec-${meta.pos}`,
        problems: (d.problems || []).map(p => normalizeProblem(p, meta)),
      };
      State.sectionsData.push(sec);
      State.sectionsByPos.set(meta.pos, sec);
      sec.problems.forEach(p => State.problemsById.set(p.id, p));
    } else {
      State.loadErrors.push({ pos: meta.pos, title: meta.title, error: String(res.reason) });
      // Add empty placeholder so user still sees the card.
      const sec = { pos: meta.pos, title: meta.title, short: meta.short, nick: meta.nick, sectionId: `sec-${meta.pos}`, problems: [], _error: String(res.reason) };
      State.sectionsData.push(sec);
      State.sectionsByPos.set(meta.pos, sec);
    }
  });
  State.sectionsData.sort((a,b) => a.pos - b.pos);
}

/* ============================================================
   UTILITIES
   ============================================================ */

const $  = (sel, root=document) => root.querySelector(sel);
const $$ = (sel, root=document) => Array.from(root.querySelectorAll(sel));

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}

/* Reduce a JSON dict key (used as a vector or point name) to a clean
   display label suitable for an SVG <text> element.

   The SVG labels render in italic Fraunces (display serif), so:
   - "u" -> "u"          (already short)
   - "AB" -> "AB"        (already short)
   - "unitAB" -> "unitAB" (single CamelCase word, fine as-is)
   - "x_1" -> "x\u2081"  (Unicode subscript so it reads as math without MathJax)
   - "v_after_solving" -> "v"  (multi-segment underscore name -> use first segment)
   - "F_x" -> "F\u2093"  (subscript single-letter -> Unicode subscript)
   - "M_AB" -> "M"       (subscript multi-letter -> truncate, can't subscript)

   We do NOT run SVG labels through MathJax; the labels render as literal text. */
function svgLabelName(key) {
  if (key == null) return "";
  const s = String(key).trim();
  if (!s) return "";

  // No underscore at all -> use as is
  if (!s.includes("_")) return s;

  // Multi-segment underscore identifier like "v_after_solving" -> first segment only
  const segs = s.split("_");
  if (segs.length > 2) return segs[0];

  // Two segments: x_1, F_x, M_AB. Try a Unicode subscript for single-character second segs.
  const base = segs[0], sub = segs[1];
  if (sub.length === 1) {
    const subMap = {
      "0":"\u2080","1":"\u2081","2":"\u2082","3":"\u2083","4":"\u2084",
      "5":"\u2085","6":"\u2086","7":"\u2087","8":"\u2088","9":"\u2089",
      "a":"\u2090","e":"\u2091","h":"\u2095","i":"\u1d62","j":"\u2c7c",
      "k":"\u2096","l":"\u2097","m":"\u2098","n":"\u2099","o":"\u2092",
      "p":"\u209a","r":"\u1d63","s":"\u209b","t":"\u209c","u":"\u1d64",
      "v":"\u1d65","x":"\u2093"
    };
    if (subMap[sub]) return base + subMap[sub];
  }
  // Two-segment but no clean Unicode subscript -> just use the base
  return base;
}

/* ============================================================
   TOASTS — small auto-dismissing feedback messages
   ============================================================ */
let _toastCounter = 0;
function showToast(message, kind, durationMs) {
  if (!message) return;
  let container = document.getElementById("toastContainer");
  if (!container) {
    container = document.createElement("div");
    container.id = "toastContainer";
    container.className = "toast-container";
    container.setAttribute("aria-live", "polite");
    container.setAttribute("role", "status");
    document.body.appendChild(container);
  }
  const toast = document.createElement("div");
  toast.className = `toast ${kind ? "toast-" + kind : ""}`;
  const icon = kind === "got" ? "✓" : kind === "neutral" ? "·" : "•";
  toast.innerHTML = `<span class="toast-icon" aria-hidden="true">${icon}</span><span class="toast-text">${escapeHtml(message)}</span>`;
  container.appendChild(toast);
  // Trigger enter animation on next frame
  requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.add("show")));
  // Auto-dismiss
  const id = ++_toastCounter;
  toast.dataset.id = id;
  const dur = typeof durationMs === "number" ? durationMs : 2400;
  setTimeout(() => {
    toast.classList.remove("show");
    toast.classList.add("hide");
    setTimeout(() => { if (toast.parentNode) toast.remove(); }, 260);
  }, dur);
}

// Render math after DOM updates. MathJax v3 is async; safe-call.
// MathJax keeps every typeset item in its document list, and each one pins its DOM. When a view is
// re-rendered those nodes are gone from the page but stay in memory, so drop them before each typeset.
function pruneDetachedMath() {
  try {
    const d = MathJax.startup && MathJax.startup.document;
    if (!d || !d.math) return;
    const gone = [];
    for (const m of d.math) { const r = m.typesetRoot || (m.start && m.start.node); if (r && !r.isConnected) gone.push(m); }
    if (gone.length) d.math.remove(...gone);
  } catch (_) {}
}
// Formulas in narrow cards (the guides' key formulas) shrink just enough to fit, never below 72%;
// one that is still too wide scrolls sideways inside its line instead of being cut off.
function fitMath(root) {
  (root || document).querySelectorAll(".sg-formulas li, .walk-formula-latex, .walk-list-formulas li, .sg-board-line, .sg-answer .tex-lines, .sg-board-step").forEach(host => {
    const cs = getComputedStyle(host), avail = host.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    if (avail <= 0) return;
    host.querySelectorAll("mjx-container").forEach(m => {
      m.style.fontSize = "";
      const w = m.getBoundingClientRect().width;
      if (w > avail + 1) m.style.fontSize = (Math.max(.72, (avail - 6) / w) * 100).toFixed(1) + "%";   // a little slack: scaling isn't exactly linear
    });
    host.classList.toggle("math-scroll", [...host.querySelectorAll("mjx-container")].some(m => m.getBoundingClientRect().width > avail + 1));
  });
  fitWideMath(root);
}
// Phones: a displayed equation wider than its box (problem pages, exam questions, method boards) shrinks to fit,
// down to 78% of its size; one that is still too wide scrolls sideways, and its right edge fades out until it has
// been scrolled to the end, so a cut-off equation never looks finished.
function fitWideMath(root) {
  if (innerWidth > 700) return;
  (root || document).querySelectorAll(".math-block mjx-container[display='true'], .concept-formula mjx-container, .st-tex mjx-container[display='true']").forEach(m => {
    const box = m.closest(".concept-formula, .st-tex") || m;            // the element that scrolls
    m.style.removeProperty("font-size");
    const cs = getComputedStyle(box), avail = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const svg = m.querySelector(":scope > svg"), w = svg ? svg.getBoundingClientRect().width : m.scrollWidth;
    if (avail <= 0 || !w) return;
    if (w > avail + 1) m.style.setProperty("font-size", (Math.max(.78, (avail - 4) / w) * 100).toFixed(1) + "%", "important");
    mathEdge(box);
  });
  // walkthrough boards and answers are already shrunk by fitMath above; one still too wide gets the same fade
  (root || document).querySelectorAll(".sg-board mjx-container[display='true'], .sg-answer mjx-container[display='true']").forEach(mathEdge);
}
function mathEdge(box) {
  const set = () => box.classList.toggle("mx-more", box.scrollWidth - box.clientWidth - box.scrollLeft > 2);
  if (!box.dataset.mxEdge) { box.dataset.mxEdge = "1"; box.addEventListener("scroll", set, { passive: true }); }
  set();
}
let fitWideW = innerWidth;
addEventListener("resize", () => {                                    // a phone turned on its side: fit again
  if (Math.abs(innerWidth - fitWideW) < 40) return;
  fitWideW = innerWidth; clearTimeout(fitWideMath.t);
  fitWideMath.t = setTimeout(() => {
    document.querySelectorAll("mjx-container[style*='font-size']").forEach(m => { if (m.closest(".math-block, .concept-formula, .st-tex")) m.style.removeProperty("font-size"); });
    document.querySelectorAll(".mx-more").forEach(b => b.classList.remove("mx-more"));
    fitWideMath(document);
  }, 250);
});
function typesetMath(root) {
  if (window.MathJax && MathJax.typesetPromise) {
    pruneDetachedMath();
    return MathJax.typesetPromise(root ? [root] : undefined).then(() => fitMath(root)).catch(err => {
      console.warn("MathJax error:", err);
      // A failed typeset leaves half-processed items in MathJax's internal list,
      // and every later typeset trips over them, so all math on every page stops
      // rendering until reload. Dropping that list lets the next view render.
      try { MathJax.typesetClear(); } catch (_) {}
    });
  }
  return Promise.resolve();
}

function classForDifficulty(d) {
  if (!d) return "";
  const k = d.toLowerCase();
  if (k.includes("warm")) return "diff-warm";
  if (k.includes("concept")) return "diff-concept";
  if (k.includes("stretch") || k.includes("hard") || k.includes("challenge")
      || k.includes("exam") || k.includes("final")) return "diff-stretch";
  return "diff-core";
}

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* ============================================================
   ROUTING (hash-based SPA)
   ============================================================ */

function navigate(route, opts = {}) {
  if (opts.replace) location.replace("#" + route);
  else location.hash = route;
}
function currentRoute() {
  const h = location.hash.replace(/^#/, "");
  return h || "/home";
}

function handleRoute() {
  const route = currentRoute();
  const scrollTarget = beginNavigation(route);
  const wt = document.querySelector(".wu-tip"); if (wt) wt.hidden = true;     // a chart tooltip never outlives its page
  // nor does an open overlay (a phone's Back swipe used to carry About or the shortcuts card onto the next page)
  ["#shortcutsHelp", "#aboutModal", "#qrModal"].forEach(q => { const m = $(q); if (m) m.hidden = true; });
  const openReport = $("#pageReport"); if (openReport) openReport.remove();
  const parts = route.split("/").filter(Boolean);
  const head = parts[0] || "home";
  // full screen belongs to one Visualize picture: going anywhere else (back, the index, a nav link) leaves it
  if (document.fullscreenElement && !(head === "visualize" && parts[1] && VzView.def && VzView.def.id === parts[1])) document.exitFullscreen().catch(() => {});

  // Switch active view
  $$(".view").forEach(v => v.classList.remove("active"));
  $$(".nav-link").forEach(b => b.classList.remove("active"));
  $("#topnav").classList.remove("open");

  // Body class so we can tighten chrome on the single-viewport home page
  document.body.classList.toggle("is-home", head === "home");
  document.body.classList.toggle("vz-detail", head === "visualize" && !!parts[1]);   // a picture fits one screen
  if (head !== "visualize") vzStop();
  if (!(head === "exam" && parts[1] === "run")) stopExamClock();

  if (head === "home")    { $("#view-home").classList.add("active"); markNav("/home"); renderHome(); }
  else if (head === "topics") { $("#view-topics").classList.add("active"); markNav("/topics"); renderTopics(); }
  else if (head === "section" && parts[1]) {
    $("#view-section").classList.add("active"); markNav("/topics");
    renderSection(Number(parts[1]));
  }
  else if (head === "problem" && parts[1]) {
    $("#view-problem").classList.add("active"); markNav("/topics");
    renderProblem(parts[1]);
  }
  else if (head === "visualize") { $("#view-visualize").classList.add("active"); markNav("/visualize"); renderVisualize(parts[1]); }
  else if (head === "exam" && parts[1] === "run") { $("#view-examrun").classList.add("active"); markNav("/exam"); renderExamRun(parts[2]); }
  else if (head === "exam")    { $("#view-exam").classList.add("active"); markNav("/exam"); renderExamSetup(); }
  else if (head === "review")  { $("#view-review").classList.add("active"); markNav("/review"); renderReview(); }
  else if (head === "walkthroughs" && !parts[1]) {
    // Visiting #/walkthroughs marks the SI leader as unlocked for this browser session
    setWalkUnlocked(true);
    $("#view-walkthroughs").classList.add("active"); markNav("/walkthroughs");
    renderWalkthroughs();
  }
  else if (head === "walkthroughs" && parts[1]) {
    setWalkUnlocked(true);
    $("#view-walkthrough").classList.add("active"); markNav("/walkthroughs");
    renderWalkthroughDetail(parts[1]);
  }
  else { navigate("/home", { replace: true }); }

  // New pages open at the top; Back/Forward and list pages return to where you were
  jumpTo(scrollTarget);

  // Anonymous usage ping (GoatCounter) — one count per route
  countRoute();
}
function markNav(route) {
  $$(".nav-link").forEach(b => {
    if (b.dataset.route === route) b.classList.add("active");
  });
}

/* ============================================================
   OFFLINE SUPPORT
   sw.js keeps a copy of the site and the problem library, so anything
   already opened keeps working without wifi. Registered on the live https
   site only; add ?sw=1 to test it on a local server.
   ============================================================ */
if ("serviceWorker" in navigator && (location.protocol === "https:" || /[?&]sw=1\b/.test(location.search))) {
  window.addEventListener("load", () => { navigator.serviceWorker.register("sw.js").catch(() => {}); });
}
window.addEventListener("offline", () => showToast("You're offline. The practice library still works.", "neutral", 3200));
window.addEventListener("online", () => showToast("Back online", "neutral", 1800));

/* ============================================================
   USAGE ANALYTICS (GoatCounter — anonymous, cookieless)
   One page-view per hash-route, so we can see how many students
   visit, roughly how long they stay, and which sections/problems
   they use. No cookies, no personal data. Endpoint is set in <head>.
   ============================================================ */
let lastCountedPath = null, qrCounted = false;
function countRoute() {
  const p = location.hash ? location.hash.replace(/^#/, "") : "/home";
  if (p === lastCountedPath) return;                 // de-dupe repeated handleRoute() calls
  if (window.goatcounter && typeof window.goatcounter.count === "function") {
    lastCountedPath = p;
    const viaQr = QR_ARRIVAL && !qrCounted;          // the first view of a QR scan
    qrCounted = true;
    window.goatcounter.count({ path: viaQr ? "/si-qr" : p });
  }
}
// count.js loads async; fire the first page-view as soon as it is ready
(function goatCounterReady(tries) {
  if (window.goatcounter && typeof window.goatcounter.count === "function") countRoute();
  else if (tries < 50) setTimeout(() => goatCounterReady(tries + 1), 100);
})(0);

/* ============================================================
   STATS
   ============================================================ */

function computeStats() {
  const status = getStatusMap();
  const totalProblems = State.problemsById.size;
  let got = 0, review = 0;
  Object.values(status).forEach(v => {
    if (v === "got") got++;
    if (v === "review") review++;
  });
  return { sections: State.sectionsData.length, problems: totalProblems, got, review };
}

const HomeAnim = { ringPct: null, gotNum: null, tilePct: {} };
function updateStats() {
  const s = computeStats();
  // Hero stat row (top of home page)
  const hSec   = document.getElementById("heroStatSections");
  const hProb  = document.getElementById("heroStatProblems");
  const hGot   = document.getElementById("heroStatGot");
  const hTotal = document.getElementById("heroStatTotal");
  if (hSec)   hSec.textContent   = s.sections || "—";
  if (hProb)  hProb.textContent  = s.problems || "—";
  if (hGot)   hGot.textContent   = s.got;
  if (hTotal) hTotal.textContent = s.problems || "—";

  // Progress ring + module (modules row)
  const root = document.getElementById("homeModules");
  if (!root) return;
  const pct = s.problems ? Math.round((s.got / s.problems) * 100) : 0;
  const ring = document.getElementById("progressRingFill");
  const txt  = document.getElementById("progressRingText");
  const fromPct = HomeAnim.ringPct == null ? 0 : HomeAnim.ringPct;
  if (ring && HomeAnim.ringPct !== pct) {
    // Start from what was last shown, then ease to the new value
    const C = 2 * Math.PI * 50;
    ring.setAttribute("stroke-dasharray", C.toFixed(2));
    ring.style.transition = "none";
    ring.style.strokeDashoffset = (C * (1 - fromPct / 100)).toFixed(2);
    ring.getBoundingClientRect();
    ring.style.transition = "";
    ring.style.strokeDashoffset = (C * (1 - pct / 100)).toFixed(2);
  }
  if (txt && HomeAnim.ringPct !== pct) tweenNumber(txt, fromPct, pct, "%");
  HomeAnim.ringPct = pct;
  const gotNum = document.getElementById("progressGotNum");
  const totNum = document.getElementById("progressTotalNum");
  if (gotNum && HomeAnim.gotNum !== s.got) tweenNumber(gotNum, HomeAnim.gotNum == null ? 0 : HomeAnim.gotNum, s.got, "");
  HomeAnim.gotNum = s.got;
  if (totNum) totNum.textContent = `/ ${s.problems || "—"}`;
}

/* ============================================================
   RENDER: HOME
   ============================================================ */

function sectionProgress(section) {
  const status = getStatusMap();
  let got = 0;
  section.problems.forEach(p => { if (status[p.id] === "got") got++; });
  const total = section.problems.length;
  const pct = total ? Math.round((got / total) * 100) : 0;
  return { got, total, pct };
}

/* Cooked-level (difficulty heatmap) computation.
   Combines average estimated minutes per section with the proportion of
   non-warmup problems. Output is a 1..5 integer, low → high effort. */
function sectionCookedLevel(section) {
  const probs = section.problems || [];
  if (!probs.length) return null;
  const mins = probs.map(p => Number(p.estimatedMinutes) || 0);
  const avg  = mins.reduce((a, b) => a + b, 0) / probs.length;
  const heavyCount = probs.filter(p => {
    const d = (p.difficulty || "").toLowerCase();
    return d.includes("core") || d.includes("exam") || d.includes("final");
  }).length;
  const heavyFrac = heavyCount / probs.length;
  // Composite score; tune so the typical range maps cleanly to 1..5
  const score = avg * 0.55 + heavyFrac * 6.2;
  return { score, avg, heavyFrac };
}

function bucketCooked(score, allScores) {
  if (!score) return 1;
  const sorted = allScores.slice().sort((a, b) => a - b);
  const idx = sorted.indexOf(score);
  // Map ordinal to 1..4 fairly
  const lvl = 1 + Math.floor((idx / Math.max(1, sorted.length - 1)) * 3 + 0.0001);
  return Math.max(1, Math.min(4, lvl));
}

const COOKED_FOOT = {
  1: "chill",
  2: "moderate",
  3: "severe",
  4: "cooked"
};

function renderCookedGrid() {
  const grid = document.getElementById("cookedGrid");
  if (!grid) return;
  const sections = State.sectionsData;
  if (!sections.length) {
    grid.innerHTML = Array.from({ length: 10 }).map(() => `
      <div class="cooked-cell" style="background:var(--bg-subtle); opacity:.45;">
        <div class="skeleton" style="height: 16px; width: 40%; margin-bottom: 8px;"></div>
        <div class="skeleton" style="height: 11px; width: 80%; margin-bottom: 4px;"></div>
        <div class="skeleton" style="height: 11px; width: 60%;"></div>
      </div>`).join("");
    return;
  }

  // First pass: compute cooked scores for sections that have data
  const computed = sections.map(s => {
    const r = sectionCookedLevel(s);
    return { section: s, score: r ? r.score : 0, avg: r ? r.avg : 0 };
  });
  const allScores = computed.filter(c => c.score > 0).map(c => c.score);

  grid.innerHTML = computed.map(({ section: s, score, avg }) => {
    const lvl = score ? bucketCooked(score, allScores) : 1;
    const titleShort = s.nick || (s.title.length > 38 ? s.title.slice(0, 36).trim() + "…" : s.title);
    const prog = sectionProgress(s);
    const fromPct = HomeAnim.tilePct[s.pos] == null ? 0 : HomeAnim.tilePct[s.pos];
    return `
      <button class="cooked-cell heat-${lvl}" data-route="/section/${s.pos}" data-pos="${s.pos}" data-prog="${prog.pct}"
              style="--prog: ${fromPct}%"
              aria-label="Section ${s.pos}: ${escapeHtml(s.title)} — ${COOKED_FOOT[lvl]}, ${prog.got} of ${prog.total} complete">
        <div class="sec-num">${String(s.pos).padStart(2,'0')}${prog.got ? `<span class="sec-got">${prog.got}/${prog.total}</span>` : ""}</div>
        <div class="sec-title">${escapeHtml(titleShort)}</div>
        <div class="sec-foot">${avg ? `<span class="sec-min">~${Math.round(avg)} min · </span>` : ""}${COOKED_FOOT[lvl]}</div>
        ${sectionGlyph(s.pos)}
      </button>`;
  }).join("");

  // Progress bars grow from the last value you saw; a tile that changed gets a nudge
  grid.getBoundingClientRect();
  grid.querySelectorAll(".cooked-cell[data-pos]").forEach(cell => {
    const pos = Number(cell.dataset.pos), to = Number(cell.dataset.prog);
    const before = HomeAnim.tilePct[pos];
    cell.style.setProperty("--prog", to + "%");
    if (before != null && before !== to) cell.classList.add("nudge");
    HomeAnim.tilePct[pos] = to;
  });
  scheduleTileReplay();
}

/* Phones can't hover, so the tile drawings would never play there. Instead, while the home page
   is on screen, one tile at a time replays its draw-in, every few seconds, going round the grid
   from a random starting tile. Skipped with reduced motion, in hidden tabs, and when the tiles are
   scrolled away. */
let tileReplayTimer = 0, tileReplayNext = -1;
addEventListener("scroll", () => { window.__lastScroll = performance.now(); }, { passive: true });
function scheduleTileReplay() {
  clearTimeout(tileReplayTimer);
  const noHover = window.matchMedia && matchMedia("(hover: none)").matches;
  const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!noHover || reduce) return;
  const run = () => {
    const grid = document.getElementById("cookedGrid"), home = document.getElementById("view-home");
    if (!grid || !home || !home.classList.contains("active")) return;         // left home: stop until it renders again
    const r = grid.getBoundingClientRect();
    const cells = Array.from(grid.querySelectorAll(".cooked-cell[data-pos]"));
    if (!document.hidden && cells.length && r.bottom > 0 && r.top < window.innerHeight && performance.now() - (window.__lastScroll || 0) > 700) {   // not mid-scroll
      if (tileReplayNext < 0) tileReplayNext = Math.floor(Math.random() * cells.length);
      const c = cells[tileReplayNext % cells.length]; tileReplayNext = (tileReplayNext + 1) % cells.length;
      c.classList.remove("replay"); void c.offsetWidth; c.classList.add("replay");
      setTimeout(() => c.classList.remove("replay"), 2400);
    }
    tileReplayTimer = setTimeout(run, 4200);
  };
  tileReplayTimer = setTimeout(run, 2200);
}

function renderResumeLink() {
  const helpEl = document.getElementById("progressHelp");
  if (!helpEl) return;
  const lastId = lsGet(LS.LAST_PROBLEM, null);
  const lastProblem = lastId ? State.problemsById.get(lastId) : null;
  if (lastProblem && State.sectionsData.length > 0) {
    const status = getStatus(lastId);
    const verb = status === "got" ? "Revisit" : "Continue";
    // Do NOT hard-truncate the title: some titles contain \(...\) math, and
    // slicing can cut a LaTeX command in half. CSS ellipsis handles overflow,
    // and we typeset below so math in titles renders properly.
    const title = String(lastProblem.title || "");
    helpEl.innerHTML = `<button class="resume-link" data-route="/problem/${lastId}" type="button">
      <span class="resume-text"><span class="resume-verb">${verb} where you left off</span>
      <span class="resume-title">${escapeHtml(title)}</span></span>
      <span class="resume-arrow" aria-hidden="true">&rarr;</span>
    </button>`;
    helpEl.classList.add("has-resume");
    typesetMath(helpEl);
  } else {
    helpEl.innerHTML = "Mark problems as you finish. Your progress is saved in this browser.";
    helpEl.classList.remove("has-resume");
  }
}

/* ============================================================
   FALL 2026 LECTURE SCHEDULE (from the 21-254 syllabus)
   [lecture #, date, topic, practice problem ids]. Drives the home page
   "This week" strip.
   ============================================================ */
const COURSE_LECTURES = [
  [1,  "2026-08-24", "Vectors",                     ["vecmat-001", "vecmat-002"]],
  [2,  "2026-08-26", "Matrices",                    ["vecmat-003", "vecmat-004", "vecmat-009"]],
  [3,  "2026-08-28", "Transposes",                  ["vecmat-005", "vecmat-006", "vecmat-007", "vecmat-008"]],
  [4,  "2026-08-31", "Linear systems",              ["rref-008", "rref-003", "rref-004"]],
  [5,  "2026-09-02", "Gaussian elimination",        ["rref-001", "rref-007", "rref-002", "rref-005", "rref-006"]],
  [6,  "2026-09-04", "Linear independence",         ["basis-001", "basis-002", "basis-007"]],
  [7,  "2026-09-09", "Subspaces",                   ["basis-003", "basis-006", "basis-004", "basis-005", "basis-008", "basis-009"]],
  [8,  "2026-09-11", "Linear transformations",      ["transdet-002", "transdet-007", "transdet-001"]],
  [9,  "2026-09-14", "Determinants",                ["transdet-003", "transdet-006", "transdet-005", "transdet-008"]],
  [10, "2026-09-16", "Matrix inverses",             ["transdet-004", "transdet-009"]],
  [11, "2026-09-18", "Eigenvalues and eigenvectors",["eig-001", "eig-003", "eig-005"]],
  [12, "2026-09-21", "Eigenvalue multiplicity",     ["eig-002", "eig-008"]],
  [13, "2026-09-23", "Eigenbases",                  ["eig-004", "eig-007", "eig-010", "eig-009"]],
  [14, "2026-09-28", "Complex eigenvalues",         ["eig-006"]],
  [15, "2026-09-30", "Diagonalization",             ["diagprojcross-001", "diagprojcross-002", "diagprojcross-003", "diagprojcross-004"]],
  [16, "2026-10-02", "Projections",                 ["diagprojcross-005", "diagprojcross-006", "diagprojcross-007"]],
  [17, "2026-10-05", "Cross product",               ["diagprojcross-008", "diagprojcross-009", "diagprojcross-010"]],
  [18, "2026-10-07", "Curves",                      ["curvgradopt-001", "curvgradopt-002"]],
  [19, "2026-10-09", "Scalar functions",            ["curvgradopt-003"]],
  [20, "2026-10-19", "Partial derivatives",         ["curvgradopt-004", "curvgradopt-005"]],
  [21, "2026-10-21", "Gradient",                    ["curvgradopt-006", "curvgradopt-008", "curvgradopt-007"]],
  [22, "2026-10-26", "Optimization",                ["curvgradopt-009", "curvgradopt-010"]],
  [23, "2026-10-28", "Vector fields",               ["vecfieldline-001"]],
  [24, "2026-10-30", "Divergence and curl",         ["vecfieldline-002", "vecfieldline-001"]],
  [25, "2026-11-02", "Line integrals",              ["vecfieldline-005", "vecfieldline-006", "vecfieldline-008"]],
  [26, "2026-11-04", "Path independence",           ["vecfieldline-003", "vecfieldline-009", "vecfieldline-007", "vecfieldline-004", "vecfieldline-010"]],
  [27, "2026-11-06", "Double integrals",            ["doublegreen-001", "doublegreen-002", "doublegreen-003"]],
  [28, "2026-11-09", "Triple integrals",            ["surfstokes-007", "surfstokes-008"]],
  [29, "2026-11-11", "Change of variables",         ["doublegreen-006", "doublegreen-007", "doublegreen-004", "doublegreen-005"]],
  [30, "2026-11-16", "Green's Theorem",             ["doublegreen-008", "doublegreen-009", "doublegreen-010"]],
  [31, "2026-11-18", "Surfaces",                    ["surfstokes-001"]],
  [32, "2026-11-20", "Scalar surface integrals",    ["surfstokes-002"]],
  [33, "2026-11-23", "Vector surface integrals",    ["surfstokes-003", "surfstokes-004"]],
  [34, "2026-11-30", "Stokes' Theorem",             ["surfstokes-005", "surfstokes-006"]],
  [35, "2026-12-02", "Divergence Theorem",          ["surfstokes-009", "surfstokes-010"]],
  [36, "2026-12-04", "Wrap-up",                     []],
];
const FINALS_END = "2026-12-11";

// problem id -> the lectures it goes with, and a short tag like "Lecture 15" for the UI
const LECTURES_BY_PROBLEM = (() => {
  const m = new Map();
  COURSE_LECTURES.forEach(([n, date, topic, ids]) => ids.forEach(id => { if (!m.has(id)) m.set(id, []); m.get(id).push({ n, topic }); }));
  return m;
})();
function lectureOf(id) {
  const L = LECTURES_BY_PROBLEM.get(id);
  if (!L || !L.length) return null;
  const a = L[0], b = L[L.length - 1];
  return { first: a.n, short: a === b ? `Lecture ${a.n}` : `Lectures ${a.n}\u2013${b.n}`,
           topic: a === b ? a.topic : a.topic + " / " + b.topic };
}

function localDate(s) { const [y, m, d] = s.split("-").map(Number); return new Date(y, m - 1, d); }
function mondayOf(d) { const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - (x.getDay() + 6) % 7); return x; }

// Lectures to feature right now: this week's, or the next teaching week during a
// break / before the term. Returns null once finals are over.
function currentLectures(now = new Date()) {
  const L = COURSE_LECTURES.map(([n, date, topic, ids]) => ({ n, date: localDate(date), topic, ids }))
                           .filter(l => l.ids.length);
  const inWeek = start => { const end = new Date(start); end.setDate(start.getDate() + 7);
                            return L.filter(l => l.date >= start && l.date < end); };
  const beforeTerm = now < L[0].date;
  let list = inWeek(mondayOf(now));
  if (list.length) return { mode: beforeTerm ? "first" : "week", list };
  const next = L.find(l => l.date >= now);
  if (next) return { mode: beforeTerm ? "first" : "next", list: inWeek(mondayOf(next.date)) };
  const endOfFinals = localDate(FINALS_END); endOfFinals.setDate(endOfFinals.getDate() + 1);
  return now < endOfFinals ? { mode: "finals", list: [] } : null;
}
function lectureRange(list) {
  const a = list[0].n, b = list[list.length - 1].n;
  return list.length === 1 ? "Lecture " + a : "Lectures " + a + "\u2013" + b;
}

function renderWeekStrip() {
  const strip = $("#weekStrip");
  if (!strip) return;
  const cur = currentLectures();
  if (!cur) { strip.hidden = true; return; }
  const label = { week: "This week", next: "Up next", first: "First week", finals: "Finals week" }[cur.mode];
  $("#weekKicker").innerHTML = "<b>" + label + "</b>" + (cur.list.length ? " &middot; " + lectureRange(cur.list) : " &middot; review everything");
  $("#weekChips").innerHTML = cur.list.length
    ? cur.list.map(l => '<a class="week-chip" href="#/problem/' + l.ids[0] + '">' + escapeHtml(l.topic) + ' <span class="arr" aria-hidden="true">&rarr;</span></a>').join("")
    : '<a class="week-chip" href="#/exam">Exam Mode <span class="arr" aria-hidden="true">&rarr;</span></a>' +
      '<a class="week-chip" href="#/topics">All topics <span class="arr" aria-hidden="true">&rarr;</span></a>';
  $("#weekNote").textContent = cur.list.length
    ? "Recommended review for Fall 2026. Always confirm with the course calendar."
    : "Recommended review. Always confirm what each exam covers with the course calendar.";
  strip.hidden = false;
}

function renderHome() {
  renderWeekStrip();
  updateStats();
  renderCookedGrid();
  renderResumeLink();

  // Error/empty state pinned below the hero (so layout still fits the viewport)
  const err = document.getElementById("homeError");
  if (err) {
    const allErrored = State.sectionsData.length && State.sectionsData.every(s => s._error);
    if (!State.sectionsData.length) {
      err.innerHTML = "";
    } else if (allErrored) {
      err.innerHTML = `<div class="error-state" style="margin:10px 0 0;">
        <h3>We couldn't load any problem files</h3>
        <div>This site reads JSON files from the <code>/data</code> folder. Make sure those files exist in your repository and that GitHub Pages is enabled.</div>
      </div>`;
    } else {
      err.innerHTML = "";
    }
  }
}

function examsForSection(pos) {
  const out = [];
  Object.entries(EXAM_MAP).forEach(([k, cfg]) => {
    if (k === "final") return; // skip Final — it covers all sections, too noisy
    if (cfg.sections && cfg.sections.includes(pos)) out.push({ key: k, title: cfg.title });
  });
  return out;
}

function topicCardHtml(section, options = {}) {
  const { dimmed = false, highlighted = false } = options;
  const prog = sectionProgress(section);
  const err = section._error;
  const cls = ["card"];
  if (dimmed) cls.push("dimmed");
  if (highlighted) cls.push("highlighted");
  const exams = examsForSection(section.pos);
  return `
    <button class="${cls.join(' ')}" data-route="/section/${section.pos}" aria-label="${escapeHtml(section.title)}">
      <div class="card-top">
        <div class="card-num">SECTION<span class="n">${String(section.pos).padStart(2,'0')}</span></div>
        <div class="card-count">${err ? "—" : prog.total + " problem" + (prog.total === 1 ? "" : "s")}</div>
      </div>
      <h3>${escapeHtml(section.title)}</h3>
      ${exams.length ? `<div class="card-exam-badges">${
        exams.map(ex => `<span class="exam-badge" data-exam="${ex.key}">${escapeHtml(ex.title)}</span>`).join("")
      }</div>` : ""}
      <p class="card-desc">${escapeHtml(section.short || "")}</p>
      ${err ? `<div class="error-state" style="margin:0 0 14px; padding:10px 12px; font-size:13px;">
                 <h3 style="font-size:14px; margin:0 0 2px;">Couldn't load</h3>
                 <div>${escapeHtml(err.slice(0, 120))}</div>
               </div>` : `
      <div class="progress" aria-hidden="true"><div class="progress-bar" style="width:${prog.pct}%"></div></div>
      <div class="card-foot">
        <span class="card-progress-text">${prog.got} / ${prog.total} got it · ${prog.pct}%</span>
        <span class="btn btn-sm btn-ghost" style="pointer-events:none;">Study Section <span class="arrow">→</span></span>
      </div>`}
    </button>
  `;
}

function renderLoadingCards(n) {
  return Array.from({ length: n }).map(() => `
    <div class="card loading" aria-hidden="true">
      <div class="skel-line w1 skeleton"></div>
      <div class="skel-line w2 skeleton"></div>
      <div class="skel-line w3 skeleton"></div>
      <div class="skel-line w4 skeleton"></div>
    </div>
  `).join("");
}

/* ============================================================
   RENDER: TOPICS (Browser + Exam Highlighting)
   ============================================================ */

let activeExamFilter = "all";

function renderTopics() {
  // Tabs
  $$(".exam-tab").forEach(b => {
    b.classList.toggle("active", b.dataset.exam === activeExamFilter);
  });
  // Explainer
  const explainBox = $("#examExplain");
  if (activeExamFilter === "all") {
    explainBox.classList.remove("visible");
    explainBox.innerHTML = "";
  } else {
    const cfg = EXAM_MAP[activeExamFilter];
    explainBox.classList.add("visible");
    explainBox.innerHTML = `
      <strong>${escapeHtml(cfg.title)} coverage:</strong> ${escapeHtml(cfg.explain)}
      <div><a class="review-cta" href="#/exam">Practice for ${escapeHtml(cfg.title)} →</a></div>
    `;
    // Wire that link manually because it needs to also preselect the exam
    explainBox.querySelector("a").addEventListener("click", (e) => {
      e.preventDefault(); e.stopPropagation();       // the global [data-route] handler must not re-route this click
      State.examChoice = activeExamFilter;
      navigate("/exam");
    });
  }
  // Cards with highlight / dim
  const wrap = $("#topicCards");
  const highlightSet = new Set(
    activeExamFilter === "all" ? [] : EXAM_MAP[activeExamFilter].sections
  );
  wrap.innerHTML = State.sectionsData.map(s => topicCardHtml(s, {
    dimmed:      activeExamFilter !== "all" && !highlightSet.has(s.pos),
    highlighted: activeExamFilter !== "all" && highlightSet.has(s.pos),
  })).join("");
  typesetMath(wrap);
}

/* ============================================================
   RENDER: SECTION (problem list)
   ============================================================ */

function renderSection(pos) {
  const section = State.sectionsByPos.get(pos);
  if (!section) {
    // Data may still be loading (deep-link / refresh on a hash route).
    // Show shimmer; init() calls handleRoute() again once data lands.
    if (State.sectionsData.length === 0) {
      $("#sectionDetailKicker").textContent = "";
      $("#sectionDetailTitle").textContent  = "Loading…";
      $("#sectionDetailDesc").textContent   = "";
      $("#sectionDetailMeta").innerHTML     = "";
      $("#problemList").innerHTML = renderLoadingCards(4);
      return;
    }
    // Truly unknown section — back to topics.
    navigate("/topics", { replace: true });
    return;
  }
  State.currentSection = section;
  lsSet(LS.LAST_SECTION, pos);

  $("#sectionDetailKicker").textContent = `Section ${String(pos).padStart(2,'0')}`;
  const art = $("#sectionArt");
  if (art) { art.innerHTML = sectionGlyph(pos, "glyph-anim", true); }
  $("#sectionDetailTitle").textContent  = section.title;
  $("#sectionDetailDesc").textContent   = section.short || "";

  const prog = sectionProgress(section);
  $("#sectionDetailMeta").innerHTML = `
    <span><strong>${section.problems.length}</strong> problems</span>
    <span><strong>${prog.got}</strong> got it</span>
    <span><strong>${prog.pct}%</strong> complete</span>
  `;

  // Populate difficulty dropdown from problems
  const diffs = Array.from(new Set(section.problems.map(p => p.difficulty).filter(Boolean)));
  const diffSel = $("#filterDifficulty");
  diffSel.innerHTML = `<option value="">All</option>` + diffs.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join("");

  // Reset filter UI (keep search if user just navigated)
  $("#filterSearch").value = State.filters.search || "";
  $("#filterStatus").value = "";
  $("#filterSort").value = "default";
  State.filters = { search: $("#filterSearch").value, difficulty: "", status: "", sort: "default" };

  renderProblemList();
}

function renderProblemList() {
  const section = State.currentSection;
  if (!section) return;
  const list = $("#problemList");
  const { search, difficulty, status, sort } = State.filters;
  let problems = section.problems.slice();

  if (difficulty) problems = problems.filter(p => p.difficulty === difficulty);
  if (status === "got")    problems = problems.filter(p => getStatus(p.id) === "got");
  if (status === "review") problems = problems.filter(p => getStatus(p.id) === "review");
  if (status === "none")   problems = problems.filter(p => !getStatus(p.id));

  if (search.trim()) {
    const q = search.toLowerCase();
    problems = problems.filter(p => {
      return (p.title || "").toLowerCase().includes(q)
          || (p.skills || []).some(s => s.toLowerCase().includes(q))
          || (p.problemLatex || "").toLowerCase().includes(q)
          || (p.topic || "").toLowerCase().includes(q)
          || (p.examFlavor || "").toLowerCase().includes(q);
    });
  }

  if (sort === "difficulty") {
    const order = { "warm-up": 0, "warm up": 0, "core": 1, "conceptual": 2,
                    "challenge": 3, "stretch": 3, "exam-style": 3, "final-review": 4 };
    problems.sort((a,b) => (order[a.difficulty?.toLowerCase()] ?? 1) - (order[b.difficulty?.toLowerCase()] ?? 1));
  } else if (sort === "minutes") {
    problems.sort((a,b) => (a.estimatedMinutes || 999) - (b.estimatedMinutes || 999));
  }

  if (!problems.length) {
    list.innerHTML = `
      <div class="empty">
        ${emptyArt("region")}
        <h3>No problems match your filters</h3>
        <p>Try clearing the search or relaxing the difficulty / status filter.</p>
      </div>`;
    return;
  }

  list.innerHTML = problems.map((p, idx) => {
    const st = getStatus(p.id);
    return `
    <button class="prob-row" data-problem-id="${escapeHtml(p.id)}">
      <div class="prob-row-main">
        <div class="prob-row-title">${String(idx+1).padStart(2,'0')}. ${escapeHtml(p.title)}</div>
        <div class="prob-row-sub">
          ${lectureOf(p.id) ? `<span class="lec-tag">${lectureOf(p.id).short}</span>` : ""}
          ${p.estimatedMinutes ? `<span>~${p.estimatedMinutes} min</span>` : ""}
          ${(p.skills || []).slice(0, 3).map(s => `<span class="prob-skill">${escapeHtml(s)}</span>`).join("")}
        </div>
      </div>
      <div class="prob-row-right">
        ${p.difficulty ? `<span class="pill ${classForDifficulty(p.difficulty)}">${escapeHtml(p.difficulty)}</span>` : ""}
        ${st === "got" ? `<span class="pill status-got">Got it</span>` : ""}
        ${st === "review" ? `<span class="pill status-review">Review</span>` : ""}
        ${getReport(p.id) ? `<span class="pill status-report">Reported</span>` : ""}
      </div>
    </button>`;
  }).join("");
  typesetMath(list);
}
/* ============================================================
   CONCEPT VISUALS — lightweight inline SVG sketches keyed to
   problem skills. All visuals are conceptual ("not to scale").
   ============================================================ */

// Shared SVG helpers (defs, frame).  Every visual reuses these so
// markers and styling are consistent.
const CV_NS = "http://www.w3.org/2000/svg";

function cvDefs(prefix) {
  // Unique marker ids per visual so multiple SVGs on one page don't collide.
  const p = prefix || "cv";
  return `
    <defs>
      <marker id="${p}-arrR" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--red)"/>
      </marker>
      <marker id="${p}-arrI" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--ink)"/>
      </marker>
      <marker id="${p}-arrG" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--gold)"/>
      </marker>
      <marker id="${p}-arrM" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--ink-faint)"/>
      </marker>
    </defs>`;
}

function cvFrame(body, opts) {
  const w = (opts && opts.w) || 320;
  const h = (opts && opts.h) || 220;
  const t = (opts && opts.t) || "Concept sketch";
  const p = (opts && opts.prefix) || "cv";
  return `
    <svg viewBox="0 0 ${w} ${h}" xmlns="${CV_NS}" class="concept-svg"
         role="img" aria-labelledby="${p}-title">
      <title id="${p}-title">${t}</title>
      ${cvDefs(p)}
      ${body}
    </svg>`;
}

// Returns the math-italic label (uses Fraunces italic, matches LaTeX style)
function cvLabel(x, y, text, opts) {
  const fill  = (opts && opts.fill)  || "var(--ink)";
  const size  = (opts && opts.size)  || 14;
  const anchor= (opts && opts.anchor)|| "start";
  const italic= (opts && opts.italic !== false);
  const family= (opts && opts.family) || "var(--font-display)";
  const weight= (opts && opts.weight) || 500;
  return `<text x="${x}" y="${y}" font-size="${size}" fill="${fill}"
                font-family="${family}"
                font-weight="${weight}"
                ${italic ? 'font-style="italic"' : ''}
                text-anchor="${anchor}">${text}</text>`;
}

function cvNote(x, y, text, opts) {
  const fill  = (opts && opts.fill)  || "var(--ink-mute)";
  const size  = (opts && opts.size)  || 11;
  const anchor= (opts && opts.anchor)|| "start";
  return `<text x="${x}" y="${y}" font-size="${size}" fill="${fill}"
                font-family="var(--font-sans)" font-weight="500"
                text-anchor="${anchor}">${text}</text>`;
}

// Formula renderer: turn "[_x]" into subscript and "[^y]" into superscript
// via SVG tspan baseline-shift. Examples:
//   cvFmla(100, 100, "∫[_a][^b] ∫[_bot][^top] f dy dx")
//   cvFmla(100, 100, "f[_x] · (x − a)", {italic: true})
function cvFmla(x, y, str, opts) {
  const fill   = (opts && opts.fill)   || "var(--ink-mute)";
  const size   = (opts && opts.size)   || 11;
  const anchor = (opts && opts.anchor) || "start";
  const family = (opts && opts.family) || "var(--font-sans)";
  const italic = (opts && opts.italic) ? 'font-style="italic"' : '';
  const weight = (opts && opts.weight) || 500;
  const ss     = Math.max(8, Math.round(size * 0.72));
  function esc(s) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;"); }
  let i = 0, out = "";
  while (i < str.length) {
    const sub = str.indexOf("[_", i);
    const sup = str.indexOf("[^", i);
    let next = -1, kind = null;
    if (sub === -1 && sup === -1) { out += esc(str.slice(i)); break; }
    if      (sub === -1)        { next = sup; kind = "super"; }
    else if (sup === -1)        { next = sub; kind = "sub";   }
    else if (sub < sup)         { next = sub; kind = "sub";   }
    else                        { next = sup; kind = "super"; }
    if (next > i) out += esc(str.slice(i, next));
    const end = str.indexOf("]", next);
    if (end === -1) { out += esc(str.slice(i)); break; }
    out += `<tspan baseline-shift="${kind}" font-size="${ss}">${esc(str.slice(next + 2, end))}</tspan>`;
    i = end + 1;
  }
  return `<text x="${x}" y="${y}" font-size="${size}" fill="${fill}"
                font-family="${family}" font-weight="${weight}"
                text-anchor="${anchor}" ${italic}>${out}</text>`;
}

/* ============================================================
   The CONCEPT registry. Each entry returns
   { kicker, title, svg, caption }.
   ============================================================ */

const CONCEPT = {

  /* ---------- Vectors: arithmetic, addition ---------- */
  vectorAdd: () => ({
    kicker: "Visual idea",
    title:  "Vector addition — parallelogram rule",
    svg: cvFrame(`
      <line x1="50" y1="180" x2="290" y2="180" stroke="var(--border)" stroke-width="1"/>
      <line x1="60" y1="40"  x2="60"  y2="180" stroke="var(--border)" stroke-width="1"/>
      <circle cx="60" cy="180" r="3" fill="var(--ink)"/>
      ${cvNote(50, 195, "0", {anchor:"end"})}
      <!-- v translated to u's tip (dashed, no arrowhead) -->
      <line x1="170" y1="140" x2="210" y2="50" stroke="var(--ink-mute)" stroke-width="1.2"
            stroke-dasharray="4 3"/>
      <!-- u translated to v's tip (dashed, no arrowhead) -->
      <line x1="100" y1="90" x2="210" y2="50" stroke="var(--ink-mute)" stroke-width="1.2"
            stroke-dasharray="4 3"/>
      <!-- u (solid red, NE) -->
      <line x1="60" y1="180" x2="170" y2="140" stroke="var(--red)" stroke-width="2.4"
            marker-end="url(#cv-vadd-arrR)"/>
      ${cvLabel(112, 174, "u", {fill:"var(--red)", size:15})}
      <!-- v (solid ink, N-NE) -->
      <line x1="60" y1="180" x2="100" y2="90" stroke="var(--ink)" stroke-width="2.4"
            marker-end="url(#cv-vadd-arrI)"/>
      ${cvLabel(72, 130, "v", {fill:"var(--ink)", size:15})}
      <!-- u + v diagonal -->
      <line x1="60" y1="180" x2="210" y2="50" stroke="var(--gold)" stroke-width="2.6"
            marker-end="url(#cv-vadd-arrG)"/>
      ${cvLabel(216, 50, "u + v", {fill:"var(--gold)", size:14})}
    `, {prefix:"cv-vadd", t:"Vector addition"}),
    caption: "Place v's tail at u's head — the diagonal of the parallelogram is u + v."
  }),

  /* ---------- Dot product / angle ---------- */
  dotProduct: () => ({
    kicker: "Visual idea",
    title:  "Dot product and the angle between vectors",
    svg: cvFrame(`
      <line x1="60" y1="170" x2="280" y2="170" stroke="var(--border)" stroke-width="1"/>
      <circle cx="60" cy="170" r="3" fill="var(--ink)"/>
      ${cvNote(50, 185, "0", {anchor:"end"})}
      <line x1="60" y1="170" x2="240" y2="170" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-dot-arrI)"/>
      ${cvLabel(248, 174, "v", {fill:"var(--ink)", size:16})}
      <line x1="60" y1="170" x2="200" y2="70" stroke="var(--red)" stroke-width="2"
            marker-end="url(#cv-dot-arrR)"/>
      ${cvLabel(206, 64, "u", {fill:"var(--red)", size:16})}
      <path d="M 110 170 A 50 50 0 0 0 95 134" stroke="var(--ink-soft)"
            stroke-width="1.3" fill="none"/>
      ${cvLabel(112, 152, "θ", {fill:"var(--ink-soft)", size:13, italic:false})}
    `, {prefix:"cv-dot", t:"Dot product angle"}),
    formula: "\\mathbf{u}\\cdot\\mathbf{v}=\\|\\mathbf{u}\\|\\,\\|\\mathbf{v}\\|\\cos\\theta",
    caption: "θ is the angle between u and v. Orthogonal ⇔ u · v = 0."
  }),

  /* ---------- Cross product (3D-ish) ---------- */
  crossProduct: () => ({
    kicker: "Visual idea",
    title:  "Cross product — a vector perpendicular to both",
    svg: cvFrame(`
      <!-- a tilted plane containing u, v -->
      <ellipse cx="170" cy="150" rx="120" ry="34" fill="var(--red-tint)"
               stroke="var(--border)" stroke-width="1" opacity="0.85"/>
      <circle cx="170" cy="150" r="3" fill="var(--ink)"/>
      ${cvNote(160, 165, "0", {anchor:"end"})}
      <!-- u: along the "back" of the plane (right side, slightly back) -->
      <line x1="170" y1="150" x2="252" y2="128" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-cross-arrI)"/>
      ${cvLabel(260, 124, "u", {fill:"var(--ink)", size:15})}
      <!-- v: along the "front" of the plane (right side, slightly front) -->
      <line x1="170" y1="150" x2="214" y2="180" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-cross-arrI)"/>
      ${cvLabel(222, 186, "v", {fill:"var(--ink)", size:15})}
      <!-- u × v: straight up, perpendicular to the plane -->
      <line x1="170" y1="150" x2="170" y2="40" stroke="var(--red)" stroke-width="2.4"
            marker-end="url(#cv-cross-arrR)"/>
      ${cvLabel(178, 50, "u × v", {fill:"var(--red)", size:15})}
      <!-- right-hand curl hint -->
      <path d="M 196 96 A 22 22 0 0 0 152 96" stroke="var(--ink-faint)"
            stroke-width="1" fill="none" stroke-dasharray="3 3"/>
      ${cvNote(160, 210, "|u × v| = area of parallelogram", {anchor:"middle", size:11})}
    `, {prefix:"cv-cross", t:"Cross product"}),
    formula: "\\|\\mathbf{u}\\times\\mathbf{v}\\|=\\|\\mathbf{u}\\|\\,\\|\\mathbf{v}\\|\\sin\\theta=\\text{area of the parallelogram}",
    caption: "u × v is normal to the plane through u and v (right-hand rule)."
  }),

  /* ---------- Scalar triple product / parallelepiped ---------- */
  tripleProduct: () => ({
    kicker: "Visual idea",
    title:  "Scalar triple product — signed volume",
    svg: cvFrame(`
      <!-- Parallelepiped via isometric projection.
           Origin O = (80, 170).  Edge projections:
             a-edge: (+120,  +10)  → right and slightly down
             b-edge: ( +60, -50)   → back and up
             c-edge: (   0, -100)  → straight up
           8 vertices computed below. -->
      <!-- back face (b): O+b, O+a+b, O+a+b+c, O+b+c -->
      <polygon points="140,120 260,130 260,30 140,20"
               fill="#FFFFFF" opacity="0.7"
               stroke="var(--ink-soft)" stroke-width="1"/>
      <!-- right face (a + c, varying b): O+a, O+a+b, O+a+b+c, O+a+c -->
      <polygon points="200,180 260,130 260,30 200,80"
               fill="var(--red-soft)" opacity="0.75"
               stroke="var(--ink-soft)" stroke-width="1"/>
      <!-- top face (c full): O+c, O+a+c, O+a+b+c, O+b+c -->
      <polygon points="80,70 200,80 260,30 140,20"
               fill="var(--red-tint)" opacity="0.7"
               stroke="var(--ink-soft)" stroke-width="1"/>
      <!-- front face (b=0): O, O+a, O+a+c, O+c -->
      <polygon points="80,170 200,180 200,80 80,70"
               fill="var(--red-tint)" opacity="0.55"
               stroke="var(--red)" stroke-width="1.2"/>
      <!-- origin -->
      <circle cx="80" cy="170" r="3" fill="var(--ink)"/>
      ${cvNote(72, 184, "0", {anchor:"end"})}
      <!-- a -->
      <line x1="80" y1="170" x2="200" y2="180" stroke="var(--red)" stroke-width="2"
            marker-end="url(#cv-trp-arrR)"/>
      ${cvLabel(208, 188, "a", {fill:"var(--red)", size:14})}
      <!-- b -->
      <line x1="80" y1="170" x2="140" y2="120" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-trp-arrI)"/>
      ${cvLabel(146, 116, "b", {fill:"var(--ink)", size:14})}
      <!-- c -->
      <line x1="80" y1="170" x2="80" y2="70" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-trp-arrI)"/>
      ${cvLabel(58, 70, "c", {fill:"var(--ink)", size:14, anchor:"end"})}
      ${cvNote(170, 210, "Volume = | a · (b × c) |", {anchor:"middle", size:11})}
    `, {prefix:"cv-trp", t:"Triple product"}),
    formula: "V=\\bigl|\\,\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\\,\\bigr|",
    caption: "The three vectors span a parallelepiped whose signed volume is a · (b × c)."
  }),

  /* ---------- Projection of one vector onto another ---------- */
  projection: () => ({
    kicker: "Visual idea",
    title:  "Vector decomposition — parallel and perpendicular",
    svg: cvFrame(`
      <line x1="40" y1="180" x2="290" y2="180" stroke="var(--border)" stroke-width="1"/>
      <circle cx="60" cy="180" r="3" fill="var(--ink)"/>
      ${cvNote(50, 195, "0", {anchor:"end"})}
      <!-- direction a along the x-axis -->
      <line x1="60" y1="180" x2="260" y2="180" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-prj-arrI)"/>
      ${cvLabel(268, 184, "a", {fill:"var(--ink)", size:15})}
      <!-- vector b -->
      <line x1="60" y1="180" x2="200" y2="80" stroke="var(--red)" stroke-width="2.2"
            marker-end="url(#cv-prj-arrR)"/>
      ${cvLabel(208, 76, "b", {fill:"var(--red)", size:15})}
      <!-- projection onto a (along x-axis, length = 200-60 = 140) -->
      <line x1="60" y1="180" x2="200" y2="180" stroke="var(--gold)" stroke-width="3.2"
            stroke-linecap="round"/>
      ${cvFmla(130, 200, "proj[_a] b", {fill:"var(--gold)", size:13, anchor:"middle", italic:true, family:"var(--font-display)"})}
      <!-- perpendicular component (drop from b to its projection) -->
      <line x1="200" y1="180" x2="200" y2="80" stroke="var(--ink-mute)" stroke-width="1.5"
            stroke-dasharray="4 4"/>
      ${cvFmla(206, 130, "b − proj[_a] b", {fill:"var(--ink-mute)", size:12, italic:true, family:"var(--font-display)"})}
      <!-- right angle -->
      <path d="M 200 168 L 188 168 L 188 180" stroke="var(--ink-soft)" stroke-width="1"
            fill="none"/>
    `, {prefix:"cv-prj", t:"Vector projection"}),
    formula: "\\operatorname{proj}_{\\mathbf a}\\mathbf b=\\frac{\\mathbf a\\cdot\\mathbf b}{\\mathbf a\\cdot\\mathbf a}\\,\\mathbf a",
    caption: "Drop a perpendicular from b to span(a). The foot is the projection of b onto a; the leftover is perpendicular."
  }),

  /* ---------- Span — line through origin (R²) ---------- */
  spanLine: () => ({
    kicker: "Visual idea",
    title:  "Span of one vector — a line through the origin",
    svg: cvFrame(`
      <line x1="160" y1="20" x2="160" y2="200" stroke="var(--border)" stroke-width="1"/>
      <line x1="30"  y1="110" x2="290" y2="110" stroke="var(--border)" stroke-width="1"/>
      <!-- the spanned line -->
      <line x1="60"  y1="180" x2="260" y2="40"  stroke="var(--red)" stroke-width="2.5"
            opacity="0.65"/>
      <line x1="60"  y1="180" x2="260" y2="40"  stroke="var(--red)" stroke-width="1.5"
            stroke-dasharray="2 5" opacity="0.5"/>
      <circle cx="160" cy="110" r="3" fill="var(--ink)"/>
      ${cvNote(166, 124, "0", {anchor:"start"})}
      <!-- the vector v -->
      <line x1="160" y1="110" x2="220" y2="68" stroke="var(--red)" stroke-width="2.6"
            marker-end="url(#cv-spl-arrR)"/>
      ${cvLabel(226, 64, "v", {fill:"var(--red)", size:16})}
    `, {prefix:"cv-spl", t:"Span — line"}),
    formula: "\\operatorname{span}\\{\\mathbf v\\}=\\{\\,c\\,\\mathbf v\\;:\\;c\\in\\mathbb{R}\\,\\}",
    caption: "All scalar multiples of v sweep out a line through the origin."
  }),

  /* ---------- Span — plane in R³ ---------- */
  spanPlane: () => ({
    kicker: "Visual idea",
    title:  "Span of two vectors — a plane through the origin",
    svg: cvFrame(`
      <!-- tilted plane through origin -->
      <ellipse cx="160" cy="125" rx="125" ry="44" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.1" opacity="0.7"/>
      <circle cx="160" cy="125" r="3" fill="var(--ink)"/>
      ${cvNote(160, 142, "0", {anchor:"start"})}
      <!-- u: forward-right within plane -->
      <line x1="160" y1="125" x2="248" y2="100" stroke="var(--red)" stroke-width="2.4"
            marker-end="url(#cv-spp-arrR)"/>
      ${cvLabel(254, 96, "u", {fill:"var(--red)", size:15})}
      <!-- v: back-right within plane (clearly different direction from u) -->
      <line x1="160" y1="125" x2="220" y2="156" stroke="var(--ink)" stroke-width="2.4"
            marker-end="url(#cv-spp-arrI)"/>
      ${cvLabel(228, 162, "v", {fill:"var(--ink)", size:15})}
      ${cvNote(160, 40, "span{ u, v }", {anchor:"middle", size:13, fill:"var(--red)"})}
      ${cvNote(160, 200, "every point = au + bv", {anchor:"middle", size:11})}
    `, {prefix:"cv-spp", t:"Span — plane"}),
    formula: "\\operatorname{span}\\{\\mathbf u,\\mathbf v\\}=\\{\\,a\\,\\mathbf u+b\\,\\mathbf v\\;:\\;a,b\\in\\mathbb{R}\\,\\}",
    caption: "Two non-parallel vectors sweep out a plane through the origin in ℝ³."
  }),

  /* ---------- Subspace (plane through origin) ---------- */
  subspace: () => ({
    kicker: "Visual idea",
    title:  "Subspace — must contain the origin and be closed",
    svg: cvFrame(`
      <ellipse cx="120" cy="120" rx="90" ry="34" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.1" opacity="0.7"/>
      <circle cx="120" cy="120" r="3" fill="var(--ink)"/>
      ${cvNote(124, 136, "0", {anchor:"start"})}
      ${cvNote(120, 70, "subspace ✓", {anchor:"middle", size:12, fill:"var(--red)"})}
      <ellipse cx="240" cy="80" rx="60" ry="22" fill="var(--bg-subtle)"
               stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="4 3" opacity="0.85"/>
      ${cvNote(240, 50, "shifted plane ✗", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
      ${cvNote(240, 110, "(misses 0)", {anchor:"middle", size:10, fill:"var(--ink-mute)"})}
      ${cvNote(160, 200, "closed under + and scalar ×", {anchor:"middle", size:11})}
    `, {prefix:"cv-sub", t:"Subspace"}),
    formula: "\\mathbf 0\\in W,\\qquad \\mathbf u+\\mathbf v\\in W,\\qquad c\\,\\mathbf u\\in W",
    caption: "Subspaces are planes / lines / etc. that pass through the origin and stay closed under combinations."
  }),

  /* ---------- Linear independence (vectors in plane) ---------- */
  linearIndep: () => ({
    kicker: "Visual idea",
    title:  "Linearly dependent — one vector lies in the span of the others",
    svg: cvFrame(`
      <line x1="160" y1="20" x2="160" y2="200" stroke="var(--border)" stroke-width="1"/>
      <line x1="30"  y1="120" x2="290" y2="120" stroke="var(--border)" stroke-width="1"/>
      <circle cx="160" cy="120" r="3" fill="var(--ink)"/>
      <!-- v₁ pointing right -->
      <line x1="160" y1="120" x2="240" y2="120" stroke="var(--red)" stroke-width="2.4"
            marker-end="url(#cv-lid-arrR)"/>
      ${cvLabel(196, 138, "v₁", {fill:"var(--red)", size:14, anchor:"middle"})}
      <!-- v₂ pointing up-left -->
      <line x1="160" y1="120" x2="105" y2="65" stroke="var(--ink)" stroke-width="2.4"
            marker-end="url(#cv-lid-arrI)"/>
      ${cvLabel(120, 82, "v₂", {fill:"var(--ink)", size:14, anchor:"end"})}
      <!-- Construction lines showing v₃ = v₁ + v₂ as the diagonal -->
      <line x1="240" y1="120" x2="185" y2="65" stroke="var(--ink-mute)" stroke-width="1"
            stroke-dasharray="3 3"/>
      <line x1="105" y1="65" x2="185" y2="65" stroke="var(--ink-mute)" stroke-width="1"
            stroke-dasharray="3 3"/>
      <!-- v₃ = v₁ + v₂ diagonal (gold) -->
      <line x1="160" y1="120" x2="185" y2="65" stroke="var(--gold)" stroke-width="2.6"
            marker-end="url(#cv-lid-arrG)"/>
      ${cvLabel(196, 60, "v₃ = v₁ + v₂", {fill:"var(--gold)", size:13})}
      ${cvNote(160, 215, "{ v₁, v₂, v₃ }  is dependent — v₃ already lies in span{v₁, v₂}",
               {anchor:"middle", size:11, fill:"var(--ink-soft)"})}
    `, {prefix:"cv-lid", t:"Linear dependence"}),
    formula: "c_1\\mathbf v_1+c_2\\mathbf v_2+c_3\\mathbf v_3=\\mathbf 0\\quad\\text{with not all }c_i=0",
    caption: "If one vector is a combination of the others, the set is linearly dependent."
  }),

  /* ---------- Basis / coordinates ---------- */
  basisCoords: () => ({
    kicker: "Visual idea",
    title:  "Coordinates in a basis",
    svg: cvFrame(`
      <line x1="160" y1="20" x2="160" y2="200" stroke="var(--border)" stroke-width="1"/>
      <line x1="30"  y1="160" x2="290" y2="160" stroke="var(--border)" stroke-width="1"/>
      <circle cx="60" cy="160" r="3" fill="var(--ink)"/>
      <!--
        b₁ = (60, 0)   along +x direction
        b₂ = (20, -40) tilted up-right
        v = 3·b₁ + 2·b₂ = (180 + 40, 0 − 80) = (220, −80)
        On screen: origin (60,160), so
          v   ends at (280, 80)
          3b₁ ends at (240, 160) — along b₁ direction
          (3b₁ + 2b₂) = v ends at (280, 80)
      -->
      <!-- 3·b₁ as a gold dashed segment along b₁ direction -->
      <line x1="60" y1="160" x2="240" y2="160" stroke="var(--gold)" stroke-width="2"
            stroke-dasharray="5 3"/>
      <!-- 2·b₂ from end of 3·b₁ to v -->
      <line x1="240" y1="160" x2="280" y2="80" stroke="var(--gold)" stroke-width="2"
            stroke-dasharray="5 3"/>
      <!-- basis vectors at origin (solid, short) -->
      <line x1="60" y1="160" x2="120" y2="160" stroke="var(--ink)" stroke-width="2.4"
            marker-end="url(#cv-bc-arrI)"/>
      ${cvLabel(96, 178, "b₁", {fill:"var(--ink)", size:13, anchor:"middle"})}
      <line x1="60" y1="160" x2="80" y2="120" stroke="var(--ink)" stroke-width="2.4"
            marker-end="url(#cv-bc-arrI)"/>
      ${cvLabel(60, 124, "b₂", {fill:"var(--ink)", size:13, anchor:"end"})}
      <!-- v (red, to the same endpoint as 3b₁ + 2b₂) -->
      <line x1="60" y1="160" x2="280" y2="80" stroke="var(--red)" stroke-width="2.2"
            marker-end="url(#cv-bc-arrR)"/>
      ${cvLabel(286, 76, "v", {fill:"var(--red)", size:16})}
    `, {prefix:"cv-bc", t:"Basis coordinates"}),
    formula: "[\\mathbf v]_{\\mathcal B}=(3,\\,2)\\;\\Longleftrightarrow\\;\\mathbf v=3\\,\\mathbf b_1+2\\,\\mathbf b_2",
    caption: "v's coordinates in a basis are the unique scalars that combine the basis vectors into v."
  }),

  /* ---------- Linear transformation: unit square → parallelogram ---------- */
  transformation: () => ({
    kicker: "Visual idea",
    title:  "A linear map sends the unit square to a parallelogram",
    svg: cvFrame(`
      <!-- before -->
      <rect x="40" y="80" width="80" height="80" fill="var(--bg-subtle)"
            stroke="var(--ink-soft)" stroke-width="1.2"/>
      <line x1="40" y1="160" x2="120" y2="160" stroke="var(--red)" stroke-width="2"
            marker-end="url(#cv-trn-arrR)"/>
      <line x1="40" y1="160" x2="40"  y2="80"  stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-trn-arrI)"/>
      ${cvLabel(80, 178, "e₁", {fill:"var(--red)", size:12, anchor:"middle"})}
      ${cvLabel(32, 120, "e₂", {fill:"var(--ink)", size:12, anchor:"end"})}
      ${cvNote(80, 200, "domain", {anchor:"middle", size:11})}
      <!-- arrow A (connector) -->
      ${cvLabel(160, 100, "A", {fill:"var(--ink-soft)", size:14, anchor:"middle"})}
      <line x1="138" y1="120" x2="182" y2="120" stroke="var(--ink-soft)"
            stroke-width="1.6" marker-end="url(#cv-trn-arrI)"/>
      <!-- after: parallelogram -->
      <polygon points="200,160 280,140 270,70 190,90" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.2"/>
      <line x1="200" y1="160" x2="280" y2="140" stroke="var(--red)" stroke-width="2"
            marker-end="url(#cv-trn-arrR)"/>
      <line x1="200" y1="160" x2="190" y2="90"  stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-trn-arrI)"/>
      ${cvLabel(252, 158, "Ae₁", {fill:"var(--red)", size:12, anchor:"middle"})}
      ${cvLabel(204, 128, "Ae₂", {fill:"var(--ink)", size:12})}
      ${cvNote(240, 200, "image", {anchor:"middle", size:11})}
    `, {prefix:"cv-trn", t:"Linear transformation"}),
    formula: "T(\\mathbf x)=A\\mathbf x,\\qquad A=\\bigl[\\,T(\\mathbf e_1)\\;\\;T(\\mathbf e_2)\\,\\bigr]",
    caption: "A maps basis vectors to its columns; the unit square's image is the parallelogram those columns span."
  }),

  /* ---------- Determinant — signed area scaling ---------- */
  determinant: () => ({
    kicker: "Visual idea",
    title:  "|det A| = area scale factor",
    svg: cvFrame(`
      <rect x="40" y="100" width="60" height="60" fill="var(--bg-subtle)"
            stroke="var(--ink-soft)" stroke-width="1.2"/>
      ${cvNote(70, 178, "area = 1", {anchor:"middle", size:11})}
      <line x1="110" y1="130" x2="160" y2="130" stroke="var(--ink-soft)"
            stroke-width="1.6" marker-end="url(#cv-det-arrI)"/>
      ${cvLabel(135, 122, "A", {fill:"var(--ink-soft)", size:13, anchor:"middle"})}
      <polygon points="170,160 270,140 260,70 180,90" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.2"/>
      ${cvNote(220, 200, "area = | det A |", {anchor:"middle", size:11, fill:"var(--red)"})}
      ${cvNote(220, 40, "sign of det = orientation", {anchor:"middle", size:11, fill:"var(--ink-soft)"})}
    `, {prefix:"cv-det", t:"Determinant"}),
    formula: "\\text{area of image}=|\\det A|\\cdot\\text{area of input}",
    caption: "The determinant tells you how A scales area, and whether it flips orientation."
  }),

  /* ---------- Eigenvector — invariant direction ---------- */
  /* ---------- complex eigenvalues: turn and stretch, no fixed direction ---------- */
  complexEigen: () => ({
    kicker: "Visual idea",
    title:  "Complex eigenvalues: A turns every direction",
    svg: cvFrame(`
      <line x1="160" y1="20" x2="160" y2="205" stroke="var(--border)" stroke-width="1"/>
      <line x1="30" y1="122" x2="290" y2="122" stroke="var(--border)" stroke-width="1"/>
      <circle cx="160" cy="122" r="50" fill="none" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="3 4"/>
      <path d="M189.1 114.7 A30 30 0 0 0 179.3 99.0" fill="none" stroke="var(--ink-mute)" stroke-width="1.2" marker-end="url(#cv-cx-arrM)"/>
      <path d="M178.8 86.7 A40 40 0 0 0 154.4 82.4" fill="none" stroke="var(--ink-mute)" stroke-width="1.2" marker-end="url(#cv-cx-arrM)"/>
      <line x1="160" y1="122" x2="209.5" y2="115.0" stroke="var(--ink)" stroke-width="2.2" marker-end="url(#cv-cx-arrI)"/>
      <line x1="160" y1="122" x2="195.8" y2="68.9" stroke="var(--red)" stroke-width="2.3" marker-end="url(#cv-cx-arrR)"/>
      <line x1="160" y1="122" x2="140.2" y2="42.4" stroke="var(--red)" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#cv-cx-arrR)"/>
      <circle cx="160" cy="122" r="3" fill="var(--ink)"/>
      ${cvLabel(217.5, 119.0, "v", {fill:"var(--ink)", size:14})}
      ${cvLabel(203.8, 64.9, "Av", {fill:"var(--red)", size:13})}
      ${cvLabel(132.2, 36.4, "A²v", {fill:"var(--red)", size:13, anchor:"end"})}
      ${cvNote(160, 212, "each step turns by the same angle and stretches by |λ|", {anchor:"middle", size:11})}
    `, {prefix:"cv-cx", t:"Complex eigenvalues"}),
    formula: "\\lambda = a \\pm b\\,i,\\qquad |\\lambda| = \\sqrt{a^2+b^2}",
    caption: "No real direction stays on its own line, so A has no real eigenvectors. In suitable coordinates A is a rotation by the angle of λ combined with a stretch by |λ|."
  }),

  eigenvector: () => ({
    kicker: "Visual idea",
    title:  "An eigenvector keeps its direction under A",
    svg: cvFrame(`
      <line x1="160" y1="20" x2="160" y2="200" stroke="var(--border)" stroke-width="1"/>
      <line x1="30" y1="120" x2="290" y2="120" stroke="var(--border)" stroke-width="1"/>
      <circle cx="160" cy="120" r="3" fill="var(--ink)"/>
      <!-- eigenvector v along a fixed direction -->
      <line x1="160" y1="120" x2="220" y2="80" stroke="var(--red)" stroke-width="2.2"
            marker-end="url(#cv-eig-arrR)"/>
      ${cvLabel(226, 76, "v", {fill:"var(--red)", size:14})}
      <!-- Av on the same line, longer (lambda > 1) -->
      <line x1="160" y1="120" x2="250" y2="60" stroke="var(--red)" stroke-width="2.4"
            stroke-dasharray="5 4" marker-end="url(#cv-eig-arrR)"/>
      ${cvLabel(256, 56, "Av = λv", {fill:"var(--red)", size:13})}
      <!-- non-eigenvector w → Aw rotated -->
      <line x1="160" y1="120" x2="100" y2="80" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-eig-arrI)"/>
      ${cvLabel(86, 78, "w", {fill:"var(--ink)", size:13, anchor:"end"})}
      <line x1="160" y1="120" x2="80" y2="60" stroke="var(--ink-mute)" stroke-width="1.7"
            stroke-dasharray="5 4" marker-end="url(#cv-eig-arrM)"/>
      ${cvLabel(72, 56, "Aw", {fill:"var(--ink-mute)", size:12, anchor:"end"})}
      ${cvNote(160, 210, "v's direction is preserved; w's is not", {anchor:"middle", size:11})}
    `, {prefix:"cv-eig", t:"Eigenvector"}),
    formula: "A\\mathbf v=\\lambda\\,\\mathbf v,\\qquad \\mathbf v\\neq\\mathbf 0",
    caption: "Eigenvectors are special directions where A acts as pure scaling by λ."
  }),

  /* ---------- RREF / pivots ---------- */
  rref: () => ({
    kicker: "Visual idea",
    title:  "Reduced row echelon form — pivots in red",
    svg: cvFrame(`
      <rect x="30" y="40" width="260" height="120" fill="#FFFFFF"
            stroke="var(--ink-soft)" stroke-width="1.2" rx="6"/>
      <!-- bracket-like sides -->
      <line x1="38" y1="46" x2="38" y2="154" stroke="var(--ink)" stroke-width="1.8"/>
      <line x1="282" y1="46" x2="282" y2="154" stroke="var(--ink)" stroke-width="1.8"/>
      <!-- entries: rough RREF pattern  1 0 *  | 2
                                          0 1 *  | 5
                                          0 0 0  | 0 -->
      ${cvNote(70,  75, "1", {size:14, fill:"var(--ink)"})}
      ${cvNote(120, 75, "0", {size:14, fill:"var(--ink-faint)"})}
      ${cvNote(170, 75, "★", {size:14, fill:"var(--ink-mute)"})}
      ${cvNote(70,  110, "0", {size:14, fill:"var(--ink-faint)"})}
      ${cvNote(120, 110, "1", {size:14, fill:"var(--ink)"})}
      ${cvNote(170, 110, "★", {size:14, fill:"var(--ink-mute)"})}
      ${cvNote(70,  145, "0", {size:14, fill:"var(--ink-faint)"})}
      ${cvNote(120, 145, "0", {size:14, fill:"var(--ink-faint)"})}
      ${cvNote(170, 145, "0", {size:14, fill:"var(--ink-faint)"})}
      <!-- pivot circles -->
      <circle cx="70" cy="71" r="14" fill="none" stroke="var(--red)" stroke-width="2"/>
      <circle cx="120" cy="106" r="14" fill="none" stroke="var(--red)" stroke-width="2"/>
      <!-- vertical separator for augmented -->
      <line x1="210" y1="50" x2="210" y2="150" stroke="var(--ink-faint)" stroke-width="1"
            stroke-dasharray="3 3"/>
      ${cvNote(250, 75, "2", {size:14, fill:"var(--ink)"})}
      ${cvNote(250, 110, "5", {size:14, fill:"var(--ink)"})}
      ${cvNote(250, 145, "0", {size:14, fill:"var(--ink-faint)"})}
      ${cvNote(160, 200, "circled = pivot · ★ = free column", {anchor:"middle", size:11})}
    `, {prefix:"cv-rref", t:"RREF and pivots"}),
    caption: "Each pivot fixes one variable; free columns give a parametric family of solutions."
  }),

  /* ---------- Matrix multiplication dimensions ---------- */
  matrixDims: () => ({
    kicker: "Visual idea",
    title:  "AB defined when inner dimensions match",
    svg: cvFrame(`
      <rect x="20" y="80" width="70" height="60" fill="var(--bg-subtle)"
            stroke="var(--ink-soft)" stroke-width="1"/>
      ${cvNote(55, 115, "A", {size:18, fill:"var(--ink)", anchor:"middle"})}
      ${cvNote(55, 70, "m × n", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
      <rect x="120" y="80" width="70" height="60" fill="var(--bg-subtle)"
            stroke="var(--ink-soft)" stroke-width="1"/>
      ${cvNote(155, 115, "B", {size:18, fill:"var(--ink)", anchor:"middle"})}
      ${cvNote(155, 70, "n × p", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
      <!-- inner-dim match arrow -->
      <path d="M 80 150 Q 105 175 130 150" stroke="var(--red)" stroke-width="1.6"
            fill="none" marker-end="url(#cv-mdm-arrR)"/>
      ${cvNote(105, 190, "n = n  ✓", {anchor:"middle", size:11, fill:"var(--red)"})}
      <!-- equals -->
      ${cvNote(205, 115, "=", {anchor:"middle", size:18, fill:"var(--ink)"})}
      <rect x="220" y="80" width="70" height="60" fill="var(--red-tint)"
            stroke="var(--red)" stroke-width="1"/>
      ${cvNote(255, 115, "AB", {size:16, fill:"var(--ink)", anchor:"middle"})}
      ${cvNote(255, 70, "m × p", {anchor:"middle", size:11, fill:"var(--red)"})}
    `, {prefix:"cv-mdm", t:"Matrix dimensions"}),
    formula: "A_{m\\times n}\\,B_{n\\times p}=(AB)_{m\\times p}",
    caption: "Inner dims must agree; outer dims tell you the shape of AB."
  }),

  /* ---------- Symmetric matrix ---------- */
  symmetric: () => ({
    kicker: "Visual idea",
    title:  "Symmetric — entries mirror across the diagonal",
    svg: cvFrame(`
      <rect x="60" y="40" width="200" height="140" fill="#FFFFFF"
            stroke="var(--ink-soft)" stroke-width="1.2" rx="6"/>
      <line x1="70" y1="50" x2="250" y2="170" stroke="var(--gold)" stroke-width="1.5"
            stroke-dasharray="4 3"/>
      ${cvNote(110, 80, "a", {size:14, fill:"var(--ink)"})}
      ${cvNote(170, 80, "b", {size:14, fill:"var(--red)"})}
      ${cvNote(230, 80, "c", {size:14, fill:"var(--red)"})}
      ${cvNote(110, 120, "b", {size:14, fill:"var(--red)"})}
      ${cvNote(170, 120, "d", {size:14, fill:"var(--ink)"})}
      ${cvNote(230, 120, "e", {size:14, fill:"var(--red)"})}
      ${cvNote(110, 160, "c", {size:14, fill:"var(--red)"})}
      ${cvNote(170, 160, "e", {size:14, fill:"var(--red)"})}
      ${cvNote(230, 160, "f", {size:14, fill:"var(--ink)"})}
      ${cvNote(160, 25, "M = Mᵀ", {anchor:"middle", size:13, fill:"var(--ink-soft)"})}
      ${cvNote(160, 205, "mirror pairs shown in red", {anchor:"middle", size:11})}
    `, {prefix:"cv-sym", t:"Symmetric matrix"}),
    caption: "A symmetric matrix is unchanged by transposition: aᵢⱼ = aⱼᵢ."
  }),

  /* ---------- Parametric curve with tangent ---------- */
  parametricCurve: () => ({
    kicker: "Visual idea",
    title:  "A curve and its tangent direction",
    svg: cvFrame(`
      <line x1="30" y1="180" x2="290" y2="180" stroke="var(--border)" stroke-width="1"/>
      <line x1="50" y1="30" x2="50" y2="200" stroke="var(--border)" stroke-width="1"/>
      <!-- smooth curve via cubic Bezier -->
      <path d="M 60 170 C 110 60, 200 230, 280 80" stroke="var(--red)" stroke-width="2.4"
            fill="none"/>
      <!-- point on curve at parameter t0 = around halfway -->
      <circle cx="170" cy="118" r="4" fill="var(--red-deep)"/>
      <!-- tangent direction at that point (approx slope) -->
      <line x1="170" y1="118" x2="240" y2="98" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-pc-arrI)"/>
      ${cvLabel(244, 92, "r'(t)", {fill:"var(--ink)", size:13})}
      ${cvLabel(146, 110, "r(t)", {fill:"var(--red-deep)", size:13, anchor:"end"})}
      ${cvNote(160, 215, "speed = | r'(t) |,  unit tangent = r'/| r' |",
               {anchor:"middle", size:11})}
    `, {prefix:"cv-pc", t:"Parametric curve"}),
    formula: "\\text{speed}=\\|\\mathbf r\'(t)\\|,\\qquad \\mathbf T(t)=\\frac{\\mathbf r\'(t)}{\\|\\mathbf r\'(t)\\|}",
    caption: "r(t) traces a curve; r'(t) points along it. |r'(t)| is the instantaneous speed."
  }),

  /* ---------- Level curves (contours) ---------- */
  levelCurves: () => ({
    kicker: "Visual idea",
    title:  "Level curves of a scalar function",
    svg: cvFrame(`
      <line x1="30" y1="170" x2="290" y2="170" stroke="var(--border)" stroke-width="1"/>
      <line x1="50" y1="20" x2="50" y2="190" stroke="var(--border)" stroke-width="1"/>
      <!-- concentric ellipses -->
      <ellipse cx="160" cy="100" rx="100" ry="60" fill="none" stroke="var(--ink-faint)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="75" ry="44" fill="none" stroke="var(--ink-mute)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="48" ry="28" fill="none" stroke="var(--ink-soft)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="20" ry="12" fill="var(--red-tint)" stroke="var(--red)" stroke-width="1.2"/>
      ${cvNote(266, 64, "f = 1", {size:11, fill:"var(--ink-mute)"})}
      ${cvNote(241, 80, "f = 2", {size:11, fill:"var(--ink-mute)"})}
      ${cvNote(216, 92, "f = 3", {size:11, fill:"var(--ink-mute)"})}
      ${cvNote(170, 98, "max", {size:11, fill:"var(--red)"})}
      ${cvNote(160, 205, "each curve = points where f has one value", {anchor:"middle", size:11})}
    `, {prefix:"cv-lvc", t:"Level curves"}),
    formula: "\\text{level curve: }\\;f(x,y)=c",
    caption: "Each curve is the set of inputs where f(x, y) hits a single value — like a contour line on a map."
  }),

  /* ---------- Gradient + level curves ---------- */
  gradient: () => ({
    kicker: "Visual idea",
    title:  "Gradient points along steepest ascent",
    svg: cvFrame(`
      <line x1="30" y1="170" x2="290" y2="170" stroke="var(--border)" stroke-width="1"/>
      <line x1="50" y1="20" x2="50" y2="190" stroke="var(--border)" stroke-width="1"/>
      <ellipse cx="160" cy="100" rx="100" ry="60" fill="none" stroke="var(--ink-faint)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="75" ry="44" fill="none" stroke="var(--ink-mute)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="48" ry="28" fill="none" stroke="var(--ink-soft)" stroke-width="1.2"/>
      <ellipse cx="160" cy="100" rx="20" ry="12" fill="var(--red-tint)" stroke="var(--red)" stroke-width="1.2"/>
      <!-- point on a level curve & gradient arrow -->
      <circle cx="232" cy="86" r="3" fill="var(--ink)"/>
      ${cvNote(216, 80, "P", {size:12, fill:"var(--ink)", anchor:"end"})}
      <!-- gradient roughly perpendicular to ellipse tangent at P -->
      <line x1="232" y1="86" x2="195" y2="60" stroke="var(--red)" stroke-width="2.2"
            marker-end="url(#cv-grd-arrR)"/>
      ${cvLabel(180, 56, "∇f", {fill:"var(--red)", size:14, anchor:"end", italic:false})}
      ${cvNote(160, 205, "∇f is perpendicular to the level curve at every point",
               {anchor:"middle", size:11})}
    `, {prefix:"cv-grd", t:"Gradient"}),
    formula: "\\nabla f=\\left\\langle f_x,\\;f_y\\right\\rangle\\;\\perp\\;\\text{level curves}",
    caption: "∇f at P points in the direction of fastest increase, perpendicular to that level curve."
  }),

  /* ---------- Tangent plane ---------- */
  tangentPlane: () => ({
    kicker: "Visual idea",
    title:  "Tangent plane at a point on a surface",
    svg: cvFrame(`
      <!-- saddle-ish surface -->
      <path d="M 50 120 Q 130 60 210 100 Q 280 130 290 80
               L 290 130 Q 200 170 130 130 Q 80 110 50 165 Z"
            fill="var(--bg-subtle)" stroke="var(--ink-soft)" stroke-width="1"/>
      <!-- tangent plane (parallelogram) -->
      <polygon points="120,110 220,90 240,160 140,180" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.2" opacity="0.75"/>
      <circle cx="180" cy="135" r="3.5" fill="var(--red-deep)"/>
      ${cvNote(186, 138, "(a, b, f(a,b))", {size:11, fill:"var(--red-deep)"})}
      <line x1="180" y1="135" x2="200" y2="60" stroke="var(--ink)" stroke-width="1.8"
            stroke-dasharray="4 3" marker-end="url(#cv-tp-arrI)"/>
      ${cvLabel(206, 56, "n", {fill:"var(--ink)", size:13})}
      ${cvFmla(160, 205, "z = f(a,b) + f[_x] · (x − a) + f[_y] · (y − b)",
               {anchor:"middle", size:11})}
    `, {prefix:"cv-tp", t:"Tangent plane"}),
    formula: "z=f(a,b)+f_x(a,b)\\,(x-a)+f_y(a,b)\\,(y-b)",
    caption: "The tangent plane is the best linear approximation of f at (a, b)."
  }),

  /* ---------- Vector field (grid of arrows, swirling) ---------- */
  vectorField: () => ({
    kicker: "Visual idea",
    title:  "A vector field — one vector at every point",
    svg: cvFrame(`
      <rect x="40" y="30" width="240" height="160" fill="#FFFFFF"
            stroke="var(--border)" stroke-width="1"/>
      ${(() => {
        // grid of arrows tangent to a swirl, CCW on screen.
        // For F = ⟨-y, x⟩ in math coords (y-up): on SVG (y-down)
        //   screen-dx = -y_math = (cy - cy0)
        //   screen-dy = -x_math = -(cx - cx0)
        let out = "";
        for (let i = 0; i < 6; i++) {
          for (let j = 0; j < 4; j++) {
            const cx = 60 + i * 36;
            const cy = 50 + j * 36;
            const dx =  (cy - 110);
            const dy = -(cx - 160);
            const len = Math.sqrt(dx*dx + dy*dy) || 1;
            const k = 12 / len;
            const x2 = cx + dx * k;
            const y2 = cy + dy * k;
            out += `<line x1="${cx}" y1="${cy}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"
                          stroke="var(--ink-soft)" stroke-width="1.2"
                          marker-end="url(#cv-vf-arrM)"/>`;
          }
        }
        return out;
      })()}
    `, {prefix:"cv-vf", t:"Vector field"}),
    formula: "\\mathbf F(x,y)=\\langle -y,\\;x\\rangle",
    caption: "A vector field assigns a vector to every point — like wind, fluid flow, or force."
  }),

  /* ---------- Line integral: curve through field ---------- */
  lineIntegral: () => ({
    kicker: "Visual idea",
    title:  "Line integral — a curve through a vector field",
    svg: cvFrame(`
      <rect x="40" y="30" width="240" height="160" fill="#FFFFFF"
            stroke="var(--border)" stroke-width="1"/>
      ${(() => {
        let out = "";
        for (let i = 0; i < 5; i++) {
          for (let j = 0; j < 4; j++) {
            const cx = 65 + i * 42;
            const cy = 50 + j * 36;
            const dx = 1, dy = 0.3;
            const k = 9;
            out += `<line x1="${cx}" y1="${cy}" x2="${cx + dx*k}" y2="${cy + dy*k}"
                          stroke="var(--ink-faint)" stroke-width="1"
                          marker-end="url(#cv-li-arrM)"/>`;
          }
        }
        return out;
      })()}
      <!-- curve C -->
      <path d="M 60 160 C 110 60, 200 200, 270 70" stroke="var(--red)" stroke-width="2.4"
            fill="none" marker-end="url(#cv-li-arrR)"/>
      <circle cx="60" cy="160" r="3" fill="var(--red)"/>
      <circle cx="270" cy="70" r="3" fill="var(--red)"/>
      ${cvNote(54, 178, "A", {size:11, fill:"var(--red)"})}
      ${cvNote(274, 64, "B", {size:11, fill:"var(--red)"})}
    `, {prefix:"cv-li", t:"Line integral"}),
    formula: "\\int_C\\mathbf F\\cdot d\\mathbf r=\\int_a^b\\mathbf F(\\mathbf r(t))\\cdot\\mathbf r\'(t)\\,dt",
    caption: "∫<sub>C</sub> F · dr adds up F's component along the curve from start to finish."
  }),

  /* ---------- Conservative field / path independence ---------- */
  conservative: () => ({
    kicker: "Visual idea",
    title:  "Conservative field — value depends only on endpoints",
    svg: cvFrame(`
      <rect x="40" y="30" width="240" height="160" fill="#FFFFFF"
            stroke="var(--border)" stroke-width="1"/>
      <circle cx="80" cy="160" r="4" fill="var(--ink)"/>
      <circle cx="250" cy="60" r="4" fill="var(--ink)"/>
      ${cvNote(72, 178, "A", {size:11, fill:"var(--ink)"})}
      ${cvNote(254, 56, "B", {size:11, fill:"var(--ink)"})}
      <path d="M 80 160 Q 130 80 250 60" stroke="var(--red)" stroke-width="2.2"
            fill="none"/>
      <path d="M 80 160 Q 220 180 250 60" stroke="var(--gold)" stroke-width="2.2"
            fill="none" stroke-dasharray="5 4"/>
      <line x1="143" y1="98"  x2="152" y2="92"  stroke="var(--red)"  stroke-width="2.2" marker-end="url(#cv-cons-arrR)"/>
      <line x1="188" y1="148" x2="197" y2="142" stroke="var(--gold)" stroke-width="2.2" marker-end="url(#cv-cons-arrG)"/>
      ${cvNote(150, 80, "path 1", {anchor:"middle", size:11, fill:"var(--red)"})}
      ${cvNote(170, 170, "path 2", {anchor:"middle", size:11, fill:"var(--gold)"})}
    `, {prefix:"cv-cons", t:"Conservative field"}),
    formula: "\\int_C\\nabla f\\cdot d\\mathbf r=f(B)-f(A)",
    caption: "If F = ∇f, then the line integral only depends on the endpoints — every path gives the same value."
  }),

  /* ---------- Double-integral region ---------- */
  doubleRegion: () => ({
    kicker: "Visual idea",
    title:  "Region of integration",
    svg: cvFrame(`
      <line x1="40" y1="180" x2="292" y2="180" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-dr-arrI)"/>
      <line x1="60" y1="200" x2="60" y2="30" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-dr-arrI)"/>
      ${cvNote(296, 196, "x", {size:11, fill:"var(--ink-mute)", anchor:"end"})}
      ${cvNote(50, 34, "y", {size:11, fill:"var(--ink-mute)", anchor:"end"})}
      ${(() => {
        // Region between two computed curves, so the fill and the curve
        // labels always agree exactly with the drawn geometry.
        const a = 95, b = 235;
        const top = x => 150 - 0.90 * (x - a) + 0.00225 * (x - a) * (x - a);
        const bot = x => 162 - 0.32 * (x - a) + 0.00080 * (x - a) * (x - a);
        const topPts = [], botPts = [];
        for (let x = a; x <= b; x += 5) topPts.push(x + "," + top(x).toFixed(1));
        for (let x = b; x >= a; x -= 5) botPts.push(x + "," + bot(x).toFixed(1));
        const xs = 171, w = 11;
        return `
          <polygon points="${topPts.join(" ")} ${botPts.join(" ")}"
                   fill="var(--red-tint)" stroke="var(--red)" stroke-width="1.6"
                   stroke-linejoin="round"/>
          <rect x="${xs - w / 2}" y="${top(xs).toFixed(1)}" width="${w}"
                height="${(bot(xs) - top(xs)).toFixed(1)}"
                fill="var(--red-soft)" stroke="var(--red-deep)" stroke-width="1"/>
          <line x1="${a}" y1="180" x2="${a}" y2="${top(a).toFixed(1)}"
                stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>
          <line x1="${b}" y1="180" x2="${b}" y2="${top(b).toFixed(1)}"
                stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>`;
      })()}
      ${cvNote(95, 195, "a", {anchor:"middle", size:11})}
      ${cvNote(235, 195, "b", {anchor:"middle", size:11})}
      ${cvLabel(128, 90, "y = top(x)", {fill:"var(--ink-soft)", size:12.5, anchor:"middle"})}
      ${cvLabel(208, 160, "y = bot(x)", {fill:"var(--ink-soft)", size:12.5, anchor:"middle"})}
      ${cvNote(186, 116, "one dy-slice", {size:10.5, fill:"var(--red-deep)"})}
    `, {prefix:"cv-dr", t:"Double-integral region"}),
    formula: "\\iint_D f\\,dA=\\int_a^b\\!\\int_{\\text{bot}(x)}^{\\text{top}(x)} f\\;dy\\,dx",
    caption: "For a vertically simple region, integrate y from bot(x) to top(x), then x from a to b."
  }),

  /* ---------- Polar region ---------- */
  polarRegion: () => ({
    kicker: "Visual idea",
    title:  "Polar region — sweep r between θ-rays",
    svg: cvFrame(`
      <!-- axes; origin at (60, 180) -->
      <line x1="40" y1="180" x2="290" y2="180" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-pol-arrI)"/>
      <line x1="60" y1="200" x2="60" y2="30" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-pol-arrI)"/>
      ${cvNote(294, 184, "x", {size:11, fill:"var(--ink-mute)"})}
      ${cvNote(56, 28, "y", {anchor:"end", size:11, fill:"var(--ink-mute)"})}
      <!-- Pie wedge from origin (60,180); θ from 20° to 65°, radius 120.
           Cartesian endpoints:
             ray @ 20°:  (60 + 120·cos20°, 180 − 120·sin20°) ≈ (173, 139)
             ray @ 65°:  (60 + 120·cos65°, 180 − 120·sin65°) ≈ (111, 71) -->
      <path d="M 60 180 L 173 139 A 120 120 0 0 0 111 71 Z"
            fill="var(--red-tint)" stroke="var(--red)" stroke-width="1.6"/>
      <!-- ray extensions (dashed) -->
      <line x1="173" y1="139" x2="220" y2="122" stroke="var(--ink-faint)" stroke-width="1"
            stroke-dasharray="3 3"/>
      <line x1="111" y1="71"  x2="92"  y2="48"  stroke="var(--ink-faint)" stroke-width="1"
            stroke-dasharray="3 3"/>
      <!-- θ angle arc near origin -->
      <path d="M 110 180 A 50 50 0 0 0 81 142" stroke="var(--ink-soft)"
            stroke-width="1.4" fill="none"/>
      ${cvLabel(102, 158, "θ", {fill:"var(--ink-soft)", size:14, italic:false})}
      <!-- r label along the lower ray, mid-radius -->
      ${cvLabel(132, 174, "r", {fill:"var(--red)", size:15, italic:true, family:"var(--font-display)"})}
      <!-- origin dot -->
      <circle cx="60" cy="180" r="2.5" fill="var(--ink)"/>
    `, {prefix:"cv-pol", t:"Polar region"}),
    formula: "dA=r\\,dr\\,d\\theta",
    caption: "In polar coordinates dA = r dr dθ — the extra r keeps area honest as you sweep around the origin."
  }),

  /* ---------- Green's theorem: closed region + CCW boundary ---------- */
  greens: () => ({
    kicker: "Visual idea",
    title:  "Green's theorem — boundary ↔ region interior",
    svg: cvFrame(`
      <line x1="30" y1="180" x2="290" y2="180" stroke="var(--border)" stroke-width="1"/>
      <line x1="50" y1="20" x2="50" y2="200" stroke="var(--border)" stroke-width="1"/>
      <ellipse cx="163" cy="118" rx="92" ry="52" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="2"/>
      ${(() => {
        // Orientation arrows computed to sit exactly on the boundary,
        // tangent to it, counterclockwise as seen on screen.
        const cx = 163, cy = 118, rx = 92, ry = 52;
        return [38, 128, 218, 308].map(deg => {
          const t = deg * Math.PI / 180;
          const px = cx + rx * Math.cos(t), py = cy - ry * Math.sin(t);
          const dx = -rx * Math.sin(t), dy = -ry * Math.cos(t);
          const L = Math.hypot(dx, dy), ux = dx / L, uy = dy / L;
          return `<line x1="${(px - ux * 10).toFixed(1)}" y1="${(py - uy * 10).toFixed(1)}"
                        x2="${(px + ux * 10).toFixed(1)}" y2="${(py + uy * 10).toFixed(1)}"
                        stroke="var(--red-deep)" stroke-width="2.4"
                        marker-end="url(#cv-grn-arrR)"/>`;
        }).join("");
      })()}
      ${cvLabel(163, 116, "D", {fill:"var(--red-deep)", size:17, anchor:"middle"})}
      ${cvNote(163, 134, "interior", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
      ${cvLabel(254, 174, "∂D", {fill:"var(--red)", size:14})}
    `, {prefix:"cv-grn", t:"Green's theorem"}),
    formula: "\\oint_{\\partial D}P\\,dx+Q\\,dy=\\iint_D\\bigl(Q_x-P_y\\bigr)\\,dA",
    caption: "Counterclockwise boundary ∂D circulates around the region D — line integral = double integral."
  }),

  /* ---------- Change of variables / Jacobian ---------- */
  changeOfVars: () => ({
    kicker: "Visual idea",
    title:  "Change of variables — straighten a region",
    svg: cvFrame(`
      <rect x="30" y="100" width="80" height="60" fill="var(--bg-subtle)"
            stroke="var(--ink-soft)" stroke-width="1.2"/>
      <!-- straight grid in S -->
      <line x1="57"  y1="100" x2="57"  y2="160" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <line x1="83"  y1="100" x2="83"  y2="160" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <line x1="30"  y1="120" x2="110" y2="120" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <line x1="30"  y1="140" x2="110" y2="140" stroke="var(--ink-faint)" stroke-width="0.8"/>
      ${cvNote(70, 134, "S", {anchor:"middle", size:14, fill:"var(--ink)"})}
      ${cvNote(70, 178, "uv-plane", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
      <line x1="125" y1="130" x2="180" y2="130" stroke="var(--ink-soft)" stroke-width="1.6"
            marker-end="url(#cv-cov-arrI)"/>
      ${cvLabel(152, 122, "T", {fill:"var(--ink-soft)", size:13, anchor:"middle"})}
      ${cvNote(152, 144, "scales area by |J|", {anchor:"middle", size:9.5, fill:"var(--ink-mute)"})}
      <polygon points="200,160 280,150 270,80 195,90" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.2"/>
      <!-- the same grid, carried through T into R -->
      <path d="M 226.7 156.7 Q 228 122 220 86.7"   fill="none" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <path d="M 253.3 153.3 Q 253 118 245 83.3"   fill="none" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <path d="M 198.3 136.7 Q 237 136 276.7 126.7" fill="none" stroke="var(--ink-faint)" stroke-width="0.8"/>
      <path d="M 196.7 113.3 Q 235 112 273.3 103.3" fill="none" stroke="var(--ink-faint)" stroke-width="0.8"/>
      ${cvNote(238, 130, "R", {anchor:"middle", size:14, fill:"var(--red)"})}
      ${cvNote(238, 178, "xy-plane", {anchor:"middle", size:11, fill:"var(--ink-mute)"})}
    `, {prefix:"cv-cov", t:"Change of variables"}),
    formula: "\\iint_R f\\,dA=\\iint_S f(T(u,v))\\,\\bigl|J\\bigr|\\,du\\,dv",
    caption: "T maps a tidy S to the original region R. The Jacobian |J| corrects how T stretches area."
  }),

  /* ---------- Surface patch with normal ---------- */
  surfacePatch: () => ({
    kicker: "Visual idea",
    title:  "Parametrized surface and its normal",
    svg: cvFrame(`
      <!-- a curved patch -->
      <path d="M 50 130 Q 130 50 200 90 Q 270 130 290 90
               L 290 140 Q 220 180 150 145 Q 100 120 50 175 Z"
            fill="var(--bg-subtle)" stroke="var(--ink-soft)" stroke-width="1"/>
      <!-- u-grid curves and v-grid curves to suggest parametrization -->
      <path d="M 70 145 Q 150 70 220 105 Q 270 130 285 110"
            stroke="var(--ink-faint)" stroke-width="0.8" fill="none" stroke-dasharray="2 3"/>
      <path d="M 60 165 Q 140 95 215 125 Q 265 145 290 130"
            stroke="var(--ink-faint)" stroke-width="0.8" fill="none" stroke-dasharray="2 3"/>
      <path d="M 130 75 Q 140 110 130 160" stroke="var(--ink-faint)" stroke-width="0.8" fill="none" stroke-dasharray="2 3"/>
      <path d="M 200 95 Q 210 130 195 168" stroke="var(--ink-faint)" stroke-width="0.8" fill="none" stroke-dasharray="2 3"/>
      <!-- point of interest on the surface -->
      <circle cx="170" cy="118" r="3" fill="var(--ink)"/>
      <!-- r_u: tangent along the u-grid (rightward along surface) -->
      <line x1="170" y1="118" x2="220" y2="108" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-srf-arrI)"/>
      ${cvFmla(225, 102, "r[_u]", {fill:"var(--ink)", size:13, italic:true, family:"var(--font-display)"})}
      <!-- r_v: tangent along the v-grid (down along surface, staying on it) -->
      <line x1="170" y1="118" x2="160" y2="158" stroke="var(--ink)" stroke-width="2"
            marker-end="url(#cv-srf-arrI)"/>
      ${cvFmla(150, 168, "r[_v]", {fill:"var(--ink)", size:13, anchor:"end", italic:true, family:"var(--font-display)"})}
      <!-- normal = r_u × r_v -->
      <line x1="170" y1="118" x2="190" y2="50" stroke="var(--red)" stroke-width="2.4"
            marker-end="url(#cv-srf-arrR)"/>
      ${cvFmla(196, 46, "n = r[_u] × r[_v]", {fill:"var(--red)", size:13, italic:true, family:"var(--font-display)"})}
      ${cvFmla(160, 210, "dS = | r[_u] × r[_v] | du dv", {anchor:"middle", size:11})}
    `, {prefix:"cv-srf", t:"Surface patch"}),
    formula: "dS=\\|\\mathbf r_u\\times\\mathbf r_v\\|\\,du\\,dv",
    caption: "Tangent vectors r<sub>u</sub>, r<sub>v</sub> span the tangent plane; their cross product is normal to the surface."
  }),

  /* ---------- Flux through a surface ---------- */
  flux: () => ({
    kicker: "Visual idea",
    title:  "Flux — vector field through an oriented surface",
    svg: cvFrame(`
      <!-- curved surface (dome) -->
      <path d="M 50 160 Q 160 30 270 160 Z" fill="var(--red-tint)"
            stroke="var(--red)" stroke-width="1.4"/>
      <!-- field arrows poking through, varying angle -->
      <line x1="100" y1="180" x2="105" y2="115" stroke="var(--ink-soft)" stroke-width="1.4"
            marker-end="url(#cv-flx-arrM)"/>
      <line x1="160" y1="190" x2="160" y2="75" stroke="var(--ink-soft)" stroke-width="1.4"
            marker-end="url(#cv-flx-arrM)"/>
      <line x1="220" y1="180" x2="215" y2="115" stroke="var(--ink-soft)" stroke-width="1.4"
            marker-end="url(#cv-flx-arrM)"/>
      <!-- a normal vector on the surface -->
      <line x1="160" y1="75" x2="160" y2="30" stroke="var(--red-deep)" stroke-width="2.2"
            marker-end="url(#cv-flx-arrR)"/>
      ${cvLabel(168, 30, "n", {fill:"var(--red-deep)", size:14})}
      ${cvFmla(160, 210, "Flux = ∬[_S] F · n dS", {anchor:"middle", size:12, fill:"var(--red)"})}
    `, {prefix:"cv-flx", t:"Flux"}),
    formula: "\\text{Flux}=\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS",
    caption: "Flux measures how much of F passes through S in the direction of the chosen normal n."
  }),

  /* ---------- Stokes' theorem ---------- */
  stokes: () => ({
    kicker: "Visual idea",
    title:  "Stokes' theorem — surface curl ↔ boundary circulation",
    svg: cvFrame(`
      <!-- disk-like surface in perspective -->
      <ellipse cx="160" cy="120" rx="110" ry="36" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.6"/>
      <!-- boundary orientation arrows -->
      <line x1="50" y1="120" x2="50" y2="113" stroke="var(--red-deep)" stroke-width="2"
            marker-end="url(#cv-stk-arrR)"/>
      <line x1="160" y1="84"  x2="170" y2="84"  stroke="var(--red-deep)" stroke-width="2"
            marker-end="url(#cv-stk-arrR)"/>
      <line x1="270" y1="120" x2="270" y2="128" stroke="var(--red-deep)" stroke-width="2"
            marker-end="url(#cv-stk-arrR)"/>
      <line x1="160" y1="156" x2="148" y2="156" stroke="var(--red-deep)" stroke-width="2"
            marker-end="url(#cv-stk-arrR)"/>
      <!-- curl arrows inside -->
      <path d="M 130 110 A 20 8 0 1 0 170 110" stroke="var(--ink-soft)" stroke-width="1.4"
            fill="none" marker-end="url(#cv-stk-arrM)"/>
      <path d="M 110 130 A 20 8 0 1 0 150 130" stroke="var(--ink-soft)" stroke-width="1.4"
            fill="none" marker-end="url(#cv-stk-arrM)"/>
      <!-- normal -->
      <line x1="160" y1="120" x2="160" y2="50" stroke="var(--red-deep)" stroke-width="2.2"
            stroke-dasharray="4 3" marker-end="url(#cv-stk-arrR)"/>
      ${cvLabel(168, 50, "n", {fill:"var(--red-deep)", size:13})}
      ${cvNote(160, 35, "S", {anchor:"middle", size:13, fill:"var(--red-deep)", italic:true})}
      ${cvFmla(160, 195, "∮[_∂S] F · dr = ∬[_S] (∇×F) · n dS",
               {anchor:"middle", size:11})}
    `, {prefix:"cv-stk", t:"Stokes' theorem"}),
    formula: "\\oint_{\\partial S}\\mathbf F\\cdot d\\mathbf r=\\iint_S(\\nabla\\times\\mathbf F)\\cdot\\mathbf n\\,dS",
    caption: "Circulation around the boundary equals the total curl through S, oriented by n."
  }),

  /* ---------- Triple integral region (tetrahedron) ---------- */
  tripleRegion: () => ({
    kicker: "Visual idea",
    title:  "Triple integral — a 3D region with bounds",
    svg: cvFrame(`
      <!-- axes -->
      <line x1="60" y1="180" x2="280" y2="180" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-tr3-arrI)"/>
      <line x1="60" y1="180" x2="60" y2="40" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-tr3-arrI)"/>
      <line x1="60" y1="180" x2="160" y2="120" stroke="var(--ink-soft)" stroke-width="1.2"
            marker-end="url(#cv-tr3-arrI)"/>
      ${cvNote(286, 184, "x", {size:11, fill:"var(--ink-mute)"})}
      ${cvNote(56, 36, "z", {size:11, fill:"var(--ink-mute)", anchor:"end"})}
      ${cvNote(164, 120, "y", {size:11, fill:"var(--ink-mute)"})}
      <!-- tetrahedron vertices: origin (60,180), x-axis (210, 180), y-axis (135, 135), z-axis (60, 70) -->
      <polygon points="60,180 210,180 135,135" fill="var(--red-tint)"
               stroke="var(--red)" stroke-width="1.2" opacity="0.7"/>
      <polygon points="60,180 210,180 60,70" fill="var(--red-soft)"
               stroke="var(--red)" stroke-width="1.2" opacity="0.6"/>
      <polygon points="60,180 135,135 60,70" fill="#FFFFFF" opacity="0.4"
               stroke="var(--red)" stroke-width="1.2"/>
      <line x1="210" y1="180" x2="60" y2="70" stroke="var(--red)" stroke-width="1.2"/>
      <line x1="210" y1="180" x2="135" y2="135" stroke="var(--red)" stroke-width="1.2"/>
      <line x1="135" y1="135" x2="60" y2="70" stroke="var(--red)" stroke-width="1.2"/>
      ${cvNote(160, 210, "bounds: 0 ≤ z ≤ top(x,y), region in xy-plane",
               {anchor:"middle", size:11})}
    `, {prefix:"cv-tr3", t:"Triple integral region"}),
    formula: "\\iiint_E f\\,dV=\\iint_D\\left[\\int_{z_{\\min}}^{z_{\\max}} f\\,dz\\right]dA",
    caption: "Pick an order (e.g. dz dy dx) and integrate the innermost over the slice at each step."
  }),

  /* ---------- Critical points / extrema ---------- */
  extrema: () => ({
    kicker: "Visual idea",
    title:  "Critical points — where ∇f = 0",
    svg: cvFrame(`
      <!-- three mini contour panels: min, saddle, max -->
      <rect x="18"  y="38" width="88" height="128" rx="10" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1"/>
      <rect x="116" y="38" width="88" height="128" rx="10" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1"/>
      <rect x="214" y="38" width="88" height="128" rx="10" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1"/>
      ${cvNote(62, 28, "min", {anchor:"middle", size:12.5, fill:"var(--gold)"})}
      ${cvNote(160, 28, "saddle", {anchor:"middle", size:12.5, fill:"var(--ink)"})}
      ${cvNote(258, 28, "max", {anchor:"middle", size:12.5, fill:"var(--red)"})}

      <!-- min: f rises outward, so the uphill arrows point away -->
      <ellipse cx="62" cy="102" rx="30" ry="20" fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <ellipse cx="62" cy="102" rx="20" ry="13" fill="none" stroke="var(--ink-mute)" stroke-width="1"/>
      <ellipse cx="62" cy="102" rx="10" ry="6"  fill="none" stroke="var(--ink-soft)" stroke-width="1"/>
      <line x1="62" y1="88"  x2="62" y2="74"  stroke="var(--gold)" stroke-width="1.5" marker-end="url(#cv-ext-arrG)"/>
      <line x1="62" y1="116" x2="62" y2="130" stroke="var(--gold)" stroke-width="1.5" marker-end="url(#cv-ext-arrG)"/>
      <line x1="46" y1="102" x2="32" y2="102" stroke="var(--gold)" stroke-width="1.5" marker-end="url(#cv-ext-arrG)"/>
      <line x1="78" y1="102" x2="92" y2="102" stroke="var(--gold)" stroke-width="1.5" marker-end="url(#cv-ext-arrG)"/>
      <circle cx="62" cy="102" r="3.5" fill="var(--gold)" stroke="#FFFFFF" stroke-width="1"/>

      <!-- saddle: hyperbolic contours + dashed separatrices -->
      <path d="M 126 70 Q 158 102 126 134"  fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <path d="M 194 70 Q 162 102 194 134"  fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <path d="M 134 76 Q 158 102 134 128"  fill="none" stroke="var(--ink-mute)" stroke-width="1"/>
      <path d="M 186 76 Q 162 102 186 128"  fill="none" stroke="var(--ink-mute)" stroke-width="1"/>
      <path d="M 144 62 Q 160 92 176 62"    fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <path d="M 144 142 Q 160 112 176 142" fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <line x1="134" y1="76" x2="186" y2="128" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="3 3"/>
      <line x1="186" y1="76" x2="134" y2="128" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="3 3"/>
      <circle cx="160" cy="102" r="3.5" fill="var(--ink)" stroke="#FFFFFF" stroke-width="1"/>

      <!-- max: f falls outward, so the uphill arrows point in -->
      <ellipse cx="258" cy="102" rx="30" ry="20" fill="none" stroke="var(--ink-faint)" stroke-width="1"/>
      <ellipse cx="258" cy="102" rx="20" ry="13" fill="none" stroke="var(--ink-mute)" stroke-width="1"/>
      <ellipse cx="258" cy="102" rx="10" ry="6"  fill="var(--red-tint)" stroke="var(--red)" stroke-width="1"/>
      <line x1="258" y1="74"  x2="258" y2="88"  stroke="var(--red)" stroke-width="1.5" marker-end="url(#cv-ext-arrR)"/>
      <line x1="258" y1="130" x2="258" y2="116" stroke="var(--red)" stroke-width="1.5" marker-end="url(#cv-ext-arrR)"/>
      <line x1="228" y1="102" x2="242" y2="102" stroke="var(--red)" stroke-width="1.5" marker-end="url(#cv-ext-arrR)"/>
      <line x1="288" y1="102" x2="274" y2="102" stroke="var(--red)" stroke-width="1.5" marker-end="url(#cv-ext-arrR)"/>
      <circle cx="258" cy="102" r="3.5" fill="var(--red)" stroke="#FFFFFF" stroke-width="1"/>

      ${cvNote(62, 184, "f rises outward", {anchor:"middle", size:10})}
      ${cvNote(160, 184, "up one way, down another", {anchor:"middle", size:10})}
      ${cvNote(258, 184, "f falls outward", {anchor:"middle", size:10})}
      ${cvNote(160, 204, "arrows show ∇f — it vanishes at each critical point", {anchor:"middle", size:10.5, fill:"var(--ink-soft)"})}
    `, {prefix:"cv-ext", t:"Critical points"}),
    formula: "\\nabla f=\\mathbf 0,\\qquad D=f_{xx}f_{yy}-f_{xy}^{\\,2}",
    caption: "At critical points the gradient vanishes; the Hessian sorts mins from maxes from saddles."
  }),

  /* ---------- Conservative test / curl ---------- */
  curlVis: () => ({
    kicker: "Visual idea",
    title:  "Curl — local rotation of a vector field",
    svg: cvFrame(`
      <rect x="40" y="30" width="240" height="160" fill="#FFFFFF"
            stroke="var(--border)" stroke-width="1"/>
      ${(() => {
        let out = "";
        for (let i = 0; i < 5; i++) {
          for (let j = 0; j < 4; j++) {
            const cx = 70 + i * 40;
            const cy = 50 + j * 36;
            const dx =  (cy - 110);
            const dy = -(cx - 160);
            const len = Math.sqrt(dx*dx + dy*dy) || 1;
            const k = 12 / len;
            const x2 = cx + dx * k;
            const y2 = cy + dy * k;
            out += `<line x1="${cx}" y1="${cy}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"
                          stroke="var(--ink-faint)" stroke-width="1"
                          marker-end="url(#cv-crl-arrM)"/>`;
          }
        }
        return out;
      })()}
      <!-- a small paddle at center -->
      <circle cx="160" cy="110" r="22" fill="none" stroke="var(--red)" stroke-width="1.6"
              stroke-dasharray="3 3"/>
      <!-- spin arc going CCW on screen -->
      <path d="M 182 110 A 22 22 0 0 0 160 88" stroke="var(--red)" stroke-width="2.2"
            fill="none" marker-end="url(#cv-crl-arrR)"/>
    `, {prefix:"cv-crl", t:"Curl of a field"}),
    formula: "(\\nabla\\times\\mathbf F)\\cdot\\mathbf k=Q_x-P_y",
    caption: "Drop a tiny paddlewheel into F: curl tells you how fast (and which way) it spins."
  }),

};

/* ============================================================
   VIZ3D — tiny dependency-free interactive 3-D renderer
   ============================================================
   Upgrades the inherently three-dimensional concept sketches into
   rotatable scenes. Plain <canvas> 2D: primitives are projected,
   depth-sorted (painter's algorithm), and drawn back-to-front.
   No WebGL, no libraries, fully static-hosting friendly.

   World convention: z is up. Scenes are conceptual, not to scale.
   - Drag (mouse, or horizontal swipe on touch) orbits the camera.
   - Scenes auto-rotate slowly until first touched; disabled when
     the user prefers reduced motion.
   - Render loop self-terminates when its canvas leaves the DOM.
============================================================ */

const Viz3D = (() => {
  // ---- vector helpers ([x, y, z] arrays) ----
  const add   = (a, b) => [a[0]+b[0], a[1]+b[1], a[2]+b[2]];
  const sub   = (a, b) => [a[0]-b[0], a[1]-b[1], a[2]-b[2]];
  const scl   = (a, s) => [a[0]*s, a[1]*s, a[2]*s];
  const cross = (a, b) => [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]];
  const dot   = (a, b) => a[0]*b[0] + a[1]*b[1] + a[2]*b[2];
  const vlen  = a => Math.hypot(a[0], a[1], a[2]);
  const norm  = a => { const l = vlen(a) || 1; return scl(a, 1/l); };

  // ---- theme colors (canvas can't use CSS var() directly) ----
  let THEME = null;
  function theme() {
    if (THEME) return THEME;
    const cs = getComputedStyle(document.documentElement);
    const get = (n, fb) => ((cs.getPropertyValue(n) || "").trim() || fb);
    THEME = {
      red:      get("--red", "#C8102E"),
      redDeep:  get("--red-deep", "#9A0B22"),
      redTint:  get("--red-tint", "#FCEFF1"),
      redSoft:  get("--red-soft", "#F7DEE2"),
      ink:      get("--ink", "#1F2933"),
      inkSoft:  get("--ink-soft", "#46535F"),
      inkMute:  get("--ink-mute", "#6B7682"),
      inkFaint: get("--ink-faint", "#95A0AB"),
      gold:     get("--gold", "#B89642"),
      border:   get("--border", "#E7E1D6"),
      white:    "#FFFFFF",
    };
    return THEME;
  }
  function hexRgb(hex) {
    const h = hex.replace("#", "");
    const v = h.length === 3 ? h.split("").map(c => c + c).join("") : h;
    return [parseInt(v.slice(0,2),16), parseInt(v.slice(2,4),16), parseInt(v.slice(4,6),16)];
  }
  // t = 0 -> a, t = 1 -> b
  function mixHex(a, b, t) {
    const A = hexRgb(a), B = hexRgb(b);
    const c = A.map((v, i) => Math.round(v + (B[i] - v) * t));
    return `rgb(${c[0]},${c[1]},${c[2]})`;
  }

  const LIGHT = norm([0.45, -0.55, 0.75]);   // fixed light for face shading

  // ---- camera / projection ----
  function projector(cam, w, h) {
    const cyw = Math.cos(cam.yaw),   syw = Math.sin(cam.yaw);
    const cp  = Math.cos(cam.pitch), sp  = Math.sin(cam.pitch);
    const s   = (Math.min(w, h) / 3.6) * (cam.zoom || 1);
    const cx  = w / 2, cy = h / 2 + (cam.lift || 0);
    const P   = 7;  // perspective distance (world units)
    const C   = cam.center || [0, 0, 0];   // the point the scene turns around (and sits on screen center)
    return (q) => {
      const p  = [q[0] - C[0], q[1] - C[1], q[2] - C[2]];
      const x  = p[0] * cyw - p[1] * syw;
      const y  = p[0] * syw + p[1] * cyw;
      const z  = p[2];
      const d  = y * cp + z * sp;          // toward the camera
      const up = z * cp - y * sp;          // screen-up component
      const f  = P / (P - d);
      return { x: cx + x * f * s, y: cy - up * f * s, d, f };
    };
  }

  function primDepth(p, proj) {
    const pts = p.pts || (p.a ? [p.a, p.b] : [p.p]);
    let d = 0;
    for (const q of pts) d += proj(q).d;
    d /= pts.length;
    if (p.type === "label") d += 1000;     // labels always draw on top
    return d + (p.bias || 0);
  }

  /* Painter's algorithm only sorts well when pieces are small, so long lines and arrow shafts
     are cut into short segments, and marks (lines, arrows, points) get a small nudge toward the
     camera so a curve or vector lying on a surface is never lost under that surface's own tile.
     The floor grid and flat "decal" regions (a parallelogram, a solid's faces) draw first. */
  const SEG = 0.12, MARK_BIAS = 0.08;
  const lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
  function prepare(prims) {
    const floor = [], decal = [], main = [];
    for (const p of prims) {
      if (p.floor) { floor.push(p); continue; }
      if (p.decal) { decal.push(p); continue; }
      if ((p.type === "line" || p.type === "arrow") && !p.dash) {
        const L = vlen(sub(p.b, p.a)), n = Math.max(1, Math.ceil(L / SEG));
        for (let i = 0; i < n; i++) {
          const seg = { type: "line", a: lerp3(p.a, p.b, i / n), b: lerp3(p.a, p.b, (i + 1) / n), color: p.color,
                        lw: p.lw || (p.type === "arrow" ? 2 : 1.2), opacity: p.opacity, bias: MARK_BIAS };
          if (p.type === "arrow" && i === n - 1) { seg.trim = p.head || 9; }
          main.push(seg);
        }
        if (p.type === "arrow") main.push(Object.assign({}, p, { type: "head", a: lerp3(p.a, p.b, 0.96), bias: MARK_BIAS + 0.02 }));
        continue;
      }
      main.push(p.type === "poly" ? p : Object.assign({ bias: MARK_BIAS }, p));
    }
    return { floor, decal, main };
  }

  // a label: typeset glyphs from the sketch atlas when available, italic text otherwise.
  // (x, y) is the anchor; along = unit screen direction to push the label out along (arrow tips)
  function texLabel(ctx, tex, x, y, size, color, along, anchor) {
    const [w, h] = typeof skTexBox === "function" ? skTexBox(tex, size) : [tex.length * size * .5, size];
    let cx, cy;
    if (along) { const r = 9 + Math.min(Math.abs(w / 2 / (along[0] || 1e-9)), Math.abs(h / 2 / (along[1] || 1e-9))); cx = x + along[0] * r; cy = y + along[1] * r; }
    else { cx = anchor === "center" ? x : x + w / 2; cy = y - size * .32; }
    if (typeof skTexCanvas === "function" && skTexCanvas(ctx, tex, cx, cy, size, color, 3)) return;
    ctx.font = `italic 500 ${size}px Georgia, serif`; ctx.fillStyle = color; ctx.textAlign = "center";
    ctx.fillText(typeof skPlain === "function" ? skPlain(tex) : tex, cx, cy + size * .34);
  }

  function drawPrim(ctx, p, proj, T) {
    ctx.globalAlpha = p.opacity != null ? p.opacity : 1;
    if (p.type === "poly") {
      const pts = p.pts.map(proj);
      ctx.beginPath();
      pts.forEach((q, i) => i ? ctx.lineTo(q.x, q.y) : ctx.moveTo(q.x, q.y));
      ctx.closePath();
      let fill = p.fill;
      if (p.shade) {
        const n = norm(cross(sub(p.pts[2], p.pts[1]), sub(p.pts[0], p.pts[1])));
        const t = 0.5 * (1 - Math.abs(dot(n, LIGHT)));   // 0 = full color, .5 = lighter
        fill = mixHex(p.fill, "#FFFFFF", t);
      }
      ctx.fillStyle = fill;
      ctx.fill();
      if (p.stroke || p.wire) {
        ctx.strokeStyle = p.stroke || fill;
        ctx.lineWidth = p.lw || 0.75;
        ctx.stroke();
      } else if ((p.opacity == null ? 1 : p.opacity) >= 0.95) {
        // hairline in the fill color to hide seams between adjacent opaque quads
        ctx.strokeStyle = fill;
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    } else if (p.type === "line") {
      const A = proj(p.a), B = proj(p.b);
      let bx = B.x, by = B.y;
      if (p.trim) {                                   // last piece of a shaft stops under its arrowhead
        const dx = B.x - A.x, dy = B.y - A.y, L = Math.hypot(dx, dy) || 1, cut = Math.min(L, p.trim * Math.min(1.25, B.f) * 0.7);
        bx -= dx / L * cut; by -= dy / L * cut;
      }
      ctx.beginPath();
      ctx.moveTo(A.x, A.y); ctx.lineTo(bx, by);
      ctx.strokeStyle = p.color;
      ctx.lineWidth = p.lw || 1.2;
      ctx.setLineDash(p.dash || []);
      ctx.stroke();
      ctx.setLineDash([]);
    } else if (p.type === "arrow") {
      const A = proj(p.a), B = proj(p.b);
      const dx = B.x - A.x, dy = B.y - A.y;
      const L = Math.hypot(dx, dy) || 1;
      const ux = dx / L, uy = dy / L;
      const hs = (p.head || 9) * Math.min(1.25, B.f);
      ctx.beginPath();
      ctx.moveTo(A.x, A.y);
      ctx.lineTo(B.x - ux * hs * 0.7, B.y - uy * hs * 0.7);
      ctx.strokeStyle = p.color;
      ctx.lineWidth = p.lw || 2;
      ctx.setLineDash(p.dash || []);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.beginPath();
      ctx.moveTo(B.x, B.y);
      ctx.lineTo(B.x - ux * hs - uy * hs * 0.42, B.y - uy * hs + ux * hs * 0.42);
      ctx.lineTo(B.x - ux * hs + uy * hs * 0.42, B.y - uy * hs - ux * hs * 0.42);
      ctx.closePath();
      ctx.fillStyle = p.color;
      ctx.fill();
      if (p.label) {
        // past the tip; for an arrow lying along a drawn line, turned 65° off it (toward the upper side) so the label clears the line
        let dir = [ux, uy];
        if (p.side) { const c = Math.cos(1.13), sn = Math.sin(1.13), r1 = [ux * c - uy * sn, ux * sn + uy * c], r2 = [ux * c + uy * sn, -ux * sn + uy * c]; dir = r1[1] < r2[1] ? r1 : r2; }
        ctx.globalAlpha = 1; texLabel(ctx, p.label, B.x + (p.ldx || 0), B.y + (p.ldy || 0), p.size || 15, p.labelColor || p.color, dir);
      }
    } else if (p.type === "head") {
      const A = proj(p.a), B = proj(p.b);
      const dx = B.x - A.x, dy = B.y - A.y, L = Math.hypot(dx, dy) || 1, ux = dx / L, uy = dy / L;
      const hs = (p.head || 9) * Math.min(1.25, B.f);
      ctx.beginPath();
      ctx.moveTo(B.x, B.y);
      ctx.lineTo(B.x - ux * hs - uy * hs * 0.42, B.y - uy * hs + ux * hs * 0.42);
      ctx.lineTo(B.x - ux * hs + uy * hs * 0.42, B.y - uy * hs - ux * hs * 0.42);
      ctx.closePath();
      ctx.fillStyle = p.color;
      ctx.fill();
      if (p.label) {
        // past the tip; for an arrow lying along a drawn line, turned 65° off it (toward the upper side) so the label clears the line
        let dir = [ux, uy];
        if (p.side) { const c = Math.cos(1.13), sn = Math.sin(1.13), r1 = [ux * c - uy * sn, ux * sn + uy * c], r2 = [ux * c + uy * sn, -ux * sn + uy * c]; dir = r1[1] < r2[1] ? r1 : r2; }
        ctx.globalAlpha = 1; texLabel(ctx, p.label, B.x + (p.ldx || 0), B.y + (p.ldy || 0), p.size || 15, p.labelColor || p.color, dir);
      }
    } else if (p.type === "point") {
      const q = proj(p.p);
      ctx.beginPath();
      ctx.arc(q.x, q.y, (p.r || 3.6) * Math.min(1.2, q.f), 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
    } else if (p.type === "label") {
      const q = proj(p.p);
      if (p.italic === false) {                       // plain words (notes) stay in the UI font
        ctx.font = `${p.weight || 500} ${p.size || 13}px Manrope, sans-serif`;
        ctx.fillStyle = p.color || T.ink;
        ctx.textAlign = p.anchor || "left";
        ctx.fillText(p.text, q.x + (p.dx || 0), q.y + (p.dy || 0));
      } else texLabel(ctx, p.text, q.x + (p.dx || 0), q.y + (p.dy || 0), p.size || 14, p.color || T.ink, null, p.anchor);
    }
    ctx.globalAlpha = 1;
  }

  // ---- scene-building helpers ----
  function floorGrid(R, step, T, z = 0) {
    const out = [];
    for (let v = -R; v <= R + 1e-9; v += step) {
      out.push({ type: "line", a: [v, -R, z], b: [v, R, z], color: T.border, lw: 0.8, floor: true });
      out.push({ type: "line", a: [-R, v, z], b: [R, v, z], color: T.border, lw: 0.8, floor: true });
    }
    return out;
  }
  function axesPrims(L, T, labels = ["x", "y", "z"]) {    // L: one length, or [Lx, Ly, Lz]
    const [lx, ly, lz] = Array.isArray(L) ? L : [L, L, L];
    return [
      { type: "arrow", a: [0,0,0], b: [lx,0,0], color: T.inkFaint, lw: 1.2, head: 7, label: labels[0], size: 12, labelColor: T.inkMute },
      { type: "arrow", a: [0,0,0], b: [0,ly,0], color: T.inkFaint, lw: 1.2, head: 7, label: labels[1], size: 12, labelColor: T.inkMute },
      { type: "arrow", a: [0,0,0], b: [0,0,lz], color: T.inkFaint, lw: 1.2, head: 7, label: labels[2], size: 12, labelColor: T.inkMute },
    ];
  }
  // generic mesh: fn(u, v) -> [x, y, z]
  function meshQuads(fn, u0, u1, v0, v1, nu, nv, opts) {
    const out = [];
    const du = (u1 - u0) / nu, dv = (v1 - v0) / nv;
    for (let i = 0; i < nu; i++) {
      for (let j = 0; j < nv; j++) {
        const ua = u0 + i * du, ub = ua + du;
        const va = v0 + j * dv, vb = va + dv;
        out.push(Object.assign({
          type: "poly",
          pts: [fn(ua, va), fn(ub, va), fn(ub, vb), fn(ua, vb)],
          shade: true,
        }, opts));
      }
    }
    return out;
  }
  function ringSegs(c, R, z, color, lw, dash, n = 56, opacity, floor) {
    const out = [];
    for (let i = 0; i < n; i++) {
      const t0 = (i / n) * Math.PI * 2, t1 = ((i + 1) / n) * Math.PI * 2;
      out.push({ type: "line",
        a: [c[0] + R * Math.cos(t0), c[1] + R * Math.sin(t0), z],
        b: [c[0] + R * Math.cos(t1), c[1] + R * Math.sin(t1), z],
        color, lw, dash, opacity, floor });
    }
    return out;
  }
  function curveSegs(fn, t0, t1, n, color, lw, dash) {
    const out = [];
    for (let i = 0; i < n; i++) {
      const a = t0 + (i / n) * (t1 - t0), b = t0 + ((i + 1) / n) * (t1 - t0);
      out.push({ type: "line", a: fn(a), b: fn(b), color, lw, dash });
    }
    return out;
  }

  /* ---- the scenes ---- */
  const SCENES = {

    crossProduct() {
      const T = theme();
      const u = [1.25, 0.2, 0], v = [0.35, 1.1, 0];
      const w = scl(norm(cross(u, v)), 1.25);
      return { prims: [
        ...floorGrid(1.5, 0.5, T),
        { type: "poly", pts: [[0,0,0], u, add(u, v), v], fill: T.redTint, opacity: 0.85, stroke: T.redSoft, lw: 1, decal: true },
        { type: "arrow", a: [0,0,0], b: u, color: T.ink, lw: 2.4, label: "u" },
        { type: "arrow", a: [0,0,0], b: v, color: T.ink, lw: 2.4, label: "v" },
        { type: "arrow", a: [0,0,0], b: w, color: T.red, lw: 2.8, label: "u\\times v" },
        { type: "point", p: [0,0,0], color: T.ink, r: 3 },
      ], yaw: -0.55, pitch: 0.42 };
    },

    tripleProduct() {
      const T = theme();
      const a = [1.25, 0.15, 0], b = [0.35, 0.95, 0.1], c = [0.18, 0.3, 1.0];
      const V = (...vs) => vs.reduce(add, [0, 0, 0]);
      const faces = [
        [[0,0,0], a, V(a,b), b], [[0,0,0], a, V(a,c), c], [[0,0,0], b, V(b,c), c],
        [c, V(a,c), V(a,b,c), V(b,c)], [b, V(a,b), V(a,b,c), V(b,c)], [a, V(a,b), V(a,b,c), V(a,c)],
      ];
      return { prims: [
        ...floorGrid(1.5, 0.5, T),
        ...faces.map(pts => ({ type: "poly", pts, fill: T.redTint, opacity: 0.6, shade: true, stroke: T.redSoft, lw: 1, decal: true })),
        { type: "arrow", a: [0,0,0], b: a, color: T.red,  lw: 2.6, label: "a" },
        { type: "arrow", a: [0,0,0], b: b, color: T.ink,  lw: 2.6, label: "b" },
        { type: "arrow", a: [0,0,0], b: c, color: T.gold, lw: 2.6, label: "c" },
      ], yaw: -0.5, pitch: 0.4 };
    },

    spanPlane() {
      const T = theme();
      const u = [1.1, 0.25, 0.22], v = [0.3, 1.05, -0.2];
      const plane = (s, t) => add(scl(u, s), scl(v, t));
      const w = add(scl(u, 0.75), scl(v, 0.85));
      return { prims: [
        ...axesPrims(1.5, T),
        ...meshQuads(plane, -1.05, 1.05, -1.05, 1.05, 6, 6,
          { fill: T.redTint, opacity: 0.55, shade: false, stroke: T.redSoft, lw: 0.7, decal: true }),
        { type: "arrow", a: [0,0,0], b: u, color: T.red, lw: 2.6, label: "u" },
        { type: "arrow", a: [0,0,0], b: v, color: T.ink, lw: 2.6, label: "v" },
        { type: "arrow", a: [0,0,0], b: w, color: T.gold, lw: 2.2, dash: [6, 4], label: "au+bv" },
        { type: "point", p: [0,0,0], color: T.ink, r: 3.2 },
        { type: "label", p: add(scl(u, 0.9), scl(v, -0.95)), text: "\\operatorname{span}\\{u,v\\}", color: T.redDeep, size: 13, anchor: "center", dy: 16 },
      ], yaw: -0.45, pitch: 0.4 };
    },

    surfacePatch() {
      const T = theme();
      const f = (x, y) => 0.42 * Math.sin(1.15 * x) + 0.32 * Math.cos(1.3 * y);
      const r = (u, v) => [u, v, f(u, v)];
      const p0 = [0.15, -0.1, f(0.15, -0.1)];
      const ru = norm([1, 0, 0.42 * 1.15 * Math.cos(1.15 * 0.15)]);
      const rv = norm([0, 1, -0.32 * 1.3 * Math.sin(1.3 * -0.1)]);
      const n  = scl(norm(cross(ru, rv)), 1.0);
      return { prims: [
        ...meshQuads(r, -1.25, 1.25, -1.25, 1.25, 14, 14,
          { fill: "#F4EFE7", shade: true, stroke: "#D8D0C0", lw: 0.5, opacity: 0.96 }),
        { type: "arrow", a: p0, b: add(p0, scl(ru, 0.8)), color: T.ink, lw: 2.3, label: "\\mathbf r_u" },
        { type: "arrow", a: p0, b: add(p0, scl(rv, 0.8)), color: T.ink, lw: 2.3, label: "\\mathbf r_v" },
        { type: "arrow", a: p0, b: add(p0, n), color: T.red, lw: 2.7, label: "\\mathbf n=\\mathbf r_u\\times\\mathbf r_v" },
        { type: "point", p: p0, color: T.redDeep, r: 3.6 },
      ], yaw: -0.55, pitch: 0.5 };
    },

    tangentPlane() {
      const T = theme();
      const f = (x, y) => 1.0 - 0.38 * (x * x + y * y);
      const a = 0.5, b = 0.32, z0 = f(a, b);
      const fx = -0.76 * a, fy = -0.76 * b;
      // Slight z-offset keeps the plane from z-fighting the surface at the
      // touch point; the plane itself is meshed so painter's-algorithm depth
      // sorting stays local and it never appears to slice through the dome.
      const tp = (s, t) => [a + s, b + t, z0 + fx * s + fy * t + 0.012];
      const n = scl(norm([-fx, -fy, 1]), 0.85);
      return { prims: [
        ...floorGrid(1.4, 0.7, T, -0.05),
        ...meshQuads((x, y) => [x, y, f(x, y)], -1.25, 1.25, -1.25, 1.25, 14, 14,
          { fill: "#F4EFE7", shade: true, stroke: "#D8D0C0", lw: 0.5, opacity: 0.95 }),
        ...meshQuads(tp, -0.5, 0.5, -0.5, 0.5, 5, 5,
          { fill: T.redTint, opacity: 0.55, shade: false, stroke: T.redSoft, lw: 0.6 }),
        { type: "line", a: tp(-0.5, -0.5), b: tp(0.5, -0.5),  color: T.red, lw: 1.4 },
        { type: "line", a: tp(0.5, -0.5),  b: tp(0.5, 0.5),   color: T.red, lw: 1.4 },
        { type: "line", a: tp(0.5, 0.5),   b: tp(-0.5, 0.5),  color: T.red, lw: 1.4 },
        { type: "line", a: tp(-0.5, 0.5),  b: tp(-0.5, -0.5), color: T.red, lw: 1.4 },
        { type: "arrow", a: [a, b, z0 + 0.012], b: add([a, b, z0], n), color: T.redDeep, lw: 2.5, label: "\\mathbf n" },
        { type: "point", p: [a, b, z0 + 0.012], color: T.redDeep, r: 3.8 },
        { type: "label", p: [a, b, z0], text: "(a,b,f(a,b))", color: T.redDeep, size: 12.5, anchor: "center", dy: 48 },
      ], yaw: -0.5, pitch: 0.38, lift: 14 };
    },

    gradient() {
      const T = theme();
      const f = (x, y) => 1.3 * Math.exp(-(x * x + y * y) / 0.85);
      const levels = [0.25, 0.55, 0.9];
      const rings = levels.map(c => Math.sqrt(-0.85 * Math.log(c / 1.3)));
      const th0 = 0.6;
      const P = [rings[0] * Math.cos(th0), rings[0] * Math.sin(th0), 0];
      const G = add(P, scl(norm([-P[0], -P[1], 0]), 0.62));
      return { prims: [
        ...floorGrid(1.5, 0.75, T),
        ...meshQuads((x, y) => [x, y, f(x, y)], -1.4, 1.4, -1.4, 1.4, 16, 16,
          { fill: "#F4EFE7", shade: true, stroke: "#D8D0C0", lw: 0.45, opacity: 0.38 }),
        ...rings.flatMap((R, i) => ringSegs([0, 0], R, 0, i === 0 ? T.inkSoft : T.inkFaint, 1.4)),
        { type: "line", a: P, b: [P[0], P[1], f(P[0], P[1])], color: T.inkMute, lw: 1, dash: [3, 3] },
        { type: "arrow", a: P, b: G, color: T.red, lw: 2.7, label: "\\nabla f" },
        { type: "point", p: P, color: T.ink, r: 3.6 },
        { type: "label", p: P, text: "P", color: T.ink, size: 13, dx: 6, dy: 16 },
        { type: "label", p: [-rings[0] * Math.cos(th0), -rings[0] * Math.sin(th0), 0], text: "level curves", color: T.inkMute, size: 11, italic: false, anchor: "center", dy: 16 },
      ], yaw: -0.4, pitch: 0.55 };
    },

    levelCurves() {
      const T = theme();
      const f = (x, y) => 1.3 * Math.exp(-(x * x + y * y) / 0.85);
      const levels = [0.3, 0.65, 1.0];
      const rings = levels.map(c => Math.sqrt(-0.85 * Math.log(c / 1.3)));
      return { prims: [
        ...floorGrid(1.5, 0.75, T, -0.02),
        ...meshQuads((x, y) => [x, y, f(x, y)], -1.4, 1.4, -1.4, 1.4, 16, 16,
          { fill: "#F4EFE7", shade: true, stroke: "#D8D0C0", lw: 0.45, opacity: 0.8 }),
        ...rings.flatMap((R, i) => ringSegs([0, 0], R, levels[i] + 0.02, T.redDeep, 1.7, undefined, 56, 0.9)),
        ...rings.flatMap(R => ringSegs([0, 0], R, -0.02, T.inkMute, 1.1, [4, 3], 56, undefined, true)),
        { type: "label", p: [0, 0, 1.42], text: "f(x,y)", color: T.inkSoft, size: 12.5, anchor: "center" },
        { type: "label", p: [0, -rings[0] - 0.12, -0.02], text: "contours", color: T.inkMute, size: 11, italic: false, anchor: "center", dy: 16 },
      ], yaw: -0.4, pitch: 0.5 };
    },

    curve3d() {
      const T = theme();
      const r = t => [Math.cos(t), Math.sin(t), -0.85 + 0.145 * t];
      const t0 = Math.PI * 2.4;
      const p0 = r(t0);
      const tan = scl(norm([-Math.sin(t0), Math.cos(t0), 0.145]), 0.85);
      return { prims: [
        ...floorGrid(1.5, 0.75, T, -0.95),
        ...ringSegs([0, 0], 1, -0.95, T.inkFaint, 1, [3, 4], 56, undefined, true),
        ...axesPrims(1.45, T),
        ...curveSegs(r, 0, 4 * Math.PI, 90, T.red, 2.4),
        { type: "arrow", a: p0, b: add(p0, tan), color: T.ink, lw: 2.5, label: "\\mathbf r'(t)" },
        { type: "point", p: p0, color: T.redDeep, r: 3.8 },
        { type: "label", p: r(4 * Math.PI), text: "\\mathbf r(t)", color: T.redDeep, size: 13, dx: 8, dy: -6 },
      ], yaw: -0.5, pitch: 0.42 };
    },

    stokes() {
      const T = theme();
      const R = 1.15;
      const cap = (rr, th) => [rr * Math.cos(th), rr * Math.sin(th), 0.4 * (1 - (rr / R) * (rr / R))];
      const orient = [0, 0.5, 1, 1.5].map(k => {
        const th = k * Math.PI;
        const a = [R * Math.cos(th), R * Math.sin(th), 0];
        const tn = scl([-Math.sin(th), Math.cos(th), 0], 0.34);
        return { type: "arrow", a, b: add(a, tn), color: T.redDeep, lw: 2.4, head: 8 };
      });
      const swirl = (cx, cy) => {
        const z = 0.4 * (1 - (Math.hypot(cx, cy) / R) ** 2) + 0.03;
        return curveSegs(t => [cx + 0.16 * Math.cos(t), cy + 0.16 * Math.sin(t), z], 0.4, 5.6, 18, T.inkSoft, 1.3)
          .concat([{ type: "arrow",
            a: [cx + 0.16 * Math.cos(5.4), cy + 0.16 * Math.sin(5.4), z],
            b: [cx + 0.16 * Math.cos(6.0), cy + 0.16 * Math.sin(6.0), z],
            color: T.inkSoft, lw: 1.3, head: 6 }]);
      };
      return { prims: [
        ...floorGrid(1.5, 0.75, T, -0.3),
        ...meshQuads(cap, 0.001, R, 0, Math.PI * 2, 8, 28,
          { fill: T.redTint, shade: true, stroke: T.redSoft, lw: 0.45, opacity: 0.9 }),
        ...ringSegs([0, 0], R, 0, T.red, 2.6),
        ...orient,
        ...swirl(0.45, -0.1), ...swirl(-0.35, 0.3),
        { type: "arrow", a: [0, 0, 0.4], b: [0, 0, 1.3], color: T.redDeep, lw: 2.6, label: "\\mathbf n" },
        { type: "label", p: [-R * 0.8, -R * 0.75, 0], text: "\\partial S", color: T.red, size: 13, dy: 16 },
        { type: "label", p: [0.1, 0.85, 0.25], text: "S", color: T.redDeep, size: 14 },
      ], yaw: -0.45, pitch: 0.5 };
    },

    flux() {
      const T = theme();
      const R = 1.1;
      const dome = (rr, th) => [rr * Math.cos(th), rr * Math.sin(th), 0.62 * (1 - (rr / R) * (rr / R))];
      const field = [];
      for (const x of [-0.65, 0.05, 0.7]) {
        for (const y of [-0.6, 0.35]) {
          const zTop = 0.62 * Math.max(0, 1 - (Math.hypot(x, y) / R) ** 2);
          field.push({ type: "arrow", a: [x, y, -0.75], b: [x + 0.14, y + 0.07, zTop + 0.55],
                       color: T.inkSoft, lw: 1.5, head: 7 });
        }
      }
      return { prims: [
        ...floorGrid(1.5, 0.75, T, -0.8),
        ...field,
        ...meshQuads(dome, 0.001, R, 0, Math.PI * 2, 8, 28,
          { fill: T.redTint, shade: true, stroke: T.redSoft, lw: 0.45, opacity: 0.66 }),
        ...ringSegs([0, 0], R, 0, T.red, 1.8),
        { type: "arrow", a: [0, 0, 0.62], b: [0, 0, 1.45], color: T.redDeep, lw: 2.6, label: "\\mathbf n" },
        { type: "label", p: [R * 0.75, -R * 0.6, 0.25], text: "S", color: T.redDeep, size: 14 },
        { type: "label", p: [-1.05, 0.8, -0.75], text: "\\mathbf F", color: T.inkSoft, size: 13 },
      ], yaw: -0.5, pitch: 0.4 };
    },

    tripleRegion() {
      const T = theme();
      const L = 1.5;
      const O = [0,0,0], X = [L,0,0], Y = [0,L,0], Z = [0,0,L];
      return { prims: [
        ...floorGrid(1.6, 0.8, T),
        { type: "poly", pts: [O, X, Y], fill: T.redSoft, opacity: 0.85, shade: true, stroke: T.red, lw: 1, decal: true },
        { type: "poly", pts: [O, X, Z], fill: "#FFFFFF",  opacity: 0.6,  shade: true, stroke: T.red, lw: 1, decal: true },
        { type: "poly", pts: [O, Y, Z], fill: "#FFFFFF",  opacity: 0.6,  shade: true, stroke: T.red, lw: 1, decal: true },
        { type: "poly", pts: [X, Y, Z], fill: T.redTint,  opacity: 0.85, shade: true, stroke: T.red, lw: 1.3, decal: true },
        ...axesPrims(1.95, T),
        { type: "label", p: scl(add(add(X, Y), Z), 0.36), text: "E", color: T.redDeep, size: 15 },
        { type: "label", p: [L * 0.2, L * 0.2, 0], text: "D", color: T.inkMute, size: 13, anchor: "center", dy: 4 },
      ], yaw: -0.42, pitch: 0.42 };
    },

  };

  /* ---- engine: one instance per canvas ---- */
  function mount(wrap) {
    const name = wrap.dataset.viz3d;
    const sceneFn = SCENES[name];
    if (!sceneFn || wrap.dataset.mounted) return;
    wrap.dataset.mounted = "1";

    const T = theme();
    const scene = sceneFn();
    const layers = prepare(scene.prims);
    const canvas = document.createElement("canvas");
    canvas.className = "viz3d-canvas";
    canvas.setAttribute("role", "img");
    canvas.setAttribute("aria-label", "Interactive 3-D concept sketch. Drag to rotate.");
    const hint = document.createElement("span");
    hint.className = "viz3d-hint";
    hint.textContent = "↻ drag to rotate";
    wrap.appendChild(canvas);
    wrap.appendChild(hint);

    const ctx = canvas.getContext("2d");
    const cam = { yaw: scene.yaw ?? -0.5, pitch: scene.pitch ?? 0.42, zoom: scene.zoom || 1, lift: scene.lift || 0, center: scene.center };
    const reducedMotion = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
    let auto = !reducedMotion;
    let dragging = false, lastX = 0, lastY = 0;
    let visible = true, needsFrame = true, dpr = 1;

    const isDynamic = typeof scene.dynamic === "function";

    // Paint synchronously on mount/resize/drag so the scene is visible even
    // when requestAnimationFrame is throttled (background/hidden tabs).
    function resize() {
      dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      if (!rect.width) return;
      canvas.width  = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      needsFrame = true;
      drawFrame(performance.now() / 1000);
    }

    function drawFrame(tSec) {
      const w = canvas.width / dpr, h = canvas.height / dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const proj = projector(cam, w, h);
      const byDepth = list => list.map(p => ({ p, d: primDepth(p, proj) })).sort((a, b) => a.d - b.d).forEach(it => drawPrim(ctx, it.p, proj, T));
      layers.floor.forEach(p => drawPrim(ctx, p, proj, T));
      byDepth(layers.decal);
      // dynamic scenes contribute time-varying primitives (reduced motion gets a fixed pose)
      byDepth(isDynamic ? layers.main.concat(prepare(scene.dynamic(reducedMotion ? 4 : (tSec || 0)) || []).main) : layers.main);
    }
    let lastTs = 0, running = false;
    function loop(ts) {
      if (!canvas.isConnected) { running = false; return; }   // view was re-rendered — stop quietly
      if (!visible) { running = false; lastTs = 0; return; }    // off screen: sleep until it scrolls back
      const dt = lastTs ? Math.min(0.05, (ts - lastTs) / 1000) : 0;
      lastTs = ts;
      const animating = auto || (isDynamic && !reducedMotion);
      if (visible && (animating || needsFrame)) {
        // turn by elapsed time (not per frame) so the spin is even at any frame rate
        if (auto) cam.yaw += dt * 0.2 * (scene.spin != null ? scene.spin : 1);
        drawFrame(ts / 1000);
        needsFrame = false;
      }
      requestAnimationFrame(loop);
    }

    resize();
    if (window.ResizeObserver) new ResizeObserver(resize).observe(canvas);
    if (window.IntersectionObserver) {
      new IntersectionObserver(es => {
        visible = es.some(e => e.isIntersecting);
        if (visible) { needsFrame = true; if (!running && canvas.isConnected) { running = true; requestAnimationFrame(loop); } }
        // the hint has done its job once it has been seen for a few seconds; it never sits over a label for good
        if (visible && !wrap._hintT) wrap._hintT = setTimeout(() => wrap.classList.add("touched"), 4000);
      }).observe(canvas);
    }

    canvas.addEventListener("pointerdown", e => {
      dragging = true; auto = false;
      wrap.classList.add("touched");
      lastX = e.clientX; lastY = e.clientY;
      try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
    });
    canvas.addEventListener("pointermove", e => {
      if (!dragging) return;
      cam.yaw   += (e.clientX - lastX) * 0.009;
      cam.pitch += (e.clientY - lastY) * 0.009;
      cam.pitch = Math.max(-0.35, Math.min(1.45, cam.pitch));
      lastX = e.clientX; lastY = e.clientY;
      needsFrame = true;
      drawFrame(performance.now() / 1000);   // immediate feedback, even without rAF
    });
    const stop = () => { dragging = false; };
    canvas.addEventListener("pointerup", stop);
    canvas.addEventListener("pointercancel", stop);

    running = true; requestAnimationFrame(loop);
  }

  return {
    supported: () => {
      try { return !!document.createElement("canvas").getContext("2d"); }
      catch (_) { return false; }
    },
    hasScene: name => !!SCENES[name],
    mountAll: root => $$(".viz3d-wrap[data-viz3d]", root || document).forEach(mount),
    // per-problem scenes register themselves here (see the PROBLEM SKETCHES block)
    addScene: (name, fn) => { SCENES[name] = fn; },
    kit: { theme, floorGrid, axesPrims, meshQuads, ringSegs, curveSegs, add, sub, scl, cross, dot, norm, vlen },
    // every math label any scene draws (tools/sketch_tex.mjs typesets these)
    labels: () => { const out = new Set(); Object.values(SCENES).forEach(fn => { try { (fn().prims || []).forEach(p => { if (p.label) out.add(p.label); if (p.type === "label" && p.italic !== false) out.add(p.text); }); } catch (_) {} }); return [...out]; },
  };
})();

/* Concepts with an interactive 3-D upgrade. The study view shows the
   rotatable scene for these; everything else keeps its flat sketch. */
const CONCEPT_VIZ3D = {
  crossProduct:    "crossProduct",
  tripleProduct:   "tripleProduct",
  spanPlane:       "spanPlane",
  surfacePatch:    "surfacePatch",
  tangentPlane:    "tangentPlane",
  gradient:        "gradient",
  levelCurves:     "levelCurves",
  parametricCurve: "curve3d",
  stokes:          "stokes",
  flux:            "flux",
  tripleRegion:    "tripleRegion",
};
Object.entries(CONCEPT_VIZ3D).forEach(([key, sceneName]) => {
  const base = CONCEPT[key];
  if (!base) return;
  CONCEPT[key] = () => Object.assign(base(), { viz3d: sceneName });
});

/* ============================================================
   PICKER — choose a visual based on problem skills + title.
   Order matters: most specific patterns first.
   ============================================================ */

// Explicit picks for problems where keyword matching lands on the wrong idea,
// e.g. "verify a basis using a determinant" matching the area-scaling sketch,
// or a non-conservative field getting the "every path gives the same value" one.
/*SKETCHES_BEGIN*/
/* ============================================================
   PROBLEM SKETCHES
   Every problem gets its own drawing, built from that problem's actual
   numbers (its vectors, matrices, regions and fields), in one visual
   language: paper grid, filled arrowheads, and math labels set in the same
   TeX fonts as the problem statement. Label glyphs come from SK_TEX, an
   atlas pre-rendered with the site's MathJax by tools/sketch_tex.mjs
   (re-run it after adding labels); anything missing from the atlas falls
   back to Georgia italic. The 3-D canvas scenes draw from the same atlas.
   ============================================================ */
