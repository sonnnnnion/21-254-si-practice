        o += vzArrow3(cam, P, Q, "I", 2.4) + vzArrow3(cam, P, R, "I", 2.4);
        if (front) o += nArr;
        o += `<circle cx="${q2(Gs[0])}" cy="${q2(Gs[1])}" r="2.6" fill="${VZ.red}"/>`;
        const T = cam(...tip);
        o += pl + this.labFree(T[0], T[1], this.fan(T[0] - Gs[0], T[1] - Gs[1]), 12, vzB("n") + (C.lab.n ? " = " + C.lab.n : ""), VZ.red, 15, boxes);
      }
      o += vzKey(flat ? [["dot", VZ.ink, "P, Q, R"], ["dash", VZ.grey, "the line through them"]]
        : [["fill", VZ.gold, "the plane"], ["fill", VZ.red, "triangle PQR"], ["line", VZ.ink, "edges PQ, PR"], ["line", VZ.red, "normal n"]]);
      return o;
    }
    // the distance from Q to the plane a x + b y + c z = d
