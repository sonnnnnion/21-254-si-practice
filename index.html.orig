  advance(s) { const end = this.data(s).ops.length + 1, k = Math.min(end, Math.floor(this.target(s) + 1e-6) + 1); vzTweenTo({ x: k }, k === end ? 900 : 620); },
  // "Show all": one step after another, with a short rest between them
  frame(gd, s) {
