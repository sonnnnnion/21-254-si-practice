const SKC = { ink: "#1F2933", red: "#C8102E", deep: "#9A0B22", gold: "#A8842F", grey: "#6B7682", faint: "#95A0AB",
              rule: "#CFC6B6", paper: "#FBF8F4", tint: "#FCEFF1", soft: "#F4D5DA", green: "#2F7A4A", goldTint: "#F6EEDB" };
let SK_LS = 1;                                   // label scale: the SI board sketches (walk.js) draw theirs a little larger
const SK_SEEN = new Set();                       // every label asked for (tools/sketch_tex.mjs reads this)
const skN = v => Math.round(v * 10) / 10;
const skPt = p => skN(p[0]) + " " + skN(p[1]);
const skPlain = tex => String(tex)                // fallback text for a label missing from the atlas
  .replace(/\\(mathbf|boldsymbol|operatorname|text|mathrm)\{([^}]*)\}/g, "$2").replace(/\\lambda/g, "λ").replace(/\\theta/g, "θ")
  .replace(/\\times/g, "×").replace(/\\cdot/g, "·").replace(/\\sqrt\{([^}]*)\}/g, "√$1").replace(/\\[a-zA-Z]+/g, "")
  .replace(/[{}]/g, "").replace(/_(\w)/g, "$1").replace(/-/g, "−");
function skTexBox(tex, size) {                    // [w, h] of a label in px
  const L = SK_TEX.l[tex];
  if (L) return [L.vb[2] * size / 1000, L.vb[3] * size / 1000];
  return [skPlain(tex).length * size * .52 + 2, size * 1.15];
}
/* A label as SVG, its box centred at (cx, cy). halo = paper-coloured outline in px. */
function skTexSvg(tex, cx, cy, size, color, halo) {
  SK_SEEN.add(tex);
  const L = SK_TEX.l[tex];
  if (!L) return `<text x="${skN(cx)}" y="${skN(cy + size * .34)}" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="${size}" fill="${color}"` +
    (halo ? ` stroke="${SKC.paper}" stroke-width="${halo}" stroke-linejoin="round" paint-order="stroke"` : "") + `>${escapeHtml(skPlain(tex))}</text>`;
  const k = size / 1000, [mx, my, w, h] = L.vb, tx = cx - (mx + w / 2) * k, ty = cy - (my + h / 2) * k;
  let body = "";
  for (const u of L.u) {
    if (u[0] === "R") body += `<rect x="${u[7]}" y="${u[8]}" width="${u[9]}" height="${u[10]}" transform="matrix(${u.slice(1, 7).join(" ")})"/>`;
    else body += `<path d="${SK_TEX.g[u[0]]}" transform="matrix(${u.slice(1, 7).join(" ")})"/>`;
  }
  return `<g transform="translate(${skN(tx)} ${skN(ty)}) scale(${+k.toFixed(5)})" fill="${color}"` +
    (halo ? ` stroke="${SKC.paper}" stroke-width="${Math.round(halo / k)}" stroke-linejoin="round" paint-order="stroke"` : "") + `>${body}</g>`;
}
/* The same label on a 2-D canvas (Viz3D). Returns false if it had to fall back. */
const SK_PATHS = new Map();
function skTexCanvas(ctx, tex, cx, cy, size, color, halo) {
  SK_SEEN.add(tex);
  const L = SK_TEX.l[tex];
  if (!L || typeof Path2D === "undefined") return false;
  const k = size / 1000, [mx, my, w, h] = L.vb;
  ctx.save();
  ctx.translate(cx - (mx + w / 2) * k, cy - (my + h / 2) * k); ctx.scale(k, k);
  const shapes = L.u.map(u => {
    if (u[0] === "R") { const p = new Path2D(); p.rect(u[7], u[8], u[9], u[10]); return [u, p]; }
    let p = SK_PATHS.get(u[0]); if (!p) { p = new Path2D(SK_TEX.g[u[0]]); SK_PATHS.set(u[0], p); }
    return [u, p];
  });
  for (const pass of halo ? ["halo", "fill"] : ["fill"]) {
    for (const [u, p] of shapes) {
      ctx.save(); ctx.transform(u[1], u[2], u[3], u[4], u[5], u[6]);
      if (pass === "halo") { ctx.lineJoin = "round"; ctx.lineWidth = halo / k / Math.hypot(u[1], u[2]); ctx.strokeStyle = "rgba(255,255,255,.92)"; ctx.stroke(p); }
      else { ctx.fillStyle = color; ctx.fill(p); }
      ctx.restore();
    }
  }
  ctx.restore();
  return true;
}

/* ---------- views: world -> screen ---------- */
// 2-D, equal scale on both axes, y up; fits every listed point (and anything in o.also) inside the frame
function skFit2(pts, W, H, o = {}) {
  const pad = o.pad == null ? 30 : o.pad, xs = pts.map(p => p[0]), ys = pts.map(p => p[1]);
  let x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
  if (x1 - x0 < 1e-9) { x0 -= 1; x1 += 1; } if (y1 - y0 < 1e-9) { y0 -= 1; y1 += 1; }
  // o.stretch: independent x and y scales (graphs of functions); otherwise one scale keeps shapes true
  const sxFit = (W - 2 * pad - (o.padX || 0)) / (x1 - x0), syFit = (H - 2 * pad - (o.padY || 0)) / (y1 - y0);
  const s = o.s || Math.min(sxFit, syFit), sx = o.stretch ? sxFit : s, sy = o.stretch ? syFit : s;
  const ox = (W - sx * (x1 - x0)) / 2 - sx * x0 + (o.shiftX || 0), oy = (H + sy * (y1 - y0)) / 2 + sy * y0 + (o.shiftY || 0);
  const P = p => [ox + sx * p[0], oy - sy * p[1]];
  P.s = s; P.inv = q => [(q[0] - ox) / sx, (oy - q[1]) / sy];
  return P;
}
// 3-D, orthographic: z up, x toward the viewer (down-left), y to the right, seen a little from above
function skCam(yaw = -2.2, pitch = .4) {
  const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
  const f = p => { const xr = p[0] * cy - p[1] * sy, yr = p[0] * sy + p[1] * cy; return [xr, -(p[2] * cp + yr * sp), yr * cp - p[2] * sp]; };
  f.view = [sy * cp, cy * cp, -sp];                 // unused by most sketches; direction the camera looks along (world)
  return f;
}
// a yaw that shows the planes with these normals as openly as possible (not edge-on), staying near the usual view
function skFaceYaw(normals, pitch = .4, prefer = -2.2) {
  let best = prefer, score = -Infinity;
  for (let y = -Math.PI; y <= Math.PI; y += .02) {
    const cp = Math.cos(pitch), sp = Math.sin(pitch), v = [Math.sin(y) * cp, Math.cos(y) * cp, -sp];
    // open enough to read (|cos| up to .55, about 57° from edge-on), then stay close to the usual view so it still looks 3-D
    const s = Math.min(.55, ...normals.map(n => Math.abs(v[0] * n[0] + v[1] * n[1] + v[2] * n[2]) / Math.hypot(...n))) - .05 * Math.abs(y - prefer);
    if (s > score) { score = s; best = y; }
  }
  return best;
}
function skFit3(cam, pts, W, H, o = {}) {
  const pr = pts.map(cam), P2 = skFit2(pr.map(q => [q[0], -q[1]]), W, H, o);
  const P = p => { const q = cam(p); return P2([q[0], -q[1]]); };
  P.s = P2.s; P.depth = p => cam(p)[2];
  return P;
}
const sk3 = { add: (a, b) => a.map((v, i) => v + b[i]), sub: (a, b) => a.map((v, i) => v - b[i]), mul: (a, s) => a.map(v => v * s),
  dot: (a, b) => a.reduce((t, v, i) => t + v * b[i], 0), cross: (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]],
  len: a => Math.hypot(...a), unit: a => { const l = Math.hypot(...a) || 1; return a.map(v => v / l); } };

/* ---------- the drawing ---------- */
function skNew(W = 400, H = 240) {
  const layer = { back: [], fill: [], mid: [], arrow: [], dot: [], label: [], note: [] };
  const segs = [], boxes = [], dots = [];
  const put = (k, s) => { layer[k].push(s); return S; };
  const obstacle = (a, b) => segs.push([a, b]);
  const segBox = (a, b, bx) => {                    // does segment ab cross box [x0, y0, x1, y1]?
    const [x0, y0, x1, y1] = bx; let t0 = 0, t1 = 1; const dx = b[0] - a[0], dy = b[1] - a[1];
    for (const [p, q] of [[-dx, a[0] - x0], [dx, x1 - a[0]], [-dy, a[1] - y0], [dy, y1 - a[1]]]) {
      if (p === 0) { if (q < 0) return false; } else { const r = q / p; if (p < 0) { if (r > t1) return false; if (r > t0) t0 = r; } else { if (r < t0) return false; if (r < t1) t1 = r; } }
    }
    return true;
  };
  const S = {
    W, H,
    grid(step = 20) {
      return put("back", `<g stroke="${SKC.ink}" stroke-width=".4" opacity=".09">` +
