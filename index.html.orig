      <span class="vz-top-right">
        <span class="vz-crumb"><span class="vz-crumb-g">${escapeHtml(def.group)} &middot; </span>${i + 1} of ${VZ_LIST.length}</span>
        <span class="vz-steps-nav"><a class="vz-nav-btn" href="#/visualize/${prev.id}" title="Previous: ${escapeHtml(prev.title)}" aria-label="Previous: ${escapeHtml(prev.title)}">&lsaquo;</a><a class="vz-nav-btn" href="#/visualize/${next.id}" title="Next: ${escapeHtml(next.title)}" aria-label="Next: ${escapeHtml(next.title)}">&rsaquo;</a></span>
        ${document.fullscreenEnabled ? `<button class="btn btn-ghost btn-sm vz-full" id="vzFull" type="button" aria-pressed="false">Full screen</button>` : ""}
      </span>
    </div>
    <div class="vz-main">
      <div class="vz-stage-wrap"><svg class="vz-stage" id="vzStage" viewBox="0 0 ${VZ_W} ${VZ_H}" role="img" aria-label="${escapeHtml(def.title)}"></svg><div class="vz-keyhtml" id="vzKeyHtml"></div></div>
      <aside class="vz-panel">
        <h1 class="vz-title">${escapeHtml(def.title)}</h1>
        <p class="vz-sub">${escapeHtml(def.tagline || "")}</p>
        ${def.tryIt ? `<p class="vz-try"><strong>Try</strong>${escapeHtml(def.tryIt)}</p>` : ""}
        ${def.panelTop ? `<div class="vz-ptop" id="vzPTop">${def.panelTop()}</div>` : ""}
        <div class="vz-controls" id="vzControls">${vzControlsHtml(def)}</div>
        ${def.presets ? `<div class="vz-presets">${def.presets.map((p, k) => `<button class="vz-chip" type="button" data-preset="${k}">${escapeHtml(p[0])}</button>`).join("")}</div>` : ""}
        <div class="vz-readout" id="vzReadout" aria-live="polite"></div>
        <details class="vz-more"><summary>The idea</summary><p class="vz-blurb">${escapeHtml(def.blurb)}</p></details>
        <button class="vz-report" type="button" id="vzReport">Report a problem</button>
        <div class="vz-fade" aria-hidden="true"></div>
      </aside>
    </div>
    <div class="vz-pager">
      <a class="btn btn-ghost btn-sm" href="#/visualize/${prev.id}">&larr; ${escapeHtml(prev.title)}</a>
      <a class="btn btn-ghost btn-sm" href="#/visualize/${next.id}">${escapeHtml(next.title)} &rarr;</a>
