  kind(s) { const C = this.calc(s); return this.op(s) === 2 ? "" : [C.cls, !!C.lab.perp, !!C.lab.flat].join("|"); },   // (parallel vectors just glide flat)
  // the exact answer and working for the numbers in force (worked out once per set of numbers)
  calc(s) {
