  const pts = [[0, 0], [1, 1], e1, e2, f], xs = pts.map(p => p[0]), ys = pts.map(p => p[1]), x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
  const pd = 18, u = Math.min((b[2] - 2 * pd) / Math.max(x1 - x0, .01), (b[3] - 2 * pd) / Math.max(y1 - y0, .01), 64);
