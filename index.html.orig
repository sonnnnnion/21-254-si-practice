        if (F.len(dd) > 1e-9) o += vzPath3(cam, [F.sub(far[0], F.mul(dd, 1.5)), F.add(far[1], F.mul(dd, 1.5))], `stroke="${VZ.grey}" stroke-width="1.3" stroke-dasharray="6 5"`);
        o += pl;
