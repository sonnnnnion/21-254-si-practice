/* ---------- Check your own work: the determinant and inverse of your own matrix ----------
   A 2 × 2 or 3 × 3 matrix the student types, worked the course's way on a board, one step at a time. Page 1 finds
   det A (ad − bc, or cofactor expansion along the row or column with the most zeros, crossing out each entry's row
   and column in turn), beside the unit square or cube and its image; page 2 finds A⁻¹ (the 1/det formula, or row
   reducing [A | I] a column at a time) and multiplies back to check. Every number is an exact fraction (BigInt).
   The step number glides, so each step's lines fade in and the row reduction scrolls up like a column of work on
   paper; a jump (Show all, Start over, a new matrix) dissolves from the old board into the new one. */
const TDET_EX = { 2: ["2", "-1", "1", "3"], 3: ["1", "3", "2", "0", "2", "1", "-1", "1", "4"] };
const TDET_OK = "#2F7A4A", TDET_NO = "#7D6214", TDET_SERIF = "'Fraunces', Georgia, serif";
// exact fractions {n, d} with BigInt parts, d > 0, in lowest terms
const tdetAbs = a => a < 0n ? -a : a;
function tdetGcd(a, b) { a = tdetAbs(a); b = tdetAbs(b); while (b) { const t = a % b; a = b; b = t; } return a; }
function tdetQ(n, d = 1n) { if (d < 0n) { n = -n; d = -d; } const g = tdetGcd(n, d); return g > 1n ? { n: n / g, d: d / g } : { n, d }; }
