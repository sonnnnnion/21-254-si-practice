}
// cos θ = c√r: the angle exactly when it is one of the special ones
function tvecAngle(cs) {
  const tbl = { "1|1": "0", "1|−1": "π", "1|1/2": "π/3", "1|−1/2": "2π/3", "2|1/2": "π/4", "2|−1/2": "3π/4", "3|1/2": "π/6", "3|−1/2": "5π/6" };
  const ex = TVEC_R.z(cs.c) ? "π/2" : tbl[cs.r + "|" + TVEC_R.txt(cs.c)] || null, num = Math.acos(vzClamp(tvecRootNum(cs), -1, 1));
  return { ex, num, deg: ex ? Math.round(num * 180 / Math.PI) : num * 180 / Math.PI };
}

/* the five computations: each returns the answer lines, the working (one entry per step), a status and the
   few strings the picture needs */
function tvecDotOp(v, w) {
  const R = TVEC_R, T = R.txt, V = "<b>v</b>", W = "<b>w</b>", d = R.dot(v, w), vv = R.dot(v, v), ww = R.dot(w, w);
  const steps = [`${V} · ${W} = ${tvecPr(v, w)} = <b>${T(d)}</b>`, `|${V}| = √(${tvecSq(v)}) = ${tvecRootChain(vv)}`, `|${W}| = √(${tvecSq(w)}) = ${tvecRootChain(ww)}`];
  const vs = tvecVs(v), ws = tvecVs(w);
  if (R.z(vv) || R.z(ww)) {
    const who = R.z(vv) && R.z(ww) ? "v and w are both" : R.z(vv) ? "v is" : "w is";
    steps.push(`|${R.z(vv) ? V : W}| = 0, so cos θ = ${vzFrac(`${V} · ${W}`, `|${V}| |${W}|`)} would divide by 0: no angle`);
    return { ans: [`${V} · ${W} = <b>${T(d)}</b>`, `θ: not defined (${who} 0)`], steps, cls: "warn",
      status: `${who} the zero vector: no direction, so no angle.`, cap: `${vzB("v")} · ${vzB("w")} = ${T(d)},  no angle: ${who} 0`, lab: { v: vs, w: ws } };
  }
  const lv = tvecRoot(vv), lw = tvecRoot(ww), cs = tvecOverRoot(d, tvecRoot(R.mul(vv, ww))), A = tvecAngle(cs), deg = vzNum(A.deg, 2) + "°";
  steps.push(`cos θ = ${vzFrac(`${V} · ${W}`, `|${V}| |${W}|`)} = ${vzFrac(T(d), `${tvecRootTxt(lv)} · ${tvecRootTxt(lw)}`)} = ${tvecWithDec(cs)}`);
  steps.push(`θ = arccos(${tvecRootTxt(cs)}) ` + (A.ex ? `= <b>${A.ex}</b>` + (A.ex === "0" ? "" : ` = ${A.deg}°`) : `≈ <b>${vzNum(A.num, 3)}</b> rad ≈ ${deg}`));
  const th = A.ex ? `θ = <b>${A.ex}</b>` + (A.ex === "0" ? "" : ` = ${A.deg}°`) : `θ ≈ <b>${vzNum(A.num, 3)}</b> rad ≈ <b>${deg}</b>`;
  const status = R.z(d) ? "v · w = 0: v and w are orthogonal." : A.ex === "0" ? "v and w point the same way: they are parallel."
    : A.ex === "π" ? "v and w point opposite ways: they are parallel." : d[0] > 0n ? "v · w > 0, so the angle is under 90°." : "v · w < 0, so the angle is over 90°.";
  return { ans: [`${V} · ${W} = <b>${T(d)}</b>`, th], steps, cls: "ok", status,
    cap: `${vzB("v")} · ${vzB("w")} = ${T(d)},   θ ${A.ex ? "= " + (A.ex === "0" ? "0" : A.ex + " = " + A.deg + "°") : "≈ " + vzNum(A.deg, 1) + "°"}`, lab: { v: vs, w: ws, perp: R.z(d) } };
}
function tvecProjOp(v, w) {
  const R = TVEC_R, T = R.txt, V = "<b>v</b>", W = "<b>w</b>", d = R.dot(v, w), ww = R.dot(w, w);
  const comp = `comp<sub>${W}</sub>(${V})`, proj = `proj<sub>${W}</sub>(${V})`, vs = tvecVs(v), ws = tvecVs(w);
  const steps = [`${V} · ${W} = ${tvecPr(v, w)} = <b>${T(d)}</b>`];
  if (R.z(ww)) {
    steps.push(`${W} · ${W} = ${tvecSq(w)} = 0: ${W} is the zero vector, so there is nothing to divide by`);
    return { ans: [`${proj}: not defined, since ${W} = 0`], steps, cls: "warn", status: "w is the zero vector: there is no line to project onto.",
      cap: `${vzB("w")} = 0: no line to project onto`, lab: { v: vs, w: ws } };
  }
  const lw = tvecRoot(ww), cp = tvecOverRoot(d, lw), pr = R.scale(R.div(d, ww), w), perp = R.vsub(v, pr), perp0 = perp.every(R.z);
  steps.push(`${W} · ${W} = ${tvecSq(w)} = ${T(ww)}, so |${W}| = ${tvecRootChain(ww)}`);
  steps.push(`${comp} = ${vzFrac(`${V} · ${W}`, `|${W}|`)} = ${vzFrac(T(d), tvecRootTxt(lw))} = ${tvecWithDec(cp)}`);
  steps.push(`${proj} = ${vzFrac(`${V} · ${W}`, `${W} · ${W}`)} ${W} = ${vzFrac(T(d), T(ww))} ${tvecV(w)} = <b>${tvecV(pr)}</b>`);
  steps.push(`${V}<sub>⊥</sub> = ${V} − ${proj} = ${tvecV(v)} − ${tvecV(pr)} = <b>${tvecV(perp)}</b>`);
  steps.push(`check: ${V}<sub>⊥</sub> · ${W} = ${tvecPr(perp, w)} = ${T(R.dot(perp, w))} ✓`);
  const status = R.z(d) ? "v · w = 0: v is orthogonal to w, so its shadow is 0." : perp0 ? "v lies along w: proj_w(v) = v, and v⊥ = 0."
    : d[0] < 0n ? "v · w < 0: the shadow points against w." : "v = v∥ + v⊥, and v⊥ is orthogonal to w.";
  return { ans: [`${comp} = ${tvecWithDec(cp)} <span class="vz-tag">a number</span>`, `${proj} = ${V}<sub>∥</sub> = <b>${tvecV(pr)}</b>`, `${V}<sub>⊥</sub> = <b>${tvecV(perp)}</b>`],
    steps, cls: "ok", status: status.replace("proj_w(v)", "proj<sub>w</sub>(v)"),
    cap: `${vzSub("proj", "w", "(v)")} = ${tvecVs(pr)},   ${vzSub("comp", "w", "(v)")} = ${tvecRootTxt(cp)}`, lab: { v: vs, w: ws } };
}
function tvecCrossOp(v, w) {
  const R = TVEC_R, T = R.txt, V = "<b>v</b>", W = "<b>w</b>", I = "<b>i</b>", J = "<b>j</b>", K = "<b>k</b>", c = R.cross(v, w), j0 = R.sub(R.mul(v[0], w[2]), R.mul(v[2], w[0]));
  const t = (a, b, p, q) => `(${T(a)})(${T(b)}) − (${T(p)})(${T(q)})`;
  const steps = [`${V} × ${W} = ${tvecDet(v, w)}`,
    `= (${t(v[1], w[2], v[2], w[1])}) ${I} − (${t(v[0], w[2], v[2], w[0])}) ${J} + (${t(v[0], w[1], v[1], w[0])}) ${K}`,
    `= (${T(c[0])}) ${I} − (${T(j0)}) ${J} + (${T(c[2])}) ${K} = <b>${tvecV(c)}</b>`];
  const cc = R.dot(c, c), lab = { v: tvecVs(v), w: tvecVs(w), c: tvecVs(c) };
  if (R.z(cc)) {
    steps.push(`${V} × ${W} = <b>0</b>: ${V} and ${W} are parallel, so they span no area`);
    return { ans: [`${V} × ${W} = <b>${tvecV(c)}</b>`, `area 0: ${V} and ${W} are parallel`], steps, cls: "warn",
      status: "v and w are parallel (or one is 0): v × w = 0, no area.", cap: `${vzB("v")} × ${vzB("w")} = 0:  parallel, no area`, lab };
  }
  const ar = tvecRoot(cc), tri = { c: R.mul(ar.c, [1n, 2n]), r: ar.r };
  steps.push(`check: (${V} × ${W}) · ${V} = ${tvecPr(c, v)} = ${T(R.dot(c, v))} ✓<br>(${V} × ${W}) · ${W} = ${tvecPr(c, w)} = ${T(R.dot(c, w))} ✓`);
  steps.push(`parallelogram: |${V} × ${W}| = √(${tvecSq(c)}) = ${tvecRootChain(cc)}${ar.r === 1n && ar.c[1] === 1n ? "" : ` <span class="vz-approx">${tvecApprox(tvecRootNum(ar))}</span>`}<br>triangle: ½|${V} × ${W}| = ${tvecWithDec(tri)}`);
  return { ans: [`${V} × ${W} = <b>${tvecV(c)}</b>`, `area: parallelogram ${tvecWithDec(ar)}, triangle ${tvecWithDec(tri)}`], steps, cls: "ok",
    status: "v × w is orthogonal to v and to w; its length is the area.",
    cap: `${vzB("v")} × ${vzB("w")} = ${tvecVs(c)},   area ${tvecNumTxt(ar)}`, lab };
}
function tvecPlaneOp(P, Q, Rp) {
  const R = TVEC_R, T = R.txt, N = "<b>n</b>", I = "<b>i</b>", J = "<b>j</b>", K = "<b>k</b>", PQ = tvecAB("PQ"), PR = tvecAB("PR");
  const u = R.vsub(Q, P), w = R.vsub(Rp, P), n = R.cross(u, w), t = (a, b, p, q) => `(${T(a)})(${T(b)}) − (${T(p)})(${T(q)})`;
  const lab = { P: tvecPts(P), Q: tvecPts(Q), R: tvecPts(Rp) };
  const steps = [`${PQ} = Q − P = ${tvecPt(Q)} − ${tvecPt(P)} = <b>${tvecV(u)}</b><br>${PR} = R − P = ${tvecPt(Rp)} − ${tvecPt(P)} = <b>${tvecV(w)}</b>`,
    `${N} = ${PQ} × ${PR} = ${tvecDet(u, w)}<br>= (${t(u[1], w[2], u[2], w[1])}) ${I} − (${t(u[0], w[2], u[2], w[0])}) ${J} + (${t(u[0], w[1], u[1], w[0])}) ${K} = <b>${tvecV(n)}</b>`];
  if (n.every(R.z)) {
    const same = [[P, Q], [P, Rp], [Q, Rp]].some(([a, b]) => a.every((x, i) => R.z(R.sub(x, b[i]))));
    steps.push(`${N} = 0: ${same ? "two of the points are the same" : "P, Q and R lie on one line"}, so many planes go through them`);
    return { ans: [`No single plane: ${same ? "two of the points are the same" : "P, Q and R are on one line"}`], steps, cls: "warn",
      status: "Points on one line don't pick out a plane.", cap: same ? "two of the points are the same: no single plane" : "P, Q, R are on one line: no single plane", lab: Object.assign(lab, { flat: true }) };
  }
  const d = R.dot(n, P), at = (x0, nm) => R.z(x0) ? `(${nm} − 0)` : x0[0] < 0n ? `(${nm} + ${T(R.abs(x0))})` : `(${nm} − ${T(x0)})`;
  const S = tvecScale(n, d), eq1 = `${tvecLin(n)} = ${T(d)}`, eq2 = `${tvecLin(S.co)} = ${T(S.d)}`;
  const chk = X => `${tvecLin(S.co, X.map(x => `(${T(x)})`))} = ${T(R.dot(S.co, X))}`;
  steps.push(`${N} · (<b>x</b> − P) = 0: &nbsp;${tvecLin(n, [at(P[0], "x"), at(P[1], "y"), at(P[2], "z")])} = 0`);
  steps.push(S.f ? `${eq1}, or ${S.f}: <b>${eq2}</b>` : `<b>${eq1}</b>`);
  steps.push(`check Q: ${chk(Q)} ✓<br>check R: ${chk(Rp)} ✓`);
  return { ans: [`plane: <b>${eq2}</b>`, `normal ${N} = ${tvecV(n)}`], steps, cls: "ok", status: "n is orthogonal to both edges, so to the whole plane.",
    cap: `plane:  ${eq2}`, lab: Object.assign(lab, { eq: eq2, n: tvecVs(n) }) };
}
function tvecDistOp(n, d, Q) {
  const R = TVEC_R, T = R.txt, N = "<b>n</b>", PQ = tvecAB("PQ"), nn = R.dot(n, n), eq = `${tvecLin(n)} = ${T(d)}`;
  if (R.z(nn)) return { ans: ["Not a plane: a, b and c can't all be 0"], steps: [`${N} = [0, 0, 0], and 0 = ${T(d)} ${R.z(d) ? "holds for every point" : "holds for no point"}: this is not a plane`],
    cls: "warn", status: "A plane needs a normal vector n ≠ 0.", cap: "not a plane: a, b and c are all 0", lab: { Q: tvecPts(Q), flat: true } };
  // a point of the plane: two coordinates 0, the third solved for (a whole-number point when there is one)
  let i = [0, 1, 2].find(j => !R.z(n[j]) && R.div(d, n[j])[1] === 1n);
  if (i == null) i = [0, 1, 2].find(j => !R.z(n[j]));
  const P = [0, 1, 2].map(j => j === i ? R.div(d, n[i]) : [0n, 1n]), u = R.vsub(Q, P), nu = R.dot(n, u), ln = tvecRoot(nn);
  const dist = tvecOverRoot(R.abs(nu), ln), F = R.vsub(Q, R.scale(R.div(nu, nn), n));
  const steps = [`${N} = <b>${tvecV(n)}</b>, and P = ${tvecPt(P)} is on the plane: ${tvecLin(n, P.map(x => `(${T(x)})`))} = ${T(d)} ✓`,
    `${PQ} = Q − P = ${tvecPt(Q)} − ${tvecPt(P)} = <b>${tvecV(u)}</b>`,
    `${N} · ${PQ} = ${tvecPr(n, u)} = <b>${T(nu)}</b>`,
    `|${N}| = √(${tvecSq(n)}) = ${tvecRootChain(nn)}`,
    `distance = |comp<sub>${N}</sub>(${PQ})| = ${vzFrac(`|${N} · ${PQ}|`, `|${N}|`)} = ${vzFrac(T(R.abs(nu)), tvecRootTxt(ln))} = ${tvecWithDec(dist)}`,
    R.z(nu) ? `closest point: Q itself, since ${N} · ${PQ} = 0` : `closest point: Q − proj<sub>${N}</sub>(${PQ}) = ${tvecPt(Q)} ${nu[0] < 0n ? "+" : "−"} ${vzFrac(T(R.abs(nu)), T(nn))} ${tvecV(n)} = <b>${tvecPt(F)}</b>`];
  return { ans: [`distance = ${tvecWithDec(dist)}`, `closest point: <b>${tvecPt(F)}</b>`], steps, cls: "ok",
    status: R.z(nu) ? "Q lies on the plane, so the distance is 0." : "The shortest path from Q meets the plane at a right angle.",
    cap: `distance from Q to the plane = ${tvecNumTxt(dist)}`,
    lab: { P: tvecPts(P), Pn: P.map(R.num), Q: tvecPts(Q), eq, n: tvecVs(n), dist: tvecRootTxt(dist) } };
}
// plain-number vector helpers for the picture
const TVEC_F = {
  dot: (a, b) => a.reduce((s, x, i) => s + x * b[i], 0),
  add: (a, b) => a.map((x, i) => x + b[i]),
  sub: (a, b) => a.map((x, i) => x - b[i]),
  mul: (a, k) => a.map(x => x * k),
  len: a => Math.hypot(...a),
  unit: a => { const L = Math.hypot(...a) || 1; return a.map(x => x / L); },
  cross: (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]],
};

vzAdd({
  id: "tool-vec", title: "Vectors with your own numbers", card: "Vectors: your own numbers",
  tagline: "Type your vectors; get the answer, worked out.",
  blurb: "Pick what to compute, then type the numbers from your problem: whole numbers, decimals or fractions like 3/4. Answers come out exact, with fractions and simplified roots (√20 = 2√5), and a decimal beside them. The working follows the course: \\(\\mathbf v\\cdot\\mathbf w=|\\mathbf v||\\mathbf w|\\cos\\theta\\), \\(\\operatorname{comp}_{\\mathbf w}(\\mathbf v)=\\frac{\\mathbf v\\cdot\\mathbf w}{|\\mathbf w|}\\), \\(\\operatorname{proj}_{\\mathbf w}(\\mathbf v)=\\frac{\\mathbf v\\cdot\\mathbf w}{\\mathbf w\\cdot\\mathbf w}\\,\\mathbf w\\), \\(|\\mathbf v\\times\\mathbf w|\\) is the area of the parallelogram, a plane is \\(\\mathbf n\\cdot(\\mathbf x-P)=0\\), and the distance from \\(Q\\) to it is \\(|\\operatorname{comp}_{\\mathbf n}(\\overrightarrow{PQ})|\\).",
  tryIt: "Type the numbers from your problem, then Show next step.",
  state: { op: 0, dim: 2, k: 0, yaw: -32, el: .45, v1: 1, v2: 3, v3: 1, w1: 4, w2: 2, w3: 2, p1: 1, p2: 1, p3: 2, q1: 3, q2: 1, q3: 1, r1: 3, r2: 3, r3: 2, ea: 2, eb: 1, ec: 2, ed: 4, x0: 3, y0: 4, z0: 3 },
  thumb: { op: 2, yaw: 110, el: .6 },   // the cross product, from its best view
  // for the fuzz check: every computation, and the awkward inputs (zero vectors, parallel vectors, points on a line, not a plane)
  variants: [{ op: 0, dim: 3 }, { op: 1 }, { op: 1, dim: 3 }, { op: 2 }, { op: 3 }, { op: 4 }, { op: 0, v1: 0, v2: 0, v3: 0 }, { op: 0, w1: -2, w2: -6, w3: -2, dim: 3 },
    { op: 1, w1: 0, w2: 0, w3: 0 }, { op: 1, v1: 2, v2: 1 }, { op: 1, v1: -1, v2: 2 }, { op: 2, w1: 2, w2: 6, w3: 2 }, { op: 2, v1: 0, v2: 0, v3: 0 },
    { op: 3, r1: 5, r2: 1, r3: 0 }, { op: 3, q1: 1, q2: 1, q3: 2 }, { op: 4, ea: 0, eb: 0, ec: 0 }, { op: 4, x0: 2, y0: 0, z0: 0 }, { op: 4, ea: 0, eb: 3, ec: 0, ed: 1 },
    { op: 0, v1: .5, v2: -1.25, w1: 1 / 3, w2: 2 / 3 }, { op: 3, p1: 1 / 2, p2: 0, p3: 0, q1: 0, q2: 1 / 3, q3: 0, r1: 0, r2: 0, r3: 1 / 4 }],
  controls: [{ k: "yaw", label: "turn the view", min: -180, max: 180, step: 1, unit: "°", digits: 0, noPlay: true, show: s => VZ_BY_ID["tool-vec"].is3(s) }],
  op(s) { const o = Math.round(+s.op); return o >= 0 && o <= 4 ? o : 0; },
  is3(s) { return this.op(s) >= 2 || Math.round(+s.dim) !== 2; },
  reset() { this._disp = null; this._fresh = null; this._manual = false; },
  panelTop() {
    const st = this.state, inp = (k, name, w) => `<input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" id="tvec-${k}" data-tv="${k}" value="${tvecIn(st[k])}" aria-label="${escapeHtml(name)}"${w ? ` style="padding:0 2px"` : ""}>`;
    const paren = c => `<span aria-hidden="true" style="font:300 22px var(--font-display);color:var(--ink-soft)">${c}</span>`;
    const vec = (nm, ks) => `<div class="vz-mx" style="grid-template-columns:32px auto;justify-content:start;margin:0 0 6px"><span class="vz-mx-name" style="white-space:nowrap">${nm} =</span><span class="vz-brk vz-mx-grid" data-tvgrid style="grid-template-columns:repeat(3,56px)">${ks.map((k, i) => inp(k, `${nm} entry ${i + 1}`)).join("")}</span></div>`;
    const pt = (nm, ks) => `<div class="vz-mx" style="grid-template-columns:32px auto;justify-content:start;margin:0 0 6px"><span class="vz-mx-name" style="white-space:nowrap">${nm} =</span><span style="display:inline-flex;align-items:center">${paren("(")}<span class="vz-mx-grid" style="grid-template-columns:repeat(3,56px);padding:3px 3px">${ks.map((k, i) => inp(k, `${nm}: ${"xyz"[i]}`)).join("")}</span>${paren(")")}</span></div>`;
    const vr = c => `<span style="font:italic 16px var(--font-display);white-space:nowrap">${c}</span>`;
    return `<div><div class="vz-ptop-k">Compute</div><div class="vz-chips">${TVEC_OPS.map((c, i) => `<button type="button" class="vz-chip" data-tvo="${i}">${c}</button>`).join("")}</div></div>
      <div><div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px"><div class="vz-ptop-k" style="margin:0">Your numbers</div>
        <div class="vz-seg" role="group" aria-label="Vectors in the plane or in space" data-tvdim><button type="button" data-tvd="2">ℝ²</button><button type="button" data-tvd="3">ℝ³</button></div></div>
        <div data-tvg="vw">${vec("v", ["v1", "v2", "v3"])}${vec("w", ["w1", "w2", "w3"])}</div>
        <div data-tvg="pqr" hidden>${pt("P", ["p1", "p2", "p3"])}${pt("Q", ["q1", "q2", "q3"])}${pt("R", ["r1", "r2", "r3"])}</div>
        <div data-tvg="pt" hidden><div class="vz-mx" style="grid-template-columns:auto;justify-content:start;margin:0 0 6px"><span class="vz-mx-grid" style="grid-template-columns:46px auto 46px auto 46px auto 46px;align-items:center;gap:4px 5px;padding:3px 0">${inp("ea", "a, the number before x", 1)}${vr("x +")}${inp("eb", "b, the number before y", 1)}${vr("y +")}${inp("ec", "c, the number before z", 1)}${vr("z =")}${inp("ed", "d, the right-hand side", 1)}</span></div>${pt("Q", ["x0", "y0", "z0"])}</div>
        <div class="vz-mx-hint" data-tvhint>Whole numbers, decimals or fractions like −3/4.</div></div>`;
  },
  // the panel's own listeners (typing, the arrow keys, the step buttons), wired once per page
  wire(panel) {
    if (panel._tvec) return;
    panel._tvec = true;
    const def = this, hint = () => panel.querySelector("[data-tvhint]");
    const mark = (el, bad, msg) => {
      el.style.borderColor = bad ? VZ.red : ""; el.style.background = bad ? "#FFF6F7" : "";
      if (bad) el.setAttribute("aria-invalid", "true"); else el.removeAttribute("aria-invalid");
      const h = hint(); if (h) { h.textContent = msg || "Whole numbers, decimals or fractions like −3/4."; h.style.color = msg ? VZ.deep : ""; }
    };
    // a new number: the picture glides to it, and turns to suit it (unless the student has turned the view); when the
    // case changes (a zero vector, points on a line, not a plane, a right angle) the old picture dissolves instead
    const put = (el, num) => {
      if (VzView.def !== def) return;
      const st = VzView.st, k0 = def.kind(st); st[el.dataset.tv] = num;
      const jump = def.kind(st) !== k0, b = def.is3(st) && !def._manual ? def.bestView(st) : null;
