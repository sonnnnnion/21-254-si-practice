    o += vzTipLabels(P, [{ v, html: vzB("v"), col: VZ.ink }].concat(tipW ? [] : [{ v: w, html: vzB("w"), col: VZ.red }])) + tipW;
    const zs = [lv * u < 3 ? "v" : "", lw * u < 3 ? "w" : ""].filter(Boolean);
