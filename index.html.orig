    o += tags.join("");
    if (!thumb) o += vzGrip(P.X(v[0]), P.Y(v[1]), VZ.ink, VzView.hot === "v");
    o += P.arrow([0, 0], Ad, "R", 3.2) + P.arrow([0, 0], v, "I", 2.6) + P.dot([0, 0], 3.6);
    if (Math.hypot(...Ad) * Lv < 3) o += `<circle cx="${q2(cx)}" cy="${cy}" r="6" fill="none" stroke="${VZ.red}" stroke-width="2"/>`;   // Av = 0
    // names past the tips; on a shared line v's goes on one side and Av's on the other
    const L = Math.hypot(...Ad) || 1, nx = -(Ad[1] || -v[1] * 1e-6) / L, ny = (Ad[0] || v[0] * 1e-6) / L, up = ny > 1e-9 || (Math.abs(ny) <= 1e-9 && nx < 0) ? 1 : -1;
    const tipAt = (p, gap, off) => { const l = Math.hypot(...p) || 1; return [P.X(p[0]) + p[0] / l * gap + nx * up * off, P.Y(p[1]) - p[1] / l * gap - ny * up * off]; };
    const close = Math.abs(Math.hypot(...Ad) - 1) * Lv < 34, inX = x => vzClamp(x, X0 + 16, 584);
    const lAv = Math.hypot(...Ad) * Lv < 3 ? [cx + 18, cy - 14] : tipAt(Ad, 20, (close ? -18 : 16) * near), lv = tipAt(v, 16, 16 * near);
    o += vzLabel(inX(lAv[0]), lAv[1] + 5, "A" + vzB("v"), VZ.red, 18);
    const vOp = Math.max(near, vzClamp((Math.hypot(lAv[0] - lv[0], lAv[1] - lv[1]) - 18) / 14, 0, 1));
    if (vOp > .01) o += `<g opacity="${q2(vOp)}">${vzLabel(inX(lv[0]), lv[1] + 5, vzB("v"), VZ.ink, 16)}</g>`;
    // what the picture says now: on a line Av = λv; off every line, Av leaves v's line
    if (!thumb) {
      const lam = cur && cur.e, lt = lam ? sol.htmlLam(lam) : "";
      const said = every ? `Every v is an eigenvector: Av = ${coef(sol.htmlLam(sol.eig[0]))}v` : !sol.real && sol.n === 2 ? "Complex λ: Av is never along v" : lam ? (lt === "0" ? "Av = 0 = 0v: an eigenvector" : `Av = ${coef(lt)}v: v is an eigenvector`) : "";
      const off = !sol.real ? "" : "Av is not along v";
      const a1 = every || !sol.real ? 1 : vzClamp(near * 2 - 1, 0, 1), a2 = every || !sol.real ? 0 : vzClamp(1 - near * 2, 0, 1);
      if (a1 > .01 && said) o += `<g opacity="${q2(a1)}">${this.cap(G, 0, said, VZ.ink)}</g>`;
      if (a2 > .01) o += `<g opacity="${q2(a2)}">${this.cap(G, 0, off, VZ.ink)}${this.cap(G, 1, "drag v onto a dashed line")}</g>`;
      if (k > 1) o += this.cap(G, a2 > .01 ? 2 : 1, `Av drawn at ${k === 1.5 ? "2/3" : "1/" + k} of its length`);
    }
    o += vzKey([["line", VZ.ink, "v"], ["line", VZ.red, "Av"]].concat(lines.length ? [["dash", VZ.grey, "eigenvectors"]] : []), X0 + 16, 432);
    return o;
    function coef(t) { return t === "1" ? "" : t === "−1" ? "−" : /[ /]/.test(t) ? "(" + t + ")" : t; }
  },
  pic3(s, sol, thumb, split) {
    const G = this.geo(s, sol, split), { X0, cx, cy, Lv, k } = G, cam = vzCam(cx, cy + 12, Lv, vzRad(s.yaw), .4);
    const reach = Math.min(G.W / 2 - 22, 176) / Lv, pt = p => { const q = cam(p[0], p[1], p[2]); return [q[0], q[1]]; };
    const seg = (a, b, attrs) => { const p = pt(a), q = pt(b); return `<line x1="${q2(p[0])}" y1="${q2(p[1])}" x2="${q2(q[0])}" y2="${q2(q[1])}" ${attrs}/>`; };
    const arrow = (p, key, w) => { const a = pt([0, 0, 0]), b = pt(p); return vzArrow(a[0], a[1], b[0], b[1], key, w); };
    let o = "";
    ["x", "y", "z"].forEach((nm, i) => {
      const e = [0, 0, 0]; e[i] = reach * .9; const m = e.map(x => -x);
      o += seg(m, e, `stroke="${VZ.ink}" stroke-width="1.1" opacity=".22"`);
      const q = pt(e.map(x => x * 1.06)); o += `<text x="${q2(q[0])}" y="${q2(q[1] + 4)}" font-family="'Fraunces', Georgia, serif" font-style="italic" font-size="14" fill="${VZ.grey}" text-anchor="middle" opacity=".8">${nm}</text>`;
    });
    const nrm = u => { const L = Math.hypot(...u) || 1; return u.map(x => x / L); };
    const every = sol.real && sol.eig.length === 1 && sol.eig[0].gm === 3;
    const groups = every ? [] : sol.eig.filter(e => e.real && e.vecIdx && e.vecIdx.length).map(e => ({ e, us: e.vecIdx.map(i => nrm(sol.vecs[i - 1].num)) }));
    const tags = [], placed = [];
    groups.forEach(g => {
      const lam = g.e.num, lt = this.lamTag(sol, g.e);
      if (g.us.length === 2) {                         // a plane of eigenvectors
        const u1 = g.us[0], w0 = g.us[1], d = u1.reduce((s2, x, i) => s2 + x * w0[i], 0), u2 = nrm(w0.map((x, i) => x - d * u1[i])), a = reach * .5;
        const c = [[1, 1], [1, -1], [-1, -1], [-1, 1]].map(([p, q]) => pt(u1.map((x, i) => a * (p * x + q * u2[i]))));
        o += `<path d="M${c.map(p => q2(p[0]) + " " + q2(p[1])).join("L")}Z" fill="${VZ.red}" fill-opacity=".07" stroke="${VZ.red}" stroke-opacity=".3" stroke-width="1.2"/>`;
        g.corners = c;
      } else {
        const u = g.us[0]; o += seg(u.map(x => -x * reach), u.map(x => x * reach), `stroke="${VZ.grey}" stroke-width="2" stroke-dasharray=".01 7" stroke-linecap="round" opacity=".6"`);
      }
      g.us.forEach(u => {
        const Au = u.map(x => x * lam / k), longer = Math.abs(lam / k) >= 1;
        if (longer) o += arrow(Au, "R", 3.2) + arrow(u, "I", 2.4); else o += arrow(u, "I", 2.4) + arrow(Au, "R", 3.2);
      });
      // the tag goes just past the longer arrow, at whichever end of the line is farther from tags already placed
      const lt2 = lt + (g.us.length === 2 ? " (a plane)" : ""), w = lt2.length * 7.4 + 18, O = pt([0, 0, 0]);
      const ends = (g.corners || [1, -1].map(sg => { const u = g.us[0], tip = pt(u.map(x => x * sg * Math.max(1, Math.abs(lam / k)))), dx = tip[0] - O[0], dy = tip[1] - O[1], L = Math.hypot(dx, dy) || 1;
        return [tip[0] + dx / L * (14 + w / 2 * Math.abs(dx / L)), tip[1] + dy / L * (18 + 6 * Math.abs(dy / L))]; }));
      const score = p => placed.reduce((m, q) => Math.min(m, Math.hypot(p[0] - q[0], (p[1] - q[1]) * 2.5)), 999) - (p[1] < 70 || p[1] > 400 || p[0] < X0 + w / 2 || p[0] > 600 - w / 2 ? 300 : 0);
      const best = score(ends[0]) >= score(ends[1]) ? ends[0] : ends[1]; placed.push(best);
      tags.push(this.tag(best[0], best[1], lt2, 0, G));
    });
    const O = pt([0, 0, 0]); o += `<circle cx="${q2(O[0])}" cy="${q2(O[1])}" r="3.4" fill="${VZ.ink}"/>`;
    o += tags.join("");
    if (!thumb) {
      const cx2 = sol.eig.find(e => e.kind === "c" || e.kind === "xc");
      o += this.cap(G, 0, every ? `A = ${sol.htmlLam(sol.eig[0])}I: every vector is an eigenvector` : "Along each eigenvector, Av = λv", VZ.ink);
      let y = 1;
      if (cx2) o += this.cap(G, y++, "the complex pair has no real eigenvector");
      if (!sol.exact) o += this.cap(G, y++, "eigenvectors to 3 decimal places");
      if (k > 1) o += this.cap(G, y++, `Av drawn at ${k === 1.5 ? "2/3" : "1/" + k} of its length`);
    }
    o += vzKey([["line", VZ.ink, "v"], ["line", VZ.red, "Av = λv"]].concat(groups.some(g => g.us.length === 1) ? [["dash", VZ.grey, "eigenvectors"]] : groups.length ? [["fill", VZ.red, "eigenvectors"]] : []), X0 + 16, 432);
    return o;
  },
  readout(s) {
    const n = s.n === 3 ? 3 : 2, sol = TEIG_sol(s), rd = TEIG_read(s, n), sub = i => "₁₂₃"[i];
    let o = `<div class="vz-eq">λ ${sol.exact ? "= " : ""}<b>${sol.lamHtml}</b></div>`;
    if (sol.vecs.length) o += `<div class="vz-eq vz-small">${sol.vecs.map((V, i) => `<span class="vz-nw">v${sub(i)} ${sol.exact ? "= " : ""}${sol.vecHtml[i]}</span>`).join(", ")}</div>`;
    let st;
    if (rd.bad.length) {
      const q = rd.bad[0], why = { empty: "is empty", big: "is too big (keep entries between −99 and 99)", den: "has too big a denominator (99 at most)", zero: "divides by 0" }[q.err] || "isn't a number yet (try 3, −1/2 or 0.25)";
      st = ["warn", `Row ${q.i + 1}, column ${q.j + 1} ${why}. Showing the last full matrix.`];
    } else if (sol.diag) st = ["ok", `Diagonalizable: A = PDP⁻¹ with P = [${sol.vecs.map((_, i) => "v" + sub(i)).join(" ")}], D = diag(${sol.vecs.map(V => sol.htmlLam(V.e).replace("≈ ", "")).join(", ")}).`];
    else if (!sol.real) st = ["warn", n === 2 ? "Complex λ: no real eigenvectors, so no real diagonalization." : "A complex pair of λ: A can't be diagonalized with real matrices."];
    else { const b = sol.eig.find(e => e.gm < e.am); st = ["warn", `Not diagonalizable: λ = ${sol.htmlLam(b)} has ${b.gm === 1 ? "only one independent eigenvector" : `only ${b.gm} independent eigenvectors`}, and needs ${b.am}.`]; }
