+// contour lines of fn on [x0,x1]×[y0,y1] (marching squares), as one SVG path per level, in plane P's pixels; cached
+const M6_CC = {};
+function m6Contours(key, fn, x0, x1, y0, y1, n, levels, P) {
+  if (M6_CC[key]) return M6_CC[key];
+  const m = n, dx = (x1 - x0) / n, dy = (y1 - y0) / m, V = [];
+  for (let j = 0; j <= m; j++) { V.push([]); for (let i = 0; i <= n; i++) V[j].push(fn(x0 + i * dx, y0 + j * dy)); }
+  const out = levels.map(L => {
+    let d = "";
+    for (let j = 0; j < m; j++) for (let i = 0; i < n; i++) {
+      const c = [[i, j], [i + 1, j], [i + 1, j + 1], [i, j + 1]], pts = [];
+      for (let e = 0; e < 4; e++) {
+        const a = c[e], b = c[(e + 1) % 4], va = V[a[1]][a[0]] - L, vb = V[b[1]][b[0]] - L;
+        if (va * vb < 0) { const t = va / (va - vb); pts.push([P.X(x0 + (a[0] + (b[0] - a[0]) * t) * dx), P.Y(y0 + (a[1] + (b[1] - a[1]) * t) * dy)]); }
+      }
+      for (let s = 0; s + 1 < pts.length; s += 2) d += `M${q2(pts[s][0])} ${q2(pts[s][1])}L${q2(pts[s + 1][0])} ${q2(pts[s + 1][1])}`;
+    }
+    return [L, d];
+  });
+  return (M6_CC[key] = out);
+}
