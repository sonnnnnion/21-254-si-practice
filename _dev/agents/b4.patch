+// Like stLines, but for an animation that belongs to the whole step: its clock starts when the step's FIRST line of
+// math arrives and keeps running through the later lines, so a long animation is never cut short (and never jumps)
+// when the next line comes. F(K, a, d): 0 until step K's math starts, then eased in from a s over d s; 1 later on.
+function stFirstL(def, k, b, u) {
+  const m = def._f0 || (def._f0 = {});
+  if (u < 99) {
+    if (m.k !== k || b < 0 || (m.u0 != null && u < m.u0)) { m.k = k; m.u0 = null; }
+    if (b >= 0 && m.u0 == null) m.u0 = u;
+  }
+  const t = u >= 99 ? 99 : m.u0 == null ? 0 : u - m.u0;
+  return (K, a = 0, d = .7) => k > K ? 1 : k < K ? 0 : b < 0 ? 0 : stEase(t, a, d);
